{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "vitest.workers.config.ts",
    "src/**/*.workers.test.ts",
    "src/lib/test-setup.workers.ts"
  ]
}
