# This file only decorates STATIC ASSET responses (CSS, JS, fonts, images).
# On Cloudflare Workers Static Assets it is not applied to Worker-generated SSR
# pages or API routes; those get their security headers from src/middleware.ts,
# and their Content-Security-Policy as a response header from Astro security.csp
# (see astro.config.mjs). Keep this set in sync with src/lib/http/securityHeaders.ts.

# Long-lived immutable cache for content-stable assets with fixed filenames.
# Hashed /_astro/* assets get this automatically from the adapter; the public/
# assets below do not, so without these rules every navigation pays a 304
# revalidation roundtrip. These never change under the same name; if one ever
# does, bump its filename (e.g. logo-v2.svg) so caches pick it up.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/badges/*
  Cache-Control: public, max-age=31536000, immutable
/og/*
  Cache-Control: public, max-age=31536000, immutable
/orgs/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=31536000, immutable
/og.jpg
  Cache-Control: public, max-age=31536000, immutable
/og-*.jpg
  Cache-Control: public, max-age=31536000, immutable
/logo.png
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# The CIP-100 extension context: versioned URL, so the bytes never change. A new
# term means a v1 -> v2 file, and documents keep the version they were built
# with. Static Assets would otherwise serve .jsonld without a useful type.
/cip100/context/*
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

# Hand-edited script with a stable filename, so it cannot be immutable: an edit
# would not propagate to returning visitors. Cap at one hour with revalidation
# instead, which still removes most of the per-navigation roundtrips.
/brand-copy.js
  Cache-Control: public, max-age=3600, must-revalidate

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
