{
  "name": "dreptalk",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute DB --local --persist-to .wrangler/state --file scripts/seed-dev.sql",
    "typecheck": "astro check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "DREPTALK_LIVE=1 vitest run src/lib/governance/drepTx.live.test.ts",
    "sync:dev": "wrangler dev --config workers/gov-sync/wrangler.toml --test-scheduled --persist-to .wrangler/state --var CARDANO_NETWORK:preprod --port 8787",
    "deploy:app": "wrangler deploy",
    "deploy:app:preprod": "node scripts/preprod-config.mjs && wrangler deploy -c dist/server/wrangler.preprod.json",
    "deploy:sync": "wrangler deploy -c workers/gov-sync/wrangler.toml",
    "deploy:sync:preprod": "wrangler deploy -c workers/gov-sync/wrangler.toml --env preprod",
    "deploy:mainnet": "npm run deploy:app && npm run deploy:sync",
    "deploy:preprod": "npm run deploy:app:preprod && npm run deploy:sync:preprod",
    "deploy:all": "npm run deploy:mainnet && npm run deploy:preprod",
    "deploy": "npm run deploy:all"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.0",
    "@evolution-sdk/evolution": "^0.5.9",
    "@noble/curves": "^2.2.0",
    "astro": "^6.4.5",
    "bech32": "^2.0.0",
    "blakejs": "^1.2.1",
    "cborg": "^5.1.1",
    "marked": "^18.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workers-og": "^0.0.27",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.99.0"
  },
  "overrides": {
    "yaml": "^2.9.0",
    "esbuild": "^0.28.1"
  }
}
