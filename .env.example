# Cardano network: "preprod" or "mainnet". Defaults to mainnet when unset.
# Set to preprod for local and preview; leave unset in production.
CARDANO_NETWORK=preprod

# Canonical site URL
SITE_URL=https://dreptalk.com

# Cloudflare Web Analytics beacon token (public, build-time)
PUBLIC_CF_ANALYTICS_TOKEN=

# Optional Koios API token for extra rate-limit headroom
KOIOS_API_TOKEN=

# Opaque session signing secret (set in Pages encrypted env, not here)
SESSION_SECRET=

# Comma-separated DRep ids with admin rights
ADMIN_DREP_IDS=

# Flag count that auto-hides a post pending review
FLAG_THRESHOLD=3

# Pre-filled GitHub new-issue template URL for software feedback
GITHUB_ISSUES_URL=

# Imprint (TMG section 5), injected at runtime, never committed with real values
IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
IMPRINT_PHONE=
IMPRINT_VAT=
PRIVACY_CONTACT_EMAIL=
