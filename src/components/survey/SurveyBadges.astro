---
// The badges every survey surface shows — lifecycle, sealed, unavailable —
// in one place, so the list row, the thread card and the action's sidebar
// card cannot style or name the same state differently. Tones follow the
// governance status badges: positive for open, negative for a survey Tessera
// decided against, the danger tone for one the mirror lost upstream.
import { lifecycleLabel, type SurveyLifecycle } from '@/lib/surveys/state.js';

interface Props {
  lifecycle: SurveyLifecycle;
  sealed: boolean;
  unavailable: boolean;
}

const { lifecycle, sealed, unavailable } = Astro.props;
---

<span class:list={['svy-badge', `svy-badge--${lifecycle}`]}>{lifecycleLabel(lifecycle)}</span>
{sealed && <span class="svy-badge svy-badge--sealed">Sealed</span>}
{unavailable && <span class="svy-badge svy-badge--gone">Unavailable</span>}

<style>
  .svy-badge {
    font-size: 0.72rem;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.12rem 0.55rem;
  }
  .svy-badge--open {
    color: var(--c-pos);
    background: color-mix(in srgb, var(--c-pos) 12%, transparent);
  }
  .svy-badge--closed {
    color: var(--muted);
    background: color-mix(in srgb, var(--muted) 14%, transparent);
  }
  .svy-badge--cancelled,
  .svy-badge--untalliable {
    color: var(--c-neg);
    background: color-mix(in srgb, var(--c-neg) 12%, transparent);
  }
  .svy-badge--sealed {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .svy-badge--gone {
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 12%, transparent);
  }
</style>
