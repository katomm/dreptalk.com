---
// One row of the surveys category list, mirroring TopicRow's calm look
// without its user-authored affordances.
import SurveyBadges from '@/components/survey/SurveyBadges.astro';
import type { NetworkConfig } from '@/lib/config/network.js';
import type { SurveyListEntry } from '@/lib/db/surveys.js';
import { formatEpochDate } from '@/lib/governance/view.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import { participationLabel, surveyState } from '@/lib/surveys/state.js';
import { surveyDeadlineUnix } from '@/lib/surveys/view.js';

interface Props {
  entry: SurveyListEntry;
  cfg: NetworkConfig;
  now: number;
}

const { entry, cfg, now } = Astro.props;
const { survey } = entry;

const { lifecycle, participation } = surveyState(survey, now, cfg);
const deadlineUnix = surveyDeadlineUnix(survey.endEpoch, cfg);
const replies = Math.max(0, entry.postCount - 1);
---

<a class="svy-row" href={`/t/${entry.topicSlug}/`}>
  <div class="svy-row__main">
    <span class="svy-row__title">{survey.title}</span>
    <span class="svy-row__meta">
      <SurveyBadges lifecycle={lifecycle} sealed={survey.sealed} unavailable={survey.unavailable} />
      <span>
        {lifecycle === 'open'
          ? `open until ${formatEpochDate(deadlineUnix)} (epoch ${survey.endEpoch})`
          : `ended epoch ${survey.endEpoch}`}
      </span>
    </span>
  </div>
  <div class="svy-row__stats">
    <span>{participationLabel(participation)}</span>
    <span>{replies} {replies === 1 ? 'reply' : 'replies'} · {formatRelativeTime(entry.lastPostAt, now)}</span>
  </div>
</a>

<style>
  .svy-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }
  .svy-row:first-of-type {
    border-top: 0;
  }
  .svy-row__main {
    min-width: 0;
  }
  .svy-row__title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }
  .svy-row:hover .svy-row__title {
    text-decoration: underline;
  }
  .svy-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.25rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .svy-row__stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .svy-row {
      flex-direction: column;
      align-items: stretch;
    }
    .svy-row__stats {
      flex-direction: row;
      justify-content: space-between;
      white-space: normal;
    }
  }
</style>
