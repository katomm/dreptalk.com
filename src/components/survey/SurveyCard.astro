---
// The survey thread's header card, from what the page loaded out of D1, the
// "as of" line owns the staleness.
//
// It does show a tally, in SurveyTally below, and what makes that honest is how
// it is presented: a named reading rather than a claimed result. CIP-179 still
// mandates no counting policy, so the card says which rules the reading counts
// under, names the denominator under every share, and keeps the head count
// visible next to the weighted figures so a counted DRep whose voting power
// could not be resolved never disappears from its own answer. Where a
// denominator is empty or the stored reading is not current, the card says which
// of those it is instead of drawing a figure.
import type { SurveyDefinition } from 'cip-179';
import SurveyBadges from '@/components/survey/SurveyBadges.astro';
import SurveyTally from '@/components/survey/SurveyTally.astro';
import type { NetworkConfig } from '@/lib/config/network.js';
import type { SurveyTallyRow } from '@/lib/db/surveyTally.js';
import type { SurveyRow } from '@/lib/db/surveys.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import { participationLabel, surveyState } from '@/lib/surveys/state.js';
import { tallyRefusal } from '@/lib/surveys/tallyRefusal.js';
import { questionViews, surveyDescription } from '@/lib/surveys/view.js';

interface Props {
  survey: SurveyRow;
  /** The decoded definition, or null when the stored form could not be
   * read, the card then shows the row's facts and says so. */
  definition: SurveyDefinition | null;
  cfg: NetworkConfig;
  now: number;
  /** The precomputed informational tally, or null when there is none to show.
   * A row computed from an artifact the survey no longer names arrives as null
   * with `tallyStale` set, never as figures. */
  tally: SurveyTallyRow | null;
  tallyStale: boolean;
  /** Newest epoch the local power history holds, null when it holds nothing.
   * Tells an uncomputed reading apart from an uncomputable one. */
  powerEpoch: number | null;
}

const { survey, definition, cfg, now, tally, tallyStale, powerEpoch } = Astro.props;

const { lifecycle, participation } = surveyState(survey, now, cfg);
const questions = definition ? questionViews(definition) : [];
const description = definition ? surveyDescription(definition) : '';

// The tally owns the counted figure whenever one is on the page: it names the
// rules it counted under, its denominators and its own age, none of which a bare
// participation line carries, and two counts with different bases and no stated
// relationship read as a contradiction. Where no tally can exist the line is the
// only figure there is, so it stays.
const showParticipation = tally === null;

// Wherever the tally draws, it renders every question in full: the prompt, the
// kind, and every option as a bar, the ones nobody picked included. A second
// list above it would repeat the whole survey, so the card's own list is the one
// that gives way, being the one that carries no figures. Where the tally refuses
// it draws no options at all, and then this list is the only place the survey's
// questions are readable. The refusal is decided in one place, tallyRefusal, so
// the two cannot drift into showing both lists or neither.
const showQuestions =
  tallyRefusal({
    unavailable: survey.unavailable,
    externalContent: survey.externalContent,
    sealed: survey.sealed,
    finalState: survey.finalState,
    artifactHash: survey.artifactHash,
    eligibleRoles: survey.eligibleRoles,
    lifecycle,
    definitionReadable: definition !== null,
    tallyStale,
    hasTally: tally !== null,
    powerEpoch,
  }) !== null;
---

<section class="svy-card">
  <div class="svy-card__head">
    <span class="svy-card__kind">CIP-179 survey</span>
    <SurveyBadges lifecycle={lifecycle} sealed={survey.sealed} unavailable={survey.unavailable} />
  </div>

  {survey.unavailable && (
    <p class="svy-card__warn">
      This survey is no longer in the index, or no governance action links it any more. Its
      record, or the action's, may have been rolled back. The thread stays and answering is disabled.
    </p>
  )}

  {!definition ? (
    <p class="svy-card__note">
      The stored survey definition could not be read, so its text is not shown here.
    </p>
  ) : survey.externalContent ? (
    <p class="svy-card__note">
      The survey text lives in an external document that is not loaded here.
    </p>
  ) : (
    description && <p class="svy-card__desc">{description}</p>
  )}

  {showQuestions && (
    <ol class="svy-card__questions">
      {questions.map((q, index) => (
        <li class="svy-q">
          <span class="svy-q__number">Question {index + 1}</span>
          <p class="svy-q__prompt">{q.prompt}{q.required && <span class="svy-q__req" title="An answer must include this question"> *</span>}</p>
          <p class="svy-q__kind">{q.kindLabel}</p>
          {q.options && (
            <ul class="svy-q__options">
              {q.options.map((o) => <li>{o}</li>)}
            </ul>
          )}
          {q.optionNote && <p class="svy-q__kind">{q.optionNote}</p>}
        </li>
      ))}
    </ol>
  )}

  <SurveyTally
    tally={tally}
    tallyStale={tallyStale}
    powerEpoch={powerEpoch}
    survey={survey}
    definition={definition}
    lifecycle={lifecycle}
    now={now}
  />

  {showParticipation && (
    <p class="svy-card__participation">{participationLabel(participation)}</p>
  )}
</section>

<style>
  .svy-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: clamp(1.1rem, 3vw, 1.75rem);
    margin-bottom: 1.5rem;
  }
  .svy-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .svy-card__kind {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .svy-card__warn {
    font-size: 0.875rem;
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 8%, transparent);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    margin: 0 0 0.9rem;
  }
  .svy-card__desc,
  .svy-card__note {
    font-size: 0.9375rem;
    margin: 0 0 1rem;
    /* The description is external text from the chain, so one unbroken string
       must wrap instead of widening the column. */
    overflow-wrap: anywhere;
  }
  .svy-card__note {
    color: var(--muted);
    font-style: italic;
  }
  .svy-card__questions {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.75rem;
  }
  .svy-q__number {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  .svy-q__prompt {
    margin: 0;
    /* The prompt is the survey's content, so it carries the weight the facts
       used to take here before they moved to the sidebar. */
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .svy-q__req {
    color: var(--danger);
  }
  .svy-q__kind {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  /* A plain list, deliberately not option cards. Nothing here is answerable,
     the answer widget is further down the page, so border-and-background chrome
     would read as a button that does nothing. */
  .svy-q__options {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .svy-q__options li {
    overflow-wrap: anywhere;
  }
  /* Only rendered where no tally can exist, so it is the page's single counted
     figure whenever it appears at all. */
  .svy-card__participation {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
