---
// SSR voting-power trend card for a DRep profile: an area chart over the last few
// epoch snapshots with gridlines and axis labels, the single-epoch delta in the
// header, and the whole-window change in the footer. A second dashed line carries
// the delegator headcount on its own scale (see buildOverlaySeries). No client JS;
// renders nothing when there are fewer than two snapshots. Colored by the latest
// step (gain green, loss red); the footer total is colored independently of the
// header, and the delegator line keeps the accent color in every state.
import { buildOverlaySeries, buildPowerChart, computeVotingPowerDelta, formatTrendDelta } from '@/lib/dreps/votingPowerTrend.js';
import type { VotingPowerDelta } from '@/lib/dreps/votingPowerTrend.js';
import { formatAdaCompact } from '@/lib/forum/view.js';

interface Props {
  series: { epoch: number; amount: string; delegatorCount?: number | null }[];
}
const { series } = Astro.props;

const values = series.map((s) => Number(s.amount)).filter((n) => Number.isFinite(n));
const chart = buildPowerChart(values, { width: 480, height: 180, padLeft: 4, padRight: 60, padTop: 18, padBottom: 30 });

// Delegator headcount per epoch, index-aligned with the power series. Only stamped
// from the epoch the count started being recorded, so the older entries are null
// and the overlay draws the trailing run alone.
const counts = series.map((s) => (typeof s.delegatorCount === 'number' ? s.delegatorCount : null));
const overlay = chart ? buildOverlaySeries(counts, chart) : null;
const delegatorChange = overlay ? overlay.lastValue - overlay.firstValue : 0;
const fmtInt = (n: number) => n.toLocaleString('en-US');

// Latest single-epoch step (matches the directory list chip): newest vs the one before.
const lastAmount = series.length >= 1 ? series[series.length - 1].amount : null;
const prevAmount = series.length >= 2 ? series[series.length - 2].amount : null;
const delta = computeVotingPowerDelta(lastAmount, prevAmount);
const dir = delta?.direction ?? 'flat';
// The percent leads, unless the baseline was too small for one to mean anything
// (a DRep's first epochs after registration), and then the amount does.
const deltaDisplay = formatTrendDelta(delta);

// Net change across the whole window (first vs last), a muted secondary so the
// multi-epoch span is never read as the single-epoch step. Only with 3+ points.
const firstAmount = series.length >= 1 ? series[0].amount : null;
const spanDelta = series.length >= 3 ? computeVotingPowerDelta(lastAmount, firstAmount) : null;
const spanDisplay = formatTrendDelta(spanDelta);

const firstEpoch = series[0]?.epoch;
const lastEpoch = series[series.length - 1]?.epoch;

const arrow = (d: 'up' | 'down' | 'flat'): string => (d === 'up' ? '▲' : d === 'down' ? '▼' : '');
const adaTick = (lovelace: number): string => formatAdaCompact(String(Math.round(lovelace))) ?? '';

// The delegator line gets its current value in the same label column as the power
// axis, rather than a second axis of its own: two sets of gridlines on one small
// card would suggest the lines can be read against each other, which they cannot.
// One label per series, each at its own line's end.
const LABEL_GAP = 13;
const delLabelY = ((): number | null => {
  if (!chart || !overlay) return null;
  let y = overlay.last.y + 4;
  // Nudge clear of a power tick label sitting at the same height, away from it, so
  // the two numbers never overlap into an unreadable stack.
  for (const t of chart.yTicks) {
    const other = t.y + 4;
    const gap = y - other;
    if (Math.abs(gap) < LABEL_GAP) y = other + (gap === 0 ? (overlay.last.y <= t.y ? -LABEL_GAP : LABEL_GAP) : Math.sign(gap) * LABEL_GAP);
  }
  // Keep it inside the card whatever the nudge did.
  return Math.min(Math.max(y, 12), chart.height - 12);
})();

// The absolute change moves to the hover so the card surfaces only the percent.
// Nothing to hover when the card already shows the amount itself, and flat
// carries no magnitude worth showing.
const hoverText = (d: VotingPowerDelta | null, label: string): string | undefined => {
  const display = formatTrendDelta(d);
  if (!d || display?.pct == null) return undefined;
  if (d.direction === 'flat') return `No change ${label}`;
  return `${d.direction === 'up' ? 'Up' : 'Down'} ${display.ada} ${label}`;
};
---

{chart && (
  <section class={`vptrend vptrend--${dir}`} aria-label="Voting power trend">
    <header class="vptrend__head">
      <span class="vptrend__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 16l5-5 4 4 6-8" />
          <path d="M3 21h18" opacity="0.4" />
        </svg>
      </span>
      <span class="vptrend__title">Voting power trend</span>
      {deltaDisplay && (
        <span class="vptrend__delta" title={hoverText(delta, 'since last epoch')}>
          {dir !== 'flat' && <span class="vptrend__arrow" aria-hidden="true">{arrow(dir)}</span>}
          <span class="vptrend__pct">{deltaDisplay.pct ?? deltaDisplay.ada}</span>
          <span class="vptrend__label">vs last epoch</span>
        </span>
      )}
    </header>

    <svg
      class="vptrend__chart"
      viewBox={`0 0 ${chart.width} ${chart.height}`}
      role="img"
      aria-label={overlay
        ? `Voting power and delegator count from epoch ${firstEpoch} to ${lastEpoch}. Voting power ${adaTick(values[values.length - 1])}, delegators ${fmtInt(overlay.lastValue)}.`
        : `Voting power from epoch ${firstEpoch} to ${lastEpoch}`}
    >
      <defs>
        <linearGradient id="vptrend-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.2" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
        </linearGradient>
      </defs>
      {chart.yTicks.map((t) => (
        <line class="vptrend__grid" x1={chart.plot.x} y1={t.y} x2={chart.plot.x + chart.plot.w} y2={t.y} />
      ))}
      <path class="vptrend__area" d={chart.area} />
      <polyline class="vptrend__line" points={chart.line} vector-effect="non-scaling-stroke" />
      <circle class="vptrend__dot-ring" cx={chart.last.x} cy={chart.last.y} r="5.5" />
      <circle class="vptrend__dot" cx={chart.last.x} cy={chart.last.y} r="3.5" />
      {overlay && (
        <>
          <polyline class="vptrend__delline" points={overlay.line} vector-effect="non-scaling-stroke" />
          <circle class="vptrend__deldot" cx={overlay.last.x} cy={overlay.last.y} r="2.75" />
        </>
      )}
      {chart.yTicks.map((t) => (
        <text class="vptrend__ylabel" x={chart.plot.x + chart.plot.w + 8} y={t.y + 4}>{adaTick(t.value)}</text>
      ))}
      {overlay && delLabelY != null && (
        <text class="vptrend__dellabel" x={chart.plot.x + chart.plot.w + 8} y={delLabelY}>{fmtInt(overlay.lastValue)}</text>
      )}
      <text class="vptrend__xlabel" x={chart.plot.x} y={chart.height - 8} text-anchor="start">Epoch {firstEpoch}</text>
      <text class="vptrend__xlabel" x={chart.plot.x + chart.plot.w} y={chart.height - 8} text-anchor="end">Epoch {lastEpoch}</text>
    </svg>

    {(spanDelta && spanDisplay) || overlay ? (
      <footer class="vptrend__foot">
        {spanDelta && spanDisplay && (
          <span class={`vptrend__total vptrend__total--${spanDelta.direction}`} title={hoverText(spanDelta, `over ${series.length} epochs`)}>
            {spanDelta.direction !== 'flat' && <span class="vptrend__arrow" aria-hidden="true">{arrow(spanDelta.direction)}</span>}
            <span>{spanDisplay.pct ?? spanDisplay.ada}</span>
            <span class="vptrend__label">over {series.length} epochs</span>
          </span>
        )}
        {overlay && (
          <span class="vptrend__legend" title={`Delegator count over the last ${overlay.points} epochs`}>
            <span class="vptrend__swatch" aria-hidden="true"></span>
            <span class="vptrend__label">Delegators</span>
            {/* Narrow screens drop every in-chart label, so the count moves into
                the legend there and is hidden here on wider ones. */}
            <span class="vptrend__legend-value">{fmtInt(overlay.lastValue)}</span>
            {delegatorChange !== 0 && (
              <span class={`vptrend__legend-delta vptrend__legend-delta--${delegatorChange > 0 ? 'up' : 'down'}`}>
                {delegatorChange > 0 ? '+' : '-'}{fmtInt(Math.abs(delegatorChange))}
              </span>
            )}
            <span class="vptrend__label">over {overlay.points} epochs</span>
          </span>
        )}
      </footer>
    ) : null}

</section>
)}

<style>
  .vptrend {
    --vp-color: var(--c-pos);
    /* A compact widget, not a full-width banner: caps at ~32rem on desktop and
       falls back to full width on narrow screens. The page places it in a summary
       row, which owns the surrounding margin. */
    max-width: 32rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    padding: 1.1rem 1.25rem 0.9rem;
    margin: 0;
    box-shadow: var(--shadow);
  }
  .vptrend--up { --vp-color: var(--c-pos); }
  .vptrend--down { --vp-color: var(--c-neg); }
  .vptrend--flat { --vp-color: var(--muted); }

  .vptrend__head { display: flex; align-items: center; gap: 0.6rem; }
  .vptrend__badge {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-fg);
    flex: none;
  }
  .vptrend__title { font-weight: 650; font-size: 1.05rem; color: var(--fg); }
  .vptrend__delta {
    margin-left: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--vp-color);
    font-variant-numeric: tabular-nums;
  }
  .vptrend__arrow { font-size: 0.7em; }
  .vptrend__pct { font-size: 1.15rem; font-weight: 700; }
  .vptrend__label { color: var(--muted); font-size: 0.8125rem; font-weight: 400; }

  .vptrend__chart {
    color: var(--vp-color);
    display: block;
    width: 100%;
    height: auto;
    margin: 0.4rem 0 0.2rem;
  }
  .vptrend__grid { stroke: var(--border); stroke-dasharray: 4 5; }
  .vptrend__ylabel,
  .vptrend__xlabel { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .vptrend__dellabel { fill: var(--accent); font-size: 12px; font-variant-numeric: tabular-nums; }
  .vptrend__area { fill: url(#vptrend-fill); }
  .vptrend__line { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .vptrend__dot-ring { fill: var(--surface-2); }
  .vptrend__dot { fill: currentColor; }

  /* The delegator series: dashed and thinner so it never competes with the power
     line, and in the accent color rather than the card's gain/loss color, because
     it is a different unit on a different scale and must not be read as part of
     the same axis. */
  .vptrend__delline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .vptrend__deldot { fill: var(--accent); }

  .vptrend__foot {
    border-top: 1px solid var(--border);
    margin-top: 0.4rem;
    padding-top: 0.7rem;
    font-size: 0.8125rem;
    color: var(--muted);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    flex-wrap: wrap;
  }
  .vptrend__total {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-variant-numeric: tabular-nums;
  }
  .vptrend__total--up { color: var(--c-pos); }
  .vptrend__total--down { color: var(--c-neg); }
  .vptrend__total--flat { color: var(--muted); }

  /* Legend for the dashed series, doubling as its current value: the chart's own
     axis labels belong to the power line, so the headcount is named here instead. */
  .vptrend__legend {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .vptrend__legend-value { display: none; color: var(--fg); font-weight: 650; }
  .vptrend__swatch {
    align-self: center;
    width: 0.9rem;
    height: 0;
    border-top: 2px dashed var(--accent);
    flex: none;
  }
  .vptrend__legend-delta--up { color: var(--c-pos); }
  .vptrend__legend-delta--down { color: var(--c-neg); }

  /* Narrow screens: drop the in-chart axis labels (they scale down too far); the
     trend shape and the header/footer percentages stay. */
  @media (max-width: 560px) {
    .vptrend__ylabel,
    .vptrend__xlabel,
    .vptrend__dellabel { display: none; }
    .vptrend__legend-value { display: inline; }
    .vptrend__head { flex-wrap: wrap; }
    .vptrend__delta { margin-left: 2.7rem; flex-basis: 100%; }
  }
</style>
