---
// Layered avatar: a deterministic identicon SVG as the base, with the stored
// self-hosted R2 copy (/api/avatar/<hash>, content addressed) as an overlay
// background-image. If the R2 fetch 404s, the background simply does not paint
// and the identicon shows through; the strict CSP forbids inline onerror
// handlers, so this layering is the fallback mechanism. The single avatar
// implementation, shared by AuthorIdentity, the header pill, the account menu
// and the DRep profile hero.
import { identiconSvg, type IdenticonKind } from '@/lib/identity/identicon';

interface Props {
  /** Stable identicon seed (DRep credential hex when known, else the user id). */
  seed: string;
  /** Content hash of the stored avatar in R2, or null when none is stored. */
  imageHash?: string | null;
  /** Avatar edge length in px. */
  size?: number;
  /** Replace the border with a subtle ring for placement on accent surfaces. */
  ring?: boolean;
  /** Entity kind for the identicon centre glyph. Only needed for a hex pool hash
      seed ("pool"); a hex seed otherwise reads as a DRep and bech32 auto-detects. */
  kind?: IdenticonKind;
  /** When set, the avatar becomes a link to the profile. It stays out of the
      a11y tree (aria-hidden + tabindex=-1): the adjacent name link already
      carries the accessible name, so this is a mouse convenience, not a
      duplicate stop for keyboard and screen-reader users. */
  href?: string | null;
}
const { seed, imageHash = null, size = 28, ring = false, kind, href = null } = Astro.props;
// Render as an anchor only when linked; otherwise the original inert span.
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['avatar', { 'avatar--ring': ring, 'avatar--link': href }]}
  style={`--avatar-size:${size}px;`}
  aria-hidden="true"
  {...(href ? { href, tabindex: '-1' } : {})}
>
  <span class="avatar__icon" set:html={identiconSvg(seed, size, kind)} />
  {imageHash && (
    <span class="avatar__img" style={`background-image:url(/api/avatar/${imageHash})`}></span>
  )}
</Tag>

<style>
  .avatar {
    position: relative;
    display: inline-block;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    background: var(--avatar-ground);
    border: 1px solid var(--border);
  }
  .avatar--ring {
    border-color: transparent;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-fg) 35%, transparent);
  }
  /* Linked avatar: pointer affordance and a faint lift on hover, matching the
     underline the neighboring name link shows. */
  a.avatar--link { cursor: pointer; }
  a.avatar--link:hover { opacity: 0.85; }
  .avatar__icon {
    position: absolute;
    inset: 0;
    display: block;
  }
  .avatar__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* R2 avatar overlay as a background so a 404 falls through to the identicon.
     Opaque fill underneath so a transparent stored image shows the surface, not
     the identicon bleeding through (a 404 then shows a plain surface circle, but
     the store clears image_content_hash on failure, so that is rare). */
  .avatar__img {
    position: absolute;
    inset: 0;
    background-color: var(--surface);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
