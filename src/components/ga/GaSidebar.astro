---
// Sidebar column for the governance-action detail page: stacks status, voting
// info, proposer, more-from-this-proposer, and top DRep participants cards.
import ActionStatusCard from './ActionStatusCard.astro';
import VotingInfoCard from './VotingInfoCard.astro';
import ProposerCard from './ProposerCard.astro';
import AuthorsCard from './AuthorsCard.astro';
import TopParticipantsCard from './TopParticipantsCard.astro';
import RelatedActionsCard from './RelatedActionsCard.astro';
import type { GovernanceAction, RelatedActionRow } from '@/lib/db/governance.js';
import type { ProtocolParams } from '@/lib/db/protocolParams.js';
import type { CardanoNetwork } from '@/lib/config/network.js';
import type { ActionVoterRow } from '@/lib/db/drepVotes.js';
import type { Drep } from '@/lib/db/dreps.js';
import type { TrendChart } from '@/lib/governance/voteTrend.js';

interface Props {
  action: GovernanceAction;
  params: ProtocolParams | null;
  // Total active DRep voting power, for the Voting Information card's DRep denominator.
  drepStakeTotal: number | null;
  network: CardanoNetwork;
  topVoters: ActionVoterRow[];
  dreps: Map<string, Drep>;
  related: RelatedActionRow[];
  slug: string;
  positionsTotal: number;
  rationaleCount: number;
  // Render instant, forwarded to the Voting Information card's tally-freshness note.
  now: number;
  // Compact voting-trend teaser for the Voting Information card; null when empty.
  miniChart: TrendChart | null;
  // Href of the History tab, for the teaser link.
  trendHref: string;
}

const {
  action,
  params,
  drepStakeTotal,
  network,
  topVoters,
  dreps,
  related,
  slug,
  positionsTotal,
  rationaleCount,
  now,
  miniChart,
  trendHref,
} = Astro.props;
---

<aside class="ga-sidebar">
  {/* ActionStatusCard must stay first: on mobile the gov action detail page
      promotes this sidebar's first child above the main column (the
      display:contents + order rules in pages/t/[slug].astro). */}
  <ActionStatusCard action={action} network={network} />
  {/* Optional card slotted in between Status and Voting Information, e.g. the
      NCL mini card on TreasuryWithdrawals action pages. Empty for every other
      action type. */}
  <slot name="after-status" />
  <VotingInfoCard action={action} params={params} drepStakeTotal={drepStakeTotal} now={now} miniChart={miniChart} trendHref={trendHref} />
  <ProposerCard returnAddress={action.returnAddress} />
  <AuthorsCard authors={action.authors} />
  <RelatedActionsCard actions={related} />
  <TopParticipantsCard voters={topVoters} dreps={dreps} slug={slug} total={positionsTotal} rationaleCount={rationaleCount} />
</aside>

<style>
  .ga-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
