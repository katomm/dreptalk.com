---
// Tab bar for the governance-action detail page: Overview, Discussion, DRep Positions.
// Overview lives at /t/[slug]; other tabs append ?tab=<id>.
import { GA_TABS } from '@/lib/governance/tab.js';
import type { GaTabId } from '@/lib/governance/tab.js';

interface Props {
  slug: string;
  active: GaTabId;
  commentCount: number;
  /** Total DRep votes on the action; shown as a count badge on the Positions tab. */
  positionsCount?: number;
}

const { slug, active, commentCount, positionsCount } = Astro.props;

function tabHref(id: GaTabId): string {
  return id === 'overview' ? `/t/${slug}` : `/t/${slug}?tab=${id}`;
}

function tabLabel(id: GaTabId, label: string): string {
  if (id === 'discussion') return `${label} (${commentCount})`;
  if (id === 'positions' && positionsCount != null) return `${label} (${positionsCount})`;
  return label;
}
---

<nav class="ga-tabbar" aria-label="Governance action sections">
  {GA_TABS.map((tab) => (
    <a
      class={`ga-tabbar__tab${active === tab.id ? ' ga-tabbar__tab--active' : ''}`}
      href={tabHref(tab.id)}
      aria-current={active === tab.id ? 'page' : undefined}
    >
      {tabLabel(tab.id, tab.label)}
    </a>
  ))}
</nav>

<style>
  .ga-tabbar {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--border);
    margin-bottom: 1.5rem;
    /* Five tabs do not fit a phone width; scroll them sideways instead of
       widening the whole page. Scrollbar hidden for a clean edge. */
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ga-tabbar::-webkit-scrollbar {
    display: none;
  }
  /* On phones the last tabs (On-chain Data, History) sit off-screen with no
     scrollbar, so fade the right edge as a hint that the bar scrolls. Desktop
     fits all tabs, so no fade there. */
  @media (max-width: 640px) {
    .ga-tabbar {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 1.75rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 1.75rem), transparent);
    }
  }
  .ga-tabbar__tab {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    /* Keep each tab on one line and at full width while the bar scrolls. */
    flex-shrink: 0;
    white-space: nowrap;
    transition: color 0.12s, border-color 0.12s;
  }
  .ga-tabbar__tab:hover {
    color: var(--fg);
  }
  .ga-tabbar__tab--active {
    color: var(--fg);
    font-weight: 700;
    border-bottom-color: var(--accent);
  }
</style>
