---
// Overview "Rationale highlights": the strongest DReps' vote rationales, shown as
// short excerpts on the canonical Overview URL. The full rationales live on the
// Votes tab; this surfaces the site's unique content (why big DReps voted as they
// did) on the indexed page and bridges readers into the Votes tab. Abstains and
// rationale-less votes are already filtered out by getRationaleHighlights.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { voterDescriptor } from '@/lib/forum/author.js';
import { formatAdaCompact } from '@/lib/governance/view.js';
import { excerptFromHtml } from '@/lib/forum/view.js';
import type { RationaleHighlight } from '@/lib/db/actionRationale.js';
import type { Drep } from '@/lib/db/dreps.js';

interface Props {
  highlights: RationaleHighlight[];
  dreps: Map<string, Drep>;
  slug: string;
  /** Total readable rationales on the action, for the "see all" link. */
  totalRationales: number;
}

const { highlights, dreps, slug, totalRationales } = Astro.props;

const positionsHref = `/t/${slug}/?tab=positions`;
// Long enough to convey the DRep's reasoning, short enough to stay a highlight.
const EXCERPT_LEN = 260;
---

{highlights.length > 0 && (
  <section class="ga-highlights" aria-labelledby="ga-highlights-title">
    <p class="ga-highlights__label" id="ga-highlights-title">Rationale highlights</p>
    <p class="ga-highlights__sub">Why some of the largest DReps voted the way they did.</p>

    <ul class="ga-highlights__list">
      {highlights.map((h) => {
        const descriptor = voterDescriptor(h, dreps);
        const ada = formatAdaCompact(h.voting_power);
        const excerpt = excerptFromHtml(h.body_html, EXCERPT_LEN);
        return (
          <li class="ga-highlights__item">
            <div class="ga-highlights__head">
              <div class="ga-highlights__identity">
                <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate />
              </div>
              <VoteBadge vote={h.vote} compact />
              {ada && <span class="ga-highlights__power">{ada}</span>}
            </div>
            <p class="ga-highlights__excerpt">{excerpt}</p>
            <a class="ga-highlights__more" href={`${positionsHref}#voter-${h.voter_id}`}>
              Read full rationale &rarr;
            </a>
          </li>
        );
      })}
    </ul>

    {totalRationales > highlights.length && (
      <a class="ga-highlights__all" href={positionsHref}>See all {totalRationales} rationales &rarr;</a>
    )}
  </section>
)}

<style>
  .ga-highlights {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .ga-highlights__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .ga-highlights__sub {
    margin: 0.25rem 0 0.9rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .ga-highlights__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ga-highlights__item {
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* Identity grows; vote badge and power sit as fixed trailing columns. */
  .ga-highlights__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .ga-highlights__identity {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .ga-highlights__power {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ga-highlights__excerpt {
    margin: 0.55rem 0 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .ga-highlights__more {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .ga-highlights__more:hover {
    text-decoration: underline;
  }
  .ga-highlights__all {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .ga-highlights__all:hover {
    text-decoration: underline;
  }
</style>
