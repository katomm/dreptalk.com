---
// Sidebar card: one row per voting body (DRep, SPO, CC) with a Yes / No / Not-voted
// composition bar over that body's whole eligible voting power. The headline "X% yes
// of eligible" is the stored ratification percentage (matches gov.tools/adastats), so
// non-voting stake is shown as its own Not-voted segment rather than folded into a
// misleading "No", and a low-turnout action never reads as "100% yes". Types with an
// on-chain threshold also carry the threshold marker and a Met / Not met verdict; Info
// actions have neither (their percentages are advisory). The voting window lives in the
// Status card above, so it is not repeated here.
import CompositionBar from './CompositionBar.astro';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { ProtocolParams } from '@/lib/db/protocolParams.js';
import { evaluateThresholds, hasOnchainThreshold } from '@/lib/governance/thresholds.js';
import { parameterChangeScope } from '@/lib/governance/onchain.js';
import {
  fmtPct,
  fmtPctFine,
  overviewRowVoting,
  compositionAmounts,
  absentBodyNote,
} from '@/lib/governance/view.js';
import { formatRelativeTime } from '@/lib/forum/view.js';

interface Props {
  action: GovernanceAction;
  params: ProtocolParams | null;
  // Total active DRep voting power: the denominator for the DRep composition and
  // turnout. Null for SPO-led types or before a tally syncs.
  drepStakeTotal: number | null;
  // Render instant, for the tally-freshness note ("Tallies as of ...").
  now: number;
}

const { action, params, drepStakeTotal, now } = Astro.props;

// ParameterChange voting bodies depend on which parameters change: SPOs vote only on
// security-relevant ones. Derive that from the payload; null for other types.
const paramScope =
  action.type === 'ParameterChange' ? parameterChangeScope(action.onchainPayload) : null;
const paramTouchesSecurity = paramScope?.touchesSecurity ?? false;

const opts = { drepStakeTotal, committeeSize: params?.committeeSize ?? null };
const hasThreshold = hasOnchainThreshold(action.type);

// Threshold verdict + marker per body, for types that ratify (null for Info actions,
// or before protocol params / tallies have synced).
const thresholds =
  hasThreshold && params
    ? evaluateThresholds(
        {
          type: action.type,
          drepYesPct: action.drepYesPct,
          spoYesPct: action.spoYesPct,
          ccYesPct: action.ccYesPct,
          paramScope,
        },
        params,
      )
    : null;

// Eligible bodies for this action type (reuses the overview's per-type eligibility +
// participation), enriched with the honest composition and its amounts.
const { bodies } = overviewRowVoting(action, opts, { paramTouchesSecurity });
const rows = bodies.map((b) => {
  const t = thresholds?.find((x) => x.body === b.body) ?? null;
  return {
    body: b.body,
    label: b.label,
    composition: b.composition,
    amounts: compositionAmounts(action, b.body, opts),
    participation: b.participation,
    thresholdPct: t?.thresholdPct ?? null,
    met: t?.met ?? null,
  };
});

// Names the bodies that cannot vote on this action type ("SPOs do not vote on
// treasury withdrawals"), shown here rather than repeated on every overview row.
const absentNote = absentBodyNote(action, { paramTouchesSecurity });

// Freshness of the vote numbers shown here.
const asOf = action.tallySyncedAt ? formatRelativeTime(action.tallySyncedAt, now) : null;
---

<div class="sidebar-card">
  <p class="sidebar-card__title">Voting Information</p>

  {rows.length === 0 ? (
    <p class="info-note">No voting bodies for this action type.</p>
  ) : (
    <div class="vbody-list">
      {rows.map((r) => (
        <div class="vbody">
          <div class="vbody__head">
            <span class="vbody__body">{r.label}</span>
            {r.met != null && (
              <span class={`vbody__met vbody__met--${r.met ? 'yes' : 'no'}`}>
                {r.met ? (
                  <>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    Met
                  </>
                ) : (
                  'Not met'
                )}
              </span>
            )}
          </div>

          {r.composition ? (
            <>
              <div class="vbody__lead">
                <span class="vbody__yes"><b>{fmtPctFine(r.composition.yes)}</b> yes of eligible</span>
                {r.participation != null && (
                  <span class="vbody__turnout">{fmtPct(r.participation)} turnout</span>
                )}
              </div>

              <CompositionBar bar={r.composition} thresholdPct={r.thresholdPct} />

              {r.amounts && (
                <div class="vote-amounts">
                  <span><b>{r.amounts.yes}</b> yes</span>
                  <span>{r.amounts.no} no</span>
                  <span>{r.amounts.notVoted} not voted</span>
                </div>
              )}

              {(r.thresholdPct != null || r.amounts?.hasAbstain) && (
                <div class="vbody__foot">
                  {r.thresholdPct != null && (
                    <span class="vbody__thr">Threshold {fmtPctFine(r.thresholdPct)}</span>
                  )}
                  {r.amounts?.hasAbstain && (
                    <span>{r.amounts.abstainExcluded} abstain excluded</span>
                  )}
                </div>
              )}
            </>
          ) : (
            <p class="vbody__none">No votes recorded.</p>
          )}
        </div>
      ))}
    </div>
  )}

  {!hasThreshold && rows.length > 0 && (
    <p class="info-note">
      No on-chain threshold for this action type; shares are of eligible voting power, abstentions excluded.
    </p>
  )}
  {absentNote && <p class="info-note info-note--absent">{absentNote}</p>}
  {asOf && <p class="info-footnote">Tallies as of {asOf}. Cached, not live.</p>}
</div>

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }

  .vbody-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .vbody {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--surface-2) 50%, transparent);
    font-size: 0.8125rem;
  }
  .vbody__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .vbody__body {
    font-weight: 700;
    color: var(--fg);
  }
  .vbody__met {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .vbody__met--yes { color: var(--c-pos); }
  .vbody__met--no { color: var(--muted); }

  /* Headline: the ratification yes-share (matches gov.tools), with turnout to the
     right so a big Yes off a tiny turnout is never read out of context. */
  .vbody__lead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.0625rem;
  }
  .vbody__yes {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .vbody__yes b {
    color: var(--fg);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .vbody__turnout {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .vote-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.0625rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .vote-amounts b {
    color: var(--fg);
    font-weight: 600;
  }

  .vbody__foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .vbody__none {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }

  .info-note {
    margin: 0.625rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }
  .info-note--absent {
    margin-top: 0.625rem;
  }
  .info-footnote {
    margin: 0.375rem 0 0;
    font-size: 0.6875rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
