---
// Sidebar card: on-chain thresholds with per-body results, each with a threshold
// gauge (yes/no/abstain bar + threshold marker) and amounts. InfoActions carry no
// threshold, so they show the plain vote sentiment instead. The voting window
// (start/end epochs) is not repeated here; the Status card above already has it.
import TallyBar from '@/components/TallyBar.astro';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { ProtocolParams } from '@/lib/db/protocolParams.js';
import { evaluateThresholds, hasOnchainThreshold } from '@/lib/governance/thresholds.js';
import { parameterChangeScope } from '@/lib/governance/onchain.js';
import {
  fmtPct,
  bodyVoteAmounts,
  overviewTally,
  sentimentSubline,
  type StakeParticipation,
} from '@/lib/governance/view.js';
import { formatRelativeTime } from '@/lib/forum/view.js';

interface Props {
  action: GovernanceAction;
  params: ProtocolParams | null;
  // DRep turnout (voted vs total DRep stake); null for SPO-led types or before a
  // tally syncs. Only the DRep row shows it; we have no equivalent total for SPO/CC.
  stake: StakeParticipation | null;
  // Render instant, for the tally-freshness note ("Tallies as of ...").
  now: number;
}

const { action, params, stake, now } = Astro.props;

// Clamp the threshold marker to the bar so a stray >100 value cannot escape it.
const markerLeft = (pct: number): number => Math.min(100, Math.max(0, pct));

// ParameterChange voting bodies depend on which parameters change: SPOs vote only
// on security-relevant ones. Derive that from the payload; null for other types.
const paramScope =
  action.type === 'ParameterChange' ? parameterChangeScope(action.onchainPayload) : null;

// Advisory types (InfoAction) have no on-chain threshold, so instead of a gauge
// they show the plain vote sentiment (leading role's yes/no/abstain bar). This runs
// off the action tally, not the protocol params, so it shows even before params sync.
const noThreshold = !hasOnchainThreshold(action.type);
const sentimentTally = noThreshold ? overviewTally(action) : null;
const sentimentAmounts = sentimentTally ? bodyVoteAmounts(action, sentimentTally.role) : null;

// Threshold evaluation for all other types (null when params have not synced yet).
const results = !noThreshold && params
  ? evaluateThresholds(
      {
        type: action.type,
        drepYesPct: action.drepYesPct,
        spoYesPct: action.spoYesPct,
        ccYesPct: action.ccYesPct,
        paramScope,
      },
      params,
    )
  : null;

// Freshness of the vote numbers shown here (per-body amounts / sentiment bar).
const asOf = action.tallySyncedAt ? formatRelativeTime(action.tallySyncedAt, now) : null;
---

<div class="sidebar-card">
  <p class="sidebar-card__title">Voting Information</p>

  {/* No on-chain threshold (advisory): show the plain vote sentiment, not a gauge. */}
  {noThreshold ? (
    sentimentTally ? (
      <div class="sentiment">
        <span class="sentiment__pct">
          {fmtPct(sentimentTally.bar.yes)} <span class="sentiment__word">{sentimentTally.role} support</span>
        </span>
        <span class="sentiment__sub">{sentimentSubline(sentimentTally)}</span>
        <TallyBar bar={sentimentTally.bar} height={7} pendingNo={sentimentTally.noIsPending} />
        {sentimentAmounts && (
          <div class="vote-amounts">
            <span><b>{sentimentAmounts.yes}</b> yes</span>
            <span>{sentimentAmounts.no} no</span>
            <span>{sentimentAmounts.abstain} abstain</span>
          </div>
        )}
        <p class="info-note">No on-chain threshold for this action type; this is advisory sentiment.</p>
      </div>
    ) : (
      <p class="info-note">No on-chain threshold for this action type.</p>
    )
  ) : results === null ? (
    <p class="info-note">Thresholds not yet available.</p>
  ) : (
    <div class="threshold-list">
      {results.map((r) => {
        const amounts = bodyVoteAmounts(action, r.body);
        const isCC = r.body === 'CC';
        return (
          <div class="threshold-row">
            <div class="threshold-row__head">
              <span class="threshold-row__body">{r.body}</span>
              {r.met ? (
                <span class="threshold-row__met threshold-row__met--yes">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Met
                </span>
              ) : (
                <span class="threshold-row__met threshold-row__met--no">Not met</span>
              )}
            </div>

            {r.yesPct != null && (
              <div class="gauge">
                <div class="gauge__track">
                  <div class="gauge__fill" style={`width:${markerLeft(r.yesPct)}%`}></div>
                </div>
                {r.thresholdPct != null && (
                  <span
                    class="gauge__marker"
                    style={`left:${markerLeft(r.thresholdPct)}%`}
                    aria-hidden="true"
                  ></span>
                )}
              </div>
            )}

            <div class="threshold-row__values">
              <div class="threshold-row__pcts">
                {r.thresholdPct != null && (
                  <span class="threshold-row__thr">Threshold {fmtPct(r.thresholdPct)}</span>
                )}
                {r.yesPct != null && (
                  <span class="threshold-row__yes">Yes {fmtPct(r.yesPct)}</span>
                )}
              </div>
              {amounts && (
                <div class="vote-amounts">
                  <span><b>{amounts.yes}</b> yes</span>
                  <span>{amounts.no} no</span>
                  <span>{amounts.abstain} abstain</span>
                </div>
              )}
              {isCC && params?.committeeSize != null && params?.committeeMinSize != null && (
                <span class="threshold-row__cc">
                  {params.committeeSize} members (min {params.committeeMinSize})
                </span>
              )}
              {r.body === 'DRep' && stake && (
                <span class="threshold-row__turnout">
                  Turnout {stake.votedLabel} of {stake.totalLabel} ({fmtPct(stake.pct)})
                </span>
              )}
            </div>
          </div>
        );
      })}
      {params?.epoch != null && (
        <p class="info-footnote">Thresholds as of epoch {params.epoch}.</p>
      )}
    </div>
  )}

  {asOf && <p class="info-footnote">Tallies as of {asOf}. Cached, not live.</p>}
</div>

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }

  /* InfoAction sentiment block: mirrors the row / stat-card metric styling. */
  .sentiment {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .sentiment__pct {
    font-weight: 700;
    font-size: 1rem;
    color: var(--c-pos);
  }
  .sentiment__word {
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .sentiment__sub {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .info-note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
  }

  .threshold-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .threshold-row {
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--surface-2) 50%, transparent);
    font-size: 0.8125rem;
  }
  .threshold-row__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }
  .threshold-row__body {
    font-weight: 700;
    color: var(--fg);
  }
  .threshold-row__met {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .threshold-row__met--yes { color: #1a7f37; }
  .threshold-row__met--no { color: var(--muted); }

  /* Threshold gauge: a single green Yes fill against a neutral track, with a
     vertical marker at the threshold. Both the fill (yesPct) and the marker
     (thresholdPct) sit on the same ratification scale, so the fill reaching (or
     not) the line reads at a glance and always agrees with Met / Not met. The
     real no/abstain figures live in the amounts line, not as a bar segment, since
     the no-percentage is an unreliable "No" share (e.g. it counts absent CC
     members). */
  .gauge {
    position: relative;
    margin: 0.375rem 0 0.5rem;
  }
  .gauge__track {
    height: 10px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .gauge__fill {
    height: 100%;
    /* Mirrors TONE_BAR_COLORS.positive, the calm bar green used site-wide. */
    background: #5cb88a;
    border-radius: 999px;
  }
  .gauge__marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    background: var(--fg);
    transform: translateX(-1px);
    border-radius: 1px;
  }
  .gauge__marker::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid var(--fg);
  }

  .threshold-row__values {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
  }
  .threshold-row__pcts {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .threshold-row__thr,
  .threshold-row__cc {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .threshold-row__yes {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg);
  }
  .vote-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.0625rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .vote-amounts b {
    color: var(--fg);
    font-weight: 600;
  }
  .threshold-row__turnout {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .info-footnote {
    margin: 0.375rem 0 0;
    font-size: 0.6875rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
