---
// Sidebar card: one row per voting body (DRep, SPO, CC), compact by default and
// expandable to the full stake behind the number.
//
// Compact carries only what cannot be misread on its own: the ratification yes share
// WITH the denominator it is measured against, the Yes-against-No-side bar with the
// threshold marker, and the amount of stake the tally excludes. That last figure is
// also the affordance to expand, because on most actions it is the biggest and most
// surprising number in the card (half the pool stake on a typical NewCommittee), and a
// bare chevron would promise nothing.
//
// Everything that needs its denominator explained is in the expanded state: the
// per-segment breakdown, how much of the No side never actually voted, and turnout.
// The old compact row showed "X% yes of eligible" next to a turnout on a different
// denominator, which let 51% yes sit beside 28% turnout with no way to tell that both
// were right. Types with an on-chain threshold carry the marker and a Met / Not met
// verdict; Info actions have neither (their percentages are advisory). The voting
// window lives in the Status card above, so it is not repeated here.
import CompositionBar from './CompositionBar.astro';
import FullStakeBar from './FullStakeBar.astro';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { ProtocolParams } from '@/lib/db/protocolParams.js';
import type { TrendChart } from '@/lib/governance/voteTrend.js';
import { evaluateThresholds, hasOnchainThreshold, readThresholdSnapshot } from '@/lib/governance/thresholds.js';
import { parameterChangeScope } from '@/lib/governance/onchain.js';
import {
  fmtPctFine,
  overviewRowVoting,
  compositionAmounts,
  bodyStake,
  absentBodyNote,
} from '@/lib/governance/view.js';
import { formatRelativeTime } from '@/lib/forum/view.js';

interface Props {
  action: GovernanceAction;
  params: ProtocolParams | null;
  // Total active DRep voting power: the denominator for the DRep composition and
  // turnout. Null for SPO-led types or before a tally syncs.
  drepStakeTotal: number | null;
  // Render instant, for the tally-freshness note ("Tallies as of ...").
  now: number;
  /** Compact multi-body step sparkline for the History-tab teaser; null when empty. */
  miniChart: TrendChart | null;
  /** Href of the History tab, for the teaser link. */
  trendHref: string;
}

const { action, params, drepStakeTotal, now, miniChart, trendHref } = Astro.props;

// ParameterChange voting bodies depend on which parameters change: SPOs vote only on
// security-relevant ones. Derive that from the payload; null for other types.
const paramScope =
  action.type === 'ParameterChange' ? parameterChangeScope(action.onchainPayload) : null;
const paramTouchesSecurity = paramScope?.touchesSecurity ?? false;

const opts = { drepStakeTotal, committeeSize: params?.committeeSize ?? null };
const hasThreshold = hasOnchainThreshold(action.type);

// Threshold verdict + marker per body, for types that ratify (null for Info actions,
// or before protocol params / tallies have synced).
// Prefer the frozen per-body snapshot; fall back to live params only when absent
// (active actions not yet snapshotted). Never render an old action's threshold from
// today's params.
const snapshot = readThresholdSnapshot(action.thresholdsJson);
const liveThresholds =
  !snapshot && hasThreshold && params
    ? evaluateThresholds(
        { type: action.type, drepYesPct: action.drepYesPct, spoYesPct: action.spoYesPct, ccYesPct: action.ccYesPct, paramScope },
        params,
      )
    : null;
const thresholdPctFor = (body: 'DRep' | 'SPO' | 'CC'): number | null =>
  snapshot
    ? (body === 'DRep' ? snapshot.drep : body === 'SPO' ? snapshot.spo : snapshot.cc)
    : liveThresholds?.find((x) => x.body === body)?.thresholdPct ?? null;

// Eligible bodies for this action type (reuses the overview's per-type eligibility +
// participation), enriched with the honest composition and its amounts.
const { bodies } = overviewRowVoting(action, opts, { paramTouchesSecurity });
const rows = bodies.map((b) => {
  const thr = thresholdPctFor(b.body);
  const t = liveThresholds?.find((x) => x.body === b.body) ?? null;
  const yes = b.composition?.yes ?? null;
  // From a frozen snapshot, the CC "Met" also honors the committee quorum gate
  // (committee below its minimum size cannot ratify, regardless of the yes share).
  const met = t
    ? t.met
    : thr == null || yes == null
      ? null
      : b.body === 'CC' && snapshot?.ccBelowMinSize
        ? false
        : yes >= thr;
  // The captured stake model, for both stake bodies now that the No side is stored.
  // Null for CC (seats, not stake) and for actions whose buckets predate the capture,
  // in which case the row renders compact-only with no expander.
  const stake = bodyStake(action, b.body, thr);
  return {
    body: b.body,
    label: b.label,
    composition: b.composition,
    amounts: compositionAmounts(action, b.body, opts),
    participation: b.participation,
    thresholdPct: thr,
    met,
    stake,
  };
});

// Whether every rendered body states its own denominator inline. When they do, the
// "no on-chain threshold" note below drops the eligible/abstain clause, which only
// describes the pre-capture fallback rendering.
const allStated = rows.every((r) => r.stake != null);

// Names the bodies that cannot vote on this action type ("SPOs do not vote on
// treasury withdrawals"), shown here rather than repeated on every overview row.
const absentNote = absentBodyNote(action, { paramTouchesSecurity });

// Freshness of the vote numbers shown here.
const asOf = action.tallySyncedAt ? formatRelativeTime(action.tallySyncedAt, now) : null;
---

<div class="sidebar-card">
  <p class="sidebar-card__title">Voting Information</p>

  {rows.length === 0 ? (
    <p class="info-note">No voting bodies for this action type.</p>
  ) : (
    <div class="vbody-list">
      {rows.map((r) => (
        <div class="vbody">
          <div class="vbody__head">
            <span class="vbody__body">{r.label}</span>
            {r.met != null && (
              <span class={`vbody__met vbody__met--${r.met ? 'yes' : 'no'}`}>
                {r.met ? (
                  <>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    Met
                  </>
                ) : (
                  'Not met'
                )}
              </span>
            )}
          </div>

          {r.composition ? (
            r.stake ? (
              <details class="vbody__more">
                <summary>
                  <div class="vbody__lead">
                    <span class="vbody__yes"><b>{fmtPctFine(r.composition.yes)}</b> yes</span>
                    <span class="vbody__basis">of {r.stake.countedLabel} counted</span>
                  </div>
                  <div class="vbody__bar"><CompositionBar bar={r.composition} thresholdPct={r.thresholdPct} /></div>
                  <div class="vbody__foot">
                    {r.thresholdPct != null && (
                      <span class="vbody__thr">Threshold {fmtPctFine(r.thresholdPct)}</span>
                    )}
                    <span class="vbody__expand">{r.stake.excludedLabel} excluded</span>
                  </div>
                </summary>
                <FullStakeBar view={r.stake} />
              </details>
            ) : (
              <>
                <div class="vbody__lead">
                  <span class="vbody__yes"><b>{fmtPctFine(r.composition.yes)}</b> yes</span>
                  <span class="vbody__basis">of the counted stake</span>
                </div>

                <div class="vbody__bar"><CompositionBar bar={r.composition} thresholdPct={r.thresholdPct} /></div>

                {r.amounts && (
                  <div class="vote-amounts">
                    <span><b>{r.amounts.yes}</b> yes</span>
                    <span>{r.amounts.no} no</span>
                    <span>{r.amounts.notVoted} not voted</span>
                  </div>
                )}

                {(r.thresholdPct != null || r.amounts?.hasAbstain) && (
                  <div class="vbody__foot">
                    {r.thresholdPct != null && (
                      <span class="vbody__thr">Threshold {fmtPctFine(r.thresholdPct)}</span>
                    )}
                    {r.amounts?.hasAbstain && (
                      <span>{r.amounts.abstainExcluded} abstain excluded</span>
                    )}
                  </div>
                )}
              </>
            )
          ) : (
            <p class="vbody__none">No votes recorded.</p>
          )}
        </div>
      ))}
    </div>
  )}

  {miniChart && (
    <a class="vtrend-teaser" href={trendHref} aria-label="See the full voting trend">
      <span class="vtrend-teaser__title">Voting trend over time</span>
      <svg class="vtrend-teaser__svg" viewBox={`0 0 ${miniChart.width} ${miniChart.height}`} aria-hidden="true">
        {miniChart.series.map((s) => (
          <path class="vtrend-teaser__line" style={`color:${s.key === 'DRep' ? 'var(--accent)' : s.key === 'SPO' ? 'var(--c-pos)' : 'var(--c-cc)'}`} d={s.stepPath} vector-effect="non-scaling-stroke" />
        ))}
      </svg>
    </a>
  )}

  {!hasThreshold && rows.length > 0 && (
    <p class="info-note">
      {allStated
        ? 'No on-chain threshold for this action type.'
        : 'No on-chain threshold for this action type. Shares are of the counted stake, abstentions excluded.'}
    </p>
  )}
  {absentNote && <p class="info-note info-note--absent">{absentNote}</p>}
  {asOf && <p class="info-footnote">Tallies as of {asOf}. Cached, not live.</p>}
</div>

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }

  .vbody-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .vbody {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--surface-2) 50%, transparent);
    font-size: 0.8125rem;
  }
  .vbody__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .vbody__body {
    font-weight: 700;
    color: var(--fg);
  }
  .vbody__met {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .vbody__met--yes { color: var(--c-pos); }
  .vbody__met--no { color: var(--muted); }

  /* Headline: the ratification yes-share with the denominator it belongs to, on
     the same line, so the two can never be quoted apart. */
  .vbody__lead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.0625rem;
  }
  .vbody__yes {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .vbody__yes b {
    color: var(--fg);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .vbody__basis {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Clearance for the threshold tick's overhang on both sides of the track, so the
     line reads against the bar and never against a digit. */
  .vbody__bar {
    margin: 0.1875rem 0;
  }

  /* Expandable body row. <details> keeps this working with no JavaScript, so it
     survives SSR and needs no CSP hash, and each body opens independently. */
  .vbody__more > summary {
    list-style: none;
    cursor: pointer;
    /* summary is its own box, so it does not inherit .vbody's row gap. Without
       this the headline and footer sit flush against the bar and the threshold
       tick, which overhangs the track by design, crosses into the text. */
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .vbody__more > summary::-webkit-details-marker { display: none; }
  .vbody__more > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
  /* The excluded amount doubles as the expander: it is the number most likely to
     make a reader want the breakdown, so it carries the affordance. */
  .vbody__expand {
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  .vbody__expand::after {
    content: '';
    width: 0.3rem;
    height: 0.3rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-1px) rotate(45deg);
    transition: transform 0.12s ease;
  }
  .vbody__more[open] > summary .vbody__expand::after {
    transform: translateY(1px) rotate(225deg);
  }
  .vbody__more > summary:hover .vbody__expand { text-decoration: underline; }
  /* Grid trick: animates to the content's own height without hard-coding one. */
  .vbody__more[open] > :global(.fsbar) {
    display: grid;
    grid-template-rows: 1fr;
    animation: vbody-open 0.14s ease;
  }
  @keyframes vbody-open {
    from { grid-template-rows: 0fr; opacity: 0; }
    to { grid-template-rows: 1fr; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vbody__more[open] > :global(.fsbar) { animation: none; }
    .vbody__expand::after { transition: none; }
  }

  .vote-amounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.0625rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .vote-amounts b {
    color: var(--fg);
    font-weight: 600;
  }

  .vbody__foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .vbody__none {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }

  .info-note {
    margin: 0.625rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }
  .info-note--absent {
    margin-top: 0.625rem;
  }
  .info-footnote {
    margin: 0.375rem 0 0;
    font-size: 0.6875rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Box the trend teaser like the per-body rows above it, so it reads as part of
     the same list instead of a loose sparkline under them. */
  .vtrend-teaser {
    display: block;
    margin-top: 0.625rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--surface-2) 50%, transparent);
    text-decoration: none;
    color: var(--muted);
    transition: border-color 0.12s;
  }
  .vtrend-teaser__title {
    display: block;
    font-weight: 700;
    color: var(--fg);
    font-size: 0.8125rem;
    margin-bottom: 0.375rem;
  }
  .vtrend-teaser__svg { display: block; width: 100%; height: auto; }
  .vtrend-teaser__line { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .vtrend-teaser:hover { border-color: var(--accent); }
  .vtrend-teaser:hover .vtrend-teaser__title { text-decoration: underline; }
</style>
