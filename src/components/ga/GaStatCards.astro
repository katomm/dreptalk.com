---
// Stat cards row for the governance-action overview: Stake Participation,
// Sentiment, and DRep/Voter Participation. Reuses .metric markup from GovActionRow.
import TallyBar from '@/components/TallyBar.astro';
import { fmtPct } from '@/lib/governance/view.js';
import type { StakeParticipation, OverviewTally } from '@/lib/governance/view.js';

interface Props {
  stake: StakeParticipation | null;
  tally: OverviewTally | null;
}

const { stake, tally } = Astro.props;
---

<div class="ga-statcards">
  <!-- Stake participation: voted DRep power / total DRep power -->
  <div class="ga-card">
    <p class="ga-card__label">Stake Participation</p>
    {stake ? (
      <div class="metric">
        <span class="metric__pct">{Math.round(stake.pct)}%</span>
        <span class="metric__sub">{stake.votedLabel} of {stake.totalLabel}</span>
        <span class="metric__cap">voting stake represented</span>
        <div class="track" aria-hidden="true">
          <span class="fill" style={`width:${stake.pct}%;background:var(--accent)`}></span>
        </div>
      </div>
    ) : (
      <span class="metric__sub">-</span>
    )}
  </div>

  <!-- Sentiment: yes/no/abstain tally bar for the leading voter role -->
  <div class="ga-card">
    <p class="ga-card__label">Sentiment</p>
    {tally ? (
      <div class="metric">
        <span class="metric__pct metric__pct--pos">
          {fmtPct(tally.bar.yes)} <span class="metric__pctword">{tally.role} support</span>
        </span>
        <span class="metric__sub">{fmtPct(tally.bar.no)} against &middot; {fmtPct(tally.bar.abstain)} abstain</span>
        <TallyBar bar={tally.bar} height={7} />
      </div>
    ) : (
      <span class="metric__sub">-</span>
    )}
  </div>

  <!-- Voter participation: count of voters who cast yes/no/abstain -->
  <div class="ga-card">
    <p class="ga-card__label">Voter Participation</p>
    {tally ? (
      <div class="metric">
        <span class="metric__pct">{tally.voted}</span>
        <span class="metric__sub">{tally.role}s participating</span>
      </div>
    ) : (
      <span class="metric__sub">-</span>
    )}
  </div>
</div>

<style>
  .ga-statcards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 720px) {
    .ga-statcards {
      grid-template-columns: 1fr;
    }
  }

  .ga-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .ga-card__label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  /* .metric styles mirrored from GovActionRow */
  .metric { min-width: 0; }
  .metric__pct { font-weight: 700; font-size: 1.05rem; display: block; margin: 0 0 2px; }
  .metric__pct--pos { color: var(--c-pos); }
  .metric__pctword { font-weight: 600; font-size: 0.8rem; color: var(--muted); }
  .metric__sub { color: var(--muted); font-size: 0.72rem; display: block; }
  .metric__cap { color: var(--muted); font-size: 0.7rem; display: block; margin-top: 1px; }
  .track { display: flex; height: 7px; border-radius: 999px; overflow: hidden; background: var(--border); margin-top: 6px; }
  .fill { height: 100%; }
</style>
