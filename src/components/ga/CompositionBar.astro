---
// A Yes / No / Not-voted composition bar over a body's whole eligible voting power
// (see compositionBar in view.ts). Abstain is excluded from the denominator, so it
// is never a segment. Not voted is a faint neutral fill, present but recessive, so a
// low-turnout action reads as a near-empty bar dominated by the silent majority
// rather than a false wall of opposition. An optional threshold marker sits on the
// same ratification scale as the Yes segment, so the fill reaching (or not) the line
// reads at a glance.
import { TONE_BAR_COLORS, type CompositionBar } from '@/lib/governance/view.js';

interface Props {
  bar: CompositionBar;
  height?: number;
  thresholdPct?: number | null;
  // Dense lists (the overview) get a bare threshold line without the triangle cap,
  // which reads as noise at small bar heights.
  compactMarker?: boolean;
}

const { bar, height = 10, thresholdPct = null, compactMarker = false } = Astro.props;
const clamp = (n: number): number => Math.min(100, Math.max(0, n));
---

<div class="cbar">
  <div class="cbar__track" style={`height:${height}px`} aria-hidden="true">
    <span class="cbar__seg" style={`width:${bar.yes}%;background:${TONE_BAR_COLORS.positive}`}></span>
    <span class="cbar__seg" style={`width:${bar.no}%;background:${TONE_BAR_COLORS.negative}`}></span>
    <span class="cbar__seg cbar__seg--nv" style={`width:${bar.notVoted}%`}></span>
  </div>
  {thresholdPct != null && (
    <span
      class:list={['cbar__marker', compactMarker && 'cbar__marker--bare']}
      style={`left:${clamp(thresholdPct)}%`}
      aria-hidden="true"
    ></span>
  )}
</div>

<style>
  .cbar { position: relative; }
  .cbar__track {
    display: flex;
    border-radius: 999px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .cbar__seg { height: 100%; }
  /* Not voted: a faint neutral fill, clearly recessive against Yes/No, so the
     silent majority is visible without reading as opposition. */
  .cbar__seg--nv { background: color-mix(in srgb, var(--muted) 42%, var(--surface-2)); }
  .cbar__marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    background: var(--fg);
    transform: translateX(-1px);
    border-radius: 1px;
  }
  .cbar__marker::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid var(--fg);
  }
  /* Bare line for dense lists: drop the triangle cap. */
  .cbar__marker--bare::before { display: none; }
</style>
