---
// The ratification split for one body: Yes against the No side, over the denominator
// the threshold is measured against (see compositionBar in view.ts). Abstain is not a
// segment because it leaves that denominator entirely. Stake that never voted is part
// of the No side, because that is what the ledger counts it as; how much of the No
// side that is gets named in the breakdown below the bar, not by softening the bar.
//
// The threshold marker overhangs the track top and bottom rather than sitting inside
// it, so the line reads against the fill instead of disappearing into it.
import { TONE_BAR_COLORS, type CompositionBar } from '@/lib/governance/view.js';

interface Props {
  bar: CompositionBar;
  height?: number;
  thresholdPct?: number | null;
  // Dense lists (the overview) get a shorter overhang, which keeps the line legible
  // without letting it dominate an 8px bar.
  compactMarker?: boolean;
}

const { bar, height = 10, thresholdPct = null, compactMarker = false } = Astro.props;
const clamp = (n: number): number => Math.min(100, Math.max(0, n));
// Text alternative so the color-only bar is not lost to screen readers.
const barLabel =
  `Yes ${Math.round(bar.yes)}% of the counted stake, no side ${Math.round(bar.no)}%` +
  (thresholdPct != null ? `, threshold ${Math.round(clamp(thresholdPct))}%` : '');
---

<div class="cbar">
  <div class="cbar__track" style={`height:${height}px`} role="img" aria-label={barLabel}>
    <span class="cbar__seg" style={`width:${bar.yes}%;background:${TONE_BAR_COLORS.positive}`} aria-hidden="true"></span>
    <span class="cbar__seg" style={`width:${bar.no}%;background:${TONE_BAR_COLORS.negative}`} aria-hidden="true"></span>
  </div>
  {thresholdPct != null && (
    <span
      class:list={['cbar__marker', compactMarker && 'cbar__marker--compact']}
      style={`left:${clamp(thresholdPct)}%`}
      aria-hidden="true"
    ></span>
  )}
</div>

<style>
  .cbar { position: relative; }
  .cbar__track {
    display: flex;
    border-radius: 999px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .cbar__seg { height: 100%; }
  /* Overhanging tick: the line runs past the track on both sides, so it stays
     readable wherever it falls, including on top of the Yes fill. A hairline of
     the card background around it keeps it separated from the fill it crosses. */
  .cbar__marker {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 2px;
    background: var(--fg);
    box-shadow: 0 0 0 1px var(--surface);
    transform: translateX(-1px);
    border-radius: 1px;
  }
  .cbar__marker--compact {
    top: -3px;
    bottom: -3px;
  }
</style>
