---
// Votes tab box: the fewest DReps whose switch to Yes would reach the threshold.
// The sidebar card only states the gap and links here, because a list of dozens of
// names does not fit the narrow column. The first rows show, the rest sit behind a
// native <details> (no script, CSP-safe).
import type { PassListView } from '@/lib/governance/passPathView.js';
import { PASS_LIST_FOOTNOTE, PASS_SECTION_ID } from '@/lib/governance/passPathView.js';

interface Props {
  list: PassListView;
}

const { list } = Astro.props;
const VISIBLE = 10;
// The first rows show, the rest open behind "Show all".
const groups = [
  { start: 1, rows: list.rows.slice(0, VISIBLE) },
  { start: VISIBLE + 1, rows: list.rows.slice(VISIBLE) },
].filter((g) => g.rows.length > 0);
---

{/* Folded by default, the summary line tells the count. The anchor sits on the
    heading: the site's deep-link script opens every <details> around a hash target
    (so the sidebar link unfolds the box) and inside it ("Show all" stays folded). */}
<details class="pass-box">
  <summary class="pass-box__head">
    <h2 class="pass-box__title" id={PASS_SECTION_ID}>Path to pass</h2>
    <span class="pass-box__summary">{list.summary}</span>
  </summary>
  <p class="pass-box__line">{list.intro}</p>
  {list.abstainNote && <p class="pass-box__line pass-box__line--muted">{list.abstainNote}</p>}
  {groups.map((g) => {
    const items = (
      <ol class="pass-list" start={g.start}>
        {g.rows.map((row) => (
          <li class="pass-list__row">
            <a class="pass-list__name" href={row.href}>{row.name}</a>
            <span class="pass-list__stance">{row.stanceLabel}</span>
            <span class="pass-list__power">
              {row.powerLabel}
              {row.closesLabel && (
                <span
                  class="pass-list__closes"
                  tabindex="0"
                  data-tip-term="Why less than the voting power"
                  data-tip-text={row.closesTitle ?? undefined}
                >{row.closesLabel}</span>
              )}
            </span>
          </li>
        ))}
      </ol>
    );
    return g.start === 1 ? items : (
      <details class="pass-box__more">
        <summary>Show all {list.rows.length}</summary>
        {items}
      </details>
    );
  })}
  {list.comparison && <p class="pass-box__line">{list.comparison}</p>}
  <p class="pass-box__line pass-box__line--muted">{PASS_LIST_FOOTNOTE}</p>
</details>

<style>
  .pass-box {
    margin: 0.75rem 0 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }
  .pass-box__head {
    cursor: pointer;
    list-style: none;
  }
  .pass-box__head::-webkit-details-marker { display: none; }
  .pass-box__head:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .pass-box[open] > .pass-box__head { margin-bottom: 0.25rem; }
  .pass-box__summary {
    display: block;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .pass-box__head:hover .pass-box__summary { text-decoration: underline; }
  .pass-box__title {
    margin: 0 0 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    /* The sidebar link jumps here, keep the heading clear of the sticky header. */
    scroll-margin-top: 5rem;
  }
  .pass-box__line {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
  }
  .pass-box__line--muted {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .pass-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.85rem;
  }
  .pass-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.3rem 0;
    border-top: 1px solid var(--border);
  }
  .pass-list__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pass-list__stance {
    color: var(--muted);
  }
  .pass-list__power {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pass-list__closes {
    cursor: help;
    color: var(--muted);
    font-size: 0.8rem;
    margin-left: 0.4rem;
  }
  .pass-box__more > summary {
    cursor: pointer;
    color: var(--accent);
    font-size: 0.85rem;
    padding: 0.3rem 0;
    border-top: 1px solid var(--border);
  }
  .pass-box__more > summary:hover { text-decoration: underline; }
  .pass-box__more > summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .pass-box__more .pass-list { margin-top: 0; }
  /* Phones: the stance drops under the name so the name keeps its width. */
  @media (max-width: 480px) {
    .pass-list__row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 0.75rem;
    }
    .pass-list__stance { grid-row: 2; font-size: 0.8rem; }
    .pass-list__power { grid-row: 1 / span 2; grid-column: 2; align-self: center; }
    .pass-list__closes {
    cursor: help; display: block; margin-left: 0; }
  }
</style>
