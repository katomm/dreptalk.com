---
// Discussion tab: posts list, composer, pagination. Verbatim move of the thread
// markup from t/[slug].astro so governance and non-governance topics render
// identically. The isGovernanceTopic + page flags drive the opening-post identity.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import PostActions from '@/components/PostActions.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import Composer from '@/components/Composer.tsx';
import { postViewerContext } from '@/lib/forum/postVisibility.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import type { Topic, Post } from '@/lib/db/forum.js';
import type { Reaction } from '@/lib/db/postReactions.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';

// Mirrors App.Locals.user from env.d.ts without importing the full User db type.
type SessionUser = { id: string; roles: string[] };

interface Props {
  topic: Topic;
  posts: Post[];
  govVotes: Map<string, { role: string; vote: string }>;
  /** Current user, or null when anonymous. */
  user: SessionUser | null;
  topicAuthor: AuthorDescriptor;
  describe: (authorId: string) => AuthorDescriptor;
  flaggedPostIds: Set<string>;
  viewerReactions: Map<string, Reaction>;
  isGovernanceTopic: boolean;
  page: number;
  prevPage: number | null;
  nextPage: number | null;
  now: number;
}

const {
  topic,
  posts,
  govVotes,
  user,
  topicAuthor,
  describe,
  flaggedPostIds,
  viewerReactions,
  isGovernanceTopic,
  page,
  prevPage,
  nextPage,
  now,
} = Astro.props;

const showComposer = !!user && !topic.locked;
---

<div style="display:flex;flex-direction:column;gap:0;">
  {posts.map((post, i) => {
    // The opening post of a governance-sourced topic (page 1, index 0) uses the
    // system identity even if its author_id is not literally gov-sync.
    const author =
      isGovernanceTopic && page === 1 && i === 0
        ? topicAuthor
        : describe(post.author_id);

    const { canSeeContent, canFlag, canReact, isOwnPost } = postViewerContext(post, user, !!author.isSystem);
    const authorVote = author.drepId ? govVotes.get(author.drepId) : undefined;

    return (
      <article style="border-top:1px solid var(--border);padding:1.25rem 0;" id={`post-${post.id}`}>
        <div style="font-size:0.8125rem;color:var(--muted);margin-bottom:0.75rem;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
          <AuthorIdentity author={author} />
          {authorVote && <VoteBadge vote={authorVote.vote} />}
          <span>{formatRelativeTime(post.created_at, now)}</span>
          {post.edited_at && <span>(edited)</span>}
          {post.hidden && canSeeContent && (
            <span style="background:var(--muted);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">hidden by the community</span>
          )}
        </div>
        {canSeeContent ? (
          <div class="prose" set:html={post.body_html} />
        ) : (
          <p style="margin:0;color:var(--muted);font-style:italic;font-size:0.9375rem;">
            This post was hidden after being flagged by the community.
          </p>
        )}
        {canSeeContent && (
          <PostActions
            post={post}
            canReact={canReact}
            canFlag={canFlag}
            isOwnPost={isOwnPost}
            flagged={flaggedPostIds.has(post.id)}
            viewerReaction={viewerReactions.get(post.id) ?? null}
          />
        )}
      </article>
    );
  })}
</div>

{(prevPage || nextPage) && (
  <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
    {prevPage && (
      <a href={`/t/${topic.slug}?tab=discussion&page=${prevPage}`}>Previous page</a>
    )}
    {nextPage && (
      <a href={`/t/${topic.slug}?tab=discussion&page=${nextPage}`}>Next page</a>
    )}
  </nav>
)}

{topic.locked && (
  <p style="margin-top:2rem;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:0.375rem;color:var(--muted);font-size:0.875rem;">
    This topic is locked and no longer accepts new replies.
  </p>
)}

{showComposer && (
  <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
    <h2 style="margin:0 0 1rem;font-size:1.125rem;">Reply</h2>
    <Composer client:load mode="post" topicId={topic.id} />
  </section>
)}
