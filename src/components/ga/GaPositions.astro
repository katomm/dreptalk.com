---
// DRep Positions tab: paginated list of all DReps who voted on the governance action,
// ordered by voting power desc. Each row shows identity, vote badge, and power.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import type { ActionVoterRow } from '@/lib/db/drepVotes.js';
import type { Drep } from '@/lib/db/dreps.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';
import { voteTone, TONE_COLORS, formatAda } from '@/lib/governance/view.js';

interface Props {
  voters: ActionVoterRow[];
  dreps: Map<string, Drep>;
  total: number;
  page: number;
  pageSize: number;
  slug: string;
}

const { voters, dreps, total, page, pageSize, slug } = Astro.props;

function descriptorFor(v: ActionVoterRow): AuthorDescriptor {
  const d = dreps.get(v.voter_id);
  return {
    authorId: v.voter_id,
    displayName: d?.name ?? v.voter_id,
    drepId: v.voter_id,
    imageHash: d?.imageContentHash ?? null,
    identiconSeed: d?.hex ?? v.hex ?? v.voter_hex ?? v.voter_id,
    badges: [],
  };
}

const prevPage = page > 1 ? page - 1 : null;
const nextPage = voters.length === pageSize ? page + 1 : null;

function pageHref(p: number): string {
  return `/t/${slug}?tab=positions&page=${p}`;
}
---

<div class="ga-positions">
  <p class="ga-positions__count">
    {total === 0 ? 'No DRep votes recorded yet.' : `${total} DRep${total === 1 ? '' : 's'} voted`}
  </p>

  {total > 0 && (
    <ul class="ga-positions__list">
      {voters.map((v) => {
        const descriptor = descriptorFor(v);
        const tone = voteTone(v.vote);
        const badgeColor = TONE_COLORS[tone];
        const ada = formatAda(v.voting_power);
        return (
          <li class="ga-positions__row">
            <div class="ga-positions__identity">
              <AuthorIdentity author={descriptor} />
            </div>
            <span
              class="ga-positions__vote"
              style={`background:${badgeColor};`}
            >
              {v.vote}
            </span>
            {ada && (
              <span class="ga-positions__power">{ada}</span>
            )}
          </li>
        );
      })}
    </ul>
  )}

  {(prevPage || nextPage) && (
    <nav class="ga-positions__nav">
      {prevPage && <a href={pageHref(prevPage)}>Previous</a>}
      {nextPage && <a href={pageHref(nextPage)}>Next</a>}
    </nav>
  )}
</div>

<style>
  .ga-positions__count {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0 0 0.875rem;
  }

  .ga-positions__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ga-positions__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding: 0.6rem 0;
  }

  .ga-positions__identity {
    text-decoration: none;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .ga-positions__vote {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    border-radius: 0.25rem;
    padding: 0.2rem 0.45rem;
    flex-shrink: 0;
  }

  .ga-positions__power {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ga-positions__nav {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }
</style>
