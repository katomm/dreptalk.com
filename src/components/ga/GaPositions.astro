---
// Positions tab: paginated list of all DReps and SPOs who voted on the governance action,
// ordered by voting power desc. Each row shows identity, vote badge, and power.
// Rows with a rationale become expandable via native <details> (no inline script, CSP-safe).
// A role segment (DReps / SPOs) toggles which voter list is shown.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import Avatar from '@/components/Avatar.astro';
import EarlierVotes from '@/components/EarlierVotes.astro';
import ShareVoteButton from '@/components/ShareVoteButton.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import type { ActionVoterRow } from '@/lib/db/drepVotes.js';
import type { SupersededVote } from '@/lib/db/voteHistory.js';
import type { Drep } from '@/lib/db/dreps.js';
import type { Pool } from '@/lib/db/pools.js';
import type { CcPositionRow } from '@/lib/governance/ccPositions.js';
import { voterDescriptor } from '@/lib/forum/author.js';
import { enhanceStoredHtml } from '@/lib/markdown.js';
import { formatAdaCompact } from '@/lib/governance/view.js';
import { voteStatementPath, positionsVoterAnchor } from '@/lib/governance/voteStatement.js';

interface Props {
  voters: ActionVoterRow[];
  dreps: Map<string, Drep>;
  spoVoters: ActionVoterRow[];
  pools: Map<string, Pool>;
  spoTotal: number;
  total: number;
  page: number;
  pageSize: number;
  slug: string;
  rationales: Map<string, { bodyHtml: string | null; source: string; voterRole: string }>;
  /** Voter ids whose vote was cast after ratification and did not count in the tally. */
  notCounted: Set<string>;
  /** Superseded votes on this action keyed by voter id (newest first); marks changed votes. */
  voteHistory: Map<string, SupersededVote[]>;
  now: number;
  ccRows: CcPositionRow[];
  ccTotal: number;
}

const { voters, dreps, spoVoters, pools, spoTotal, total, page, pageSize, slug, rationales, notCounted, voteHistory, now, ccRows, ccTotal } = Astro.props;

// Determine active role from the query string; default to DReps.
const roleParam = Astro.url.searchParams.get('role');
const role = (roleParam === 'spo' ? 'spo' : roleParam === 'cc' ? 'cc' : 'drep') as 'drep' | 'spo' | 'cc';
// The DRep/SPO list below is CC-agnostic. The CC role has its own list further
// down, so it gets no rows here (voters/spoVoters only ever hold DRep/SPO rows).
const activeVoters = role === 'spo' ? spoVoters : role === 'cc' ? [] : voters;

// Action-wide rationale counts (the map covers the whole action, not just this
// page). The map also carries CC rationales (Task 5's join), so count per role.
const withRationale = [...rationales.values()].filter((r) => r.voterRole === 'DRep').length;
const spoWithRationale = [...rationales.values()].filter((r) => r.voterRole === 'SPO').length;

// Action-wide count of voters who changed their vote, per role (the history map
// covers the whole action too; each voter's entries all carry the same role).
const changedByRole = (r: 'DRep' | 'SPO') =>
  [...voteHistory.values()].filter((list) => list[0]?.voter_role === r).length;
const drepChanged = changedByRole('DRep');
const spoChanged = changedByRole('SPO');

// Late votes among the rows shown on this page (cast after ratification).
const lateOnPage = activeVoters.filter((v) => notCounted.has(v.voter_id)).length;

const prevPage = page > 1 ? page - 1 : null;
// For the active list, use the appropriate length to determine whether a next page exists.
const nextPage = activeVoters.length === pageSize ? page + 1 : null;

// Build hrefs that preserve tab=positions and role, replacing only the page param.
function pageHref(p: number): string {
  return `/t/${slug}/?tab=positions&role=${role}&page=${p}`;
}

// Role toggle hrefs: preserve tab=positions, reset page to avoid stale offsets.
const drepHref = `/t/${slug}/?tab=positions&role=drep`;
const spoHref = `/t/${slug}/?tab=positions&role=spo`;
const ccHref = `/t/${slug}/?tab=positions&role=cc`;

// Absolute origin for per-vote share links, so the copied link stands alone
// off-site. Anchor-form links go through positionsVoterAnchor, which carries
// the voter both as a resolvable page param and as the scroll anchor.
const shareOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<div class="ga-positions">
  <div class="ga-positions__segment" role="tablist" aria-label="Voter role">
    <a
      role="tab"
      aria-selected={role === 'drep' ? 'true' : 'false'}
      class:list={['ga-positions__seg', { 'ga-positions__seg--active': role === 'drep' }]}
      href={drepHref}
    >DReps <span class="ga-positions__seg-count">{total}</span></a>
    <a
      role="tab"
      aria-selected={role === 'spo' ? 'true' : 'false'}
      class:list={['ga-positions__seg', { 'ga-positions__seg--active': role === 'spo' }]}
      href={spoHref}
    >SPOs <span class="ga-positions__seg-count">{spoTotal}</span></a>
    {ccTotal > 0 && (
      <a
        role="tab"
        aria-selected={role === 'cc' ? 'true' : 'false'}
        class:list={['ga-positions__seg', { 'ga-positions__seg--active': role === 'cc' }]}
        href={ccHref}
      >CC <span class="ga-positions__seg-count">{ccTotal}</span></a>
    )}
  </div>

  {role === 'drep' && (
    <p class="ga-positions__count">
      {total === 0
        ? 'No DRep votes recorded yet.'
        : `${total} DRep${total === 1 ? '' : 's'} voted`}
      {withRationale > 0 && (
        <span class="ga-positions__count-rationale">{` · ${withRationale} with a rationale`}</span>
      )}
      {drepChanged > 0 && (
        <span class="ga-positions__count-changed">{` · ${drepChanged} changed their vote`}</span>
      )}
    </p>
  )}

  {role === 'spo' && (
    <p class="ga-positions__count">
      {spoTotal === 0
        ? 'No SPO votes recorded for this action.'
        : `${spoTotal} SPO${spoTotal === 1 ? '' : 's'} voted`}
      {spoWithRationale > 0 && (
        <span class="ga-positions__count-rationale">{` · ${spoWithRationale} with a rationale`}</span>
      )}
      {spoChanged > 0 && (
        <span class="ga-positions__count-changed">{` · ${spoChanged} changed their vote`}</span>
      )}
    </p>
  )}

  {((role === 'drep' && withRationale > 0) || (role === 'spo' && spoWithRationale > 0)) && (
    <p class="ga-positions__hint">Open a row to read the rationale.</p>
  )}

  {lateOnPage > 0 && (
    <p class="ga-positions__hint">Struck-through weight was cast after ratification and did not count in the tally.</p>
  )}

  {activeVoters.length > 0 && (
    <ul class="ga-positions__list">
      {activeVoters.map((v) => {
        const descriptor = role === 'spo' ? voterDescriptor(v, dreps, pools) : voterDescriptor(v, dreps);
        const ada = formatAdaCompact(v.voting_power);
        const bodyHtml = rationales.get(descriptor.authorId)?.bodyHtml ?? null;
        const late = notCounted.has(v.voter_id);
        const history = voteHistory.get(v.voter_id) ?? [];
        const expandable = Boolean(bodyHtml) || history.length > 0;
        // When a rationale exists, share the dedicated vote page keyed by the
        // canonical slug (falling back to the raw id when unassigned) instead
        // of the in-page anchor, so the copied link stands alone off-site.
        const voterKey = role === 'spo'
          ? (pools.get(v.voter_id)?.slug ?? v.voter_id)
          : (dreps.get(v.voter_id)?.slug ?? v.voter_id);
        // This list only ever renders for role 'drep' or 'spo' (activeVoters is
        // empty for 'cc'), so the narrowed literal here is safe.
        const voteShareUrl = bodyHtml
          ? `${shareOrigin}${voteStatementPath(role === 'spo' ? 'spo' : 'drep', voterKey, slug)}`
          : `${shareOrigin}/t/${slug}/${positionsVoterAnchor(v.voter_id, role === 'spo' ? 'spo' : undefined)}`;
        // Identity, vote, and power render identically whether or not the row
        // expands; the power slot is always present (empty when unknown) so the
        // amount column lines up across every row. A late vote (cast after
        // ratification) is tagged and its weight struck through.
        const lead = (
          <>
            <div class="ga-positions__identity">
              <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate kind={role === 'spo' ? 'pool' : undefined} />
              {late && (
                <span class="ga-positions__tag" title="Cast after ratification; not counted in the tally">Not counted</span>
              )}
            </div>
            <VoteBadge vote={v.vote} compact />
            {history.length > 0 && (
              <span class="ga-positions__tag" title={`Earlier vote: ${history[0].vote}`}>
                {history[0].vote === v.vote ? 'Revoted' : 'Changed'}
              </span>
            )}
            <span class:list={['ga-positions__power', { 'ga-positions__power--struck': late }]}>{ada ?? ''}</span>
          </>
        );
        return (
          <li class="ga-positions__row" id={`voter-${v.voter_id}`} style="scroll-margin-top:5rem">
            {expandable ? (
              <details class="ga-positions__details">
                <summary class="ga-positions__summary">
                  {lead}
                  <span class="ga-positions__cta">
                    <span class="ga-positions__cta-label">{bodyHtml ? 'Rationale' : 'History'}</span>
                    <svg class="ga-positions__chev" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>
                <div class="vote-share"><ShareVoteButton url={voteShareUrl} /></div>
                {bodyHtml && <div class="ga-positions__rationale-body" set:html={enhanceStoredHtml(bodyHtml)} />}
                {history.length > 0 && <EarlierVotes earlier={history} now={now} />}
              </details>
            ) : (
              <div class="ga-positions__summary ga-positions__summary--static">
                {lead}
                <span class="ga-positions__cta ga-positions__cta--none">
                  <span class="ga-positions__cta-label">No rationale</span>
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )}

  {role === 'cc' && (
    <>
      {(() => {
        const voted = ccRows.filter((m) => m.vote != null).length;
        return (
          <p class="ga-positions__count">
            {ccTotal === 0
              ? 'No committee data for this action.'
              : `${voted} of ${ccTotal} committee member${ccTotal === 1 ? '' : 's'} voted`}
          </p>
        );
      })()}
      <ul class="ga-positions__list">
        {ccRows.map((m) => {
          const seed = m.hotKeyHex ?? m.coldKeyHex;
          const shortKey = `${seed.slice(0, 8)}…${seed.slice(-4)}`;
          const shareUrl = m.voterId ? `${shareOrigin}/t/${slug}/${positionsVoterAnchor(m.voterId, 'cc')}` : null;
          const lead = (
            <>
              <div class="ga-positions__identity cc-id">
                <Avatar seed={seed} size={AVATAR_SIZE.rowLead} />
                <span class="cc-id__text">
                  <span class="cc-id__name">{m.displayName ?? shortKey}</span>
                  <span class="cc-id__key">{shortKey}</span>
                </span>
              </div>
              {m.vote
                ? <VoteBadge vote={m.vote} compact />
                : <span class="cc-notvoted" title="Did not vote on this action">Not voted</span>}
              <span class="cc-standing">{m.standing}{m.termExpiration != null && ` · term ends epoch ${m.termExpiration}`}</span>
            </>
          );
          return (
            <li class="ga-positions__row" id={m.voterId ? `voter-${m.voterId}` : undefined} style="scroll-margin-top:5rem">
              {m.rationale === 'view' && m.bodyHtml ? (
                <details class="ga-positions__details">
                  <summary class="ga-positions__summary">
                    {lead}
                    <span class="ga-positions__cta">
                      <span class="ga-positions__cta-label">Rationale</span>
                      <svg class="ga-positions__chev" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </summary>
                  {shareUrl && <div class="vote-share"><ShareVoteButton url={shareUrl} /></div>}
                  <div class="ga-positions__rationale-body" set:html={enhanceStoredHtml(m.bodyHtml)} />
                </details>
              ) : (
                <div class="ga-positions__summary ga-positions__summary--static">
                  {lead}
                  <span class="ga-positions__cta ga-positions__cta--none">
                    <span class="ga-positions__cta-label">{m.rationale === 'unavailable' ? 'Rationale unavailable' : 'No rationale'}</span>
                  </span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </>
  )}

  {(prevPage || nextPage) && (
    <nav class="ga-positions__nav">
      {prevPage && <a href={pageHref(prevPage)}>Previous</a>}
      {nextPage && <a href={pageHref(nextPage)}>Next</a>}
    </nav>
  )}
</div>

<style>
  .ga-positions__count {
    font-size: 0.8125rem;
    color: var(--muted);
    margin: 0 0 0.25rem;
  }

  .ga-positions__count-rationale {
    color: var(--accent);
  }

  .ga-positions__count-changed {
    color: var(--muted);
  }

  .ga-positions__hint {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 0.875rem;
  }

  .ga-positions__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ga-positions__row {
    border-top: 1px solid var(--border);
  }

  .ga-positions__details {
    width: 100%;
  }

  /* Shared row layout: identity grows, vote/power/chevron are fixed columns so
     badges and amounts line up across every row, expandable or not. */
  .ga-positions__summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.6rem 0;
    cursor: pointer;
    list-style: none;
  }

  .ga-positions__summary--static {
    cursor: default;
  }

  .ga-positions__summary::-webkit-details-marker {
    display: none;
  }

  .ga-positions__identity {
    text-decoration: none;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .ga-positions__power {
    flex-shrink: 0;
    width: 5rem;
    text-align: right;
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ga-positions__power--struck {
    text-decoration: line-through;
    opacity: 0.55;
  }

  /* Small bordered voter tag, shared by "Not counted" (cast after ratification)
     and "Changed" (the voter re-voted; earlier votes sit in the expansion). */
  .ga-positions__tag {
    flex-shrink: 0;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  /* Inside the identity cell (the "Not counted" case) the tag flows inline. */
  .ga-positions__identity .ga-positions__tag {
    display: inline-block;
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  /* Expand affordance column. Mobile: just the chevron (compact). Desktop: a
     "Rationale" / "No rationale" label too. Fixed width so the amount column to
     its left stays aligned across every row. */
  .ga-positions__cta {
    flex-shrink: 0;
    width: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem;
    color: var(--accent);
    font-size: 0.75rem;
  }

  .ga-positions__cta--none {
    color: var(--muted);
  }

  .ga-positions__cta-label {
    display: none;
  }

  .ga-positions__chev {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.15s ease;
  }

  .ga-positions__details[open] .ga-positions__chev {
    transform: rotate(90deg);
  }

  @media (min-width: 40rem) {
    .ga-positions__cta {
      width: 6.5rem;
    }
    .ga-positions__cta-label {
      display: inline;
    }
  }

  .ga-positions__rationale-body {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text);
    padding: 0.5rem 0 0.75rem;
    border-top: 1px dashed var(--border);
  }

  .ga-positions__rationale-body :global(p) {
    margin: 0 0 0.75rem;
  }

  .ga-positions__rationale-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .ga-positions__nav {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  /* Role segment toggle: DReps / SPOs switcher above the voter list. */
  .ga-positions__segment {
    display: flex;
    gap: 0;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    overflow: hidden;
    width: fit-content;
  }

  .ga-positions__seg {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    border-right: 1px solid var(--border);
    background: transparent;
    transition: background 0.1s ease, color 0.1s ease;
  }

  .ga-positions__seg:last-child {
    border-right: none;
  }

  .ga-positions__seg:hover {
    background: var(--surface-hover, color-mix(in srgb, var(--border) 40%, transparent));
    color: var(--text);
  }

  .ga-positions__seg--active {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ga-positions__seg--active:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ga-positions__seg-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  /* CC row identity: not a DRep, so a plain Avatar (never a profile link) plus
     name/key text, matching the drep row's flex layout for column alignment. */
  .cc-id {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cc-id__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cc-id__name {
    font-size: 0.9375rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cc-id__key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .cc-standing {
    flex-shrink: 0;
    text-align: right;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .cc-notvoted {
    flex-shrink: 0;
    color: var(--muted);
    border: 1px dashed var(--muted);
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    line-height: 1;
  }
</style>
