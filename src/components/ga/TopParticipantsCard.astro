---
// Sidebar card: top DRep participants (by voting power) for a governance action.
// Renders nothing when the voter list is empty (action has no recorded votes yet).
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import type { ActionVoterRow } from '@/lib/db/drepVotes.js';
import type { Drep } from '@/lib/db/dreps.js';
import { voterDescriptor } from '@/lib/forum/author.js';
import { formatAdaCompact } from '@/lib/governance/view.js';

interface Props {
  voters: ActionVoterRow[];
  dreps: Map<string, Drep>;
  slug: string;
  total: number;
  /** Action-wide count of readable rationales, surfaced on the "See all" link. */
  rationaleCount?: number;
}

const { voters, dreps, slug, total, rationaleCount = 0 } = Astro.props;
---

{voters.length > 0 && (
  <div class="sidebar-card">
    <p class="sidebar-card__title">Top DRep Participants</p>
    <ul class="top-participants__list">
      {voters.map((v) => {
        const descriptor = voterDescriptor(v, dreps);
        const ada = formatAdaCompact(v.voting_power);
        return (
          <li class="top-participants__row">
            <div class="top-participants__identity">
              <AuthorIdentity author={descriptor} size={AVATAR_SIZE.compact} truncate />
            </div>
            <VoteBadge vote={v.vote} compact />
            <span class="top-participants__power">{ada ?? ''}</span>
          </li>
        );
      })}
    </ul>
    {total > voters.length && (
      <a class="top-participants__more" href={`/t/${slug}/?tab=positions`}>
        See all {total.toLocaleString('en-US')} positions{rationaleCount > 0 ? ` and ${rationaleCount.toLocaleString('en-US')} rationale${rationaleCount === 1 ? '' : 's'}` : ''}
      </a>
    )}
  </div>
)}

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }

  .top-participants__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .top-participants__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-top: 1px solid var(--border);
  }

  .top-participants__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .top-participants__identity {
    text-decoration: none;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.8125rem;
  }

  .top-participants__power {
    flex-shrink: 0;
    width: 4.75rem;
    text-align: right;
    color: var(--muted);
    font-size: 0.75rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .top-participants__more {
    display: block;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .top-participants__more:hover {
    text-decoration: underline;
  }
</style>
