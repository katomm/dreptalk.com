---
// Sidebar card: the authors named in the action's CIP-108 metadata document.
// This is a separate on-chain signal from the Proposer (return address) card:
// the return address is who submitted the action, these are who the document
// itself names as authors. The two can differ, so both are shown and neither is
// curated. Names are self-declared and unverified; rendered verbatim as text
// (Astro auto-escapes) with no logo or link, so a claimed name never borrows a
// curated org's trust markers.
interface Props {
  /** Self-declared author names from the anchor document, or null. */
  authors: string[] | null;
}

const { authors } = Astro.props;
---

{authors && authors.length > 0 && (
  <div class="sidebar-card">
    <p class="sidebar-card__title">Authors</p>
    <ul class="authors">
      {authors.map((name) => <li class="authors__item">{name}</li>)}
    </ul>
    <p class="authors__hint">Named in the action metadata document.</p>
  </div>
)}

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }
  .authors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .authors__item { font-size: 0.9rem; color: var(--fg); }
  .authors__hint { font-size: 0.72rem; color: var(--muted); margin: 0.55rem 0 0; }
</style>
