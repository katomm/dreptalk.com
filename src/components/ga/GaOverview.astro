---
// Overview tab: on-chain changes summary, abstract and motivation/rationale, then
// the join-discussion CTA. Vote tallies (stake participation, sentiment) live in
// the sidebar's Voting Information card, so the overview no longer repeats them.
import GaOnchainChanges from './GaOnchainChanges.astro';
import GaRationaleHighlights from './GaRationaleHighlights.astro';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { OnchainChanges } from '@/lib/governance/onchain.js';
import type { RationaleHighlight } from '@/lib/db/actionRationale.js';
import type { Drep } from '@/lib/db/dreps.js';
import { ensureLinkTarget, renderMarkdown } from '@/lib/markdown.js';

interface Props {
  action: GovernanceAction;
  onchain: OnchainChanges | null;
  /** Thread slug, comment count and viewer state drive the join-discussion CTA. */
  slug: string;
  commentCount: number;
  loggedIn: boolean;
  locked: boolean;
  /** Top DRep rationales (with text, non-abstain) for the highlights section. */
  highlights: RationaleHighlight[];
  /** Resolved identities for the highlight voters. */
  highlightDreps: Map<string, Drep>;
  /** Total readable rationales on the action, for the highlights "see all" link. */
  rationaleCount: number;
}

const { action, onchain, slug, commentCount, loggedIn, locked, highlights, highlightDreps, rationaleCount } =
  Astro.props;

// The discussion lives behind its own tab; the overview only links into it. The
// composer sits at the bottom of that tab under the #reply anchor.
const discussionHref = `/t/${slug}/?tab=discussion`;
const commentLabel = commentCount === 1 ? '1 comment' : `${commentCount} comments`;
const hasComments = commentCount > 0;

// Every CIP-108 action carries an abstract (a short summary). It is the always-
// visible lede and the natural fold line: the reader gets the summary, and the
// full motivation + rationale sits behind a "show full rationale" toggle. Rendered
// from the stored abstract markdown (short, so per-request rendering is cheap).
const abstractHtml = action.abstract ? renderMarkdown(action.abstract) : null;

// The full body (motivation + rationale) collapses behind the toggle only when it
// is genuinely long; a short rationale reads better shown in one piece than behind
// a click. The plain-text length drives the threshold so markup does not inflate it.
const rationaleText = action.rationaleHtml
  ? action.rationaleHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
  : '';
const isLongRationale = rationaleText.length > 5000;
---

<section class="ga-overview">
  <GaOnchainChanges changes={onchain} />

  {abstractHtml && (
    <div class="ga-abstract">
      <p class="ga-abstract__label">Abstract</p>
      <div class="prose ga-abstract__body" set:html={ensureLinkTarget(abstractHtml)} />
    </div>
  )}

  {action.rationaleHtml && (
    <div class="ga-rationale">
      <p class="ga-rationale__label">Motivation &amp; rationale</p>
      {isLongRationale ? (
        <>
          {/* Collapsed by default: the abstract above is the summary, so the full
              body opens only on demand. Toggle sits before the body so it stays put
              when the body is hidden. */}
          <input type="checkbox" id="ga-rationale-more" class="ga-rationale__cb" aria-hidden="true" tabindex="-1" />
          <label for="ga-rationale-more" class="ga-rationale__toggle"></label>
          <div class="prose ga-rationale__body" set:html={ensureLinkTarget(action.rationaleHtml)} />
        </>
      ) : (
        <div class="prose" style="font-size:0.9375rem;" set:html={ensureLinkTarget(action.rationaleHtml)} />
      )}
    </div>
  )}

  {!action.rationaleHtml && !abstractHtml && (
    <p class="ga-overview__empty">No details available for this action.</p>
  )}

  {/* The site's unique content: what the biggest DReps said when they voted.
      Surfaced on the canonical Overview URL, with links into the Votes tab. */}
  <GaRationaleHighlights
    highlights={highlights}
    dreps={highlightDreps}
    slug={slug}
    totalRationales={rationaleCount}
  />

  {/* Bridge from the overview into the discussion. Readers land here, so this is
      the page's main nudge to weigh in; the discussion tab itself owns the
      composer and the signed-out sign-in banner. */}
  <aside class="ga-join">
    <div class="ga-join__text">
      <p class="ga-join__title">Join the discussion</p>
      <p class="ga-join__sub">
        {locked
          ? `${commentLabel}. This topic is locked, but you can still read what DReps said.`
          : commentCount > 0
            ? `${commentLabel} so far. Read the debate or add your perspective.`
            : 'No comments yet. Be the first to share your perspective.'}
      </p>
    </div>
    <div class="ga-join__actions">
      {locked ? (
        <a class="btn btn-secondary" href={discussionHref}>Read the discussion</a>
      ) : loggedIn ? (
        <a class="btn btn-primary" href={`${discussionHref}#reply`}>{hasComments ? 'Add your comment' : 'Start the discussion'}</a>
      ) : (
        <>
          <a class="btn btn-primary" href="/login/">Sign in to post</a>
          {/* Nothing to read yet when there are no comments, so the secondary
              "Read the discussion" link only appears once the thread has some. */}
          {hasComments && <a class="ga-join__link" href={discussionHref}>Read the discussion</a>}
        </>
      )}
    </div>
  </aside>
</section>

<style>
  .ga-overview__empty {
    color: var(--muted);
    font-style: italic;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Section labels shared by abstract + rationale blocks */
  .ga-abstract__label,
  .ga-rationale__label { font-size: 0.8125rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 0.4rem; }

  /* Abstract: the always-visible summary / lede */
  .ga-abstract { margin-top: 0.875rem; }
  .ga-abstract__body { font-size: 0.9375rem; }

  /* Rationale block: collapsed by default, opened via the toggle */
  .ga-rationale { margin-top: 1.125rem; }
  .ga-rationale__cb { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .ga-rationale__body { font-size: 0.9375rem; max-height: 0; overflow: hidden; }
  .ga-rationale__cb:checked ~ .ga-rationale__body { max-height: none; margin-top: 0.6rem; }
  .ga-rationale__toggle { display: inline-block; color: var(--accent); cursor: pointer; font-size: 0.8125rem; font-weight: 600; }
  .ga-rationale__toggle::after { content: 'Show full rationale'; }
  .ga-rationale__cb:checked ~ .ga-rationale__toggle::after { content: 'Show less'; }
  .ga-rationale__cb:focus-visible ~ .ga-rationale__toggle { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  /* Join-discussion CTA */
  .ga-join {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ga-join__text { flex: 1 1 16rem; min-width: 0; }
  .ga-join__title { margin: 0; font-weight: 600; font-size: 0.975rem; color: var(--fg); }
  .ga-join__sub { margin: 0.15rem 0 0; font-size: 0.875rem; color: var(--muted); line-height: 1.45; }
  .ga-join__actions { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
  .ga-join__link { color: var(--accent); text-decoration: none; font-size: 0.875rem; font-weight: 600; }
  .ga-join__link:hover { text-decoration: underline; }
</style>
