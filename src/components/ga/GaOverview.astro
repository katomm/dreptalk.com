---
// Overview tab body: on-chain changes summary, abstract, and motivation/rationale.
// The rationale highlights and the join-discussion CTA are rendered by the thread
// page as their own blocks (so they can be reordered on the mobile stack), and the
// vote tallies live in the sidebar's Voting Information card.
import GaOnchainChanges from './GaOnchainChanges.astro';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { OnchainChanges } from '@/lib/governance/onchain.js';
import { enhanceStoredHtml, renderMarkdown } from '@/lib/markdown.js';
import { resolveAnchorUrl } from '@/lib/governance/metadata.js';

interface Props {
  action: GovernanceAction;
  onchain: OnchainChanges | null;
  committeeNames?: Map<string, string>;
}

const { action, onchain, committeeNames } = Astro.props;

// Every CIP-108 action carries an abstract (a short summary). It is the always-
// visible lede and the natural fold line: the reader gets the summary, and the
// full motivation + rationale sits behind a "show full rationale" toggle. Rendered
// from the stored abstract markdown (short, so per-request rendering is cheap).
const abstractHtml = action.abstract ? renderMarkdown(action.abstract) : null;

// The full body (motivation + rationale) collapses behind the toggle only when it
// is genuinely long; a short rationale reads better shown in one piece than behind
// a click. The plain-text length drives the threshold so markup does not inflate it.
const rationaleText = action.rationaleHtml
  ? action.rationaleHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
  : '';
const isLongRationale = rationaleText.length > 5000;

// When neither an abstract nor a rationale renders, "No details available" is
// misleading: most such actions DID ship a full metadata document, but the
// proposer anchored it to a mutable URL that has since 404'd or drifted from the
// on-chain hash. anchor_status records which of those it was, so we can name the
// real cause instead of implying the proposer supplied nothing. The anchor stays
// linkable (resolving ipfs:// to a gateway) so a reader can still inspect the
// source, with the integrity caveat spelled out for a hash mismatch.
const hasBody = Boolean(abstractHtml || action.rationaleHtml);
const anchorHref = action.anchorUrl ? resolveAnchorUrl(action.anchorUrl) : null;
let emptyReason = 'No details are available for this action.';
if (!hasBody) {
  if (!action.anchorUrl) {
    emptyReason = 'The proposer did not attach a metadata document to this action.';
  } else if (action.anchorStatus === 'ok') {
    emptyReason = 'The attached metadata document contains no summary or rationale.';
  } else if (action.anchorStatus === 'hash-mismatch') {
    emptyReason =
      'The metadata document at the anchor no longer matches the on-chain hash, so it cannot be shown here.';
  } else if (action.anchorStatus === 'pending') {
    emptyReason = 'The metadata document has not been retrieved yet.';
  } else {
    // fetch-failed, too-large, bad-content-type, parse-failed, unsupported-url
    emptyReason = 'The metadata document could not be retrieved from its anchor.';
  }
}
---

<section class="ga-overview">
  <GaOnchainChanges changes={onchain} committeeNames={committeeNames} />

  {abstractHtml && (
    <div class="ga-abstract">
      <p class="ga-abstract__label">Abstract</p>
      <div class="prose ga-abstract__body" set:html={enhanceStoredHtml(abstractHtml)} />
    </div>
  )}

  {action.rationaleHtml && (
    <div class="ga-rationale">
      <p class="ga-rationale__label">Motivation &amp; rationale</p>
      {isLongRationale ? (
        <>
          {/* Collapsed by default: the abstract above is the summary, so the full
              body opens only on demand. Toggle sits before the body so it stays put
              when the body is hidden. */}
          <input type="checkbox" id="ga-rationale-more" class="ga-rationale__cb" aria-hidden="true" tabindex="-1" />
          <label for="ga-rationale-more" class="ga-rationale__toggle"></label>
          <div class="prose ga-rationale__body" set:html={enhanceStoredHtml(action.rationaleHtml)} />
        </>
      ) : (
        <div class="prose" style="font-size:0.9375rem;" set:html={enhanceStoredHtml(action.rationaleHtml)} />
      )}
    </div>
  )}

  {!hasBody && (
    <p class="ga-overview__empty">
      {emptyReason}
      {anchorHref && (
        <>
          {' '}
          <a
            class="ga-overview__anchor"
            href={anchorHref}
            target="_blank"
            rel="noopener noreferrer nofollow"
          >View the anchor document</a>.
        </>
      )}
    </p>
  )}
</section>

<style>
  .ga-overview__empty {
    color: var(--muted);
    font-style: italic;
    font-size: 0.9375rem;
    margin: 0;
  }

  .ga-overview__anchor {
    color: var(--accent);
    font-style: normal;
    text-decoration: underline;
  }

  /* Section labels shared by abstract + rationale blocks */
  .ga-abstract__label,
  .ga-rationale__label { font-size: 0.8125rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 0.4rem; }

  /* Abstract: the always-visible summary / lede */
  .ga-abstract { margin-top: 0.875rem; }
  .ga-abstract__body { font-size: 0.9375rem; }

  /* Rationale block: collapsed by default, opened via the toggle */
  .ga-rationale { margin-top: 1.125rem; }
  .ga-rationale__cb { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .ga-rationale__body { font-size: 0.9375rem; max-height: 0; overflow: hidden; }
  .ga-rationale__cb:checked ~ .ga-rationale__body { max-height: none; margin-top: 0.6rem; }
  .ga-rationale__toggle { display: inline-block; color: var(--accent); cursor: pointer; font-size: 0.8125rem; font-weight: 600; }
  .ga-rationale__toggle::after { content: 'Show full rationale'; }
  .ga-rationale__cb:checked ~ .ga-rationale__toggle::after { content: 'Show less'; }
  .ga-rationale__cb:focus-visible ~ .ga-rationale__toggle { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
</style>
