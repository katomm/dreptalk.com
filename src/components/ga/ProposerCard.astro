---
// Sidebar card: proposer identity (logo+name->website or identicon+address).
import ProposerIdentity from '@/components/ProposerIdentity.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { proposerCountLine } from '@/lib/treasury/recipientHistory.js';

interface Props {
  returnAddress: string | null;
  // All actions from this return address, the current one included. Null when not loaded.
  proposerActionCount?: number | null;
}

const { returnAddress, proposerActionCount = null } = Astro.props;
---

{returnAddress && (
  <div class="sidebar-card">
    <p class="sidebar-card__title">Proposer</p>
    <ProposerIdentity returnAddress={returnAddress} size={AVATAR_SIZE.card} />
    {proposerActionCount !== null && proposerActionCount > 0 && (
      <p class="proposer-count">{proposerCountLine(proposerActionCount)}</p>
    )}
  </div>
)}

<style>
  .sidebar-card {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
  }
  .sidebar-card__title {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.625rem;
  }
  .proposer-count {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }
</style>
