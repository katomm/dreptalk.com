---
// Copy-to-clipboard icon button for SSR markup. Drop it right after any
// on-chain identifier we render (stake key, DRep id, address, tx hash, ...) to
// let people copy the full value with one click. The visuals live in the global
// .copy-btn class so the React CopyButton island matches exactly. A single
// delegated listener (bundled by Astro, included once per page regardless of
// how many instances appear) handles every button; the strict CSP forbids
// inline handlers, so the click logic ships as this hoisted script.
interface Props {
  /** Full value copied to the clipboard. */
  value: string;
  /** Accessible label and tooltip. */
  label?: string;
}
const { value, label = 'Copy' } = Astro.props;
---

<button type="button" class="copy-btn" data-copy={value} aria-label={label} title={label}>
  <svg class="copy-btn__copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
  </svg>
  <svg class="copy-btn__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 6 9 17l-5-5" />
  </svg>
</button>

<script>
  // One delegated listener covers every .copy-btn on the page. Buttons rendered
  // by React islands set their own onClick instead and carry no data-copy, so
  // they are ignored here.
  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('.copy-btn[data-copy]');
    const value = btn?.dataset.copy;
    if (!btn || value == null) return;
    navigator.clipboard
      .writeText(value)
      .then(() => {
        btn.classList.add('is-copied');
        setTimeout(() => btn.classList.remove('is-copied'), 1500);
      })
      .catch(() => {
        // Clipboard can be blocked (no permission / insecure context); ignore.
      });
  });
</script>
