---
// A single yes/no/abstain tally bar. Reused by the governance header (full size)
// and the topic-row mini-tally. Colors come from the shared tone palette.
import { TONE_COLORS, type TallyBar } from '@/lib/governance/view.js';

interface Props {
  bar: TallyBar;
  height?: number;
}

const { bar, height = 8 } = Astro.props;
---

<div style={`display:flex;height:${height}px;border-radius:999px;overflow:hidden;background:var(--border);`}>
  <div style={`width:${bar.yes}%;background:${TONE_COLORS.positive};`}></div>
  <div style={`width:${bar.no}%;background:${TONE_COLORS.negative};`}></div>
  <div style={`width:${bar.abstain}%;background:${TONE_COLORS.neutral};`}></div>
</div>
