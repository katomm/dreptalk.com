---
// One badge card: artwork, name, optional tier label, optional progress bar.
// Locked badges pass the desaturated artwork; the tile itself stays neutral.
interface Props {
  name: string;
  image: string;
  earned?: boolean;
  /** 1..3 shows the Bronze/Silver/Gold label. */
  tier?: number;
  description?: string;
  /** Hover hint (native title) explaining how the badge is earned. */
  tip?: string;
  progress?: { current: number; goal: number } | null;
  /** Artwork size in px. */
  size?: number;
}

const { name, image, earned = true, tier = 0, description, tip, progress = null, size = 96 } = Astro.props;
const TIER_LABELS = ['', 'Bronze', 'Silver', 'Gold'];
const pct = progress ? Math.min(100, Math.round((progress.current / progress.goal) * 100)) : 0;
---

{/* height:100% + margin-top:auto on the caption block: grid rows stretch all
    cells to the tallest tile, so progress bars sit on one line per row without
    reserving blank space under single-line names. */}
<div title={tip} style={`display:flex;flex-direction:column;align-items:center;text-align:center;gap:0.3rem;height:100%;${tip ? 'cursor:help;' : ''}`}>
  <img src={image} alt="" width={size} height={size} loading="lazy" decoding="async" />
  <div style={`font-size:0.875rem;font-weight:600;line-height:1.25;${earned ? '' : 'color:var(--muted);'}`}>
    {name}
  </div>
  {description && <div style="font-size:0.75rem;color:var(--muted);line-height:1.4;">{description}</div>}
  {progress && (
    <div style="width:100%;max-width:7rem;margin-top:auto;">
      <div
        role="progressbar"
        aria-valuenow={progress.current}
        aria-valuemin="0"
        aria-valuemax={progress.goal}
        aria-label={`${name}: ${progress.current} of ${progress.goal}`}
        style="height:6px;border-radius:3px;background:var(--surface);border:1px solid var(--border);overflow:hidden;"
      >
        <div style={`width:${pct}%;height:100%;background:var(--accent);`}></div>
      </div>
      <div style="font-size:0.6875rem;color:var(--muted);margin-top:0.15rem;">
        {progress.current}/{progress.goal}{tier > 0 && ` · ${TIER_LABELS[tier]}`}
      </div>
    </div>
  )}
  {!progress && tier > 0 && <div style="font-size:0.6875rem;color:var(--muted);margin-top:auto;">{TIER_LABELS[tier]}</div>}
</div>
