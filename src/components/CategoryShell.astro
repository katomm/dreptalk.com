---
// The frame every /c/<slug>/ list renders inside: breadcrumb, heading, the
// sidebar/main two-column grid, the mobile category chips, and the pager under
// the list. Only the list body differs between category kinds, so it is the
// slot — the three kinds sharing one frame is what keeps a navigation or
// layout change from having to be made three times and land twice.
import type { Category } from '../../config/categories.js';
import CategorySidebar from '@/components/CategorySidebar.astro';
import Pager from '@/components/Pager.astro';

interface Props {
  category: Category;
  categories: readonly Category[];
  stats: Map<string, { topicCount: number; lastPostAt: number | null }>;
  now: number;
  /** Pager under the list; `totalPages` is null where only "is there a next
   * page" is known (every list but governance). */
  pager: {
    prevHref: string | null;
    nextHref: string | null;
    firstHref: string | null;
    lastHref: string | null;
    page: number;
    totalPages: number | null;
  };
}

const { category, categories, stats, now, pager } = Astro.props;
---

<nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
  <a href="/">DRepTalk</a>
  <span style="margin:0 0.375rem;">/</span>
  <span>{category.name}</span>
</nav>

<div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.5rem;">
  <div>
    <h1 style="margin:0 0 0.25rem;">{category.name}</h1>
    <p style="margin:0;color:var(--muted);font-size:0.875rem;">
      {category.description}
    </p>
  </div>
</div>

<div class="cat-layout">
  <CategorySidebar categories={categories} stats={stats} selectedSlug={category.slug} now={now} />
  <div class="cat-main">
    <nav class="cat-chips" aria-label="Categories">
      {categories.map((c) => (
        <a class:list={['cat-chip', { 'cat-chip--on': c.slug === category.slug }]} href={`/c/${c.slug}/`}>
          {c.name}<span>{stats.get(c.slug)?.topicCount ?? 0}</span>
        </a>
      ))}
    </nav>

    <slot />

    <Pager
      prevHref={pager.prevHref}
      nextHref={pager.nextHref}
      firstHref={pager.firstHref}
      lastHref={pager.lastHref}
      page={pager.page}
      totalPages={pager.totalPages}
      label="Topic list pagination"
    />

    {/* Below the pager: the discussion categories' composer, and nothing on
        the mirrored lists, which nobody posts into directly. */}
    <slot name="below-pager" />
  </div>
</div>

<style>
  /* Category two-column layout: sidebar on the left, list in the main column.
     Single column below 60rem; the sidebar is hidden there in favor of the
     mobile category chip row. */
  .cat-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  /* Grid items default to min-width:auto; without this the nowrap topic-row
     excerpt expands the main column and pushes the stat cluster off-screen. */
  .cat-main {
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .cat-layout {
      grid-template-columns: 20rem 1fr;
    }
  }
  @media (max-width: 60rem) {
    .cat-layout > :global(.cat-sidebar) {
      display: none;
    }
  }

  /* Mobile category chip row: replaces the sidebar (hidden below 60rem) with a
     horizontal-scroll list of all categories. */
  .cat-chips {
    display: none;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 60rem) {
    .cat-chips {
      display: flex;
    }
  }
  .cat-chip {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    white-space: nowrap;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--fg);
  }
  .cat-chip--on {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border-color: transparent;
    font-weight: 600;
  }
</style>
