---
// One activity feed line, three columns: a 40px icon tile (system house icon or
// the actor avatar), a content column (actor name + role badges + verb + linked
// title + inline status badge) that wraps within itself, and a right-aligned meta
// column (clock + relative time, plus an external-link on comment rows).
import type { ActivityEvent } from '@/lib/forum/activityFeed.js';
import Avatar from '@/components/Avatar.astro';
import LogoMark from '@/components/LogoMark.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { authorProfileHref } from '@/lib/forum/author.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import { GAVEL_PATH, MESSAGE_PATH, USERS_PATH } from '@/lib/forum/icons.js';
import { statusBadge, govStatusVerb, isTerminalStatus, TONE_COLORS } from '@/lib/governance/view.js';

interface Props {
  event: ActivityEvent;
  now: number;
  variant?: 'default' | 'discussions';
}

const { event, now, variant = 'default' } = Astro.props;

// Meta-line verb for the discussions variant: "{actor} {verb} in {category}".
// System events (gov_created/gov_status) have no actor, so the verb alone still
// reads as a caption under the title.
const discussionsVerb =
  event.kind === 'topic_created'
    ? 'started'
    : event.kind === 'reply_created'
      ? event.topic.isGovernance
        ? 'commented'
        : 'replied'
      : event.kind === 'gov_created'
        ? 'New governance action'
        : govStatusVerb(event.statusTransition?.to ?? '');

// Replies deep-link to the post; everything else links to the topic. On a
// governance action the comments live under the Discussion tab, so target that
// tab explicitly, otherwise the post anchor lands on the Overview tab where the
// comment is not rendered and the scroll never resolves.
const href = event.refPostId
  ? `/t/${event.topic.slug}/${event.topic.isGovernance ? '?tab=discussion' : ''}#post-${event.refPostId}`
  : `/t/${event.topic.slug}/`;

const badge =
  (event.kind === 'gov_created' || event.kind === 'gov_status') && event.governanceStatus
    ? statusBadge(event.governanceStatus)
    : null;
// Terminal outcomes render as an outline pill; a live (active) one stays filled.
const badgeOutline = badge ? isTerminalStatus(event.governanceStatus as string) : false;

const actor = event.actor;
const profileHref = actor ? authorProfileHref(actor) : null;
const seed = actor?.identiconSeed ?? actor?.authorId ?? '';
const isComment = event.kind === 'reply_created';

// System events (gov_created/gov_status) have no actor, so the verb starts the
// caption. Capitalize it in that case so it does not read as a lowercase
// fragment ("Was ratified in Governance Actions" rather than "was ratified ...").
const discussionsVerbText = actor
  ? discussionsVerb
  : discussionsVerb.charAt(0).toUpperCase() + discussionsVerb.slice(1);

const LINK = 'font-weight:500;text-decoration:none;color:var(--fg);';

// Additional events on this thread folded into this row by the collapsed
// (homepage) feed. The row itself shows the latest event; this counts the rest.
const moreLabel =
  event.extraCount > 0 ? `+${event.extraCount} more update${event.extraCount === 1 ? '' : 's'}` : null;
---

{variant === 'discussions' ? (
<div class="act-row act-row--wide">
  {actor && !actor.isSystem ? (
    <Avatar seed={seed} imageHash={actor.imageHash} size={AVATAR_SIZE.rowLead} />
  ) : (
    <span class="act-tile" aria-hidden="true">
      <LogoMark style="width:22px;height:22px;color:var(--muted);" />
    </span>
  )}

  <div class="act-body2">
    <div class="act-titlerow">
      <svg class="act-type-icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d={event.topic.isGovernance ? GAVEL_PATH : MESSAGE_PATH} />
      </svg>
      <a class="act-title2" href={href}>{event.topic.title}</a>
    </div>
    <p class="act-meta2">
      {actor && (
        <Fragment>
          {profileHref ? <a class="act-name2" href={profileHref}>{actor.displayName}</a> : <span class="act-name2">{actor.displayName}</span>}
          {' '}
        </Fragment>
      )}{discussionsVerbText} in {event.topic.categoryName}<span class="act-meta2-time"><span class="act-dot" aria-hidden="true">&middot;</span>{formatRelativeTime(event.createdAt, now)}</span>{moreLabel && (<span class="act-more"><span class="act-dot" aria-hidden="true">&middot;</span>{moreLabel}</span>)}
    </p>
    <div class="act-compact">
      <span class="act-compact-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={MESSAGE_PATH} /></svg>
        {event.topic.postCount - 1}
      </span>
      <span class="act-compact-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={USERS_PATH} /></svg>
        {event.participants ?? 0}
      </span>
      <span class="act-compact-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        {formatRelativeTime(event.createdAt, now)}
      </span>
    </div>
  </div>

  <div class="act-stats">
    <div class="act-stat">
      <span class="act-stat__num">{event.topic.postCount - 1}</span>
      <span class="act-stat__label">Replies</span>
    </div>
    <div class="act-stat">
      <span class="act-stat__num">{event.participants ?? 0}</span>
      <span class="act-stat__label">Participants</span>
    </div>
  </div>
</div>
) : (
<div class="act-row">
  {actor && !actor.isSystem ? (
    <Avatar seed={seed} imageHash={actor.imageHash} size={AVATAR_SIZE.rowLead} />
  ) : (
    <span class="act-tile" aria-hidden="true">
      <LogoMark style="width:22px;height:22px;color:var(--muted);" />
    </span>
  )}

  <div class="act-body">
    <span class="act-text">
      {actor && (
        <Fragment>
          {profileHref ? <a class="act-name" href={profileHref}>{actor.displayName}</a> : <span class="act-name">{actor.displayName}</span>}
          {(actor.badges ?? []).map((b) => <span class="act-role">{b}</span>)}
          {' '}
        </Fragment>
      )}
      {event.kind === 'topic_created' && (
        <Fragment>started <a href={href} style={LINK}>{event.topic.title}</a> <span style="color:var(--muted);">in {event.topic.categoryName}</span></Fragment>
      )}
      {event.kind === 'reply_created' && (
        event.topic.isGovernance
          ? <Fragment>commented on <a href={href} style={LINK}>{event.topic.title}</a></Fragment>
          : <Fragment>replied in <a href={href} style={LINK}>{event.topic.title}</a></Fragment>
      )}
      {event.kind === 'gov_created' && (
        <Fragment>New governance action: <a href={href} style={LINK}>{event.topic.title}</a></Fragment>
      )}
      {event.kind === 'gov_status' && (
        <Fragment><a href={href} style={LINK}>{event.topic.title}</a> {govStatusVerb(event.statusTransition?.to ?? '')}</Fragment>
      )}
      {badge && (
        <span class={`act-badge${badgeOutline ? ' act-badge--outline' : ''}`} style={`--badge:${TONE_COLORS[badge.tone]};`}>{badge.label}</span>
      )}
    </span>
  </div>

  <span class="act-meta">
    <span class="act-time">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
      {formatRelativeTime(event.createdAt, now)}
    </span>
    {isComment && (
      <a class="act-ext" href={href} aria-label="Open thread">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
      </a>
    )}
  </span>
</div>
)}

<style>
  .act-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  /* System tile: neutral rounded square carrying the grey DRepTalk mark. */
  .act-tile {
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .act-body { flex: 1; min-width: 0; }
  .act-text { color: var(--fg); }
  .act-name { font-weight: 600; color: var(--fg); text-decoration: none; }
  .act-name:hover { text-decoration: underline; }
  /* Role badge (DREP etc.): outline pill in accent, matching AuthorIdentity. */
  .act-role {
    margin-left: 0.3rem;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.35rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  /* Status badge: filled for active, outline for terminal outcomes. */
  .act-badge {
    margin-left: 0.35rem;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--on-badge);
    background: var(--badge);
    border: 1px solid var(--badge);
    border-radius: 0.3rem;
    padding: 0.1rem 0.4rem;
    vertical-align: middle;
    white-space: nowrap;
  }
  .act-badge--outline { color: var(--badge); background: transparent; }
  /* Right meta: clock + time, optional external link. Never wraps. */
  .act-meta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    padding-top: 0.1rem;
  }
  .act-time { display: inline-flex; align-items: center; gap: 0.3rem; }
  .act-ext { color: var(--muted); display: inline-flex; }
  .act-ext:hover { color: var(--fg); }

  /* ---- discussions variant: title-first row, no role badges ---- */
  .act-row--wide { align-items: center; gap: 1rem; }
  .act-body2 { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .act-titlerow { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .act-type-icon { flex-shrink: 0; color: var(--muted); }
  .act-title2 { font-weight: 600; font-size: 0.9375rem; color: var(--fg); text-decoration: none; }
  .act-title2:hover { text-decoration: underline; }
  .act-meta2 { margin: 0; color: var(--muted); font-size: 0.8125rem; }
  /* Count of folded-away events on this thread in the collapsed feed. */
  .act-more { color: var(--accent); font-weight: 600; }
  .act-name2 { font-weight: 600; color: var(--fg); text-decoration: none; }
  .act-name2:hover { text-decoration: underline; }
  .act-dot { margin: 0 0.4rem; opacity: 0.6; }
  /* Right stat cluster: Replies / Participants, number over a muted label. Never wraps. */
  .act-stats { flex-shrink: 0; display: flex; align-items: center; gap: 1.5rem; }
  .act-stat { display: flex; flex-direction: column; align-items: center; gap: 0.1rem; min-width: 3rem; }
  .act-stat__num { font-size: 0.9375rem; font-weight: 700; color: var(--fg); line-height: 1.2; }
  .act-stat__label { font-size: 0.6875rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  /* Narrow screens: collapse the desktop stat blocks (and the meta-line time)
     into one compact inline meta line, mirroring the category topic rows. */
  .act-compact { display: none; }
  .act-compact-item { display: inline-flex; align-items: center; gap: 0.3rem; }
  @media (max-width: 40rem) {
    .act-row--wide { align-items: flex-start; }
    .act-stats { display: none; }
    .act-meta2-time { display: none; }
    .act-compact { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; font-size: 0.8125rem; color: var(--muted); }
  }
</style>
