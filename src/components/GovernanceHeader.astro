---
// Rich header for a governance-action thread: type, lifecycle status, proposer,
// deposit, epochs + countdown, power-weighted DRep/SPO/CC tally bars, and the
// rationale (full when short, clamped preview + expand when long). All values
// come from D1 (synced on a cron); they are
// shown with an explicit "as of" time and never claimed to be live.
import type { GovernanceAction } from '@/lib/db/governance.js';
import { governanceActionUrl, resolveNetwork, epochStartUnix, type CardanoNetwork } from '@/lib/config/network.js';
import {
  statusBadge,
  readableType,
  formatAda,
  epochCountdown,
  formatEpochDate,
  tallyBar,
  fmtPct,
  TONE_COLORS,
  type TallyBar as TallyData,
} from '@/lib/governance/view.js';
import { formatRelativeTime, truncateId } from '@/lib/forum/view.js';
import TallyBar from '@/components/TallyBar.astro';

interface Props {
  action: GovernanceAction;
  network: CardanoNetwork;
  now: number;
}

const { action, network, now } = Astro.props;

const badge = statusBadge(action.status);
const badgeColor = TONE_COLORS[badge.tone];

const deposit = formatAda(action.deposit);
const countdown = epochCountdown(action.expiryEpoch, action.tallyEpoch);
// Calendar date of the expiry epoch boundary, shown next to the epoch number.
const expiryDate = action.expiryEpoch != null ? formatEpochDate(epochStartUnix(action.expiryEpoch, resolveNetwork(network))) : null;
const asOf = action.tallySyncedAt ? formatRelativeTime(action.tallySyncedAt, now) : null;

// Long rationales get a clamped preview + CSS-only expand; short ones render in
// full (a "show more" toggle on a two-line rationale would be noise). Heuristic
// on the rendered text length, since CSS cannot measure height server-side.
const rationaleText = action.rationaleHtml ? action.rationaleHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() : '';
const isLongRationale = rationaleText.length > 500;

interface TallyEntry {
  label: string;
  bar: TallyData;
  yes: number | null;
  no: number | null;
  abstain: number | null;
}

// The three role tallies, built once. A role with no synced pct is dropped.
const tallies = [
  { label: 'DRep', bar: tallyBar(action.drepYesPct, action.drepNoPct), yes: action.drepYes, no: action.drepNo, abstain: action.drepAbstain },
  { label: 'SPO', bar: tallyBar(action.spoYesPct, action.spoNoPct), yes: action.spoYes, no: action.spoNo, abstain: action.spoAbstain },
  { label: 'CC', bar: tallyBar(action.ccYesPct, action.ccNoPct), yes: action.ccYes, no: action.ccNo, abstain: action.ccAbstain },
].filter((t): t is TallyEntry => t.bar !== null);
---

<section style="border:1px solid var(--border);border-radius:0.5rem;padding:1rem 1.25rem;margin-bottom:1.5rem;background:color-mix(in srgb, var(--accent) 3%, var(--surface));">
  <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;margin-bottom:0.625rem;">
    <span style="font-weight:600;">{readableType(action.type)}</span>
    <span style={`font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.03em;color:#fff;background:${badgeColor};border-radius:0.25rem;padding:0.15rem 0.45rem;`}>
      {badge.label}
    </span>
    {action.proposalId && (
      <a
        href={governanceActionUrl(network, action.proposalId)}
        rel="noopener noreferrer"
        target="_blank"
        style="font-size:0.8125rem;color:var(--accent);margin-left:auto;"
      >
        View in explorer
      </a>
    )}
  </div>

  <div style="font-size:0.8125rem;color:var(--muted);display:flex;flex-wrap:wrap;gap:0.5rem 1rem;margin-bottom:0.875rem;">
    {action.returnAddress && <span>Proposer: <code>{truncateId(action.returnAddress, 22)}</code></span>}
    {deposit && <span>Deposit: {deposit}</span>}
    {action.submittedEpoch != null && <span>Submitted: epoch {action.submittedEpoch}</span>}
    {action.expiryEpoch != null && <span>Expiry: epoch {action.expiryEpoch}{expiryDate && <> ({expiryDate})</>}</span>}
    {countdown && <span>{countdown}</span>}
  </div>

  {tallies.length > 0 ? (
    <div style="display:flex;flex-direction:column;gap:0.5rem;">
      {tallies.map((t) => (
        <div>
          <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:0.2rem;">
            <span style="font-weight:600;color:var(--fg);">{t.label}</span>
            <span>
              {fmtPct(t.bar.yes)} yes &middot; {fmtPct(t.bar.no)} no
              {(t.yes != null || t.no != null || t.abstain != null) && (
                <span> ({t.yes ?? 0}/{t.no ?? 0}/{t.abstain ?? 0})</span>
              )}
            </span>
          </div>
          <TallyBar bar={t.bar} height={8} />
        </div>
      ))}
      {asOf && (
        <p style="margin:0.25rem 0 0;font-size:0.6875rem;color:var(--muted);">
          Tallies as of {asOf}. Cached, not live.
        </p>
      )}
    </div>
  ) : (
    <p style="margin:0;font-size:0.8125rem;color:var(--muted);">Tallies not yet synced.</p>
  )}

  {action.rationaleHtml && (
    <div class="ga-rationale">
      <div class="ga-rationale__label">Motivation &amp; rationale</div>
      {isLongRationale ? (
        <>
          <input type="checkbox" id="ga-rationale-more" class="ga-rationale__cb" aria-hidden="true" tabindex="-1" />
          <div class="prose ga-rationale__body" set:html={action.rationaleHtml} />
          <label for="ga-rationale-more" class="ga-rationale__toggle"></label>
        </>
      ) : (
        <div class="prose" style="font-size:0.9375rem;" set:html={action.rationaleHtml} />
      )}
    </div>
  )}
</section>

<style>
.ga-rationale { margin-top: 0.875rem; }
.ga-rationale__label { font-size: 0.8125rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.4rem; }
.ga-rationale__cb { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.ga-rationale__body { font-size: 0.9375rem; max-height: 9em; overflow: hidden; -webkit-mask-image: linear-gradient(#000 65%, transparent); mask-image: linear-gradient(#000 65%, transparent); }
.ga-rationale__cb:checked ~ .ga-rationale__body { max-height: none; -webkit-mask-image: none; mask-image: none; }
.ga-rationale__toggle { display: inline-block; margin-top: 0.4rem; color: var(--accent); cursor: pointer; font-size: 0.8125rem; font-weight: 600; }
.ga-rationale__toggle::after { content: 'Show full rationale'; }
.ga-rationale__cb:checked ~ .ga-rationale__toggle::after { content: 'Show less'; }
.ga-rationale__cb:focus-visible ~ .ga-rationale__toggle { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
</style>
