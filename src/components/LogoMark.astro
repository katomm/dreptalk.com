---
// The DRepTalk burst mark as inline SVG so it inherits `currentColor` (an
// external <img> cannot). This is the canonical mark (eight nodes, spokes,
// outer dot ring, center), matching public/logo.svg. Used where the mark sits
// next to the "DRepTalk" wordmark (header, footer) painted in --muted, leaving
// the "Talk" gradient as the only accent, and on the brand gradient card
// painted white. The large brand cards and downloads keep the full-color
// gradient logo.svg. The tab favicon (public/favicon.svg + favicon.png) is a
// deliberately simplified variant without the outer ring, which reads better at
// 16-32px.
//
// Size and color come in as an inline `style` because Astro scoped styles do
// not reach a child component's root element.
//
// `label` controls the accessible name. Next to the visible "DRepTalk" wordmark
// (header, footer) the mark is decorative, so leave it unset: the SVG is hidden
// from assistive tech, avoiding a duplicate name that would otherwise read as
// "DRepTalk DRepTalk" and mismatch the link's own label. Standing alone (the
// brand card) pass a label so it is announced like a labelled image.
//
// `hat` puts a Santa hat on the top node for the holiday season (see
// lib/brand/season.ts). It is drawn in fixed colors, not currentColor, and
// reaches above the viewBox, so the SVG lets it overflow.
interface Props {
  style?: string;
  label?: string;
  hat?: boolean;
}
const { style, label, hat = false } = Astro.props;
---
<svg
  style={style}
  viewBox="0 0 72 72"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  fill="currentColor"
>
  <g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
    <line x1="36" y1="27.5" x2="36" y2="19.5" />
    <line x1="42" y1="30" x2="47.7" y2="24.3" />
    <line x1="44.5" y1="36" x2="52.5" y2="36" />
    <line x1="42" y1="42" x2="47.7" y2="47.7" />
    <line x1="36" y1="44.5" x2="36" y2="52.5" />
    <line x1="30" y1="42" x2="24.3" y2="47.7" />
    <line x1="27.5" y1="36" x2="19.5" y2="36" />
    <line x1="30" y1="30" x2="24.3" y2="24.3" />
  </g>
  <circle cx="36" cy="15" r="4" />
  <circle cx="50.85" cy="21.15" r="4" />
  <circle cx="57" cy="36" r="4" />
  <circle cx="50.85" cy="50.85" r="4" />
  <circle cx="36" cy="57" r="4" />
  <circle cx="21.15" cy="50.85" r="4" />
  <circle cx="15" cy="36" r="4" />
  <circle cx="21.15" cy="21.15" r="4" />
  <circle cx="47.1" cy="9.2" r="2" />
  <circle cx="62.8" cy="24.9" r="2" />
  <circle cx="62.8" cy="47.1" r="2" />
  <circle cx="47.1" cy="62.8" r="2" />
  <circle cx="24.9" cy="62.8" r="2" />
  <circle cx="9.2" cy="47.1" r="2" />
  <circle cx="9.2" cy="24.9" r="2" />
  <circle cx="24.9" cy="9.2" r="2" />
  <circle cx="36" cy="36" r="7" />
  {hat && (
    <g transform="translate(72 0) scale(-1 1)">
      <g transform="rotate(10 36 22)">
        <path d="M13 22 Q18 -6 42 -12 Q61 -16 68 0 Q59 -7 52 -3 Q57 8 59 22 Z" fill="#dc2626" />
        <path d="M52 -3 Q57 8 59 22 L51 22 Q51 8 47 -1 Q49 -3 52 -3 Z" fill="#b91c1c" />
        <path class="trim" d="M72.2 1 Q73.4 3.3 71 4.3 Q70.4 6.9 67.9 6.1 Q65.8 7.7 64.4 5.5 Q61.8 5.4 62.1 2.8 Q60.2 1 62.1 -0.8 Q61.8 -3.4 64.4 -3.5 Q65.8 -5.7 67.9 -4.1 Q70.4 -4.9 71 -2.3 Q73.4 -1.3 72.2 1 Z" />
        <path class="trim" d="M14 18 Q16.8 16.4 19.5 18 Q22.2 16.4 25 18 Q27.8 16.4 30.5 18 Q33.2 16.4 36 18 Q38.8 16.4 41.5 18 Q44.2 16.4 47 18 Q49.8 16.4 52.5 18 Q55.2 16.4 58 18 A5 5 0 0 1 58 28 Q55.2 29.6 52.5 28 Q49.8 29.6 47 28 Q44.2 29.6 41.5 28 Q38.8 29.6 36 28 Q33.2 29.6 30.5 28 Q27.8 29.6 25 28 Q22.2 29.6 19.5 28 Q16.8 29.6 14 28 A5 5 0 0 1 14 18 Z" />
      </g>
    </g>
  )}
</svg>

<style>
  svg {
    display: block;
    overflow: visible;
  }
  /* White fur trim. On the light theme a white shape vanishes into the white
     header, so it gets a visible outline there. */
  .trim {
    fill: #fff;
    stroke: #a9a4bb;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  :global(html[data-theme='dark']) .trim {
    stroke: none;
  }
</style>
