---
// Per-post action row: reactions (counts visible to everyone), reply, share,
// and the community flag. Shared by every thread view so the action row cannot
// drift between governance and non-governance markup.
//
// Hydration is gated on canReact: a viewer who cannot react (anonymous,
// non-writer, own post) gets the same buttons as static server-rendered HTML
// with zero client JS; only viewers who can actually toggle pay for an island.
// Reply and Share are plain server-rendered buttons handled by the thread's
// one delegated script (see ThreadPosts.astro), not islands.
import ReactionButtons from '@/components/ReactionButtons.tsx';
import FlagButton from '@/components/FlagButton.tsx';
import type { Post } from '@/lib/db/forum.js';
import type { Reaction } from '@/lib/db/postReactions.js';

interface Props {
  post: Post;
  canReact: boolean;
  canFlag: boolean;
  /** Drives the disabled hint: own posts read differently than "sign in". */
  isOwnPost: boolean;
  /** Whether the viewer has flagged this post. */
  flagged: boolean;
  /** The viewer's current reaction, or null. */
  viewerReaction: Reaction | null;
  /** Whether the viewer may reply (signed in, topic not locked). */
  canReply?: boolean;
  /** Author display name, echoed in the composer's "Replying to" chip. */
  authorName?: string;
}

const { post, canReact, canFlag, isOwnPost, flagged, viewerReaction, canReply = false, authorName = '' } = Astro.props;
const disabledReason = isOwnPost ? 'You cannot react to your own posts' : undefined;
---

<div style="margin-top:0.75rem;display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
  {canReact ? (
    <ReactionButtons
      client:visible
      postId={post.id}
      initialUpCount={post.up_count}
      initialDownCount={post.down_count}
      initialReaction={viewerReaction}
      canReact={true}
    />
  ) : (
    <ReactionButtons
      postId={post.id}
      initialUpCount={post.up_count}
      initialDownCount={post.down_count}
      initialReaction={null}
      canReact={false}
      disabledReason={disabledReason}
    />
  )}
  {canReply && (
    <button
      type="button"
      class="post-action"
      data-reply-to={post.id}
      data-reply-author={authorName}
      title="Reply to this post"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
      <span>Reply</span>
    </button>
  )}
  <button
    type="button"
    class="post-action"
    data-share-post={post.id}
    title="Copy a link to this post"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
    </svg>
    <span data-share-label>Share</span>
  </button>
  {canFlag && (
    <FlagButton
      client:visible
      postId={post.id}
      initialFlagged={flagged}
      initialCount={post.flag_count}
      initialHidden={post.hidden}
    />
  )}
</div>

<style>
  .post-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .post-action:hover {
    color: var(--fg);
  }
</style>
