---
import {
  statusBadge,
  epochDaysLeft,
  fmtPctFine,
  overviewTally,
  overviewRowVoting,
  formatEpochDate,
} from '@/lib/governance/view.js';
import CompositionBar from '@/components/ga/CompositionBar.astro';
import GovTypePill from '@/components/GovTypePill.astro';
import { resolveNetwork, epochStartUnix, type CardanoNetwork } from '@/lib/config/network.js';
import { decodeOnchainChanges, summarizeOnchain, parameterChangeScope } from '@/lib/governance/onchain.js';
import { evaluateThresholds, hasOnchainThreshold, type Body } from '@/lib/governance/thresholds.js';
import { identiconSvg } from '@/lib/identity/identicon.js';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { proposerView } from '@/lib/identity/proposer.js';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { ProtocolParams } from '@/lib/db/protocolParams.js';
import type { Topic } from '@/lib/db/forum.js';

interface Props {
  topic: Topic;
  action: GovernanceAction;
  drepStakeTotal: number | null;  // total active DRep voting power, for DRep turnout
  committeeSize: number | null;   // current CC seat count, for CC turnout
  params: ProtocolParams | null;  // protocol params, for each row's threshold marker
  network: CardanoNetwork;
  now: number;             // render instant, for the wall-clock voting countdown
  href: string;
  epochParamsJson?: string | null; // current protocol params, for the param old→new summary
  // Presentation-ready viewer-vote badge (vote dashboard only); the caller owns
  // the label/color so this shared row stays ignorant of DRep vote states.
  voteBadge?: { label: string; color: string | null };
  closingSoon?: boolean;   // adds the "Closing soon" chip (vote dashboard only)
  // Opaque extra attributes spread onto the row anchor, e.g. the /vote client
  // filter's data-* schema. The row never interprets them.
  rowAttrs?: Record<string, string | undefined>;
  // Layout variant. 'overview' (default) is the four-column governance table.
  // 'dashboard' drops the Activity and Time Left columns (reserving that space
  // for future dashboard controls) and folds the time-left into the meta line.
  variant?: 'overview' | 'dashboard';
}
const {
  topic,
  action,
  drepStakeTotal,
  committeeSize,
  params,
  network,
  now,
  href,
  epochParamsJson,
  voteBadge,
  closingSoon,
  rowAttrs = {},
  variant = 'overview',
} = Astro.props;
const isDashboard = variant === 'dashboard';
// Resolve the proposer from the action's reward address: a known org name+logo,
// else a truncated address. Derived here so callers just pass the action.
const pv = proposerView(action.returnAddress);
const proposer = pv.kind === 'known' ? pv.name : pv.kind === 'unknown' ? pv.short : undefined;
const proposerIcon = pv.kind === 'known' ? (pv.icon ?? undefined) : undefined;
// No bundled logo: fall back to the identicon, seeded by the reward address
// (decodes stake1... natively), so the list mirrors the detail page rather than
// showing a bare name. Skipped when there is no address (renders as "Unknown").
const proposerIdenticon =
  !proposerIcon && action.returnAddress ? identiconSvg(action.returnAddress, AVATAR_SIZE.card) : null;
const badge = statusBadge(action.status);
// One-line on-chain summary in a fixed spot, so the substance of each action reads
// the same on every row regardless of how the proposer wrote the title. Treasury
// shows the requested total, a param change shows old→new, etc. Null types (info
// actions) and rows without a stored payload simply omit the line.
const onchain = summarizeOnchain(
  decodeOnchainChanges(action.onchainPayload ?? null, epochParamsJson ?? null, network),
);
// Sentiment + voter count follow the action's leading role (SPO for hard fork,
// no-confidence, committee; else DRep). The label is shown so the bar is never
// ambiguous about whose votes it represents.
const tally = overviewTally(action);
const votedLabel = tally?.role === 'SPO' ? 'SPOs' : 'DReps';
const votedCount = tally?.voted ?? 0;
const comments = Math.max(0, topic.post_count - 1); // exclude the system first post
// Decoded once: for a ParameterChange, whether the payload touches a security-relevant
// parameter (constitution PARAM-03a), which makes SPOs eligible from the start of
// voting (see overviewRowVoting's paramScope param). parameterChangeScope returns null
// for any non-ParameterChange payload, so the flag stays false for other types.
const paramScope = parameterChangeScope(action.onchainPayload ?? null);
const paramTouchesSecurity = paramScope?.touchesSecurity ?? false;
// Per-body honest composition, the single voting column this row renders.
const voting = overviewRowVoting(action, { drepStakeTotal, committeeSize }, { paramTouchesSecurity });
// Ratification threshold per body, so each threshold-type row can place the same
// marker the detail card shows. Null map for Info actions (no threshold) or before
// params sync; looked up per body when drawing the bar.
const thresholds =
  hasOnchainThreshold(action.type) && params
    ? evaluateThresholds(
        {
          type: action.type,
          drepYesPct: action.drepYesPct,
          spoYesPct: action.spoYesPct,
          ccYesPct: action.ccYesPct,
          paramScope,
        },
        params,
      )
    : null;
const thresholdFor = (body: Body): number | null =>
  thresholds?.find((t) => t.body === body)?.thresholdPct ?? null;
// Calendar boundary of the expiry epoch (when voting closes). Both the countdown
// and the "Voting ends" date derive from this same instant, so they stay in step.
const expiryUnix =
  action.expiryEpoch != null ? epochStartUnix(action.expiryEpoch, resolveNetwork(network)) : null;
const daysLeft = epochDaysLeft(expiryUnix != null ? expiryUnix * 1000 : null, action.status, now);
// Only shown while voting is still open; once past, the status badge carries the outcome.
const votingEnds = daysLeft != null && expiryUnix != null ? formatEpochDate(expiryUnix) : null;
// Proposer sub-line parts: the epoch always when known, the countdown only on the
// dashboard variant (which drops the Time Left column). Named once so the markup
// does not re-test them three times.
const showEpoch = action.submittedEpoch != null;
const showDaysLeft = isDashboard && daysLeft != null;
// Dashboard rows can carry interactive controls (the multi-vote choice pills)
// in the reserved right column. Buttons must not nest inside an anchor, so a
// row WITH controls renders a <div> root and moves the thread link onto the
// title, stretched over the card via ::after; the controls column sits above
// that overlay. Rows without controls keep the plain full-row anchor.
const hasControls = isDashboard && Astro.slots.has('controls');
const Root = hasControls ? 'div' : 'a';
---
<Root
  class:list={['garow', { 'garow--dashboard': isDashboard, 'garow--controls': hasControls }]}
  href={hasControls ? undefined : href}
  {...rowAttrs}
>
  <div class="garow__main">
    <span class="garow__tags">
      <GovTypePill type={action.type} />
      <span class={`badge badge--${badge.tone}`}>{badge.label}</span>
      {voteBadge && (
        voteBadge.color
          ? <span class="badge badge--vote" style={`color:${voteBadge.color}`}>{voteBadge.label}</span>
          : <span class="badge badge--neutral">{voteBadge.label}</span>
      )}
      {closingSoon && <span class="badge badge--soon">Closing soon</span>}
    </span>
    <p class="garow__title">
      {hasControls ? (
        <a class="garow__link" href={href}>{action.title ?? topic.title}</a>
      ) : (
        action.title ?? topic.title
      )}
    </p>
    {onchain && (
      <p class={`garow__onchain garow__onchain--${onchain.tone}`}>
        {onchain.prefix && <span class="garow__oc-prefix">{onchain.prefix}</span>}
        {onchain.oldValue && (
          <>
            <span class="garow__oc-old">{onchain.oldValue}</span>
            <span class="garow__oc-arrow">&rarr;</span>
          </>
        )}
        <span class="garow__oc-val">{onchain.value}</span>
      </p>
    )}
    {/* Abstract only when there is no structured on-chain line. For actions with an
        on-chain effect that line already carries the substance (money, params), so the
        abstract would just repeat below it. Info actions (and the rare action without a
        usable payload) have no on-chain line, so the abstract becomes the preview, with
        room for two lines. */}
    {!onchain && action.abstract && <p class="garow__desc">{action.abstract}</p>}
    <div class="garow__meta">
      {(proposerIcon || proposerIdenticon) && (
        <span class="garow__proavatar" style={`--proavatar:${AVATAR_SIZE.card}px`}>
          {proposerIcon
            ? <img src={proposerIcon} alt="" width={AVATAR_SIZE.card} height={AVATAR_SIZE.card} loading="lazy" />
            : <span class="garow__proicon" set:html={proposerIdenticon} />}
        </span>
      )}
      <span class="garow__prostack">
        <span class="garow__proname">{proposer ?? 'Unknown'}</span>
        {(showEpoch || showDaysLeft) && (
          <span class="garow__prosub">
            {showEpoch && <>Epoch {action.submittedEpoch}</>}
            {showDaysLeft && (
              <>{showEpoch && ' · '}<span class="garow__accent">~{daysLeft} {daysLeft === 1 ? 'day' : 'days'} left</span></>
            )}
          </span>
        )}
      </span>
    </div>
  </div>

  <!-- Voting: one merged row per eligible body. The composition bar carries BOTH
       facts at once, how full it is = turnout (Yes + No), the empty remainder = not
       voted, and the green/red split within = sentiment. The percentage is the Yes
       share of eligible power (ratification), so a low-turnout action reads honestly
       (a near-empty bar), never as a false "100% yes". Raw amounts and threshold
       context live on the detail page's Voting Information card. -->
  <div class="garow__voting">
    {voting.bodies.map((b) => (
      <div class="vrow">
        <span class="vrow__label">{b.label}</span>
        {b.composition ? (
          <>
            <div class="vrow__bar"><CompositionBar bar={b.composition} height={8} thresholdPct={thresholdFor(b.body)} compactMarker /></div>
            <span class="vrow__pct">{fmtPctFine(b.composition.yes)}</span>
          </>
        ) : (
          <span class="vrow__dash">no votes</span>
        )}
      </div>
    ))}
  </div>

  <!-- Two activity stats. They stack on the desktop grid; on mobile they sit side
       by side as the footer's left/right halves (the time block takes its own row). -->
  <div class="garow__activity">
    <span class="garow__stat">
      <span class="garow__actline">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="garow__strong">{votedCount} {votedLabel}</span>
      </span>
      <span class="garow__sub garow__actcap">participating</span>
    </span>
    <span class="garow__stat">
      <span class="garow__actline">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span class="garow__sub">{comments} comments</span>
      </span>
    </span>
  </div>

  <div class="garow__time">
    <div class="garow__timebody">
      {daysLeft != null ? (
        <>
          <span class="garow__timehead">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="garow__strong garow__accent">~{daysLeft} {daysLeft === 1 ? 'day' : 'days'} left</span>
          </span>
          {votingEnds && <span class="garow__sub">Voting ends {votingEnds}</span>}
          {action.expiryEpoch != null && <span class="garow__sub">(Epoch {action.expiryEpoch})</span>}
        </>
      ) : <span class="garow__sub">{badge.label}</span>}
    </div>
  </div>

  {/* Dashboard variant: the freed right column holds the caller's vote controls
      when provided (real buttons, sitting above the stretched title link), else
      a Vote call-to-action. The CTA is a styled affordance, not a nested anchor:
      in that case the whole row is the link. */}
  {isDashboard && (
    hasControls ? (
      <div class="garow__vote garow__vote--controls">
        <slot name="controls" />
      </div>
    ) : (
      <div class="garow__vote">
        <span class="garow__votebtn">Vote</span>
      </div>
    )
  )}
</Root>

<style>
  /* Four columns on wide screens: action, voting, activity, time. The header grid in
     c/[slug].astro mirrors this at every breakpoint. */
  .garow { display:grid; grid-template-columns:2.7fr 1.6fr 0.9fr 1.2fr; gap:18px; align-items:start;
    padding:16px 18px; border-bottom:1px solid var(--border); text-decoration:none; color:var(--fg); }
  .garow:hover { background:var(--surface); }
  /* Dashboard variant (/vote): drop the Activity and Time Left columns and end on a
     fixed-width Vote CTA. Action and voting absorb the freed space (they grow past
     their overview widths); the fixed last track keeps the button aligned and lets
     the .ga-list__head--dashboard header line up over the same columns. */
  .garow--dashboard { grid-template-columns:2.7fr 1.6fr 112px; }
  .garow--dashboard .garow__activity,
  .garow--dashboard .garow__time { display:none; }
  /* Dashboard rows: the main cell drives the row height, so the two right-hand
     cells (voting bars, vote controls) both center vertically. Top-hanging bars
     next to centered controls read restless. The overview keeps top alignment
     (its four columns are all top-anchored). */
  .garow--dashboard .garow__voting { align-self:center; }
  .garow__vote { align-self:center; }
  /* Controls variant: the root is a <div>, the thread link lives on the title and
     stretches over the whole card via ::after; the controls column stacks above
     that overlay so its buttons stay clickable. */
  .garow--controls { position:relative; }
  .garow__link { color:inherit; text-decoration:none; }
  /* z-index 1 lifts the overlay above positioned descendants of the row (the
     composition-bar segments), so a click on the bars still navigates. */
  .garow__link::after { content:''; position:absolute; inset:0; z-index:1; }
  .garow__vote--controls { position:relative; z-index:2; }
  .garow__votebtn {
    display:flex; align-items:center; justify-content:center; width:100%;
    padding:0.45rem 0.6rem; border-radius:999px;
    background:var(--accent); color:var(--accent-fg);
    font-size:0.8125rem; font-weight:600; white-space:nowrap;
  }
  .garow:hover .garow__votebtn { background:color-mix(in srgb, var(--accent) 88%, #000); }
  /* Let the cell shrink below its content width so the abstract truncates with an
     ellipsis instead of stretching the row into one endless line. */
  .garow__main { min-width:0; }
  /* Type pill and status badge sit on one line above the title. */
  .garow__tags { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:0 0 6px; }
  .garow__title { font-weight:700; font-size:0.95rem; margin:0 0 3px; }
  /* On-chain summary: a fixed line under the title so each action's substance sits
     in the same place on every row. Wraps on narrow widths rather than overflowing. */
  .garow__onchain { font-size:0.85rem; margin:0 0 5px; min-width:0;
    display:flex; flex-wrap:wrap; align-items:baseline; gap:5px; }
  .garow__oc-prefix { color:var(--muted); }
  .garow__oc-old { color:var(--muted); text-decoration:line-through; }
  .garow__oc-arrow { color:var(--muted); }
  .garow__oc-val { font-weight:600; color:var(--fg); }
  /* Treasury headline figure: accent + small uppercase label, since a bare number
     would be ambiguous. */
  .garow__onchain--amount .garow__oc-prefix { font-size:0.65rem; font-weight:600;
    text-transform:uppercase; letter-spacing:0.04em; }
  .garow__onchain--amount .garow__oc-val { color:var(--accent); font-weight:700; }
  /* old→new pair (single param, protocol version): label gets a trailing colon. */
  .garow__onchain--change .garow__oc-prefix::after { content:':'; }
  /* Two-line preview (only shown when there is no on-chain line, i.e. info actions):
     clamp to two lines so a long abstract gets more room than the old single line
     without pushing the row taller than the metric columns. */
  .garow__desc { color:var(--muted); font-size:0.8rem; margin:0 0 6px;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  /* Proposer identity: a round avatar (org logo or identicon) beside a two-line
     block, name over epoch/countdown. Gives the identicon real presence instead
     of a tiny inline mark. */
  .garow__meta { display:flex; align-items:center; gap:9px; margin:0; min-width:0; }
  /* Size comes from AVATAR_SIZE.card via the inline --proavatar var. */
  .garow__proavatar { width:var(--proavatar); height:var(--proavatar); flex:none;
    border-radius:999px; overflow:hidden; background:var(--avatar-ground); }
  .garow__proavatar img { width:100%; height:100%; object-fit:cover; display:block; }
  .garow__proicon { display:block; width:100%; height:100%; }
  .garow__proicon :global(svg) { width:100%; height:100%; display:block; }
  .garow__prostack { display:flex; flex-direction:column; min-width:0; line-height:1.3; }
  .garow__proname { font-size:0.8rem; color:var(--fg); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .garow__prosub { font-size:0.72rem; color:var(--muted); }

  /* Voting cell: a compact label + composition bar + Yes-of-eligible percentage per
     eligible body (DRep/SPO/CC), stacked vertically. The single bar shows turnout
     (how full) and sentiment (green/red split) at once. */
  .garow__voting { min-width:0; display:flex; flex-direction:column; gap:7px; }
  .vrow { display:flex; align-items:center; gap:7px; min-width:0; }
  .vrow__label { flex:0 0 auto; width:3.4em; color:var(--muted); font-size:0.72rem;
    font-weight:600; white-space:nowrap; }
  .vrow__bar { flex:1 1 auto; min-width:0; }
  .vrow__pct { flex:0 0 auto; width:3.4em; text-align:right; font-weight:600; font-size:0.78rem; }
  .vrow__dash { flex:1 1 auto; color:var(--muted); font-size:0.75rem; }

  .garow__activity { display:flex; flex-direction:column; gap:3px; }
  .garow__stat { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .garow__actline { display:inline-flex; align-items:center; gap:6px; }
  .garow__actline svg { color:var(--muted); }
  .garow__actcap { margin-left:20px; }
  .garow__strong { font-weight:600; font-size:0.85rem; }
  .garow__sub { color:var(--muted); font-size:0.75rem; }

  .garow__time { display:flex; align-items:center; gap:8px; }
  .garow__timebody { display:flex; flex-direction:column; gap:2px; min-width:0; }
  .garow__timehead { display:inline-flex; align-items:center; gap:6px; }
  .garow__timehead svg { color:var(--accent); }
  .garow__accent { color:var(--accent); }

  .badge { font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; padding:2px 7px; border-radius:999px; }
  .badge--active { background:color-mix(in srgb, var(--accent) 14%, transparent); color:var(--accent); }
  .badge--positive { background:color-mix(in srgb, var(--c-pos) 14%, transparent); color:var(--c-pos); }
  .badge--neutral { background:var(--surface-2); color:var(--muted); }
  .badge--negative { background:color-mix(in srgb, var(--c-neg) 14%, transparent); color:var(--c-neg); }
  /* Viewer's own vote (vote dashboard): outlined in the vote-tone color so it
     stands apart from the filled status badge next to it. */
  .badge--vote { background:transparent; border:1px solid currentColor; }
  /* Closing-soon marker: accent outline, distinct from the filled ACTIVE badge. */
  .badge--soon { background:transparent; color:var(--accent); border:1px solid var(--accent); }

  /* The /vote client filter toggles [hidden] on rows; the base .garow is
     display:grid, which outranks the UA [hidden] rule, so re-assert none. */
  .garow[hidden] { display:none; }

  /* Below the wide breakpoint the four columns tighten but stay a table row (the
     merge to one voting column already freed the width the old 5-column layout
     needed to reflow here). Header grid in c/[slug].astro mirrors these widths. */
  @media (max-width:1000px) {
    .garow { grid-template-columns:2.4fr 1.6fr 0.8fr 1.1fr; }
    /* Mirror the tightened action/voting widths; keep the fixed Vote-button track. */
    .garow--dashboard { grid-template-columns:2.4fr 1.6fr 112px; }
  }
  /* Mobile: each row becomes a self-contained rounded card. The voting cell keeps
     its per-body composition list full width, above a two-column footer
     (comments | time). The list drops its table separators (in c/[slug].astro). */
  @media (max-width:720px) {
    .garow {
      position:relative;
      min-width:0; /* a flex child of .ga-list; let the card shrink to the viewport */
      grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);
      gap:12px 0;
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px;
    }
    .garow__main { grid-column:1 / -1; min-width:0; }
    .garow__voting { grid-column:1 / -1; min-width:0; }
    /* Drop the proposer/epoch line on mobile: mostly a truncated stake address
       on a small screen; the proposer stays on the detail page. */
    .garow__meta { display:none; }
    /* The dashboard card has no footer, so keep its meta line: it carries the
       time-left the dropped Time Left column would otherwise show. */
    .garow--dashboard .garow__meta { display:flex; }
    /* Vote CTA spans the card full width at the bottom. */
    .garow--dashboard .garow__vote { grid-column:1 / -1; }
    .garow--dashboard .garow__votebtn { padding:0.6rem; }
    /* Activity holds the first footer column; the time block is the second. */
    .garow__activity { grid-column:1 / 2; flex-direction:row; gap:0; min-width:0; }
    .garow__stat { flex:1 1 0; padding:0 6px; align-items:center; text-align:center; }
    .garow__stat:first-child { padding-left:0; }
    .garow__stat + .garow__stat { border-left:1px solid var(--border); }
    .garow__time { grid-column:2 / 3; min-width:0; justify-content:center; padding-left:6px;
      border-left:1px solid var(--border); }
    .garow__timebody { align-items:center; text-align:center; min-width:0; }
    .garow__actcap { margin-left:0; }
    /* Stack each footer item: chip on top, text centered below. */
    .garow__activity .garow__actline,
    .garow__timehead { flex-direction:column; gap:5px; }
    .garow__strong { font-size:0.8rem; }
    .garow__sub { font-size:0.72rem; }
    /* Footer icons read as soft accent chips. */
    .garow__actline svg,
    .garow__timehead svg {
      box-sizing:content-box;
      padding:5px;
      border-radius:8px;
      background:color-mix(in srgb, var(--accent) 12%, transparent);
      color:var(--accent);
    }
  }
</style>
