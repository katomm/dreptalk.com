---
import {
  statusBadge,
  epochDaysLeft,
  fmtPct,
  overviewTally,
  sentimentSubline,
  readableType,
  formatEpochDate,
  govTypeTone,
} from '@/lib/governance/view.js';
import { resolveNetwork, epochStartUnix, type CardanoNetwork } from '@/lib/config/network.js';
import { decodeOnchainChanges, summarizeOnchain } from '@/lib/governance/onchain.js';
import { identiconSvg } from '@/lib/identity/identicon.js';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { Topic } from '@/lib/db/forum.js';
import type { StakeParticipation } from '@/lib/governance/view.js';
import TallyBar from './TallyBar.astro';

interface Props {
  topic: Topic;
  action: GovernanceAction;
  proposer?: string;       // resolved display name or truncated address
  proposerIcon?: string;   // bundled logo path for a known proposer
  stake: StakeParticipation | null;
  network: CardanoNetwork;
  now: number;             // render instant, for the wall-clock voting countdown
  href: string;
  epochParamsJson?: string | null; // current protocol params, for the param old→new summary
}
const { topic, action, proposer, proposerIcon, stake, network, now, href, epochParamsJson } = Astro.props;
// No bundled logo: fall back to the cardenticon, seeded by the reward address
// (decodes stake1... natively), so the list mirrors the detail page rather than
// showing a bare name. Skipped when there is no address (renders as "Unknown").
const proposerIdenticon =
  !proposerIcon && action.returnAddress ? identiconSvg(action.returnAddress, 14) : null;
const badge = statusBadge(action.status);
const typeTone = govTypeTone(action.type);
// One-line on-chain summary in a fixed spot, so the substance of each action reads
// the same on every row regardless of how the proposer wrote the title. Treasury
// shows the requested total, a param change shows old→new, etc. Null types (info
// actions) and rows without a stored payload simply omit the line.
const onchain = summarizeOnchain(
  decodeOnchainChanges(action.onchainPayload ?? null, epochParamsJson ?? null, network),
);
// Sentiment + voter count follow the action's leading role (SPO for hard fork,
// no-confidence, committee; else DRep). The label is shown so the bar is never
// ambiguous about whose votes it represents.
const tally = overviewTally(action);
const votedLabel = tally?.role === 'SPO' ? 'SPOs' : 'DReps';
const votedCount = tally?.voted ?? 0;
const comments = Math.max(0, topic.post_count - 1); // exclude the system first post
// Calendar boundary of the expiry epoch (when voting closes). Both the countdown
// and the "Voting ends" date derive from this same instant, so they stay in step.
const expiryUnix =
  action.expiryEpoch != null ? epochStartUnix(action.expiryEpoch, resolveNetwork(network)) : null;
const daysLeft = epochDaysLeft(expiryUnix != null ? expiryUnix * 1000 : null, action.status, now);
// Only shown while voting is still open; once past, the status badge carries the outcome.
const votingEnds = daysLeft != null && expiryUnix != null ? formatEpochDate(expiryUnix) : null;
---
<a class="garow" href={href}>
  <div class="garow__main">
    <span class="garow__tags">
      <span class="pill" style={`--ph:var(--gov-${typeTone})`}>{readableType(action.type)}</span>
      <span class={`badge badge--${badge.tone}`}>{badge.label}</span>
    </span>
    <p class="garow__title">{action.title ?? topic.title}</p>
    {onchain && (
      <p class={`garow__onchain garow__onchain--${onchain.tone}`}>
        {onchain.prefix && <span class="garow__oc-prefix">{onchain.prefix}</span>}
        {onchain.oldValue && (
          <>
            <span class="garow__oc-old">{onchain.oldValue}</span>
            <span class="garow__oc-arrow">&rarr;</span>
          </>
        )}
        <span class="garow__oc-val">{onchain.value}</span>
      </p>
    )}
    {/* Abstract only when there is no structured on-chain line. For actions with an
        on-chain effect that line already carries the substance (money, params), so the
        abstract would just repeat below it. Info actions (and the rare action without a
        usable payload) have no on-chain line, so the abstract becomes the preview, with
        room for two lines. */}
    {!onchain && action.abstract && <p class="garow__desc">{action.abstract}</p>}
    <p class="garow__meta">
      {proposerIcon
        ? <img class="garow__pico" src={proposerIcon} alt="" width="14" height="14" loading="lazy" />
        : proposerIdenticon && <span class="garow__pico garow__pico--ident" set:html={proposerIdenticon} />}
      {proposer ?? 'Unknown'}{action.submittedEpoch != null && <> &middot; Epoch {action.submittedEpoch}</>}
    </p>
  </div>

  <!-- Stake participation. On wide screens it sits beside sentiment; below the
       layout breakpoint only the metric chosen by the page toggle is shown. -->
  <div class="metric garow__metric--stake">
    {stake ? (
      <>
        <span class="metric__pct">{fmtPct(stake.pct)}</span>
        <span class="metric__sub">{stake.votedLabel} of {stake.totalLabel}</span>
        <span class="metric__cap">voting stake represented</span>
        <div class="track" aria-hidden="true"><span class="fill" style={`width:${stake.pct}%;background:var(--accent)`}></span></div>
      </>
    ) : <span class="metric__sub">-</span>}
  </div>

  <!-- Sentiment for the action's leading voter role, led by the share in support. -->
  <div class="metric garow__metric--sentiment">
    {tally ? (
      <>
        <span class="metric__pct">{fmtPct(tally.bar.yes)} <span class="metric__pctword">{tally.role} support</span></span>
        <span class="metric__sub">{sentimentSubline(tally)}</span>
        {/* The sentiment bar's pastel palette lives in TallyBar (TONE_BAR_COLORS); do not inline colors here without it. */}
        <TallyBar bar={tally.bar} height={7} pendingNo={tally.noIsPending} />
      </>
    ) : <span class="metric__sub">-</span>}
  </div>

  <!-- Two activity stats. They stack on the desktop grid; on mobile they sit side
       by side as the footer's left/right halves (the time block takes its own row). -->
  <div class="garow__activity">
    <span class="garow__stat">
      <span class="garow__actline">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="garow__strong">{votedCount} {votedLabel}</span>
      </span>
      <span class="garow__sub garow__actcap">participating</span>
    </span>
    <span class="garow__stat">
      <span class="garow__actline">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span class="garow__sub">{comments} comments</span>
      </span>
    </span>
  </div>

  <div class="garow__time">
    <div class="garow__timebody">
      {daysLeft != null ? (
        <>
          <span class="garow__timehead">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="garow__strong garow__accent">~{daysLeft} days left</span>
          </span>
          {votingEnds && <span class="garow__sub">Voting ends {votingEnds}</span>}
          {action.expiryEpoch != null && <span class="garow__sub">(Epoch {action.expiryEpoch})</span>}
        </>
      ) : <span class="garow__sub">{badge.label}</span>}
    </div>
    <svg class="garow__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
  </div>
</a>

<style>
  /* Five columns on wide screens: action, stake, sentiment, activity, time.
     The header grid in c/[slug].astro mirrors this at every breakpoint. */
  .garow { display:grid; grid-template-columns:2.2fr 1.2fr 1.3fr 0.95fr 1.35fr; gap:18px; align-items:start;
    padding:16px 18px; border-bottom:1px solid var(--border); text-decoration:none; color:var(--fg); }
  .garow:hover { background:var(--surface); }
  /* Let the cell shrink below its content width so the abstract truncates with an
     ellipsis instead of stretching the row into one endless line. */
  .garow__main { min-width:0; }
  /* Type pill and status badge sit on one line above the title. */
  .garow__tags { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:0 0 6px; }
  .pill { display:inline-block; font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;
    padding:3px 8px; border-radius:999px;
    background:color-mix(in srgb, var(--ph) 14%, transparent); color:var(--ph); }
  .garow__title { font-weight:700; font-size:0.95rem; margin:0 0 3px; }
  /* On-chain summary: a fixed line under the title so each action's substance sits
     in the same place on every row. Wraps on narrow widths rather than overflowing. */
  .garow__onchain { font-size:0.85rem; margin:0 0 5px; min-width:0;
    display:flex; flex-wrap:wrap; align-items:baseline; gap:5px; }
  .garow__oc-prefix { color:var(--muted); }
  .garow__oc-old { color:var(--muted); text-decoration:line-through; }
  .garow__oc-arrow { color:var(--muted); }
  .garow__oc-val { font-weight:600; color:var(--fg); }
  /* Treasury headline figure: accent + small uppercase label, since a bare number
     would be ambiguous. */
  .garow__onchain--amount .garow__oc-prefix { font-size:0.65rem; font-weight:600;
    text-transform:uppercase; letter-spacing:0.04em; }
  .garow__onchain--amount .garow__oc-val { color:var(--accent); font-weight:700; }
  /* old→new pair (single param, protocol version): label gets a trailing colon. */
  .garow__onchain--change .garow__oc-prefix::after { content:':'; }
  /* Two-line preview (only shown when there is no on-chain line, i.e. info actions):
     clamp to two lines so a long abstract gets more room than the old single line
     without pushing the row taller than the metric columns. */
  .garow__desc { color:var(--muted); font-size:0.8rem; margin:0 0 6px;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .garow__meta { color:var(--muted); font-size:0.75rem; margin:0; }
  .garow__pico { vertical-align:-2px; margin-right:4px; border-radius:3px; }
  /* Identicon fallback: an inline SVG span has no intrinsic size, so pin it to the
     same 14px box as the logo and clip the rounded corners. */
  .garow__pico--ident { display:inline-block; width:14px; height:14px; overflow:hidden; }
  .garow__pico--ident :global(svg) { width:100%; height:100%; display:block; }

  .metric { min-width:0; }
  .metric__pct { font-weight:700; font-size:1.05rem; display:block; margin:0 0 2px; }
  /* Turnout is neutral; the share in support reuses the positive tally tone. */
  .garow__metric--sentiment .metric__pct { color:var(--c-pos); }
  .metric__pctword { font-weight:600; font-size:0.8rem; color:var(--muted); }
  .metric__sub { color:var(--muted); font-size:0.72rem; display:block; }
  .metric__cap { color:var(--muted); font-size:0.7rem; display:block; margin-top:1px; }
  .track { display:flex; height:7px; border-radius:999px; overflow:hidden; background:var(--border); margin-top:6px; }
  .fill { height:100%; }

  .garow__activity { display:flex; flex-direction:column; gap:3px; }
  .garow__stat { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .garow__actline { display:inline-flex; align-items:center; gap:6px; }
  .garow__actline svg { color:var(--muted); }
  .garow__actcap { margin-left:20px; }
  .garow__strong { font-weight:600; font-size:0.85rem; }
  .garow__sub { color:var(--muted); font-size:0.75rem; }

  .garow__time { display:flex; align-items:center; justify-content:space-between; gap:8px; }
  .garow__timebody { display:flex; flex-direction:column; gap:2px; min-width:0; }
  .garow__timehead { display:inline-flex; align-items:center; gap:6px; }
  .garow__timehead svg { color:var(--accent); }
  .garow__accent { color:var(--accent); }
  .garow__chevron { color:var(--muted); flex:none; }

  .badge { font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; padding:2px 7px; border-radius:999px; }
  .badge--active { background:color-mix(in srgb, var(--accent) 14%, transparent); color:var(--accent); }
  .badge--positive { background:color-mix(in srgb, var(--c-pos) 14%, transparent); color:var(--c-pos); }
  .badge--neutral { background:var(--surface-2); color:var(--muted); }
  .badge--negative { background:color-mix(in srgb, var(--c-neg) 14%, transparent); color:var(--c-neg); }

  /* Below the wide breakpoint there is no room for both metrics, so we fall back
     to four columns and show only the one the page toggle selects (data-metric
     on an ancestor). Stake is the default; sentiment swaps in. */
  @media (max-width:1000px) {
    .garow { grid-template-columns:2.6fr 1.6fr 1.1fr 1.3fr; }
    .garow__metric--sentiment { display:none; }
    :global([data-metric='sentiment']) .garow__metric--stake { display:none; }
    :global([data-metric='sentiment']) .garow__metric--sentiment { display:block; }
  }
  /* Mobile: each row becomes a self-contained rounded card with a three-column
     footer (participation | comments | time) separated by hairlines. Each column
     stacks a soft accent icon chip above centered text so all three fit even on
     360px phones. The list drops its table separators (in c/[slug].astro). */
  @media (max-width:720px) {
    .garow {
      position:relative;
      min-width:0; /* a flex child of .ga-list; let the card shrink to the viewport */
      grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.25fr);
      gap:12px 0;
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px 22px 14px 14px; /* right gutter holds the chevron */
    }
    .garow__main { grid-column:1 / -1; min-width:0; }
    .metric { grid-column:1 / -1; min-width:0; }
    /* Drop the proposer/epoch line on mobile: mostly a truncated stake address
       on a small screen; the proposer stays on the detail page. */
    .garow__meta { display:none; }
    /* Activity holds the first two footer columns; the time block is the third. */
    .garow__activity { grid-column:1 / 3; flex-direction:row; gap:0; min-width:0; }
    .garow__stat { flex:1 1 0; padding:0 6px; align-items:center; text-align:center; }
    .garow__stat:first-child { padding-left:0; }
    .garow__stat + .garow__stat { border-left:1px solid var(--border); }
    .garow__time { grid-column:3 / 4; min-width:0; justify-content:center; padding-left:6px;
      border-left:1px solid var(--border); }
    .garow__timebody { align-items:center; text-align:center; min-width:0; }
    .garow__actcap { margin-left:0; }
    /* Stack each footer item: chip on top, text centered below. */
    .garow__activity .garow__actline,
    .garow__timehead { flex-direction:column; gap:5px; }
    .garow__strong { font-size:0.8rem; }
    .garow__sub { font-size:0.72rem; }
    /* Footer icons read as soft accent chips. */
    .garow__actline svg,
    .garow__timehead svg {
      box-sizing:content-box;
      padding:5px;
      border-radius:8px;
      background:color-mix(in srgb, var(--accent) 12%, transparent);
      color:var(--accent);
    }
    /* The chevron floats in the right gutter, centered on the card. */
    .garow__chevron { position:absolute; right:8px; top:50%; transform:translateY(-50%); }
  }
</style>
