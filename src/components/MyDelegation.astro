---
// Delegator dashboard body: renders the resolved DelegationData (Task 2) per
// its view.kind. A drep-follow gets the full steckbrief (avatar, status,
// voting power, delegator count, profile link), recent confirmed votes, and
// the open actions the DRep has not voted on yet. The other kinds
// (abstain/no_confidence/none/no-follow/pending) are short explainer states
// with no history or actions. No server-side data access; loadDelegation
// (src/lib/db/loadDelegation.ts) does all the fetching. The pending state
// carries a small client retry against POST /api/delegation/track.
import Avatar from '@/components/Avatar.astro';
import Callout from '@/components/Callout.astro';
import DrepVoteRow from '@/components/DrepVoteRow.astro';
import type { DelegationData } from '@/lib/db/loadDelegation.js';
import type { NetworkConfig } from '@/lib/config/network.js';
import { drepStatusHint } from '@/lib/delegation/delegationView.js';
import { drepPath } from '@/lib/dreps/profile.js';
import { formatAda, truncateId } from '@/lib/forum/view.js';
import { epochCountdown } from '@/lib/governance/view.js';
import { epochStartMs } from '@/lib/config/network.js';

interface Props {
  data: DelegationData;
  now: number;
  network: NetworkConfig;
}
const { data, now, network } = Astro.props;
const { view } = data;

const displayName = data.drep?.name ?? (data.drep ? truncateId(data.drep.drepId, 18) : null);
const statusHint = data.drep ? drepStatusHint(data.drep.active, data.drep.status) : null;
---

{
  view.kind === 'drep' && (
    <div class="mydel">
      <h2 class="mydel__heading">Your DRep</h2>

      {data.drep ? (
        <div class="mydel-card">
          <Avatar seed={data.drep.hex ?? data.drep.drepId} imageHash={data.drep.imageContentHash} size={64} href={drepPath(data.drep)} />
          <div class="mydel-card__main">
            <div class="mydel-card__titlerow">
              <a class="mydel-card__name" href={drepPath(data.drep)}>{displayName}</a>
              {!data.drep.active && <span class="mydel-card__pill mydel-card__pill--inactive">Inactive</span>}
              {data.drep.active && <span class="mydel-card__pill mydel-card__pill--active">Active</span>}
            </div>
            <div class="mydel-card__stats">
              <span>{formatAda(data.drep.votingPower)} voting power</span>
              {data.drep.delegatorCount != null && (
                <span>{data.drep.delegatorCount.toLocaleString('en-US')} on-chain delegators</span>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="mydel-card">
          <div class="mydel-card__main">
            <span class="mydel-card__name">{truncateId(view.drepId, 24)}</span>
            <p class="mydel-card__note">This DRep ID is not currently actively registered.</p>
          </div>
        </div>
      )}

      {statusHint && (
        <div class="mydel__notice">
          <Callout variant="warning">{statusHint}</Callout>
        </div>
      )}

      {view.staleError && (
        <p class="mydel__stale">Last refresh failed. Showing the last confirmed state.</p>
      )}

      <section class="mydel-section">
        <h3 class="mydel-section__title">Recent votes</h3>
        {data.history.length > 0 ? (
          <div class="vhist">
            {data.history.map((h) => <DrepVoteRow row={h} now={now} earlier={data.earlier.get(h.ga_id) ?? []} />)}
          </div>
        ) : (
          <p class="mydel-section__empty">No recorded votes yet.</p>
        )}
      </section>

      {data.openActions.length > 0 && (
        <section class="mydel-section">
          <h3 class="mydel-section__title">Your DRep has not voted yet ({data.openActions.length})</h3>
          <ul class="mydel-open">
            {data.openActions.map((row) => {
              const countdown = epochCountdown(
                row.expiry_epoch,
                row.expiry_epoch != null ? epochStartMs(row.expiry_epoch, network) : null,
                row.status,
                now,
              );
              return (
                <li class="mydel-open__row">
                  {row.slug
                    ? <a class="mydel-open__title" href={`/t/${row.slug}/`}>{row.title ?? row.id}</a>
                    : <span class="mydel-open__title">{row.title ?? row.id}</span>}
                  {countdown && <span class="mydel-open__countdown">{countdown}</span>}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>
  )
}

{
  view.kind === 'abstain' && (
    <Callout variant="info">
      <strong>Your stake is set to always abstain.</strong>
      <p>This delegation abstains on every governance action by design; there is no DRep to follow and nothing to vote on your behalf.</p>
    </Callout>
  )
}

{
  view.kind === 'no_confidence' && (
    <Callout variant="info">
      <strong>Your stake is delegated to No Confidence.</strong>
      <p>This delegation always votes No Confidence on every governance action; there is no DRep to follow.</p>
    </Callout>
  )
}

{
  (view.kind === 'none' || view.kind === 'no-follow') && (
    <div class="mydel-onboarding">
      <p>
        {view.kind === 'none'
          ? 'You are not delegated to a DRep yet.'
          : 'Delegation tracking has not been set up yet. Sign in again to retry.'}
      </p>
      <div class="mydel-onboarding__links">
        {view.kind === 'none' && <a href="/match/">Find your DRep</a>}
        <a href="/dreps/">Discover DReps</a>
      </div>
    </div>
  )
}

{
  view.kind === 'pending' && (
    <div data-delegation-pending>
      <Callout variant="info">
        <span data-pending-msg>We could not load your delegation just now.</span>
        <button type="button" class="mydel-retry" data-retry>Retry</button>
      </Callout>
    </div>
  )
}

<script>
  // Pending-state retry: the login resolves the delegation in the background,
  // so the first dashboard render can beat it, and a failed resolve is only
  // re-attempted by the daily cron. One automatic retry via the track endpoint
  // (which re-resolves inline) covers the login race; the button covers real
  // upstream failures. Bundled <script> (not is:inline) keeps the strict CSP intact.
  const pendingRoot = document.querySelector('[data-delegation-pending]');
  if (pendingRoot) {
    const msg = pendingRoot.querySelector('[data-pending-msg]') as HTMLElement | null;
    const btn = pendingRoot.querySelector('[data-retry]') as HTMLButtonElement | null;

    const retry = async () => {
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      btn.textContent = 'Retrying…';
      try {
        const res = await fetch('/api/delegation/track', { method: 'POST' });
        const data = (await res.json().catch(() => null)) as { status?: string } | null;
        if (res.ok && data?.status === 'resolved') {
          window.location.reload();
          return;
        }
      } catch {
        // Network error: fall through to the retryable state below.
      }
      if (msg) msg.textContent = 'We still could not load your delegation. Please retry in a moment.';
      btn.disabled = false;
      btn.textContent = 'Retry';
    };

    btn?.addEventListener('click', retry);
    // The deferred login resolve usually lands within a second or two; wait it
    // out, then retry once automatically so the common case self-heals.
    setTimeout(retry, 1500);
  }
</script>

<style>
  .mydel__heading {
    font-size: 1.125rem;
    margin: 0 0 0.75rem;
  }

  .mydel-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .mydel-card__main {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .mydel-card__titlerow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .mydel-card__name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }
  a.mydel-card__name:hover {
    color: var(--accent);
  }
  .mydel-card__pill {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .mydel-card__pill--active {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .mydel-card__pill--inactive {
    background: color-mix(in srgb, var(--danger) 14%, transparent);
    color: var(--danger);
  }
  .mydel-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .mydel-card__note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .mydel__notice {
    margin-top: 0.75rem;
  }
  .mydel__stale {
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .mydel-section {
    margin-top: 1.5rem;
  }
  .mydel-section__title {
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }
  .mydel-section__empty {
    margin: 0;
    color: var(--muted);
  }

  .mydel-open {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mydel-open__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .mydel-open__title {
    color: var(--fg);
    text-decoration: none;
    min-width: 0;
  }
  a.mydel-open__title:hover {
    color: var(--accent);
  }
  .mydel-open__countdown {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* Link-styled retry button inside the pending callout. */
  .mydel-retry {
    margin-left: 0.5rem;
    padding: 0;
    background: none;
    border: none;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .mydel-retry:hover {
    text-decoration: underline;
  }
  .mydel-retry:disabled {
    color: var(--muted);
    cursor: default;
    text-decoration: none;
  }

  .mydel-onboarding {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .mydel-onboarding p {
    margin: 0;
    color: var(--muted);
  }
  .mydel-onboarding__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }
</style>
