---
// Per-post badge showing an author's on-chain vote on the governance action.
import { voteTone, TONE_COLORS } from '@/lib/governance/view.js';

interface Props {
  vote: string;
}

const { vote } = Astro.props;
const color = TONE_COLORS[voteTone(vote)];
---

<span
  title="On-chain vote on this governance action"
  style={`display:inline-flex;align-items:center;font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.03em;color:${color};border:1px solid ${color};border-radius:999px;padding:0.1rem 0.4rem;line-height:1;`}
>
  Voted {vote}
</span>
