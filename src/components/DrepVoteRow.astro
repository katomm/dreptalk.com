---
// One row of a DRep's voting history: the vote (icon + label), the action (title
// link + epoch), the outcome badge, and how long ago the vote was cast. When the
// vote carries a rendered rationale, the row becomes an expandable <details>
// (native, no inline script, CSP-safe) that reveals the rationale text, matching
// the pattern used on the action's Positions tab. When the voter changed their
// vote, a "changed from X" chip marks the row and the expansion lists the
// superseded votes (with their rationales) under "Earlier votes". Styles live in
// global.css (.vhist__*) so this row and the page's header row share one grid
// definition.
import EarlierVotes from '@/components/EarlierVotes.astro';
import type { DrepVoteHistoryRow } from '@/lib/db/drepVotes.js';
import type { SupersededVote } from '@/lib/db/voteHistory.js';
import { statusBadge } from '@/lib/governance/view.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import { enhanceStoredHtml } from '@/lib/markdown.js';

interface Props {
  row: DrepVoteHistoryRow;
  now: number;
  /** Superseded votes on this action (newest first); empty when the vote never changed. */
  earlier?: SupersededVote[];
}
const { row, now, earlier = [] } = Astro.props;

const kind = row.vote === 'Yes' ? 'yes' : row.vote === 'No' ? 'no' : 'abstain';
const badge = statusBadge(row.status);
const when = row.block_time != null ? formatRelativeTime(row.block_time * 1000, now) : null;
const label = row.title ?? row.ga_id;
const rationaleHtml = row.rationale_html || null;
const expandable = Boolean(rationaleHtml) || earlier.length > 0;
// Chip names the most recently superseded vote; the expansion carries the rest.
// A re-vote that kept the same choice (new rationale) says "revoted", since
// "changed from Yes" on a Yes row would read wrong.
const changedFrom = earlier.length > 0 ? earlier[0].vote : null;
const changedLabel = changedFrom == null ? null : changedFrom === row.vote ? 'revoted' : `changed from ${changedFrom}`;

// Link the action to its DRepTalk discussion thread (the on-site page for a
// governance action). Every synced action has one; on the rare row without a
// thread yet, the title stays plain text.
const href = row.topic_slug ? `/t/${row.topic_slug}/` : null;
---

{
  ((cells) =>
    expandable ? (
      <details class="vhist__details">
        <summary class="vhist__row vhist__row--expandable">{cells}</summary>
        {rationaleHtml && <div class="vhist__rationale" set:html={enhanceStoredHtml(rationaleHtml)} />}
        {earlier.length > 0 && <EarlierVotes earlier={earlier} now={now} />}
      </details>
    ) : (
      <div class="vhist__row">{cells}</div>
    ))(
    <>
      <span class={`vhist__vote vhist__vote--${kind}`}>
        <span class="vhist__icon" aria-hidden="true">
          {kind === 'yes' && (
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
          )}
          {kind === 'no' && (
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
          )}
          {kind === 'abstain' && (
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 12h12" /></svg>
          )}
        </span>
        <span class="vhist__vote-label">{row.vote}</span>
      </span>

      <span class="vhist__action">
        {href
          ? <a class="vhist__title" href={href}>{label}</a>
          : <span class="vhist__title">{label}</span>}
        {row.decided_epoch != null && <span class="vhist__epoch">Epoch {row.decided_epoch}</span>}
        {changedLabel && <span class="vhist__changed" title={`Earlier vote: ${changedFrom}`}>{changedLabel}</span>}
        {expandable && (
          <span class="vhist__rationale-cta">
            <span>{rationaleHtml ? 'Rationale' : 'History'}</span>
            <svg class="vhist__chev" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        )}
      </span>

      <span class="vhist__outcome">
        <span class={`vhist__badge vhist__badge--${badge.tone}`}>{badge.label}</span>
      </span>

      <span class="vhist__when">{when}</span>
    </>,
  )
}
