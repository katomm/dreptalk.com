---
// Thread map: an overview of every post on the page, with the reading
// position, a jump list and a participant filter. It renders as hidden shells.
// The script fills the map from the posts already on the page, only for long
// threads, so short threads get no extra markup beyond these shells and no work.
//
// Wide screens show the map beside the posts. variant "rail": a column in the
// empty margin right of the reading column (plain topics). variant "card": the
// last card of an existing sidebar (survey, draft and governance discussion
// pages). Below the width that has room for either, the same card opens from a
// small fixed pill as a bottom sheet.
interface Props {
  variant: 'rail' | 'card';
}
const { variant } = Astro.props;
---

<aside class:list={['thread-map', `thread-map--${variant}`]} hidden aria-label="Thread map">
  <div class="thread-map__card">
    <div class="thread-map__pos">
      <div class="thread-map__count">
        <span class="thread-map__current" data-tm-pos></span>
        <span class="thread-map__words" data-tm-words></span>
        <button type="button" class="thread-map__close" data-tm-close>Close</button>
      </div>
      <div class="thread-map__bar"><span data-tm-bar></span></div>
      <div class="thread-map__links">
        <a data-tm-top href="#">Top</a>
        <a data-tm-latest href="#">Latest</a>
        <a data-tm-prev hidden href="#">Previous page</a>
        <a data-tm-next hidden href="#">Next page</a>
        <span class="thread-map__page" data-tm-page hidden></span>
      </div>
    </div>
    <p class="thread-map__label" data-tm-people-label></p>
    <div class="thread-map__people" role="group" aria-label="Filter by participant" data-tm-people></div>
    <p class="thread-map__label">Posts</p>
    <nav class="thread-map__list" aria-label="Posts on this page" data-tm-list-wrap>
      <ol data-tm-list></ol>
    </nav>
  </div>
</aside>
<button type="button" class="thread-map-pill" data-tm-pill hidden aria-haspopup="dialog">
  <span class="thread-map-pill__row">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h8" /></svg>
    <span data-tm-pill-pos></span>
    <span class="thread-map-pill__dot" aria-hidden="true"></span>
  </span>
  <span class="thread-map-pill__bar"><span data-tm-pill-bar></span></span>
</button>
<dialog class="thread-map-sheet" data-tm-sheet aria-label="Thread map"></dialog>

<script>
  import { threadPageUrl } from '@/lib/forum/paging';
  import {
    countWords,
    currentIndex,
    groupParticipants,
    indentLevel,
    lengthBarPx,
    pillHidden,
    shouldShowMap,
  } from '@/lib/forum/threadMap';

  // The reading band starts this far below the sticky header. It must stay
  // larger than the posts' scroll-margin-top minus the header height, so a post
  // the map just jumped to counts as the current one.
  const BAND_OFFSET = 32;
  const ROW_AVATAR_PX = 18;
  const PERSON_AVATAR_PX = 24;

  type Mode = 'wide' | 'narrow';

  const shell = document.querySelector<HTMLElement>('.thread-map');
  // In the sidebar layouts the map sits in the column next to the posts, so the
  // posts are found by a document search, not by walking up from the map. A
  // page renders only one of these two containers.
  const container = document.querySelector<HTMLElement>('.thread-single, .ga-detail-layout__main');
  if (shell && container) watch(shell, container);

  // A long thread gets its map at any width. The width only decides where the
  // map shows: beside the posts where there is room, behind the pill where
  // there is none. Re-checked when the window changes size.
  function watch(shell: HTMLElement, container: HTMLElement) {
    const rail = shell.classList.contains('thread-map--rail');
    // The rail needs a text column of at least 36rem, its own 14.5rem with the
    // gap and the page padding (see the main rule below), so from 53.5rem (856px).
    const media = window.matchMedia(rail ? '(min-width: 53.5rem)' : '(min-width: 901px)');
    const map = build(shell, container);
    if (!map) return;
    const apply = () => map.setMode(media.matches ? 'wide' : 'narrow');
    media.addEventListener('change', apply);
    apply();
  }

  /** Builds the map once. Returns null when the thread is too short for one. */
  function build(shell: HTMLElement, container: HTMLElement) {
    const articles = [...container.querySelectorAll<HTMLElement>('article[data-post-id]')];
    const posts = articles.map((article) => {
      // Only the post body counts, never the header, badges or actions. Posts
      // hidden for this viewer have no .prose and count as 0 words.
      const text = article.querySelector('.prose')?.textContent ?? '';
      return {
        id: article.dataset.postId ?? '',
        authorId: article.dataset.postAuthorId ?? '',
        authorName: article.dataset.postAuthor ?? '',
        isSystem: article.dataset.postSystem !== undefined,
        depth: Number(article.dataset.postDepth ?? 0),
        words: countWords(text),
        snippet: text.trimStart().slice(0, 240).replace(/\s+/gu, ' ').trim().slice(0, 80),
      };
    });
    const totalWords = posts.reduce((sum, post) => sum + post.words, 0);
    if (!shouldShowMap(posts.length, totalWords)) return null;

    const card = shell.querySelector<HTMLElement>('.thread-map__card')!;
    const q = <T extends Element>(selector: string) => card.querySelector<T>(selector)!;
    const listWrap = q<HTMLElement>('[data-tm-list-wrap]');
    const list = q<HTMLOListElement>('[data-tm-list]');
    const pos = q<HTMLElement>('[data-tm-pos]');
    const bar = q<HTMLElement>('[data-tm-bar]');
    // Pill and sheet move to the body: fixed positioning must not depend on
    // the column the shell happens to sit in, which stacks or scrolls away.
    const pill = document.querySelector<HTMLButtonElement>('[data-tm-pill]')!;
    const sheet = document.querySelector<HTMLDialogElement>('[data-tm-sheet]')!;
    document.body.appendChild(pill);
    document.body.appendChild(sheet);
    const pillPos = pill.querySelector<HTMLElement>('[data-tm-pill-pos]')!;
    const pillBar = pill.querySelector<HTMLElement>('[data-tm-pill-bar]')!;
    const root = document.documentElement;

    const maxWords = Math.max(...posts.map((post) => post.words));
    const rows = posts.map((post, index) => {
      const link = document.createElement('a');
      link.className = 'thread-map__row';
      link.href = `#post-${post.id}`;
      if (post.snippet) link.title = post.snippet;
      link.style.setProperty('--tm-indent', String(indentLevel(post.depth)));
      link.appendChild(avatarFor(articles[index], ROW_AVATAR_PX));
      const text = document.createElement('span');
      text.className = 'thread-map__text';
      const name = document.createElement('span');
      name.className = 'thread-map__name';
      name.textContent = post.authorName;
      text.appendChild(name);
      // The first words of the post, shown in the sheet only. A touch screen
      // has no hover title, and one author's rows are otherwise all alike.
      if (post.snippet) {
        const snippet = document.createElement('span');
        snippet.className = 'thread-map__snippet';
        snippet.textContent = post.snippet;
        text.appendChild(snippet);
      }
      link.appendChild(text);
      const width = lengthBarPx(post.words, maxWords);
      if (width > 0) {
        const len = document.createElement('span');
        len.className = 'thread-map__len';
        len.style.width = `${width}px`;
        link.appendChild(len);
      }
      const item = document.createElement('li');
      item.appendChild(link);
      list.appendChild(item);
      return link;
    });

    q<HTMLElement>('[data-tm-words]').textContent = `${new Intl.NumberFormat('en-US', { notation: 'compact' }).format(totalWords)} words`;
    const top = q<HTMLAnchorElement>('[data-tm-top]');
    const latest = q<HTMLAnchorElement>('[data-tm-latest]');
    top.href = `#post-${posts[0].id}`;
    latest.href = `#post-${posts[posts.length - 1].id}`;
    // Neighbor pages: reuse the rendered pager links, which already carry the
    // right query form (governance threads live behind ?tab=discussion).
    for (const dir of ['prev', 'next'] as const) {
      const source = container.querySelector<HTMLAnchorElement>(`a[data-pager="${dir}"]`);
      const target = q<HTMLAnchorElement>(`[data-tm-${dir}]`);
      if (source) {
        target.href = source.href;
        target.hidden = false;
      }
    }
    // A thread of several pages: the counts above are this page's, so the map
    // says which page it is, and Top and Latest mean the thread's, not the page's.
    const postsEl = container.querySelector<HTMLElement>('.thread-posts');
    const page = Number(postsEl?.dataset.page ?? 1);
    const pages = Number(postsEl?.dataset.pageCount ?? 1);
    if (pages > 1) {
      const slug = window.location.pathname.split('/')[2] ?? '';
      const governance = new URLSearchParams(window.location.search).get('tab') === 'discussion';
      const label = q<HTMLElement>('[data-tm-page]');
      label.textContent = `Page ${page} of ${pages}`;
      label.hidden = false;
      if (page > 1) top.href = threadPageUrl({ slug, governance });
      if (page < pages) latest.href = threadPageUrl({ slug, governance, page: pages, hash: '#latest' });
    }

    // Participant filter: one participant at a time, a second click clears it.
    // The synced opener of a governance action is the site, not a participant.
    const participants = groupParticipants(posts.filter((post) => !post.isSystem));
    q<HTMLElement>('[data-tm-people-label]').textContent =
      `${participants.length} ${participants.length === 1 ? 'participant' : 'participants'}`;
    const people = q<HTMLElement>('[data-tm-people]');
    let selected: string | null = null;
    const buttons = participants.map((participant) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'thread-map__person';
      button.dataset.authorId = participant.authorId;
      button.setAttribute('aria-pressed', 'false');
      const label = `${participant.authorName}: ${participant.count} ${participant.count === 1 ? 'post' : 'posts'}`;
      button.title = label;
      button.setAttribute('aria-label', label);
      button.appendChild(avatarFor(articles[participant.firstIndex], PERSON_AVATAR_PX));
      button.addEventListener('click', () => setFilter(selected === participant.authorId ? null : participant.authorId));
      people.appendChild(button);
      return button;
    });
    function setFilter(authorId: string | null) {
      selected = authorId;
      // Card and pill both say that a filter is set: the narrow rail shows its
      // participants only then (the way to clear it), the pill shows its dot.
      card.toggleAttribute('data-filtered', authorId !== null);
      pill.toggleAttribute('data-filtered', authorId !== null);
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.authorId === authorId));
      posts.forEach((post, index) => {
        rows[index].classList.toggle('is-dim', authorId !== null && post.authorId !== authorId);
        articles[index].classList.toggle('thread-map-hl', authorId !== null && post.authorId === authorId);
      });
    }

    // The sheet. A modal dialog traps focus, closes on Escape and makes the
    // page inert, but the page behind still scrolls under a touch or a wheel,
    // so the scroll is locked for as long as it is open.
    function openSheet() {
      if (sheet.open) return;
      sheet.showModal();
      root.style.overflow = 'hidden';
      centerCurrentRow();
    }
    function closeSheet() {
      root.style.overflow = '';
      if (sheet.open) sheet.close();
    }
    pill.addEventListener('click', openSheet);
    q<HTMLButtonElement>('[data-tm-close]').addEventListener('click', closeSheet);
    // Escape closes the dialog without passing through closeSheet.
    sheet.addEventListener('close', closeSheet);
    sheet.addEventListener('click', (event) => {
      // The card fills the dialog, so a click on the dialog itself is a click
      // on the backdrop.
      if (event.target === sheet) closeSheet();
    });
    // A jump from the sheet (a row, Top, Latest, a neighbor page) closes it
    // first. The link's own navigation follows and does the scrolling.
    card.addEventListener('click', (event) => {
      if (sheet.open && (event.target as Element).closest('a[href]')) closeSheet();
    });

    // Reading position. The header changes height at several widths, so it is
    // measured, and the measurement also drives the sticky offset in CSS. The
    // observer's first callback, right after observe(), does the first update.
    const header = document.querySelector<HTMLElement>('.site-header');
    let headerHeight = -1;
    const headerObserver = new ResizeObserver(() => {
      const height = header?.offsetHeight ?? 0;
      if (height !== headerHeight) {
        headerHeight = height;
        root.style.setProperty('--site-header-h', `${height}px`);
      }
      update();
    });

    let mode: Mode | undefined;
    let current = -1;
    let frame = 0;
    function schedule() {
      if (!frame) frame = requestAnimationFrame(update);
    }
    function centerCurrentRow() {
      const row = rows[current];
      // A closed sheet has no height to center in.
      if (row && listWrap.clientHeight > 0) listWrap.scrollTop = row.offsetTop - listWrap.clientHeight / 2;
    }
    function update() {
      frame = 0;
      const scrollHeight = root.scrollHeight;
      const viewport = window.innerHeight;
      // A page that does not scroll is never "at the end", so the first post
      // stays current there instead of the last one.
      const atEnd = scrollHeight > viewport + 2 && viewport + window.scrollY >= scrollHeight - 2;
      const tops = articles.map((article) => article.getBoundingClientRect().top);
      const next = currentIndex(tops, headerHeight + BAND_OFFSET, atEnd);
      if (next !== current && next >= 0) {
        rows[current]?.removeAttribute('aria-current');
        current = next;
        const row = rows[current];
        row.setAttribute('aria-current', 'location');
        const share = `${Math.round(((current + 1) / posts.length) * 100)}%`;
        pos.textContent = `${current + 1} / ${posts.length}`;
        bar.style.width = share;
        pillPos.textContent = pos.textContent;
        pillBar.style.width = share;
        pill.setAttribute('aria-label', `Thread map, post ${current + 1} of ${posts.length}`);
        // Follow inside the list only. scrollIntoView would also move the window
        // and fight the reader's own scrolling.
        const above = row.offsetTop < listWrap.scrollTop;
        const below = row.offsetTop + row.offsetHeight > listWrap.scrollTop + listWrap.clientHeight;
        if (above || below) centerCurrentRow();
      }
      if (mode === 'narrow') placePill();
    }

    // The pill steps aside without leaving the layout (visibility, not
    // display), so its own box stays measurable while it is away.
    let formFocused = false;
    const forms = (postsEl ?? container).getElementsByTagName('form');
    function placePill() {
      const box = pill.getBoundingClientRect();
      const postsEnd = (postsEl ?? articles[articles.length - 1]).getBoundingClientRect().bottom;
      let overlapsForm = false;
      for (const form of forms) {
        const r = form.getBoundingClientRect();
        if (r.height > 0 && r.bottom > box.top && r.top < box.bottom && r.right > box.left && r.left < box.right) {
          overlapsForm = true;
          break;
        }
      }
      const away = pillHidden({ formFocused, postsEnd, pillBottom: box.bottom, overlapsForm });
      pill.classList.toggle('is-away', away);
      // No outline on a post without its control in view.
      if (away) root.dataset.tmOutlines = 'off';
      else delete root.dataset.tmOutlines;
    }
    const main = document.querySelector('main');
    main?.addEventListener('focusin', (event) => {
      formFocused = (event.target as Element).matches('input, textarea, select, [contenteditable]:not([contenteditable="false"])');
      schedule();
    });
    main?.addEventListener('focusout', () => {
      formFocused = false;
      schedule();
    });

    if (header) headerObserver.observe(header);
    else update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);

    return {
      // A mode change only moves the card and swaps what shows it. Position,
      // listeners and the filter stay.
      setMode(next: Mode) {
        if (next === mode) return;
        mode = next;
        if (next === 'wide') {
          // An open sheet would stay modal over the page with its card gone.
          closeSheet();
          shell.appendChild(card);
          delete root.dataset.tmOutlines;
        } else {
          sheet.appendChild(card);
        }
        shell.hidden = next !== 'wide';
        pill.hidden = next !== 'narrow';
        update();
        if (next === 'wide') centerCurrentRow();
      },
    };
  }

  // A small copy of the avatar the post header already shows (identicon plus
  // stored image, or the logo for system authors), so the map loads no images
  // of its own. The copy keeps the original's scope attributes and with them
  // its styles. Linked avatars become plain spans, since the copy sits inside a
  // link or button.
  function avatarFor(article: HTMLElement, size: number): HTMLElement {
    const copy = document.createElement('span');
    const source = article.querySelector<HTMLElement>('.author-identity .avatar, .author-identity__avatar');
    if (source) {
      for (const attr of source.attributes) {
        if (attr.name !== 'href' && attr.name !== 'tabindex') copy.setAttribute(attr.name, attr.value);
      }
      for (const child of source.childNodes) copy.appendChild(child.cloneNode(true));
    }
    copy.classList.add('thread-map__avatar');
    copy.setAttribute('aria-hidden', 'true');
    copy.style.setProperty('--avatar-size', `${size}px`);
    return copy;
  }
</script>

<style is:global>
  /* Global on purpose: rows, buttons and avatars are created by the script and
     carry no scope attribute. Every selector is rooted at .thread-map. */
  .thread-map--rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: var(--tm-rail-w);
    margin-left: var(--tm-rail-gap);
  }
  /* With the rail showing, a plain topic takes the shape of the governance
     pages: the full wide page width like the header, a 300px column for the
     rail and the text column filling the rest. main reserves the rail's space
     as right padding, so the text keeps flowing in main itself. Below 1000px
     the rail narrows to 13rem with a smaller gap, and the text column gives up
     width down to 36rem at the breakpoint (foldables, small tablets). */
  main.container--reading:has(.thread-map--rail:not([hidden])) {
    --tm-rail-w: 300px;
    --tm-rail-gap: 2rem;
    max-width: 80rem;
    padding-right: calc(1.5rem + var(--tm-rail-gap) + var(--tm-rail-w));
  }
  @media (max-width: 62.49rem) {
    main.container--reading:has(.thread-map--rail:not([hidden])) {
      --tm-rail-w: 13rem;
      --tm-rail-gap: 1.5rem;
    }
    /* The narrow rail keeps position and post list and drops the participant
       filter, which would take half its height. A filter set on the phone
       before the window grew keeps it, as the only way to clear it here. */
    .thread-map--rail .thread-map__card:not([data-filtered]) [data-tm-people-label],
    .thread-map--rail .thread-map__card:not([data-filtered]) .thread-map__people {
      display: none;
    }
  }
  /* Sticky sits on the element whose parent gives it room to move: the tall
     rail column holds a sticky card, while in a sidebar the aside itself is
     the direct child of the stretched sidebar column. */
  .thread-map--rail .thread-map__card,
  .thread-map--card {
    position: sticky;
    top: calc(var(--site-header-h, 4rem) + 1rem);
  }
  .thread-map--card {
    margin-top: 1.5rem;
  }
  .thread-map__card {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - var(--site-header-h, 4rem) - 2rem);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--surface);
    font-size: 0.8125rem;
  }
  .thread-map__count {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .thread-map__current {
    font-size: 1.125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .thread-map__words {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .thread-map__bar {
    height: 4px;
    margin: 0.375rem 0 0.5rem;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .thread-map__bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }
  .thread-map__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .thread-map__label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0.875rem 0 0.375rem;
  }
  .thread-map__people {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .thread-map__person {
    display: inline-flex;
    padding: 1px;
    border: 2px solid transparent;
    border-radius: 999px;
    background: none;
    cursor: pointer;
  }
  .thread-map__person:hover {
    border-color: var(--border);
  }
  .thread-map__person[aria-pressed='true'] {
    border-color: var(--accent);
  }
  .thread-map__person:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .thread-map__list {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    margin: 0 -0.5rem;
  }
  .thread-map__list ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thread-map__row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.5rem;
    padding-inline-start: calc(0.5rem + var(--tm-indent, 0) * 0.75rem);
    border-radius: 0.375rem;
    color: var(--muted);
    text-decoration: none;
  }
  .thread-map__row:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    color: inherit;
  }
  .thread-map__row[aria-current='location'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .thread-map__row.is-dim {
    opacity: 0.35;
  }
  .thread-map__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .thread-map__name,
  .thread-map__snippet {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  /* Sheet only, see below. Beside the posts the snippet is the hover title. */
  .thread-map__snippet,
  .thread-map__close {
    display: none;
  }
  .thread-map__page {
    color: var(--muted);
  }
  .thread-map__len {
    flex: none;
    height: 4px;
    border-radius: 2px;
    background: currentColor;
    opacity: 0.5;
  }
  /* The copied avatar keeps its own styles, these only size it. The logo of
     system authors carries an inline pixel size from the post header. */
  .thread-map__avatar {
    flex: none;
    width: var(--avatar-size);
    height: var(--avatar-size);
  }
  .thread-map__avatar svg[style] {
    width: 60% !important;
    height: 60% !important;
  }
  /* The filtered participant's posts in the thread itself. Not drawn while the
     pill has stepped aside, so an outline never shows without its control. */
  article.thread-map-hl {
    outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    outline-offset: 0.5rem;
    border-radius: 0.375rem;
  }
  html[data-tm-outlines='off'] article.thread-map-hl {
    outline: none;
  }

  /* ---- Phones and narrow windows: pill and sheet ------------------------ */
  .thread-map-pill {
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    /* Below the header, the preprod flag and the composer's quote note (50). */
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3125rem;
    min-width: 5.75rem;
    min-height: 2.75rem;
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
