---
// Governance record: metric blocks (participation, rationale coverage, vote
// timing, vote pattern donut). Shared by the DRep and SPO profiles, so the
// copy stays role-neutral: percentiles and timing are DRep-profile-only props
// that default to null everywhere else. Values are informational, never
// judgmental: no warning colors on a low rate.
import {
  buildVoteDonut, rationaleStat, participationStat, DONUT_R, DONUT_STROKE, DONUT_C,
  type VoteChangeStat,
} from '@/lib/dreps/voteStatsView.js';
import type { DrepVoteBreakdown, DrepRationaleStats, DrepParticipation } from '@/lib/db/drepVotes.js';

interface Props {
  breakdown: DrepVoteBreakdown;
  rationale: DrepRationaleStats;
  participation: DrepParticipation | null;
  /** Real vote switches (see voteChangeStat); the line is omitted when null. */
  changes?: VoteChangeStat | null;
  /** Report-card percentiles vs the active-DRep cohort. Only the DRep profile
   *  passes these; the SPO and home cards stay role-neutral and omit them. */
  percentiles?: { participationAheadPct: number; rationaleAheadPct: number | null; cohortSize: number } | null;
  /** Median vote-timing stat (see voteTimingStat). Only the DRep profile passes
   *  this; the SPO and home cards stay role-neutral and omit it. */
  timing?: { medianDay: number; timed: number; totalVotes: number } | null;
}

const { breakdown, rationale, participation, changes = null, percentiles = null, timing = null } = Astro.props;
const donut = buildVoteDonut(breakdown);
const rStat = rationaleStat(rationale);
const pStat = participationStat(participation);

const participationLine =
  pStat.kind === 'ok'
    ? `Voted on ${pStat.voted} of ${pStat.eligible} concluded actions`
    : pStat.kind === 'pending'
      ? 'Registration date pending'
      : 'No concluded governance actions yet';
---

<section class="vstats">
  <h2 class="vstats__h">Governance record</h2>

  {donut.total === 0 ? (
    <p class="vstats__empty">No recorded on-chain votes.</p>
  ) : (
    <Fragment>
    <div class="vstats__body">
      <div class="vstats__cell">
        <span class="vstats__cell-title">
          <span class="vstats__icon vstats__icon--accent" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1" />
              <circle cx="9" cy="8" r="3.2" />
              <path d="M22 19v-1a4 4 0 0 0-3-3.87" />
              <path d="M16 4.2a4 4 0 0 1 0 7.6" />
            </svg>
          </span>
          Participation
        </span>
        {pStat.kind === 'ok' && <span class="vstats__big">{pStat.pct}%</span>}
        <span class="vstats__cell-line">{participationLine}</span>
        {percentiles && (
          <span class="vstats__pctile">Ahead of {percentiles.participationAheadPct}% of {percentiles.cohortSize} active DReps</span>
        )}
        {pStat.kind === 'ok' && (
          <span class="vstats__bar" aria-hidden="true">
            <span class="vstats__bar-fill vstats__bar-fill--accent" style={`width:${pStat.pct}%;`}></span>
          </span>
        )}
      </div>

      {rStat && (
        <div class="vstats__cell">
          <span class="vstats__cell-title">
            <span class="vstats__icon vstats__icon--pos" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                <path d="M7 21h10" />
                <path d="M12 3v18" />
                <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
              </svg>
            </span>
            Votes with rationale
          </span>
          <span class="vstats__big">{rStat.pct}%</span>
          <span class="vstats__cell-line">{rStat.withRationale} of {rStat.total} votes with rationale</span>
          {percentiles?.rationaleAheadPct != null && (
            <span class="vstats__pctile">Ahead of {percentiles.rationaleAheadPct}% of {percentiles.cohortSize} active DReps</span>
          )}
          <span class="vstats__bar" aria-hidden="true">
            <span class="vstats__bar-fill vstats__bar-fill--pos" style={`width:${rStat.pct}%;`}></span>
          </span>
        </div>
      )}

      {timing && (
        <div class="vstats__cell">
          <span class="vstats__cell-title">
            <span class="vstats__icon vstats__icon--accent" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 3" />
              </svg>
            </span>
            Vote timing
          </span>
          <span class="vstats__big">Day {timing.medianDay.toFixed(1)}</span>
          <span class="vstats__cell-line">Median point after submission across {timing.timed} timed votes{timing.timed < timing.totalVotes ? ` (${timing.timed} of ${timing.totalVotes} votes have a recorded time)` : ''}</span>
        </div>
      )}

      <div class="vstats__cell">
        <span class="vstats__cell-title">Voting pattern</span>
        <div class="vstats__chart">
          <div class="vstats__donut">
            <svg viewBox="0 0 200 200" width="120" height="120" aria-hidden="true">
              <circle cx="100" cy="100" r={DONUT_R} fill="none" stroke="var(--border)" stroke-width={DONUT_STROKE} opacity="0.5" />
              <g transform="rotate(-90 100 100)">
                {donut.arcs.map((a) => (
                  <circle
                    cx="100" cy="100" r={DONUT_R} fill="none"
                    stroke={a.color} stroke-width={DONUT_STROKE}
                    stroke-dasharray={`${a.dash} ${DONUT_C - a.dash}`}
                    stroke-dashoffset={a.offset}
                  />
                ))}
              </g>
            </svg>
            <div class="vstats__donut-center">
              <span class="vstats__donut-total">{donut.total.toLocaleString('en-US')}</span>
              <span class="vstats__donut-label">votes</span>
            </div>
          </div>

          <ul class="vstats__legend">
            {donut.legend.map((l) => (
              <li class="vstats__legend-item">
                <span class="vstats__swatch" style={`background:${l.color};`} aria-hidden="true"></span>
                <span class="vstats__legend-label">{l.label}</span>
                <span class="vstats__legend-count">{l.count} ({l.pct.toFixed(0)}%)</span>
              </li>
            ))}
          </ul>
        </div>
        {changes && (
          <p class="vstats__changes">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-2.64-6.36" />
              <path d="M21 3v6h-6" />
            </svg>
            {changes.totalChanges === 0 ? (
              <span class="vstats__changes-part">No vote changes</span>
            ) : (
              <Fragment>
                <span class="vstats__changes-part">Changed vote on {changes.actionsChanged} {changes.actionsChanged === 1 ? 'action' : 'actions'}</span>
                <span class="vstats__changes-sep" aria-hidden="true">·</span>
                <span class="vstats__changes-part">{changes.totalChanges} {changes.totalChanges === 1 ? 'change' : 'changes'} total</span>
              </Fragment>
            )}
          </p>
        )}
      </div>
    </div>
    {percentiles && (
      <p class="vstats__foot">Percentiles compare active DReps with at least five concluded actions since their registration. <a href="/help/drep-report-card/">What these numbers mean</a></p>
    )}
    </Fragment>
  )}
</section>

<style>
  .vstats {
    /* Top margin for consumers that place this after another card (SPO page).
       Sibling margins collapse, so the DRep page's tighter flow is unaffected. */
    margin: 2rem 0 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: var(--shadow);
    padding: 1.25rem 1.5rem;
  }
  .vstats__h { font-size: 1.125rem; margin: 0 0 1rem; }
  .vstats__empty { color: var(--muted); margin: 0; }

  /* Equal-width blocks (up to four: participation, rationale, timing, voting
     pattern), each folding to full width on narrow screens. auto-fit already
     wraps cleanly whether the timing cell is present or not. */
  .vstats__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.25rem 2rem;
    align-items: start;
  }
  .vstats__cell { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .vstats__cell-title { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; }
  .vstats__big { font-size: 1.75rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .vstats__cell-line { font-size: 0.8125rem; color: var(--muted); }
  /* Report-card percentile: a quieter sub-line under the cell's own line, never
     competing with the cell's own (informational, non-judgmental) big value. */
  .vstats__pctile { display: block; font-size: 0.75rem; color: var(--muted); }

  /* Neutral progress track: informational fill, no warning tones at low rates. */
  .vstats__bar {
    display: block;
    margin-top: 0.25rem;
    max-width: 14rem;
    height: 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--muted) 16%, transparent);
    overflow: hidden;
  }
  .vstats__bar-fill { display: block; height: 100%; border-radius: 999px; }
  .vstats__bar-fill--accent { background: var(--accent); }
  .vstats__bar-fill--pos { background: var(--c-pos); }

  .vstats__icon { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; flex: none; }
  .vstats__icon--pos { background: color-mix(in srgb, var(--c-pos) 14%, transparent); color: var(--c-pos); }
  .vstats__icon--accent { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }

  .vstats__chart { display: flex; align-items: center; gap: 1rem; }
  .vstats__donut { position: relative; width: 120px; height: 120px; flex: none; }
  .vstats__donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .vstats__donut-total { font-size: 1.15rem; font-weight: 700; }
  .vstats__donut-label { font-size: 0.7rem; color: var(--muted); }

  .vstats__legend { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; min-width: 7rem; }
  .vstats__legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
  .vstats__swatch { width: 0.75rem; height: 0.75rem; border-radius: 3px; flex: none; }
  .vstats__legend-label { font-weight: 600; }
  .vstats__legend-count { color: var(--muted); margin-left: auto; font-variant-numeric: tabular-nums; }

  /* Neutral meta line: a re-vote is legitimate, so this is quiet information
     under the pattern, never a same-rank KPI or a warning. */
  .vstats__changes {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.4rem;
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .vstats__changes svg { flex: none; }
  /* Wrap between the two phrases, never inside one. */
  .vstats__changes-part { white-space: nowrap; }
  .vstats__changes-sep { margin: 0 0.1rem; }

  .vstats__foot {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 560px) {
    .vstats { padding: 1.1rem; }
  }
</style>
