---
// Theme menu in the header: Light, Dark or System (follow the OS). The button
// shows the theme that is on screen right now, the panel names the mode. Built
// on <details data-auto-dismiss>, so the shared script in Layout.astro closes it
// on an outside click, Escape and scroll. The entries are wired, marked and
// labelled by src/scripts/theme-init.js.

// Icon shapes as SVG children, shared by the header button and the entries.
const SUN =
  '<circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />';
const MOON = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />';
const MONITOR =
  '<rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />';
const CHOICES = [
  { value: 'light', label: 'Light', icon: SUN },
  { value: 'dark', label: 'Dark', icon: MOON },
  { value: 'system', label: 'System', icon: MONITOR },
];
---
<details class="theme-menu" id="theme-menu" data-auto-dismiss>
  <summary class="theme-toggle" id="theme-toggle" aria-label="Theme">
    <span class="toggle-icons">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={SUN} />
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={MOON} />
    </span>
  </summary>
  <div class="theme-menu__panel" role="group" aria-label="Theme">
    {CHOICES.map((choice) => (
      <button type="button" class="theme-menu__item" data-theme-choice={choice.value} aria-pressed="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={choice.icon} />
        <span class="theme-menu__label">{choice.label}</span>
        <svg class="theme-menu__check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </button>
    ))}
  </div>
</details>
<style>
  .theme-menu { position:relative; flex-shrink:0; }
  .theme-toggle { background:none; border:none; cursor:pointer; padding:6px; display:flex; align-items:center; justify-content:center; color:var(--fg); border-radius:8px; transition:background .2s ease; flex-shrink:0; list-style:none; user-select:none; }
  .theme-toggle::-webkit-details-marker { display:none; }
  .theme-toggle:hover, .theme-menu[open] .theme-toggle { background:rgba(128,128,128,.12); }
  .toggle-icons { position:relative; display:flex; align-items:center; justify-content:center; width:18px; height:18px; }
  .icon-sun, .icon-moon { position:absolute; transition:transform .5s ease, opacity .3s ease; }
  .icon-sun { opacity:1; transform:rotate(0deg) scale(1); }
  .icon-moon { opacity:0; transform:rotate(-90deg) scale(0); }
  :global(html[data-theme='dark']) .icon-sun { opacity:0; transform:rotate(90deg) scale(0); }
  :global(html[data-theme='dark']) .icon-moon { opacity:1; transform:rotate(0deg) scale(1); }
  /* Same recipe as the header nav dropdowns (.site-nav__menu), anchored to the
     right edge of the button so it stays inside a narrow phone screen. */
  .theme-menu__panel { position:absolute; top:calc(100% + .5rem); right:0; z-index:60; min-width:10rem; display:flex; flex-direction:column; gap:.1rem; padding:.4rem; background:var(--surface-2); border:1px solid var(--border); border-radius:var(--radius); box-shadow:var(--shadow-lg); }
  .theme-menu__item { display:flex; align-items:center; gap:.6rem; width:100%; padding:.5rem .7rem; border:none; background:none; color:var(--fg); font:inherit; font-size:.9375rem; font-weight:500; text-align:left; border-radius:var(--radius-sm); cursor:pointer; }
  .theme-menu__item:hover { background:var(--surface); }
  .theme-menu__label { flex:1; }
  .theme-menu__check { visibility:hidden; color:var(--accent); }
  .theme-menu__item[aria-pressed='true'] .theme-menu__check { visibility:visible; }
  @media (prefers-reduced-motion: reduce){ .icon-sun,.icon-moon{ transition:none; } }
</style>
