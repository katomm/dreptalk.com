---
// One stat tile of a .drep-stats grid: a small icon in the label line, the
// figure, an optional trend chip and sub line. Renders as a link when `href` is
// given (the homepage strip), as a plain block otherwise. The shared tokens
// live in global.css under .drep-stat. The overview rows of figures (DReps,
// groups, home, analytics vitals, treasury, recipients, committee) all use this
// one card so they look alike.
//
// `ring` adds a donut filled to that percentage (DonutRing) beside the text.
// `series` adds a sparkline of the metric's recent epochs under the figure
// (Sparkline).
import DrepStatIcon from './DrepStatIcon.astro';
import DonutRing from './DonutRing.astro';
import Sparkline from './Sparkline.astro';
import type { VitalCard } from '@/lib/statCard.js';

interface Props {
  card: VitalCard;
  href?: string;
  /** 0 to 100, draws a donut in place of the icon. */
  ring?: number;
  /** Recent values, oldest first, drawn as a sparkline under the figure. */
  series?: number[];
}
const { card, href, ring, series } = Astro.props;
const Tag = href ? 'a' : 'div';
const hasSpark = (series?.filter((n) => Number.isFinite(n)).length ?? 0) >= 2;
---

<Tag class={`drep-stat${card.alt ? ' drep-stat--alt' : ''}${hasSpark ? ' drep-stat--chart' : ''}`} href={href}>
  <span class="drep-stat__body">
    <span class="drep-stat__label">
      {card.icon && <span class="drep-stat__icon"><DrepStatIcon name={card.icon} /></span>}
      {card.label}
    </span>
    <span class="drep-stat__value">
      {card.valueShort ? (
        <>
          <span class="drep-stat__value-long">{card.value}</span>
          <span class="drep-stat__value-short">{card.valueShort}</span>
        </>
      ) : card.value}
    </span>
    {card.trend && (
      <span class={`drep-stat__delta drep-stat__delta--${card.trend.direction}`}>
        {card.trend.direction !== 'flat' && (
          <span class="drep-stat__arrow" aria-hidden="true">{card.trend.direction === 'up' ? '↑' : '↓'}</span>
        )}
        {card.trend.label}
      </span>
    )}
    {card.sub && <span class="drep-stat__sub" style={card.subAccent ? 'color:var(--accent)' : undefined}>{card.sub}</span>}
  </span>
  {ring != null && <DonutRing pct={ring} />}
  {hasSpark && series && <Sparkline series={series} />}
</Tag>
