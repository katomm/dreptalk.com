---
// One topic row for a category/overview list. Mirrors the activity feed row
// shell (a row-lead avatar on the left, body in the middle, relative time on the
// right) so the two surfaces feel consistent, while keeping the topic TITLE as
// the lead of the body: a topic list is about topics, not authors. Optionally
// renders a category badge (cross-category context) and governance enrichment
// (status badge + DRep mini-tally + countdown).
import type { Topic } from '@/lib/db/forum.js';
import type { GovernanceAction } from '@/lib/db/governance.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';
import type { Category } from '../../config/categories.js';
import Avatar from './Avatar.astro';
import LogoMark from './LogoMark.astro';
import TallyBar from './TallyBar.astro';
import { authorProfileHref } from '@/lib/forum/author.js';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { formatRelativeTime, truncateId } from '@/lib/forum/view.js';
import { statusBadge, tallyBar, epochCountdown, fmtPct, TONE_COLORS } from '@/lib/governance/view.js';
import { resolveNetwork, epochStartMs, type CardanoNetwork } from '@/lib/config/network.js';

interface Props {
  topic: Topic;
  now: number;
  network: CardanoNetwork;
  author?: AuthorDescriptor;
  category?: Category;
  governance?: GovernanceAction;
  // Discussions-variant opt-in (default 'default' keeps this component's other
  // callers, forum search and the governance overview, byte-identical). See
  // ActivityRow.astro's own discussions variant, which this mirrors.
  variant?: 'default' | 'discussions';
  excerpt?: string;
  participants?: number;
}

const { topic, now, network, author, category, governance, variant = 'default', excerpt, participants } = Astro.props;

// Discussions-variant leading type icon path: reused verbatim from
// CategorySidebar/ActivityRow so the icon matches elsewhere on the page. The
// discussion list never passes `governance`, so this is message in practice;
// gavel is kept for parity with ActivityRow should that ever change.
const GAVEL_PATH = 'M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6';
const MESSAGE_PATH = 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z';

// Left column: the author avatar, or the neutral system tile for a
// system-authored (governance) topic, mirroring the activity feed row.
const isSystem = author?.isSystem ?? false;
const seed = author?.identiconSeed ?? author?.authorId ?? topic.author_id;
const profileHref = author ? authorProfileHref(author) : null;
const badges = author?.badges ?? [];

const gaBadge = governance ? statusBadge(governance.status) : null;
const gaBar = governance ? tallyBar(governance.drepYesPct, governance.drepNoPct) : null;
const gaExpiryMs =
  governance?.expiryEpoch != null ? epochStartMs(governance.expiryEpoch, resolveNetwork(network)) : null;
const gaCountdown = governance
  ? epochCountdown(governance.expiryEpoch, gaExpiryMs, governance.status, now)
  : null;
---

<div class="topic-row">
  {isSystem ? (
    <span class="topic-row__tile" aria-hidden="true">
      <LogoMark style="width:22px;height:22px;color:var(--muted);" />
    </span>
  ) : (
    <Avatar seed={seed} imageHash={author?.imageHash} size={AVATAR_SIZE.rowLead} />
  )}

  <div class="topic-row__body">
    <div class="topic-row__titleline">
      {topic.pinned && <span aria-hidden="true" title="Pinned" class="topic-row__glyph topic-row__glyph--pin">&#128204;</span>}
      {topic.locked && <span aria-hidden="true" title="Locked" class="topic-row__glyph">&#128274;</span>}
      {variant === 'discussions' && (
        <svg class="topic-row__type-icon" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d={governance ? GAVEL_PATH : MESSAGE_PATH} />
        </svg>
      )}
      <a class="topic-row__title" href={`/t/${topic.slug}`}>{topic.title}</a>
      {category && (
        <a class="topic-row__cat" href={`/c/${category.slug}`}>{category.name}</a>
      )}
      {gaBadge && (
        <span class="topic-row__gabadge" style={`--badge:${TONE_COLORS[gaBadge.tone]};`}>{gaBadge.label}</span>
      )}
    </div>

    <div class="topic-row__meta">
      {author
        ? (profileHref
            ? <a class="topic-row__author" href={profileHref}>{author.displayName}</a>
            : <span class="topic-row__author">{author.displayName}</span>)
        : <span>by {truncateId(topic.author_id)}</span>}
      {badges.map((b) => <span class="topic-row__role">{b}</span>)}
      <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
      {gaCountdown && <span>{gaCountdown}</span>}
    </div>

    {variant === 'discussions' && excerpt && (
      <p class="topic-row__excerpt">{excerpt}</p>
    )}

    {gaBar && (
      <div class="topic-row__tally">
        <span class="topic-row__tally-label">DRep</span>
        <div style="flex:1;"><TallyBar bar={gaBar} height={6} /></div>
        <span class="topic-row__tally-label">{fmtPct(gaBar.yes)} yes</span>
      </div>
    )}
  </div>

  {variant === 'discussions' ? (
    <div class="topic-row__stats">
      <div class="topic-row__stat">
        <span class="topic-row__stat-num">{Math.max(0, topic.post_count - 1)}</span>
        <span class="topic-row__stat-label">Replies</span>
      </div>
      <div class="topic-row__stat">
        <span class="topic-row__stat-num">{participants ?? 0}</span>
        <span class="topic-row__stat-label">Participants</span>
      </div>
      <span class="topic-row__time">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        {formatRelativeTime(topic.last_post_at, now)}
      </span>
    </div>
  ) : (
    <span class="topic-row__time">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
      {formatRelativeTime(topic.last_post_at, now)}
    </span>
  )}
</div>

<style>
  .topic-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }
  /* System tile: neutral rounded square carrying the grey DRepTalk mark. */
  .topic-row__tile {
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .topic-row__body { flex: 1; min-width: 0; }
  .topic-row__titleline {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .topic-row__glyph { flex-shrink: 0; font-size: 0.8125rem; color: var(--muted); }
  .topic-row__glyph--pin { color: var(--accent); }
  .topic-row__title { font-weight: 500; text-decoration: none; color: var(--fg); }
  .topic-row__title:hover { text-decoration: underline; }
  .topic-row__cat {
    font-size: 0.6875rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    text-decoration: none;
  }
  .topic-row__gabadge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--on-badge);
    background: var(--badge);
    border-radius: 0.25rem;
    padding: 0.05rem 0.4rem;
  }
  .topic-row__meta {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 0.3rem;
    display: flex;
    gap: 0.4rem 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .topic-row__author { color: var(--muted); text-decoration: none; font-weight: 500; }
  .topic-row__author:hover { color: var(--fg); text-decoration: underline; }
  /* Role badge (DREP etc.): outline accent pill, matching the activity feed. */
  .topic-row__role {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.35rem;
    white-space: nowrap;
  }
  .topic-row__tally {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    max-width: 320px;
  }
  .topic-row__tally-label { font-size: 0.6875rem; color: var(--muted); flex-shrink: 0; }
  /* Discussions-variant leading type icon, inline before the title. */
  .topic-row__type-icon { flex-shrink: 0; color: var(--muted); }
  /* Discussions-variant excerpt: muted single line, ellipsized rather than wrapped. */
  .topic-row__excerpt {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Discussions-variant right cluster: Replies / Participants stat blocks (number
     over a muted label, mirroring ActivityRow's .act-stat), plus the relative
     time kept alongside them. */
  .topic-row__stats {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.1rem;
  }
  .topic-row__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 2.75rem;
  }
  .topic-row__stat-num { font-size: 0.9375rem; font-weight: 700; color: var(--fg); line-height: 1.2; }
  .topic-row__stat-label { font-size: 0.6875rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  .topic-row__time {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    padding-top: 0.1rem;
  }
</style>
