---
// Body of the signed-in account menu: identity header (avatar, name, shortened
// id with a copy button) above Settings, Profile (DReps only) and Log out.
// Rendered by RoleEntry in both the desktop dropdown and the flat mobile list,
// so the rows live here exactly once. The copy button is the only client JS,
// shipped as a bundled script (the strict CSP forbids inline handlers).
import { authorProfileHref, type AuthorDescriptor } from '@/lib/forum/author';
import { truncateIdMiddle } from '@/lib/forum/view';
import Avatar from '@/components/Avatar.astro';

interface Props {
  /** Resolved identity of the signed-in user. */
  account: AuthorDescriptor;
}
const { account } = Astro.props;

const name = account.displayName;
// Show (and copy) the DRep id when one is synced, else the session user id.
const id = account.drepId ?? account.authorId;
const seed = account.identiconSeed ?? account.authorId;
const imageHash = account.imageHash ?? null;
const profileHref = authorProfileHref(account);

// Inner SVG markup per menu icon (24x24 stroke icons, rendered via set:html).
const icons = {
  settings:
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  profile: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  logout:
    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>',
} as const;

// Menu rows above Log out; Profile only exists for accounts with a synced DRep.
const items = [
  { label: 'Settings', href: '/settings', icon: icons.settings },
  ...(profileHref ? [{ label: 'Profile', href: profileHref, icon: icons.profile }] : []),
];
---

<div class="account-menu" role="menu">
  <div class="account-menu__head">
    <Avatar seed={seed} imageHash={imageHash} size={40} />
    <span class="account-menu__head-text">
      <span class="account-menu__head-name">{name}</span>
      <span class="account-menu__head-id" title={id}>{truncateIdMiddle(id)}</span>
    </span>
    <button type="button" class="account-menu__copy" data-copy={id} aria-label="Copy your id" title="Copy your id">
      <svg class="account-menu__copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="account-menu__copied-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </button>
  </div>
  {items.map((item) => (
    <a class="account-menu__item" href={item.href} role="menuitem">
      <svg class="account-menu__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
      {item.label}
    </a>
  ))}
  <form method="POST" action="/api/auth/logout" class="account-menu__logout-form">
    <button type="submit" class="account-menu__item account-menu__logout-item" role="menuitem">
      <svg class="account-menu__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.logout} />
      Log out
    </button>
  </form>
</div>

<script>
  // Copy-to-clipboard for the account id. One delegated listener covers the
  // desktop and the mobile-menu instance.
  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('.account-menu__copy');
    if (!btn?.dataset.copy) return;
    navigator.clipboard
      .writeText(btn.dataset.copy)
      .then(() => {
        btn.classList.add('is-copied');
        setTimeout(() => btn.classList.remove('is-copied'), 1500);
      })
      .catch(() => {
        // Clipboard can be blocked (no permission / insecure context); ignore.
      });
  });
</script>

<style>
  /* Rows divided by hairlines; the hover surface keeps a small radius inside
     the row. */
  .account-menu {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .account-menu > :global(* + *) {
    border-top: 1px solid var(--border);
  }

  /* Identity header at the top of the menu. */
  .account-menu__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.55rem 0.65rem;
  }
  .account-menu__head-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    margin-right: auto;
  }
  .account-menu__head-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .account-menu__head-id {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Copy button swaps to the check icon while the is-copied class is on. */
  .account-menu__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
  }
  .account-menu__copy:hover {
    background: var(--surface);
    color: var(--accent);
  }
  .account-menu__copied-icon {
    display: none;
    color: var(--accent);
  }
  .account-menu__copy.is-copied .account-menu__copy-icon {
    display: none;
  }
  .account-menu__copy.is-copied .account-menu__copied-icon {
    display: block;
  }

  .account-menu__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }
  .account-menu__item-icon {
    flex-shrink: 0;
    color: var(--muted);
  }
  a.account-menu__item:hover {
    background: var(--surface);
    color: var(--accent);
  }
  a.account-menu__item:hover .account-menu__item-icon {
    color: var(--accent);
  }

  /* Log out is a <form> button rendered as a menu item; the form is a block so
     the hairline divider applies to it, the button fills the row. */
  .account-menu__logout-form {
    display: block;
  }
  button.account-menu__item {
    width: 100%;
    font: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }
  .account-menu__logout-item,
  .account-menu__logout-item .account-menu__item-icon {
    color: var(--danger);
  }
  button.account-menu__logout-item:hover {
    background: color-mix(in srgb, var(--danger) 8%, transparent);
  }
</style>
