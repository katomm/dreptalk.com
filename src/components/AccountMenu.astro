---
// Body of the signed-in account menu: identity header (avatar, name, shortened
// id with a copy button, linked to the public profile when the account has
// one) above Home, the Voting Dashboard (DReps), Settings and Log out. Devices
// is a Settings tab.
// Rendered by RoleEntry in both the desktop dropdown and the flat mobile list,
// so the rows live here exactly once. The copy button is the only client JS,
// shipped as a bundled script (the strict CSP forbids inline handlers).
import { authorProfileHref, type AuthorDescriptor } from '@/lib/forum/author';
import { SETTINGS_PATH, VOTE_PATH } from '@/lib/forum/icons';
import { truncateIdMiddle } from '@/lib/forum/view';
import Avatar from '@/components/Avatar.astro';
import CopyButton from '@/components/CopyButton.astro';
import BetaPill from '@/components/govAction/BetaPill.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { currentNetwork } from '@/lib/api/response';
import { govActionSubmissionAvailable } from '@/lib/governance/submissionGate';

interface Props {
  /** Resolved identity of the signed-in user. */
  account: AuthorDescriptor;
}
const { account } = Astro.props;

const name = account.displayName;
// Show (and copy) the DRep id when one is synced, else the session user id.
const id = account.drepId ?? account.authorId;
const seed = account.identiconSeed ?? account.authorId;
const imageHash = account.imageHash ?? null;
const profileHref = authorProfileHref(account);

// The identity header links to the public profile when the account has one
// (clicking your own name is the way to reach it), accounts without a profile
// keep a plain, non-interactive header.
const IdentityTag = profileHref ? 'a' : 'div';

// Path data per menu icon (24x24 stroke grid); the shared account-surface
// icons come from the icons module, the menu-only ones live here.
const icons = {
  home: 'M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  settings: SETTINGS_PATH,
  vote: VOTE_PATH,
  // Pencil tip plus a small plus mark: "create a new action", distinct from
  // the plain pencil-on-page glyph used elsewhere for editing metadata.
  pencilPlus:
    'M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z M5 18v4 M3 20h4',
  logout: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9',
} as const;

interface MenuItem {
  label: string;
  href: string;
  icon: string;
  /** Renders a BetaPill after the label, for rows behind the mainnet gate. */
  beta?: boolean;
}

// Menu rows above Log out, most-used first. The Voting Dashboard is DRep-only,
// since /vote redirects everyone else to /login, so it is gated on a synced
// DRep id. Submit action (Beta) shows wherever submission is available.
const items: MenuItem[] = [
  { label: 'Home', href: '/home/', icon: icons.home },
  ...(account.drepId ? [{ label: 'Voting Dashboard', href: '/vote/', icon: icons.vote }] : []),
  ...(govActionSubmissionAvailable(currentNetwork().network)
    ? [{ label: 'Submit action', href: '/ga/new/', icon: icons.pencilPlus, beta: true }]
    : []),
  { label: 'Settings', href: '/settings/', icon: icons.settings },
];
---

<div class="account-menu">
  <div class="account-menu__head">
    <IdentityTag class="account-menu__head-identity" href={profileHref ?? undefined}>
      <Avatar seed={seed} imageHash={imageHash} size={AVATAR_SIZE.rowLead} />
      <span class="account-menu__head-text">
        <span class="account-menu__head-name">{name}</span>
        <span class="account-menu__head-id" title={id}>{truncateIdMiddle(id)}</span>
      </span>
    </IdentityTag>
    <CopyButton value={id} label="Copy your id" />
  </div>
  {items.map((item) => (
    <a class="account-menu__item" href={item.href}>
      <svg class="account-menu__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
      {item.label}
      {item.beta && <BetaPill />}
    </a>
  ))}
  <form method="POST" action="/api/auth/logout" class="account-menu__logout-form">
    <button type="submit" class="account-menu__item account-menu__logout-item">
      <svg class="account-menu__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.logout} /></svg>
      Log out
    </button>
  </form>
</div>

<style>
  /* Rows divided by hairlines; the hover surface keeps a small radius inside
     the row. */
  .account-menu {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .account-menu > :global(* + *) {
    border-top: 1px solid var(--border);
  }

  /* Identity header at the top of the menu. */
  .account-menu__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.55rem 0.65rem;
  }
  .account-menu__head-identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    margin-right: auto;
    text-decoration: none;
  }
  a.account-menu__head-identity:hover .account-menu__head-name {
    color: var(--accent);
  }
  .account-menu__head-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .account-menu__head-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .account-menu__head-id {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--muted);
    white-space: nowrap;
  }

  .account-menu__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }
  .account-menu__item-icon {
    flex-shrink: 0;
    color: var(--muted);
  }
  a.account-menu__item:hover {
    background: var(--surface);
    color: var(--accent);
  }
  a.account-menu__item:hover .account-menu__item-icon {
    color: var(--accent);
  }

  /* Log out is a <form> button rendered as a menu item; the form is a block so
     the hairline divider applies to it, the button fills the row. */
  .account-menu__logout-form {
    display: block;
  }
  button.account-menu__item {
    width: 100%;
    font: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }
  .account-menu__logout-item,
  .account-menu__logout-item .account-menu__item-icon {
    color: var(--danger);
  }
  button.account-menu__logout-item:hover {
    background: color-mix(in srgb, var(--danger) 8%, transparent);
  }
</style>
