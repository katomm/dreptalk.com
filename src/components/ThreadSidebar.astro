---
import type { Topic } from '@/lib/db/forum.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import { formatRelativeTime } from '@/lib/forum/view.js';

interface Props {
  topic: Topic;
  participants: { author: AuthorDescriptor; posts: number }[];
  participantTotal: number;
  related: { title: string; slug: string; replies: number; lastPostAt: number }[];
  now: number;
}
const { topic, participants, participantTotal, related, now } = Astro.props;
---

<aside class="thread-side">
  <details class="side-card" open>
    <summary class="side-card__title">
      Participants ({participantTotal})
      <span class="side-card__chevron" aria-hidden="true"></span>
    </summary>
    <div class="side-card__body">
      {participants.map((p) => (
        <div class="side-part">
          <AuthorIdentity author={p.author} size={34}>
            <span slot="sub">{p.posts} {p.posts === 1 ? 'post' : 'posts'}</span>
          </AuthorIdentity>
        </div>
      ))}
    </div>
  </details>

  {related.length > 0 && (
    <details class="side-card" open>
      <summary class="side-card__title">
        Related topics
        <span class="side-card__chevron" aria-hidden="true"></span>
      </summary>
      <div class="side-card__body">
        {related.map((r) => (
          <a class="side-rel" href={`/t/${r.slug}`}>
            <span class="side-rel__title">{r.title}</span>
            <span class="side-rel__meta">{r.replies} {r.replies === 1 ? 'reply' : 'replies'} · {formatRelativeTime(r.lastPostAt, now)}</span>
          </a>
        ))}
        <a class="side-rel__all" href={`/c/${topic.category_slug}`}>View all in this category</a>
      </div>
    </details>
  )}
</aside>

<script>
  const mq = window.matchMedia('(min-width: 60rem)');
  const sync = () => {
    if (!mq.matches) return;
    for (const d of document.querySelectorAll('details.side-card')) {
      (d as HTMLDetailsElement).open = true;
    }
  };
  mq.addEventListener('change', sync);
  sync();
</script>

<style>
  .thread-side { display: flex; flex-direction: column; gap: 0.9rem; }
  .side-card { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .side-card__title {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .side-card__title::-webkit-details-marker { display: none; }
  .side-card__chevron {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }
  .side-card[open] > .side-card__title .side-card__chevron {
    transform: rotate(-135deg);
  }
  .side-card__body { margin-top: 0.6rem; }
  /* At desktop widths the sidebar always shows fully expanded, static cards:
     the mobile accordion toggle is disabled and its chevron hidden. A small
     script (below) force-reopens any card left collapsed from mobile when
     the viewport crosses this breakpoint. */
  @media (min-width: 60rem) {
    .side-card__title {
      pointer-events: none;
      cursor: default;
    }
    .side-card__chevron {
      display: none;
    }
  }
  .side-part { margin-top: 0.6rem; }
  .side-rel { display: block; text-decoration: none; color: inherit; padding: 0.6rem 0; border-top: 1px solid var(--border); }
  .side-rel:first-of-type { border-top: 0; }
  .side-rel__title { display: block; font-size: 0.8125rem; font-weight: 600; line-height: 1.35; color: var(--fg); }
  .side-rel__meta { display: block; font-size: 0.72rem; color: var(--muted); margin-top: 0.2rem; }
  .side-rel__all { display: inline-block; margin-top: 0.6rem; font-size: 0.78rem; font-weight: 600; color: var(--accent); text-decoration: none; }
</style>
