---
// One post card in a thread: identity row, body (or the hidden-by-community
// placeholder), and the action row. Used for top-level posts and, with
// compact, for one-level replies.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import PostActions from '@/components/PostActions.astro';
import { postViewerContext, type SessionUser } from '@/lib/forum/postVisibility.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import { enhanceStoredHtml } from '@/lib/markdown.js';
import { voteTone, voteChangedSince, TONE_COLORS } from '@/lib/governance/view.js';
import { resolveAnchorUrl } from '@/lib/governance/metadata.js';
import type { Post } from '@/lib/db/forum.js';
import type { Reaction } from '@/lib/db/postReactions.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';

interface Props {
  post: Post;
  author: AuthorDescriptor;
  /** The author's on-chain vote on the surrounding governance action, if any. */
  authorVote?: { role: string; vote: string; meta_url?: string | null };
  /** DRep author who commented on a voted-on action but cast no vote of their own. */
  authorHasNotVoted?: boolean;
  user: SessionUser | null;
  flagged: boolean;
  viewerReaction: Reaction | null;
  canReply: boolean;
  now: number;
  /** Reply rendering: smaller avatar. */
  compact?: boolean;
  /** The thread is locked: disables the Edit affordance. */
  topicLocked?: boolean;
  /** 1-based position in the thread; renders "Post #N" on the right of the header row when set (top-level posts on user topics only). */
  postNumber?: number;
  /** Co-proposer mandate label for this post's persisted proposer_grant_id, or null/absent for a personal post. */
  mandate?: string | null;
  /** Whether this post has an emitted CIP-100 document, i.e. /cite/<id>/ and the
      /cip100/post/<id>.json behind it actually resolve. Drives the Cite
      affordance in PostActions, defaults to false so a caller that forgets to
      pass it never shows a link that 404s. */
  citable?: boolean;
}

const { post, author, authorVote, authorHasNotVoted = false, user, flagged, viewerReaction, canReply, now, compact = false, topicLocked = false, postNumber, mandate, citable = false } = Astro.props;

const { canSeeContent, canFlag, canReact, isOwnPost, canEdit } = postViewerContext(post, user, !!author.isSystem);

// A hidden post's version index answers 404 for as long as it is hidden, and
// the action row still renders for its author and for moderators, so the Cite
// affordance goes with it. It comes back when the flags are withdrawn.
const showCite = citable && !post.hidden;

const isVoteRationale = post.source === 'vote_rationale';

// For vote_rationale posts: the badge color uses the same tone logic as the positions tab.
const rationaleVoteColor = isVoteRationale && post.vote
  ? TONE_COLORS[voteTone(post.vote)]
  : null;

// Anchor URL: the on-chain rationale document URL (from drep_votes.meta_url),
// mapped to a browser-openable URL (ipfs:// goes through the public gateway;
// unresolvable schemes drop the link rather than rendering a dead one).
const anchorUrl =
  isVoteRationale && authorVote?.meta_url ? resolveAnchorUrl(authorVote.meta_url) : null;

// A frozen rationale post keeps the vote it was cast with; when the author has
// since re-voted (typically outside DRepTalk, so this post was never edited),
// the current on-chain vote diverges and the post gets a pointer to the
// author's current position instead of silently showing a stale stance.
const currentVote = authorVote?.vote ?? null;
const changedVote = isVoteRationale && voteChangedSince(post.vote, currentVote) ? currentVote : null;
const changedVoteColor = changedVote ? TONE_COLORS[voteTone(changedVote)] : null;
const changedVoteHref = author.drepId
  ? `?tab=positions&voter=${author.drepId}#voter-${author.drepId}`
  : '?tab=positions';
---

<article
  style={`padding:${compact ? '1rem 0 0' : '1.25rem 0'};`}
  id={`post-${post.id}`}
  data-post-id={post.id}
  data-post-author={author.displayName}
>
  <div style="font-size:0.8125rem;color:var(--muted);margin-bottom:0.75rem;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
    <AuthorIdentity author={author} size={compact ? AVATAR_SIZE.compact : AVATAR_SIZE.card} mandate={mandate} />
    {!isVoteRationale && (authorVote ? <VoteBadge vote={authorVote.vote} /> : authorHasNotVoted && <VoteBadge hasNotVoted />)}
    {isVoteRationale && post.vote && (
      <span
        class="vr-vote-badge"
        style={`color:${rationaleVoteColor};border-color:${rationaleVoteColor};`}
      >
        Voted {post.vote.toUpperCase()}
      </span>
    )}
    {isVoteRationale && (
      <span class="vr-rationale-badge">Rationale</span>
    )}
    <span>{formatRelativeTime(post.created_at, now)}</span>
    {post.edited_at && canSeeContent && !isVoteRationale && (
      <a href={`/posts/${post.id}/history/`} data-history={post.id} class="post-edited">(edited)</a>
    )}
    {post.hidden && canSeeContent && (
      <span style="background:var(--muted);color:var(--on-badge);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">hidden by the community</span>
    )}
    {postNumber !== undefined && !compact && (
      <span style="margin-left:auto;">Post #{postNumber}</span>
    )}
  </div>
  {isVoteRationale && (
    <p class="vr-frozen-notice">
      {anchorUrl ? (
        <>Frozen. <a href={anchorUrl} rel="nofollow noopener" target="_blank" class="vr-anchor-link">On-chain rationale, submitted {formatRelativeTime(post.created_at, now)}.</a></>
      ) : (
        <>Frozen. On-chain rationale, submitted {formatRelativeTime(post.created_at, now)}.</>
      )}
    </p>
  )}
  {changedVote && (
    <p class="vr-changed-notice">
      The author has since changed their vote to{' '}
      <strong style={`color:${changedVoteColor};`}>{changedVote.toUpperCase()}</strong>; see their{' '}
      <a href={changedVoteHref} class="vr-anchor-link">current position</a>.
    </p>
  )}
  {canSeeContent ? (
    <div class="prose" set:html={enhanceStoredHtml(post.body_html)} />
  ) : (
    <p style="margin:0;color:var(--muted);font-style:italic;font-size:0.9375rem;">
      This post was hidden after being flagged by the community.
    </p>
  )}
  {canSeeContent && (
    <PostActions
      post={post}
      canReact={canReact}
      canFlag={canFlag}
      isOwnPost={isOwnPost}
      flagged={flagged}
      viewerReaction={viewerReaction}
      canReply={canReply}
      canEdit={canEdit && !topicLocked && !isVoteRationale}
      authorName={author.displayName}
      citable={showCite}
    />
  )}
</article>

<style>
  /* The post named in the URL hash (a fresh reply, a shared permalink) flashes
     briefly so the eye lands on it after the scroll. */
  article:target {
    animation: post-target-flash 2s ease-out 1;
    border-radius: 0.375rem;
  }
  @keyframes post-target-flash {
    0% {
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--accent) 12%, transparent);
    }
    100% {
      background: transparent;
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }
  .post-edited {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px dotted var(--muted);
  }
  .post-edited:hover {
    color: var(--fg);
  }

  /* Vote rationale post badges, matching the positions tab style. */
  .vr-vote-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid;
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    line-height: 1;
  }

  /* Secondary "Rationale" label badge. */
  .vr-rationale-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    line-height: 1;
  }

  /* Frozen notice bar shown above the post body for vote_rationale posts. */
  .vr-frozen-notice {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Stale-stance pointer: the author re-voted since this frozen post. */
  .vr-changed-notice {
    margin: -0.25rem 0 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
  }

  .vr-anchor-link {
    color: var(--accent);
    text-decoration: none;
  }
  .vr-anchor-link:hover {
    text-decoration: underline;
  }
</style>
