---
// Renders a <script type="application/ld+json"> block for structured data (JSON-LD).
// Pass any JSON-serializable object as `data`.
// serializeJsonLd escapes </ to <\/ so a value like "</script>" cannot break out.
import { serializeJsonLd } from '@/lib/forum/view.js';
interface Props {
  data: Record<string, unknown>;
}
const { data } = Astro.props;
---
<script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
