---
// Inline author identity for a forum post or topic header: avatar, display name,
// and a small role badge. This is a pure presentational component; it never
// queries the database. The page resolves all author data in a single batch and
// passes a ready descriptor in, so batching stays in one place (no N+1).
//
// The avatar layering (identicon base, stored R2 copy as an overlay that falls
// through on 404) lives in the shared Avatar component; the system author shows
// the grey DRepTalk mark instead.

import { authorProfileHref, type AuthorDescriptor } from '@/lib/forum/author.js';
import Avatar from '@/components/Avatar.astro';
import LogoMark from '@/components/LogoMark.astro';
import type { IdenticonKind } from '@/lib/identity/identicon';
export type { AuthorDescriptor };

interface Props {
  author: AuthorDescriptor;
  /** Avatar edge length in px. Default 28. */
  size?: number;
  /**
   * Keep the name on one line and ellipsize it, filling the parent's width.
   * For fixed-width row layouts (tables, sidebars) where the default
   * mid-word wrap would collide with a neighboring value column.
   */
  truncate?: boolean;
  /** Entity kind for the identicon glyph; pass "pool" for an SPO voter. */
  kind?: IdenticonKind;
}

const { author, size = 28, truncate = false, kind } = Astro.props;
const { displayName, imageHash, badges = [], isSystem = false } = author;

// Same seed everywhere for a given author (DRep hex when known, else the id).
const seed = author.identiconSeed ?? author.authorId;
const profileHref = authorProfileHref(author);
// Optional stacked sub-line under the name (e.g. a mobile rank in the DRep list).
// Only callers that pass a `sub` slot get the column layout; everyone else keeps
// the original inline name, so this stays transparent to existing uses.
const hasSub = Astro.slots.has('sub');
---

<span class:list={['author-identity', { 'author-identity--truncate': truncate }]} style={`--avatar-size:${size}px;`}>
  {isSystem ? (
    <span class="author-identity__avatar" aria-hidden="true">
      <LogoMark style={`width:${Math.round(size * 0.6)}px;height:${Math.round(size * 0.6)}px;color:var(--muted);`} />
    </span>
  ) : (
    <Avatar seed={seed} imageHash={imageHash} size={size} kind={kind} href={profileHref} />
  )}

  {hasSub ? (
    <span class="author-identity__body">
      {profileHref
        ? <a class="author-identity__name author-identity__name--link" href={profileHref}>{displayName}</a>
        : <span class="author-identity__name">{displayName}</span>}
      <slot name="sub" />
    </span>
  ) : (
    profileHref
      ? <a class="author-identity__name author-identity__name--link" href={profileHref}>{displayName}</a>
      : <span class="author-identity__name">{displayName}</span>
  )}

  {badges.map((badge) => (
    <span class="author-identity__badge">{badge}</span>
  ))}
</span>

<style>
  .author-identity {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* Let the identity shrink in a flex/grid row so a long name cannot push the
       row past the viewport. The name itself breaks rather than overflowing. */
    min-width: 0;
  }

  /* The neutral system avatar carrying the grey DRepTalk mark; member avatars
     render via the shared Avatar. */
  .author-identity__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  /* Stacked name + sub-line, only rendered when a `sub` slot is passed. Keeps
     min-width:0 so the name still ellipsizes in truncate mode. */
  .author-identity__body { display: flex; flex-direction: column; min-width: 0; }

  .author-identity__name {
    font-weight: 600;
    color: var(--fg);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .author-identity__badge {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.4rem;
  }

  .author-identity__name--link { text-decoration: none; }
  .author-identity__name--link:hover { text-decoration: underline; }

  /* Truncate mode: the identity becomes block-level so it is bounded by its
     cell (an inline-flex would size to its content and overflow a fixed-width
     table column), and the name ellipsizes on one line instead of breaking
     mid-word. Badges keep their width; only the name yields. */
  .author-identity--truncate { display: flex; }
  .author-identity--truncate .author-identity__name {
    overflow-wrap: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .author-identity--truncate .author-identity__badge { flex-shrink: 0; }
</style>
