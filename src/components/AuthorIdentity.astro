---
// Inline author identity for a forum post or topic header: avatar, display name,
// and a small role badge. This is a pure presentational component; it never
// queries the database. The page resolves all author data in a single batch and
// passes a ready descriptor in, so batching stays in one place (no N+1).
//
// CSP note: the strict CSP forbids inline scripts and event-handler attributes,
// so there is no onerror fallback. The avatar is layered: a deterministic
// identicon SVG is the base (the system author shows a neutral "S" instead),
// and the self-hosted R2 copy at /api/avatar/<hash> (content addressed) is an
// overlay background-image. If the R2 fetch 404s, the background simply does not
// paint and the identicon shows through. Same-origin (/api/avatar/<hash>),
// covered by the CSP.

import type { AuthorDescriptor } from '@/lib/forum/author.js';
import { identiconSvg } from '@/lib/identity/identicon.js';
export type { AuthorDescriptor };

interface Props {
  author: AuthorDescriptor;
  /** Avatar edge length in px. Default 28. */
  size?: number;
}

const { author, size = 28 } = Astro.props;
const { displayName, drepId, drepSlug, imageHash, badges = [], isSystem = false } = author;

// Overlay the stored avatar only when one exists in R2 (content addressed).
const showImage = !isSystem && !!imageHash;

// Same seed everywhere for a given author (DRep hex when known, else the id).
const seed = author.identiconSeed ?? author.authorId;
const iconSvg = isSystem ? null : identiconSvg(seed, size);
// Author profile link only for DReps with a synced row; prefer the SEO slug
// over the raw id so internal links never pay the canonical redirect.
const profileHref = !isSystem && drepId ? `/dreps/${drepSlug ?? drepId}` : null;
---

<span class="author-identity" style={`--avatar-size:${size}px;`}>
  <span
    class:list={['author-identity__avatar', { 'author-identity__avatar--system': isSystem }]}
    aria-hidden="true"
  >
    {isSystem
      ? <span class="author-identity__initial">S</span>
      : <span class="author-identity__icon" set:html={iconSvg} />}
    {showImage && (
      <span
        class="author-identity__img"
        style={`background-image:url(/api/avatar/${imageHash})`}
      ></span>
    )}
  </span>

  {profileHref
    ? <a class="author-identity__name author-identity__name--link" href={profileHref}>{displayName}</a>
    : <span class="author-identity__name">{displayName}</span>}

  {badges.map((badge) => (
    <span class="author-identity__badge">{badge}</span>
  ))}
</span>

<style>
  .author-identity {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* Let the identity shrink in a flex/grid row so a long name cannot push the
       row past the viewport. The name itself breaks rather than overflowing. */
    min-width: 0;
  }

  .author-identity__avatar {
    position: relative;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    border: 1px solid var(--border);
  }
  .author-identity__avatar--system {
    background: var(--surface);
  }

  /* The initials sit at the base; the image overlay covers them when it loads. */
  .author-identity__initial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc(var(--avatar-size) * 0.46);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    user-select: none;
  }
  .author-identity__avatar--system .author-identity__initial {
    color: var(--muted);
  }

  /* R2 avatar overlay as a background so a 404 falls through to the identicon. */
  .author-identity__img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .author-identity__name {
    font-weight: 600;
    color: var(--fg);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .author-identity__badge {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.4rem;
  }

  .author-identity__icon {
    position: absolute;
    inset: 0;
    display: block;
  }
  .author-identity__icon :global(svg) { width: 100%; height: 100%; display: block; }
  .author-identity__name--link { text-decoration: none; }
  .author-identity__name--link:hover { text-decoration: underline; }
</style>
