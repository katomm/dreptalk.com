---
// Compact stat strip above a thread: participation (participants + comments)
// and last activity. All values come from data the page already has plus one
// cheap aggregate query.
//
// Reactions are deliberately absent. The other cells are thread-wide totals, so
// a reaction count here read as the sum of every thumb in the thread when it was
// only ever the opening post's, and it duplicated numbers that already sit under
// that post. They stay where the post they belong to is.
import { formatRelativeTime } from '@/lib/forum/view.js';

interface Props {
  /** Distinct authors across the topic's live posts. */
  participants: number;
  /** Replies only (post_count minus the opening post). */
  comments: number;
  lastPostAt: number;
  now: number;
}

const { participants, comments, lastPostAt, now } = Astro.props;

// Inline outline icons (Lucide geometry) so the strip needs no icon library.
const ICONS: Record<string, string> = {
  participants:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  comments:
    '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
};

// Each cell groups related metrics under one label, every metric carries an
// inline icon next to its number.
const cells = [
  {
    label: 'Participation',
    metrics: [
      { icon: 'participants', value: String(participants) },
      { icon: 'comments', value: String(comments) },
    ],
  },
  {
    label: 'Last activity',
    metrics: [{ icon: 'clock', value: formatRelativeTime(lastPostAt, now) }],
  },
];
---

<div class="topic-stats">
  {cells.map((cell) => (
    <div class="topic-stats__item">
      <span class="topic-stats__label">{cell.label}</span>
      <span class="topic-stats__metrics">
        {cell.metrics.map((metric) => (
          <span class="topic-stats__metric">
            <svg
              class="topic-stats__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS[metric.icon]}
            />
            {metric.value}
          </span>
        ))}
      </span>
    </div>
  ))}
</div>

<style>
  .topic-stats {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 0.875rem 0;
    margin-bottom: 1.25rem;
  }
  .topic-stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    flex: 1 1 9rem;
    min-width: 0;
    padding: 0 1.125rem;
  }
  .topic-stats__item + .topic-stats__item {
    border-left: 1px solid var(--border);
  }
  .topic-stats__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }
  .topic-stats__metrics {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .topic-stats__metric {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
    white-space: nowrap;
  }
  .topic-stats__icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: var(--accent);
  }
  /* Narrow screens: keep the cells side by side (the values are short, e.g.
     "3h ago"), just tighten padding, gaps and type so the strip stays on one
     row instead of stacking into full-width blocks. */
  @media (max-width: 32rem) {
    /* nowrap: flex line-breaking keys off flex-basis, which can overflow a
       phone and drop the last cell to its own row before any shrinking
       happens. Forcing one line lets the cells shrink to fit. */
    .topic-stats {
      flex-wrap: nowrap;
    }
    .topic-stats__item {
      padding: 0 0.6rem;
    }
    .topic-stats__metrics {
      gap: 0.5rem;
    }
    .topic-stats__metric {
      font-size: 0.875rem;
      gap: 0.3rem;
    }
    .topic-stats__icon {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
