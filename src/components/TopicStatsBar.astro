---
// Compact stat strip above a thread: participants, comments, the opening
// post's supporting/opposing reactions, and last activity. All values come
// from data the page already has plus one cheap aggregate query.
import { formatRelativeTime } from '@/lib/forum/view.js';
import { TONE_COLORS } from '@/lib/governance/view.js';
import type { TopicStats } from '@/lib/db/forum.js';

interface Props {
  stats: TopicStats;
  /** Replies only (post_count minus the opening post). */
  comments: number;
  lastPostAt: number;
  now: number;
  /** Label the opening post's thumbs as Supporting/Opposing (governance threads). */
  stanceLabels?: boolean;
}

const { stats, comments, lastPostAt, now, stanceLabels = false } = Astro.props;

// Inline outline icons (Lucide geometry) so the strip needs no icon library.
const ICONS: Record<string, string> = {
  participants:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  comments:
    '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  up: '<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>',
  down: '<path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
};

const items = [
  { icon: 'participants', label: 'Participants', value: String(stats.participants), tone: 'var(--accent)' },
  { icon: 'comments', label: 'Comments', value: String(comments), tone: 'var(--accent)' },
  { icon: 'up', label: stanceLabels ? 'Supporting' : 'Thumbs up', value: String(stats.supporting), tone: TONE_COLORS.positive },
  { icon: 'down', label: stanceLabels ? 'Opposing' : 'Thumbs down', value: String(stats.opposing), tone: TONE_COLORS.negative },
  { icon: 'clock', label: 'Last activity', value: formatRelativeTime(lastPostAt, now), tone: 'var(--accent)' },
];
---

<div class="topic-stats">
  {items.map((item) => (
    <div class="topic-stats__item">
      <svg
        class="topic-stats__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        style={`color:${item.tone}`}
        set:html={ICONS[item.icon]}
      />
      <span class="topic-stats__text">
        <span class="topic-stats__label">{item.label}</span>
        <span class="topic-stats__value">{item.value}</span>
      </span>
    </div>
  ))}
</div>

<style>
  .topic-stats {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    padding: 0.875rem 0;
    margin-bottom: 1.25rem;
  }
  .topic-stats__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: 1 1 8.5rem;
    min-width: 0;
    padding: 0 1.125rem;
  }
  .topic-stats__item + .topic-stats__item {
    border-left: 1px solid var(--border);
  }
  .topic-stats__icon {
    width: 1.375rem;
    height: 1.375rem;
    flex-shrink: 0;
  }
  .topic-stats__text {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }
  .topic-stats__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }
  .topic-stats__value {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
    white-space: nowrap;
  }
</style>
