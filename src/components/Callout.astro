---
// Reusable callout / admonition for inline messages. Styling lives in the
// global `.callout` classes (src/styles/global.css) so React components can use
// the same look via className. Usage:
//   <Callout variant="error">Something went wrong.</Callout>
interface Props {
  variant?: 'error' | 'warning' | 'info' | 'success';
  class?: string;
}
const { variant = 'info', class: className = '' } = Astro.props;
const role = variant === 'error' || variant === 'warning' ? 'alert' : undefined;
---

<div class:list={['callout', `callout--${variant}`, className]} role={role}>
  <svg
    class="callout__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {variant === 'error' && (
      <Fragment>
        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
      </Fragment>
    )}
    {variant === 'warning' && (
      <Fragment>
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" />
      </Fragment>
    )}
    {variant === 'info' && (
      <Fragment>
        <circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />
      </Fragment>
    )}
    {variant === 'success' && (
      <Fragment>
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
      </Fragment>
    )}
  </svg>
  <div class="callout__body"><slot /></div>
</div>
