---
// Role-aware sign-in control. Signed out, the primary action enters as a DRep
// and the chevron reveals every writer role (the menu repeats the DRep entry so
// the list is complete). Signed in (Astro.locals.user is set by the middleware,
// the resolved identity arrives via the account prop), the pill shows the
// account's avatar, name and role and opens a menu with the identity, Settings,
// Profile (DReps only) and Log out. Reading the forum is public, this only
// gates who can post. SPO (Calidus key) and CC-member sign-in use the offline
// paste flow; DRep and proposer use the wallet flow. Built on a native
// <details> and a plain <form>; the only client JS is the copy button, shipped
// as a bundled script (the strict CSP forbids inline scripts).
import { roleLabels } from '@/lib/auth/roles';
import { drepPath } from '@/lib/drep/profile';
import type { AuthorDescriptor } from '@/lib/forum/author';
import { truncateId } from '@/lib/forum/view';
import { identiconSvg } from '@/lib/identity/identicon';

interface Props {
  layout?: 'split' | 'flat';
  /** Resolved identity of the signed-in user; null when signed out. */
  account?: AuthorDescriptor | null;
}
const { layout = 'split', account = null } = Astro.props;

const user = Astro.locals.user;

// Inner SVG markup per menu icon (24x24 stroke icons, rendered via set:html so
// the list below stays declarative).
const icons = {
  drep: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  spo: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  cc: '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  proposer:
    '<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>',
  settings:
    '<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/>',
  profile: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  logout:
    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/>',
} as const;

// Sign-in entries for the on-chain writer roles. The first doubles as the
// primary button; the flat (mobile) disclosure skips it because the primary
// button sits directly above the list there.
const signinRoles = [
  { label: 'Enter as DRep', href: '/login', icon: icons.drep, active: true },
  { label: 'Enter as SPO', href: '/login?role=spo', icon: icons.spo, active: false },
  { label: 'Enter as CC member', href: '/login?role=cc', icon: icons.cc, active: false },
  { label: 'Enter as proposer', href: '/login?role=proposer', icon: icons.proposer, active: false },
];

// Middle truncation so both the bech32 prefix and the distinctive tail stay
// visible (truncateId keeps only the head).
const shortId = (id: string) => (id.length > 21 ? `${id.slice(0, 9)}...${id.slice(-8)}` : id);

// Signed-in display values. The account descriptor carries the synced DRep
// identity (name, slug, avatar); without it the session id still renders.
const display = user
  ? {
      name: account?.displayName ?? truncateId(user.id),
      role: roleLabels(user.roles)[0],
      allRoles: roleLabels(user.roles).join(', '),
      id: account?.drepId ?? user.id,
      seed: account?.identiconSeed ?? user.id,
      imageHash: account?.imageHash ?? null,
      profileHref: account?.drepId
        ? drepPath({ drepId: account.drepId, slug: account.drepSlug ?? null })
        : null,
    }
  : null;
---

{display ? (
  <div class:list={['role-entry', 'role-entry--signedin', `role-entry--${layout}`]}>
    {layout === 'split' ? (
      <details class="role-entry__more">
        <summary class="role-entry__pill" aria-label="Account menu" title={`Signed in as ${display.allRoles}`}>
          <span class="role-entry__pill-main">
            <span class="role-entry__avatar role-entry__avatar--pill" aria-hidden="true">
              <span class="role-entry__avatar-icon" set:html={identiconSvg(display.seed, 26)} />
              {display.imageHash && (
                <span class="role-entry__avatar-img" style={`background-image:url(/api/avatar/${display.imageHash})`}></span>
              )}
            </span>
            <span class="role-entry__pill-text">
              <span class="role-entry__pill-name">{display.name}</span>
              <span class="role-entry__pill-role">{display.role}</span>
            </span>
          </span>
          <span class="role-entry__pill-chev">
            <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div class="role-entry__menu role-entry__menu--account" role="menu">
          <div class="role-entry__head">
            <span class="role-entry__avatar role-entry__avatar--head" aria-hidden="true">
              <span class="role-entry__avatar-icon" set:html={identiconSvg(display.seed, 40)} />
              {display.imageHash && (
                <span class="role-entry__avatar-img" style={`background-image:url(/api/avatar/${display.imageHash})`}></span>
              )}
            </span>
            <span class="role-entry__head-text">
              <span class="role-entry__head-name">{display.name}</span>
              <span class="role-entry__head-id" title={display.id}>{shortId(display.id)}</span>
            </span>
            <button type="button" class="role-entry__copy" data-copy={display.id} aria-label="Copy your id" title="Copy your id">
              <svg class="role-entry__copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </svg>
              <svg class="role-entry__copied-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </button>
          </div>
          <a class="role-entry__item" href="/settings" role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.settings} />
            Settings
          </a>
          {display.profileHref && (
            <a class="role-entry__item" href={display.profileHref} role="menuitem">
              <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.profile} />
              Profile
            </a>
          )}
          <form method="POST" action="/api/auth/logout" class="role-entry__logout-form">
            <button type="submit" class="role-entry__item role-entry__logout-item" role="menuitem">
              <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.logout} />
              Log out
            </button>
          </form>
        </div>
      </details>
    ) : (
      <div class="role-entry__list" role="menu">
        <div class="role-entry__head">
          <span class="role-entry__avatar role-entry__avatar--head" aria-hidden="true">
            <span class="role-entry__avatar-icon" set:html={identiconSvg(display.seed, 40)} />
            {display.imageHash && (
              <span class="role-entry__avatar-img" style={`background-image:url(/api/avatar/${display.imageHash})`}></span>
            )}
          </span>
          <span class="role-entry__head-text">
            <span class="role-entry__head-name">{display.name}</span>
            <span class="role-entry__head-id" title={display.id}>{shortId(display.id)}</span>
          </span>
          <button type="button" class="role-entry__copy" data-copy={display.id} aria-label="Copy your id" title="Copy your id">
            <svg class="role-entry__copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <svg class="role-entry__copied-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </button>
        </div>
        <a class="role-entry__item" href="/settings" role="menuitem">
          <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.settings} />
          Settings
        </a>
        {display.profileHref && (
          <a class="role-entry__item" href={display.profileHref} role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.profile} />
            Profile
          </a>
        )}
        <form method="POST" action="/api/auth/logout" class="role-entry__logout-form">
          <button type="submit" class="role-entry__item role-entry__logout-item" role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.logout} />
            Log out
          </button>
        </form>
      </div>
    )}
  </div>
) : (

<div class:list={['role-entry', `role-entry--${layout}`]}>
  <a class="btn btn-primary role-entry__main" href="/login">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>
    Enter as DRep
  </a>

  {layout === 'split' ? (
    <details class="role-entry__more">
      <summary class="role-entry__toggle" aria-label="More ways to sign in">
        <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="role-entry__menu" role="menu">
        {signinRoles.map((r) => (
          <a class:list={['role-entry__item', { 'role-entry__item--active': r.active }]} href={r.href} role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
            {r.label}
          </a>
        ))}
      </div>
    </details>
  ) : (
    <details class="role-entry__more-flat">
      <summary class="role-entry__flat-toggle">
        <span>More ways to sign in</span>
        <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="role-entry__list" role="menu">
        {signinRoles.filter((r) => !r.active).map((r) => (
          <a class="role-entry__item" href={r.href} role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
            {r.label}
          </a>
        ))}
      </div>
    </details>
  )}
  </div>
)}

<script>
  // Copy-to-clipboard for the account id. One delegated listener covers the
  // desktop and the mobile-menu instance; the strict CSP forbids inline
  // handlers, so this ships as a bundled script.
  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('.role-entry__copy');
    if (!btn?.dataset.copy) return;
    navigator.clipboard
      .writeText(btn.dataset.copy)
      .then(() => {
        btn.classList.add('is-copied');
        setTimeout(() => btn.classList.remove('is-copied'), 1500);
      })
      .catch(() => {
        // Clipboard can be blocked (no permission / insecure context); ignore.
      });
  });
</script>

<style>
  .role-entry {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    /* Destructive accent for Log out; no global danger token exists yet. */
    --danger: #dc2626;
  }
  :global(html[data-theme='dark']) .role-entry {
    --danger: #f87171;
  }

  /* The primary action reuses the global .btn .btn-primary; only the split-pill
     and flat-width tweaks below are component-specific. */

  /* Split layout: join the primary button and the chevron into one pill. */
  .role-entry--split .role-entry__main {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  .role-entry__more {
    display: inline-flex;
  }
  .role-entry__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.7rem;
    background: var(--accent);
    color: var(--accent-fg);
    border: 1px solid transparent;
    border-left: 1px solid color-mix(in srgb, var(--accent-fg) 28%, transparent);
    border-top-right-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.15s ease;
  }
  .role-entry__toggle::-webkit-details-marker {
    display: none;
  }
  .role-entry__toggle:hover {
    background: var(--accent-hover);
  }
  .role-entry__chev {
    transition: transform 0.18s ease;
  }
  .role-entry__more[open] .role-entry__chev {
    transform: rotate(180deg);
  }

  /* Dropdown menu: rows divided by hairlines; the hover surface keeps a small
     radius inside the row. */
  .role-entry__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    min-width: 230px;
    display: flex;
    flex-direction: column;
    padding: 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .role-entry__menu > :global(* + *) {
    border-top: 1px solid var(--border);
  }
  .role-entry__menu--account {
    min-width: 260px;
  }

  .role-entry__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }
  .role-entry__item-icon {
    flex-shrink: 0;
    color: var(--muted);
  }
  a.role-entry__item:hover {
    background: var(--surface);
    color: var(--accent);
  }
  a.role-entry__item:hover .role-entry__item-icon {
    color: var(--accent);
  }
  /* The DRep entry doubles the primary action; mark it as the highlighted
     default in the full role list. */
  .role-entry__item--active {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-weight: 600;
  }
  .role-entry__item--active .role-entry__item-icon {
    color: var(--accent);
  }
  a.role-entry__item--active:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  /* Flat layout for the mobile menu: stacked full-width rows, no disclosure. */
  .role-entry--flat {
    display: flex;
    width: 100%;
    margin-top: 0.4rem;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
  }
  .role-entry--flat .role-entry__main {
    justify-content: center;
    width: 100%;
  }
  .role-entry__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.15rem;
  }

  /* Flat disclosure for the mobile menu: collapsed by default, so the extra
     roles are not shown until the user opens "More ways to sign in". */
  .role-entry__more-flat {
    width: 100%;
    margin-top: 0.15rem;
  }
  .role-entry__flat-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .role-entry__flat-toggle::-webkit-details-marker {
    display: none;
  }
  .role-entry__more-flat[open] .role-entry__chev {
    transform: rotate(180deg);
  }

  /* ---- Signed in ------------------------------------------------------- */

  /* The whole pill is the <summary>, so name and chevron both open the menu;
     a hairline keeps the split-pill look of the signed-out state. */
  .role-entry__pill {
    display: inline-flex;
    align-items: stretch;
    background: var(--accent);
    color: var(--accent-fg);
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.15s ease;
  }
  .role-entry__pill::-webkit-details-marker {
    display: none;
  }
  .role-entry__pill:hover {
    background: var(--accent-hover);
  }
  .role-entry__pill-main {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.85rem 0.3rem 0.45rem;
  }
  .role-entry__pill-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }
  .role-entry__pill-name {
    font-size: 0.875rem;
    font-weight: 700;
    max-width: 11ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .role-entry__pill-role {
    font-size: 0.6875rem;
    font-weight: 500;
    opacity: 0.85;
  }
  .role-entry__pill-chev {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.7rem;
    border-left: 1px solid color-mix(in srgb, var(--accent-fg) 28%, transparent);
  }

  /* Layered avatar (same approach as AuthorIdentity): identicon base, stored
     R2 image as an overlay background so a 404 falls through silently. */
  .role-entry__avatar {
    position: relative;
    width: var(--avatar-size, 26px);
    height: var(--avatar-size, 26px);
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
  }
  .role-entry__avatar--pill {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-fg) 35%, transparent);
  }
  .role-entry__avatar--head {
    --avatar-size: 40px;
    border: 1px solid var(--border);
  }
  .role-entry__avatar-icon {
    position: absolute;
    inset: 0;
    display: block;
  }
  .role-entry__avatar-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .role-entry__avatar-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Identity header at the top of the account menu. */
  .role-entry__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.55rem 0.65rem;
  }
  .role-entry__head-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    margin-right: auto;
  }
  .role-entry__head-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .role-entry__head-id {
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--muted);
    white-space: nowrap;
  }
  .role-entry__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
  }
  .role-entry__copy:hover {
    background: var(--surface);
    color: var(--accent);
  }
  .role-entry__copied-icon {
    display: none;
