---
// Role-aware sign-in control. Signed out, the primary action enters as a DRep
// and the chevron reveals every writer role (the menu repeats the DRep entry so
// the list is complete). Signed in (Astro.locals.user is set by the middleware,
// the resolved identity arrives via the account prop), the pill shows the
// account's avatar, name and role and opens the AccountMenu. Reading the forum
// is public, this only gates who can post. SPO (Calidus key) and CC-member
// sign-in use the offline paste flow; DRep and proposer use the wallet flow.
// Built on a native <details> and a plain <form>, no client JS here (the
// strict CSP forbids inline scripts; the copy button JS lives in AccountMenu).
import { roleLabels } from '@/lib/auth/roles';
import { drepPath } from '@/lib/drep/profile';
import type { AuthorDescriptor } from '@/lib/forum/author';
import { truncateId } from '@/lib/forum/view';
import AccountMenu from '@/components/AccountMenu.astro';
import Avatar from '@/components/Avatar.astro';

interface Props {
  layout?: 'split' | 'flat';
  /** Resolved identity of the signed-in user; null when signed out. */
  account?: AuthorDescriptor | null;
}
const { layout = 'split', account = null } = Astro.props;

const user = Astro.locals.user;

// Sign-in entries for the on-chain writer roles, with their menu icons (24x24
// stroke paths, rendered via set:html). The first doubles as the primary
// button: the split menu highlights it, the flat (mobile) disclosure skips it
// because the primary button sits directly above the list there.
const signinRoles = [
  {
    label: 'Enter as DRep',
    href: '/login',
    icon: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  },
  {
    label: 'Enter as SPO',
    href: '/login?role=spo',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    label: 'Enter as CC member',
    href: '/login?role=cc',
    icon: '<line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/>',
  },
  {
    label: 'Enter as proposer',
    href: '/login?role=proposer',
    icon: '<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>',
  },
];

// Signed-in display values. The account descriptor carries the synced DRep
// identity (name, slug, avatar); without it the session id still renders.
const display = user
  ? {
      name: account?.displayName ?? truncateId(user.id),
      role: roleLabels(user.roles)[0],
      allRoles: roleLabels(user.roles).join(', '),
      id: account?.drepId ?? user.id,
      seed: account?.identiconSeed ?? user.id,
      imageHash: account?.imageHash ?? null,
      profileHref: account?.drepId
        ? drepPath({ drepId: account.drepId, slug: account.drepSlug ?? null })
        : null,
    }
  : null;
---

{display ? (
  <div class:list={['role-entry', 'role-entry--signedin', `role-entry--${layout}`]}>
    {layout === 'split' ? (
      <details class="role-entry__more">
        <summary class="role-entry__pill" aria-label="Account menu" title={`Signed in as ${display.allRoles}`}>
          <span class="role-entry__pill-main">
            <Avatar seed={display.seed} imageHash={display.imageHash} size={26} ring />
            <span class="role-entry__pill-text">
              <span class="role-entry__pill-name">{display.name}</span>
              <span class="role-entry__pill-role">{display.role}</span>
            </span>
          </span>
          <span class="role-entry__pill-chev">
            <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div class="role-entry__menu role-entry__menu--account">
          <AccountMenu
            name={display.name}
            id={display.id}
            seed={display.seed}
            imageHash={display.imageHash}
            profileHref={display.profileHref}
          />
        </div>
      </details>
    ) : (
      <AccountMenu
        name={display.name}
        id={display.id}
        seed={display.seed}
        imageHash={display.imageHash}
        profileHref={display.profileHref}
      />
    )}
  </div>
) : (

<div class:list={['role-entry', `role-entry--${layout}`]}>
  <a class="btn btn-primary role-entry__main" href="/login">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </svg>
    Enter as DRep
  </a>

  {layout === 'split' ? (
    <details class="role-entry__more">
      <summary class="role-entry__toggle" aria-label="More ways to sign in">
        <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="role-entry__menu" role="menu">
        {signinRoles.map((r, i) => (
          <a class:list={['role-entry__item', { 'role-entry__item--active': i === 0 }]} href={r.href} role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
            {r.label}
          </a>
        ))}
      </div>
    </details>
  ) : (
    <details class="role-entry__more-flat">
      <summary class="role-entry__flat-toggle">
        <span>More ways to sign in</span>
        <svg class="role-entry__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="role-entry__list" role="menu">
        {signinRoles.slice(1).map((r) => (
          <a class="role-entry__item" href={r.href} role="menuitem">
            <svg class="role-entry__item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
            {r.label}
          </a>
        ))}
      </div>
    </details>
  )}
  </div>
)}

<style>
  .role-entry {
    position: relative;
    display: inline-flex;
    align-items: stretch;
  }

  /* The primary action reuses the global .btn .btn-primary; only the split-pill
     and flat-width tweaks below are component-specific. */

  /* Split layout: join the primary button and the chevron into one pill. */
  .role-entry--split .role-entry__main {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  .role-entry__more {
    display: inline-flex;
  }

  /* Both <summary> variants (signed-out chevron segment, signed-in account
     pill) share the accent fill and disclosure-marker reset. */
  .role-entry__toggle,
  .role-entry__pill {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--accent-fg);
    border: 1px solid transparent;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.15s ease;
  }
  .role-entry__toggle::-webkit-details-marker,
  .role-entry__pill::-webkit-details-marker {
    display: none;
  }
  .role-entry__toggle:hover,
  .role-entry__pill:hover {
    background: var(--accent-hover);
  }
  .role-entry__toggle {
    justify-content: center;
    padding: 0 0.7rem;
    border-left: 1px solid color-mix(in srgb, var(--accent-fg) 28%, transparent);
    border-top-right-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
  }
  .role-entry__chev {
    transition: transform 0.18s ease;
  }
  .role-entry__more[open] .role-entry__chev {
    transform: rotate(180deg);
  }

  /* Dropdown menu: signed-out rows divided by hairlines; the signed-in variant
     is just the positioned shell around AccountMenu. */
  .role-entry__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    min-width: 230px;
    display: flex;
    flex-direction: column;
    padding: 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .role-entry__menu > :global(* + *) {
    border-top: 1px solid var(--border);
  }
  .role-entry__menu--account {
    min-width: 260px;
  }

  .role-entry__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }
  .role-entry__item-icon {
    flex-shrink: 0;
    color: var(--muted);
  }
  a.role-entry__item:hover {
    background: var(--surface);
    color: var(--accent);
  }
  a.role-entry__item:hover .role-entry__item-icon {
    color: var(--accent);
  }
  /* The DRep entry doubles the primary action; mark it as the highlighted
     default in the full role list. */
  .role-entry__item--active {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-weight: 600;
  }
  .role-entry__item--active .role-entry__item-icon {
    color: var(--accent);
  }
  a.role-entry__item--active:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  /* Flat layout for the mobile menu: stacked full-width rows, no disclosure. */
  .role-entry--flat {
    display: flex;
    width: 100%;
    margin-top: 0.4rem;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
  }
  .role-entry--flat .role-entry__main {
    justify-content: center;
    width: 100%;
  }
  .role-entry__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.15rem;
  }

  /* Flat disclosure for the mobile menu: collapsed by default, so the extra
     roles are not shown until the user opens "More ways to sign in". */
  .role-entry__more-flat {
    width: 100%;
    margin-top: 0.15rem;
  }
  .role-entry__flat-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .role-entry__flat-toggle::-webkit-details-marker {
    display: none;
  }
  .role-entry__more-flat[open] .role-entry__chev {
    transform: rotate(180deg);
  }

  /* Signed in: the whole pill is the <summary>, so name and chevron both open
     the menu; a hairline keeps the split-pill look of the signed-out state. */
  .role-entry__pill {
    align-items: stretch;
    border-radius: var(--radius);
  }
  .role-entry__pill-main {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.85rem 0.3rem 0.45rem;
  }
  .role-entry__pill-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }
  .role-entry__pill-name {
    font-size: 0.875rem;
    font-weight: 700;
    max-width: 11ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .role-entry__pill-role {
    font-size: 0.6875rem;
    font-weight: 500;
    opacity: 0.85;
  }
  .role-entry__pill-chev {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.7rem;
    border-left: 1px solid color-mix(in srgb, var(--accent-fg) 28%, transparent);
  }
</style>
