---
// Admin keys of a policy as names in a sentence, "A, B and C", each linked to its DRep profile where one is known.
import type { PolicyKeyPart } from '@/lib/groups/describe.js';

interface Props {
  keys: PolicyKeyPart[];
}

const { keys } = Astro.props;
// The separator before the i-th of n names.
const sep = (i: number): string => (i === 0 ? '' : i === keys.length - 1 ? ' and ' : ', ');
---
{keys.map((k, i) => <>{sep(i)}{k.href ? <a href={k.href}>{k.label}</a> : k.label}</>)}
