---
// Permalink control for a single vote+rationale, shown at the end of the
// expanded rationale. It shares (or copies) the deep link to this exact vote;
// opening the link scrolls to, expands, and highlights the row via the
// reveal-hash-target script in the base layout.
//
// A thin wrapper over the shared ShareButton (compact variant), so the whole
// site has one share/copy implementation, not a second parallel one.
import ShareButton from '@/components/ShareButton.astro';
interface Props {
  /** Absolute deep-link URL to this vote, including the #anchor. */
  url: string;
  /** Pass 'Share your rationale' for a voter sharing their own; anything else is
      treated as the generic per-vote share. */
  label?: string;
  /** Render just the icon (no pill, no text), for tight rows. */
  iconOnly?: boolean;
}
const { url, label = 'Copy link to this vote', iconOnly = false } = Astro.props;
const isOwnRationale = label === 'Share your rationale';
const idle = isOwnRationale ? 'Share your rationale' : 'Share';
const aria = isOwnRationale ? 'Share your rationale' : 'Share a link to this vote';
---

<ShareButton url={url} label={idle} ariaLabel={aria} iconOnly={iconOnly} variant="compact" />
