---
// Renders the Treasury and Net Change Limit overview: an intro caption, the
// treasury donut for the current period, and one NclPanel per period (newest
// first). Flexible so it can render the full detail page (all periods, with
// per-withdrawal tables) or a compact summary embedded elsewhere (current
// period only, no tables, with a link to the full detail page).
import NclPanel from '@/components/ncl/NclPanel.astro';
import TreasuryDonut from '@/components/ncl/TreasuryDonut.astro';
import type { TreasuryOverviewData } from '@/lib/treasury/overview.js';

interface Props {
  data: TreasuryOverviewData;
  /** When true, hide the per-withdrawal table on each period's panel. Default false. */
  compact?: boolean;
  /** When true, render only the current period's card, dropping past periods. Default false. */
  currentOnly?: boolean;
  /** When set, render a link to the full detail page after the period cards. */
  detailHref?: string;
}

const { data, compact = false, currentOnly = false, detailHref } = Astro.props;
const { treasuryLovelace, treasuryEpoch, currentStatus, periods } = data;

const visiblePeriods = currentOnly
  ? periods.filter((c) => c.period.id === (currentStatus?.period.id ?? periods[0]?.period.id))
  : periods;

const showDonut = treasuryLovelace !== null && currentStatus !== null;
---

<p style="color:var(--muted);max-width:65ch;line-height:1.6;">
  The Net Change Limit caps how much ada may be withdrawn from the Cardano treasury in a period. It is set by
  an Info governance action, so it is a community agreement rather than an automatic on-chain rule. The figures
  below sum enacted treasury withdrawals against the limit each period.
</p>

<div class:list={['treasury-row', { 'treasury-row--stacked': !compact }]}>
  <div class="treasury-row__col">
    {showDonut && currentStatus !== null && (
      <div class="treasury-summary">
        <TreasuryDonut
          treasuryLovelace={treasuryLovelace}
          consumedLovelace={currentStatus.consumedLovelace}
          remainingLovelace={currentStatus.remainingLovelace}
          ceilingLovelace={currentStatus.period.ceilingLovelace}
          epoch={treasuryEpoch}
        />
        <p class="treasury-summary__caption">The Net Change Limit caps the outflows, not the total balance.</p>
      </div>
    )}
  </div>
  <div class="treasury-row__col treasury-row__col--ncl">
    {visiblePeriods.map((c) => (
      <NclPanel
        status={c.status}
        windowWithdrawals={c.windowWithdrawals}
        definingLinks={c.definingLinks}
        relatedLinks={c.relatedLinks}
        compact={compact}
        showRelated={!compact}
      />
    ))}
    {compact && detailHref && (
      <a class="treasury-detail-cta" href={detailHref}>View all treasury withdrawals &gt;</a>
    )}
  </div>
</div>

{!compact && detailHref && (
  <p class="treasury-detail-link">
    <a href={detailHref}>View all treasury withdrawals &gt;</a>
  </p>
)}

<style>
  .treasury-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.5rem 0 1rem;
    background: var(--surface-2);
  }
  .treasury-summary__caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Compact mode (e.g. /c/budget): donut and the single period card sit
     side by side on desktop, each taking about half the width and matching
     the height of the taller column, and wrap to a stacked layout (donut
     on top) on narrow viewports. */
  .treasury-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1rem;
  }
  .treasury-row__col {
    flex: 1 1 320px;
    min-width: 0;
  }
  /* The right column stacks the NclPanel card and the detail CTA in a
     flex column so the CTA can be pinned to the bottom, filling any
     leftover height so the two columns line up evenly. */
  .treasury-row__col--ncl {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  /* Reset the top margins inside the row so the donut column aligns
     flush with the top of the NclPanel column (NclPanel's own margin
     is scoped to its component, so override it globally here). */
  .treasury-row .treasury-summary {
    margin-top: 0;
  }
  .treasury-row__col :global(.ncl-panel) {
    margin-top: 0;
  }

  /* Non-compact detail page (/treasury): keep the original stacked
     layout unchanged, donut block on top, then each period card full
     width below it. */
  .treasury-row--stacked {
    display: block;
  }
  .treasury-row--stacked .treasury-row__col {
    display: block;
  }
  .treasury-row--stacked .treasury-summary {
    margin: 1.5rem 0 1rem;
  }
  .treasury-row--stacked :global(.ncl-panel) {
    margin: 1rem 0;
  }

  .treasury-detail-link {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }
  .treasury-detail-link a {
    color: var(--accent);
  }

  /* Compact mode CTA: pinned to the bottom of the right column so it
     both reads as a clear call to action and helps the two columns
     reach equal height. Styled like the site's secondary button. */
  .treasury-detail-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: auto;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .treasury-detail-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
