---
// Renders the Treasury and Net Change Limit overview: an intro caption, the
// treasury donut for the current period, and one NclPanel per period (newest
// first). Flexible so it can render the full detail page (all periods, with
// per-withdrawal tables) or a compact summary embedded elsewhere (current
// period only, no tables, with a link to the full detail page).
import NclPanel from '@/components/ncl/NclPanel.astro';
import TreasuryDonut from '@/components/ncl/TreasuryDonut.astro';
import type { TreasuryOverviewData } from '@/lib/treasury/overview.js';

interface Props {
  data: TreasuryOverviewData;
  /** When true, hide the per-withdrawal table on each period's panel. Default false. */
  compact?: boolean;
  /** When true, render only the current period's card, dropping past periods. Default false. */
  currentOnly?: boolean;
  /** When set, render a link to the full detail page after the period cards. */
  detailHref?: string;
}

const { data, compact = false, currentOnly = false, detailHref } = Astro.props;
const { treasuryLovelace, treasuryEpoch, currentStatus, periods } = data;

const visiblePeriods = currentOnly
  ? periods.filter((c) => c.period.id === (currentStatus?.period.id ?? periods[0]?.period.id))
  : periods;
---

<p style="color:var(--muted);max-width:65ch;line-height:1.6;">
  The Net Change Limit caps how much ada may be withdrawn from the Cardano treasury in a period. It is set by
  an Info governance action, so it is a community agreement rather than an automatic on-chain rule. The figures
  below sum enacted treasury withdrawals against the limit each period.
</p>

{treasuryLovelace !== null && currentStatus !== null && (
  <div class="treasury-summary">
    <TreasuryDonut
      treasuryLovelace={treasuryLovelace}
      consumedLovelace={currentStatus.consumedLovelace}
      remainingLovelace={currentStatus.remainingLovelace}
      ceilingLovelace={currentStatus.period.ceilingLovelace}
      epoch={treasuryEpoch}
    />
    <p class="treasury-summary__caption">The Net Change Limit caps the outflows, not the total balance.</p>
  </div>
)}

{visiblePeriods.map((c) => (
  <NclPanel
    status={c.status}
    windowWithdrawals={c.windowWithdrawals}
    definingLinks={c.definingLinks}
    relatedLinks={c.relatedLinks}
    compact={compact}
  />
))}

{detailHref && (
  <p class="treasury-detail-link">
    <a href={detailHref}>View all treasury withdrawals &gt;</a>
  </p>
)}

<style>
  .treasury-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.5rem 0 1rem;
    background: var(--surface-2);
  }
  .treasury-summary__caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .treasury-detail-link {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }
  .treasury-detail-link a {
    color: var(--accent);
  }
</style>
