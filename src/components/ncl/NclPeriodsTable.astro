---
// Overview table of Net Change Limit periods: one row per period, linking
// through to its detail page (/treasury/<id>) where the withdrawal table and
// full breakdown live. Newest-first order is preserved from the caller.
import { formatAda } from '@/lib/format/ada.js';
import { nclLifecycle, nclBadgeStyle } from '@/lib/governance/ncl.js';
import type { NclPeriodCard } from '@/lib/treasury/overview.js';

interface Props {
  periods: NclPeriodCard[];
  currentEpoch: number | null;
}

const { periods, currentEpoch } = Astro.props;
---

<div class="ncl-periods">
  {periods.map((c) => {
    const { period, status } = c;
    const lifecycle = nclLifecycle(period, currentEpoch);
    const ceiling = formatAda(String(period.ceilingLovelace)) ?? '';
    const consumed = formatAda(String(status.consumedLovelace)) ?? '0 ₳';
    const remaining = formatAda(String(status.remainingLovelace)) ?? '0 ₳';

    return (
      <a class="ncl-periods__row" href={`/treasury/${period.id}`}>
        <div class="ncl-periods__cell ncl-periods__cell--period">
          <div class="ncl-periods__label">{period.label}</div>
          <div class="ncl-periods__sub">Epochs {period.startEpoch} to {period.endEpoch}</div>
        </div>
        <div class="ncl-periods__cell ncl-periods__cell--num ncl-periods__cell--limit">
          <div class="ncl-periods__heading">Limit</div>
          <div class="ncl-periods__value">{ceiling}</div>
        </div>
        <div class="ncl-periods__cell ncl-periods__cell--num ncl-periods__cell--used">
          <div class="ncl-periods__heading">Used</div>
          <div class="ncl-periods__value">{consumed}</div>
          <div class="ncl-periods__sub">{status.consumedPct}%</div>
        </div>
        <div class="ncl-periods__cell ncl-periods__cell--num ncl-periods__cell--remaining">
          <div class="ncl-periods__heading">Remaining</div>
          <div class="ncl-periods__value">{remaining}</div>
          <div class="ncl-periods__sub">{status.remainingPct}%</div>
        </div>
        <div class="ncl-periods__cell ncl-periods__cell--status">
          <span class="ncl-periods__badge" style={nclBadgeStyle(lifecycle)}>{lifecycle.toUpperCase()}</span>
        </div>
        <div class="ncl-periods__cell ncl-periods__cell--chevron" aria-hidden="true">&gt;</div>
      </a>
    );
  })}
</div>

<style>
  .ncl-periods {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow-x: auto;
  }

  .ncl-periods__row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    text-decoration: none;
    color: inherit;
    min-width: 640px;
  }
  .ncl-periods__row + .ncl-periods__row {
    border-top: 1px solid var(--border);
  }
  .ncl-periods__row:hover {
    background: var(--surface-2);
  }

  .ncl-periods__label {
    font-weight: 600;
    color: var(--fg);
  }
  .ncl-periods__heading {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }
  .ncl-periods__sub {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .ncl-periods__value {
    font-size: 0.9375rem;
    color: var(--fg);
  }

  .ncl-periods__cell--num {
    text-align: right;
  }

  .ncl-periods__badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .ncl-periods__cell--chevron {
    color: var(--muted);
    font-weight: 700;
  }

  /* On narrow screens the row folds into a card: period + status on top,
     then each figure as a full-width label/value line. No horizontal scroll,
     and full-form ada amounts never overflow because each gets its own row. */
  @media (max-width: 640px) {
    .ncl-periods {
      overflow-x: visible;
    }
    .ncl-periods__row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'period status'
        'limit limit'
        'used used'
        'remaining remaining';
      column-gap: 1rem;
      row-gap: 0.55rem;
      min-width: 0;
      padding: 1rem 1.1rem;
    }
    .ncl-periods__cell--period {
      grid-area: period;
    }
    .ncl-periods__cell--status {
      grid-area: status;
      justify-self: end;
    }
    .ncl-periods__cell--limit {
      grid-area: limit;
    }
    .ncl-periods__cell--used {
      grid-area: used;
    }
    .ncl-periods__cell--remaining {
      grid-area: remaining;
    }
    .ncl-periods__cell--chevron {
      display: none;
    }

    /* Figure rows: heading pinned left, value (and percent) grouped right. */
    .ncl-periods__cell--num {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      text-align: left;
      border-top: 1px solid var(--border);
      padding-top: 0.55rem;
    }
    .ncl-periods__cell--num .ncl-periods__heading {
      margin: 0 auto 0 0;
    }
    .ncl-periods__cell--num .ncl-periods__sub {
      margin: 0;
    }
  }
</style>
