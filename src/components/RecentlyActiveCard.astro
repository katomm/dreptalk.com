---
// "N DReps and M SPOs active recently on DRepTalk": the DReps/SPOs who posted most
// recently, with the counts as the heading so they can never disagree with the
// avatars shown below. Presentational only; the page resolves the descriptors and
// passes them in. Renders nothing when empty.
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';

interface Props {
  authors: AuthorDescriptor[];
}
const { authors } = Astro.props;

// Count exactly the people shown, split by role (a dual-role account counts under
// both), so the heading always matches the faces beneath it.
const drepCount = authors.filter((a) => a.badges?.includes('DRep')).length;
const spoCount = authors.filter((a) => a.badges?.includes('SPO')).length;
const roleLabel = [
  drepCount > 0 ? `${drepCount} ${drepCount === 1 ? 'DRep' : 'DReps'}` : null,
  spoCount > 0 ? `${spoCount} ${spoCount === 1 ? 'SPO' : 'SPOs'}` : null,
]
  .filter(Boolean)
  .join(' and ');
const heading = `${roleLabel} active recently on DRepTalk`;
---

{authors.length > 0 && (
  <section class="recently-active" aria-labelledby="recently-active-title">
    <p class="recently-active__title" id="recently-active-title">{heading}</p>
    <ul class="recently-active__list">
      {authors.map((a) => (
        <li class="recently-active__item">
          <AuthorIdentity author={a} size={AVATAR_SIZE.compact} />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .recently-active { margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  .recently-active__title {
    font-size: 0.95rem; font-weight: 600; color: var(--fg); margin: 0 0 1rem;
    font-variant-numeric: tabular-nums;
  }
  .recently-active__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem;
  }
  .recently-active__item { font-size: 0.875rem; min-width: 0; }
</style>
