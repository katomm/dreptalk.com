---
// "N DReps, M SPOs and K delegators active in the last 30 days on DRepTalk":
// the full role counts as the heading over an overlapping row of the DReps/SPOs
// seen most recently (see ActiveFaces for the faces and their hover cards).
// Counts are passed in (not derived from the faces) because delegators have no
// faces and the counts span the whole window; the gov actors beyond the faces
// fold into a "+N" tail. Renders nothing when the label is null.
import ActiveFaces from '@/components/ActiveFaces.astro';
import type { ActiveFace } from '@/lib/forum/activeFaces.js';
import { activeLabel } from '@/lib/forum/view.js';

interface Props {
  faces: ActiveFace[];
  counts: { actors: number; dreps: number; spos: number; delegators: number };
}
const { faces, counts } = Astro.props;
const heading = activeLabel(counts);
---

{heading && (
  <section class="raf" aria-labelledby="raf-title">
    <p class="raf__title" id="raf-title">{heading}</p>
    <ActiveFaces faces={faces} actorCount={counts.actors} />
  </section>
)}

<style>
  .raf { margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  .raf__title {
    font-size: 0.95rem; font-weight: 600; color: var(--fg); margin: 0 0 1.25rem;
    font-variant-numeric: tabular-nums;
  }
</style>
