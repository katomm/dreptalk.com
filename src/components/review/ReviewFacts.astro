---
// The four headline figures of an edition, straight from its frontmatter.
interface Props {
  facts: ReadonlyArray<{ value: string; label: string }>;
}
const { facts } = Astro.props;
---

<div class="rv-facts">
  {
    facts.map((f) => (
      <div class="rv-fact">
        <div class="rv-fact__v">{f.value}</div>
        <div class="rv-fact__l">{f.label}</div>
      </div>
    ))
  }
</div>

<style>
  .rv-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin: 0 0 1.75rem; }
  .rv-fact { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.85rem 1rem; }
  .rv-fact__v { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .rv-fact__l { font-size: 0.8rem; color: var(--muted); margin-top: 0.35rem; line-height: 1.3; }
</style>
