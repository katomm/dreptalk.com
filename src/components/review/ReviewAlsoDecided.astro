---
// The actions of the window that the article does not walk through itself. The
// featured ones are covered in the body, so they are left out of the decided
// table. The open table keeps all of its rows: an action that was still being
// voted on has no outcome anywhere else on the page, featured or not.
import type { ActionRow } from '@/lib/review/schema.js';
import { govActionHref } from '@/lib/review/links.js';

interface Props {
  rows: readonly ActionRow[];
  open: readonly ActionRow[];
  featured: readonly string[];
  epochTo: number;
}
const { rows, open, featured, epochTo } = Astro.props;
const shown = rows.filter((r) => !featured.includes(r.id));

// "Enacted 650", "Expired 651", and for an action still in its voting window the
// state it was in when the window closed.
function outcomeLabel(row: ActionRow): string {
  if (row.outcome === 'open') return openLabel(row);
  return `${row.outcome[0].toUpperCase()}${row.outcome.slice(1)} ${row.epoch}`;
}

// An open row carries its expiry epoch. Voting on an action ends at the start of
// its expiry epoch, so an action expiring one epoch after the window was still
// open at the last moment this edition can report on, and every other one has a
// voting window that outlives the edition.
function openLabel(row: ActionRow): string {
  if (row.epoch === epochTo + 1) return `Undecided at the close of epoch ${epochTo}`;
  return `Voting ends at the start of epoch ${row.epoch}`;
}

// A stored share is only printed when it is a share of this window. A row that
// carries a note prints n/a instead, and the note under the table says why, so
// a number the reader cannot use is never dressed up as one they can.
function yesPct(row: ActionRow): string {
  if (row.drepYesPctNote != null || row.drepYesPct === null) return 'n/a';
  return `${row.drepYesPct.toFixed(1)}%`;
}

const NOTE_TEXT: Record<'not-applicable' | 'later-tally', string> = {
  'not-applicable': 'n/a: DReps had no vote on this action under the rules then in force, so the record stores no share of theirs.',
  'later-tally': 'n/a: the record holds no DRep share from inside this window for this action, only a tally read after it closed.',
};

// One line per reason actually used, in a fixed order so the wording of a page
// does not depend on the order of its rows.
function notesFor(all: readonly ActionRow[]): string[] {
  const used = new Set(all.map((r) => r.drepYesPctNote).filter((n): n is 'not-applicable' | 'later-tally' => n != null));
  return (['not-applicable', 'later-tally'] as const).filter((k) => used.has(k)).map((k) => NOTE_TEXT[k]);
}
const decidedNotes = notesFor(shown);
const openNotes = notesFor(open);
---

{
  shown.length > 0 && (
    <section class="rv-also">
      <h2>Also decided</h2>
      <div class="rv-also__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Action</th>
              <th scope="col">Outcome</th>
              <th scope="col">DRep yes</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((row) => (
              <tr>
                <td>
                  <a href={govActionHref(row.id)}>{row.title}</a>
                </td>
                <td>
                  <span class={`rv-pill rv-pill--${row.outcome}`}>{outcomeLabel(row)}</span>
                </td>
                <td class="rv-num">{yesPct(row)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {decidedNotes.map((n) => (
        <p class="rv-also__note">{n}</p>
      ))}
    </section>
  )
}

{
  open.length > 0 && (
    <section class="rv-also">
      <h2>Open at the close of the window</h2>
      <div class="rv-also__scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Action</th>
              <th scope="col">Status</th>
              <th scope="col">DRep yes</th>
            </tr>
          </thead>
          <tbody>
            {open.map((row) => (
              <tr>
                <td>
                  <a href={govActionHref(row.id)}>{row.title}</a>
                </td>
                <td>
                  <span class="rv-pill rv-pill--open">{openLabel(row)}</span>
                </td>
                <td class="rv-num">{yesPct(row)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {openNotes.map((n) => (
        <p class="rv-also__note">{n}</p>
      ))}
    </section>
  )
}

<style>
  .rv-also { margin: 2.5rem 0 0; }
  .rv-also h2 { font-size: 1.25rem; margin: 0 0 0.75rem; }
  .rv-also__scroll { overflow-x: auto; }
  .rv-also__note { font-size: 0.82rem; color: var(--muted); line-height: 1.5; margin: 0.6rem 0 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { text-align: left; font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 0 0.6rem 0.5rem 0; }
  td { padding: 0.6rem 0.6rem 0.6rem 0; border-top: 1px solid var(--border); vertical-align: top; }
  th:last-child, td:last-child { padding-right: 0; text-align: right; }
  .rv-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rv-pill { display: inline-block; white-space: nowrap; font-size: 0.78rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); color: var(--muted); }
  .rv-pill--enacted, .rv-pill--ratified { color: var(--fg); }
    /* The open status is a sentence, not a one-word outcome, so it wraps on a
     narrow screen and takes a rectangle rather than a pill's 999px radius. */
  .rv-pill--open { border-color: var(--accent); color: var(--accent); white-space: normal; border-radius: var(--radius-sm); }
</style>
