---
// One edition as a card. Used by the review index and by the homepage teaser,
// which passes compact to drop the fact tiles.
import ReviewFacts from '@/components/review/ReviewFacts.astro';
import { editionSlug, formatWindowDates, type Edition } from '@/lib/review/editions.js';
import type { NetworkConfig } from '@/lib/config/network.js';

interface Props {
  edition: Edition;
  cfg: NetworkConfig;
  compact?: boolean;
}
const { edition, cfg, compact = false } = Astro.props;
const d = edition.data;
const href = `/governance-review/${editionSlug(edition)}/`;
---

<article class="rv-card">
  <p class="rv-card__kicker">
    <span>Epochs {d.epochFrom} to {d.epochTo}</span>
    <span aria-hidden="true">·</span>
    <span>{formatWindowDates(d.epochFrom, d.epochTo, cfg)}</span>
  </p>
  <h2 class="rv-card__title"><a href={href}>{d.title}</a></h2>
  <p class="rv-card__stand">{d.standfirst}</p>
  {!compact && <ReviewFacts facts={d.facts} />}
</article>

<style>
  .rv-card { border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .rv-card__kicker { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.5rem; }
  .rv-card__title { font-size: clamp(1.3rem, 3vw, 1.7rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 0.5rem; text-wrap: balance; }
  .rv-card__title a { color: inherit; text-decoration: none; }
  .rv-card__title a:hover { color: var(--accent); }
  .rv-card__stand { color: var(--muted); line-height: 1.55; margin: 0 0 1.25rem; max-width: 62ch; }
</style>
