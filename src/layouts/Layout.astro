---
import '@/styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = 'Wallet-authenticated forum for Cardano governance.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const pathname = Astro.url.pathname;
const navLinks = [
  { label: 'Governance Actions', href: '/c/governance-actions' },
  { label: 'Discussions', href: '/' },
  { label: 'DReps', href: '#' },
  { label: 'About', href: '#' },
];
// The home page is the entry point for governance actions, so mark that link
// active there; otherwise highlight whichever link matches the current path.
const isActive = (href: string) =>
  href === '/c/governance-actions' ? pathname === '/' || pathname.startsWith('/c/governance-actions') : href !== '#' && href !== '/' && pathname === href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo-96.png" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="DRepTalk" />
    <meta name="twitter:card" content="summary_large_image" />
    {analyticsToken && (
      // SRI is omitted here intentionally: Cloudflare pushes beacon.min.js
      // updates in place with no version pin, so a fixed hash would break
      // analytics silently on every Cloudflare deploy. The CSP already limits
      // this script to the specific origin (static.cloudflareinsights.com).
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner container">
        <a class="brand" href="/" aria-label="DRepTalk home">
          <img class="brand__mark" src="/logo-mark.png" alt="" width="34" height="38" />
          <span class="brand__word">DRep<span class="grad-text">Talk</span></span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              class="site-nav__link"
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >{link.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <ThemeToggle />
          <a class="site-nav__signin" href="/login">Sign in</a>
          <a class="btn btn-primary header-actions__cta" href="/login">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            DRep only access
          </a>

          <details class="mobile-menu">
            <summary class="mobile-menu__btn" aria-label="Open menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
              </svg>
            </summary>
            <div class="mobile-menu__panel">
              {navLinks.map((link) => (
                <a
                  class="mobile-menu__link"
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >{link.label}</a>
              ))}
              <a class="mobile-menu__link" href="/login">Sign in</a>
              <a class="btn btn-primary mobile-menu__cta" href="/login">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                DRep only access
              </a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner container">
        <div class="site-footer__brand">
          <a class="brand" href="/" aria-label="DRepTalk home">
            <img class="brand__mark" src="/logo-mark.png" alt="" width="32" height="36" />
            <span class="brand__word">DRep<span class="grad-text">Talk</span></span>
          </a>
          <p class="site-footer__tagline">A calmer, accountable home for Cardano governance.</p>
        </div>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="https://github.com/katomm/dreptalk.com" rel="noopener" target="_blank">GitHub</a>
        </nav>
        <p class="site-footer__copy">© {new Date().getFullYear()} DRepTalk</p>
      </div>
    </footer>

    <style>
      /* ---- Header ------------------------------------------------------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        flex-shrink: 0;
      }
      .brand__mark {
        height: 38px;
        width: auto;
        display: block;
      }
      .brand__word {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
        color: var(--fg);
        line-height: 1;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
      }
      .site-nav__link {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        padding: 0.45rem 0.7rem;
        border-radius: var(--radius-sm);
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .site-nav__link:hover {
        color: var(--fg);
        background: var(--surface);
      }
      .site-nav__link[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
      }
      .site-nav__signin {
        color: var(--fg);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        padding: 0.45rem 0.5rem;
        border-radius: var(--radius-sm);
        transition: color 0.15s ease;
      }
      .site-nav__signin:hover {
        color: var(--accent);
      }

      /* ---- Mobile menu -------------------------------------------------- */
      .mobile-menu {
        display: none;
        position: relative;
      }
      .mobile-menu__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--surface);
        color: var(--fg);
        cursor: pointer;
        list-style: none;
      }
      .mobile-menu__btn::-webkit-details-marker {
        display: none;
      }
      .mobile-menu[open] .mobile-menu__btn {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mobile-menu__panel {
        position: absolute;
        right: 0;
        top: calc(100% + 0.6rem);
        min-width: 220px;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.5rem;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
      }
      .mobile-menu__link {
        color: var(--fg);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        padding: 0.6rem 0.7rem;
        border-radius: var(--radius-sm);
      }
      .mobile-menu__link:hover {
        background: var(--surface);
      }
      .mobile-menu__link[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }
      .mobile-menu__cta {
        margin-top: 0.4rem;
        width: 100%;
      }

      /* ---- Footer ------------------------------------------------------- */
      .site-footer {
        margin-top: 5rem;
        border-top: 1px solid var(--border);
        background: var(--surface);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 2rem;
        padding-top: 2.25rem;
        padding-bottom: 2.25rem;
      }
      .site-footer__brand {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-right: auto;
      }
      .site-footer__brand .brand__mark {
        height: 34px;
      }
      .site-footer__brand .brand__word {
        font-size: 1.1rem;
      }
      .site-footer__tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
      }
      .site-footer__links {
        display: flex;
        gap: 1.25rem;
      }
      .site-footer__links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
      }
      .site-footer__links a:hover {
        color: var(--fg);
      }
      .site-footer__copy {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
        width: 100%;
      }

      /* ---- Responsive --------------------------------------------------- */
      @media (max-width: 820px) {
        .site-nav,
        .site-nav__signin,
        .header-actions__cta {
          display: none;
        }
        .header-actions {
          margin-left: auto;
        }
        .mobile-menu {
          display: block;
        }
      }
    </style>
  </body>
</html>
