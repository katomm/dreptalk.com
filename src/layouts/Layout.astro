---
import '@/styles/global.css';
import themeInit from '@/scripts/theme-init.js?raw';
import badgeSync from '@/scripts/badge-sync.js?raw';
import ThemeToggle from '@/components/ThemeToggle.astro';
import SearchTrigger from '@/components/search/SearchTrigger';
import RoleEntry from '@/components/RoleEntry.astro';
import JsonLd from '@/components/JsonLd.astro';
import LogoMark from '@/components/LogoMark.astro';
import ShareButton from '@/components/ShareButton.astro';
import { currentNetwork } from '@/lib/api/response';
import { NAV_LINKS } from '@/lib/config/nav.js';
import type { AuthorDescriptor } from '@/lib/forum/author';
import { loadSessionHeader } from '@/lib/forum/sessionHeader';
import { getHelpEntries } from '@/lib/search/helpEntries.js';
import type { HelpEntry } from '@/lib/search/staticEntries.js';
import { scopeForPath, type Scope } from '@/lib/search/scopes.js';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Widen the header, content, and footer to the app-shell max, for list and
      table pages that benefit from the extra room. Text pages stay narrower. */
  wide?: boolean;
  /** Narrow only the main content to a comfortable reading column (the nav and
      footer keep their normal width). For single-column reading pages. */
  readingWidth?: boolean;
  /** Scope pill the search palette opens with on this page. Omit to derive it
      from the current path via scopeForPath (e.g. listing pages preselect
      their own scope, everything else falls back to "all"). Pass explicitly
      only to override that derivation. */
  searchScope?: Scope;
  /** Same-origin image URL to preload with high priority. Used by profile pages
      to fetch the hero avatar early: it renders as a CSS background-image, which
      the browser would otherwise discover late (after layout) at low priority,
      making it a slow LCP element. The preload matches the same URL, so no
      double fetch. Pass null when no stored avatar exists (identicon fallback). */
  preloadImage?: string | null;
}
const { title, description = 'Wallet-authenticated forum for Cardano governance.', noindex = false, ogImage = '/og.jpg', wide = false, readingWidth = false, searchScope, preloadImage = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// og:url and og:image must resolve on the host that actually served the page. On
// preprod that is preprod.dreptalk.com, so build them from the request origin
// rather than the hard-coded mainnet Astro.site. canonical stays on the stable
// apex on purpose (SEO), and on mainnet the request origin equals Astro.site so
// nothing changes there.
// The <title> keeps the "- DRepTalk" suffix (browser tab, search results), but a
// link preview already shows the domain and the brand on the card, so the suffix
// is dropped from og:title to give the actual title the full width.
const ogTitle = title.replace(/\s-\sDRepTalk$/, '');
const ogUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImageUrl = new URL(ogImage, Astro.url.origin).href;
// Declare the OG image MIME from its extension: the site mixes JPEG cards
// (overviews, default) with the per-type PNG governance cards, so a single
// hard-coded type would be wrong for half of them. Read the extension from the
// parsed pathname so a cache-busting `?v=` query on a card URL is ignored.
const ogImageType = new URL(ogImageUrl).pathname.endsWith('.png') ? 'image/png' : 'image/jpeg';
// Cloudflare Web Analytics beacon token. The token is public by design: the
// beacon embeds it in the page HTML for every visitor, so it is committed here
// instead of being configured per environment. Gated on import.meta.env.PROD so
// local `astro dev` views are not counted; every production build (mainnet and
// preprod, which share the build output) ships the beacon.
const analyticsToken = import.meta.env.PROD ? 'ae56036d282048ea9265882a755721ff' : undefined;

// Active Cardano network, used for the preprod testnet flag below.
const net = currentNetwork();

// Site-wide Organization schema, emitted on every page.
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DRepTalk',
  url: Astro.site?.href ?? 'https://dreptalk.com/',
  logo: new URL('/logo.png', Astro.site).href,
};

// Resolve the signed-in identity (name, avatar, DRep profile link) and the
// header bell's unread count together, through the request-scoped memo, so a
// page that already loaded the pair (e.g. /home/) shares the queries instead
// of paying a second set. Both RoleEntry instances (desktop pill and mobile
// menu) receive the identity. Signed-out and prerendered renders skip the
// lookup entirely.
const sessionUser = Astro.locals.user;
const [account, unreadCount]: [AuthorDescriptor | null, number] = sessionUser
  ? await loadSessionHeader(Astro.locals, sessionUser.id)
  : [null, 0];

const pathname = Astro.url.pathname;
const navLinks = NAV_LINKS;
// Highlight the link whose path prefixes the current page. A nav href may carry a
// query (e.g. a default filter), so match on the path portion only.
const isActive = (href: string) => {
  // Nav hrefs carry the canonical trailing slash (and may carry a query); match
  // on the path portion, comparing both sides without a trailing slash so a link
  // stays highlighted on its own page and on any sub-page.
  const path = href.split('?')[0].replace(/\/$/, '');
  const current = pathname.replace(/\/$/, '');
  return current === path || current.startsWith(path + '/');
};

const helpEntries: HelpEntry[] = await getHelpEntries();
---
<!doctype html>
<html lang="en" data-notif-unread={sessionUser ? String(unreadCount) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    {/* Standalone/installed title-bar and browser-chrome color. A single tag kept
        in sync with the manual theme toggle by theme-init.js, so it stays correct
        even when the user forces a theme against the OS scheme. */}
    <meta name="theme-color" content="#0c0a12" />
    {/* Installed home-screen app: run standalone with a fixed app title. The
        manifest's display:standalone drives the mode; these refine iOS. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="DRepTalk" />
    {/* Inlined (not external) to avoid a render-blocking request before first
        paint. Its CSP hash is added in astro.config.mjs and only ships on the
        Worker-rendered (SSR) CSP header, so pages using this layout must stay
        SSR: a prerendered page gets the hash-less /* CSP from public/_headers,
        which would block this script. Keep pages off `export const prerender`. */}
    <script is:inline set:html={themeInit} />
    {/* Syncs the installed app's icon badge to the signed-in unread count (read
        off <html data-notif-unread>), and clears it when signed out. Inlined for
        the same CSP reason as theme-init above; its hash ships on the SSR header. */}
    <script is:inline set:html={badgeSync} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="DRepTalk" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <JsonLd data={organizationLd} />
    {analyticsToken && (
      // SRI is omitted here intentionally: Cloudflare pushes beacon.min.js
      // updates in place with no version pin, so a fixed hash would break
      // analytics silently on every Cloudflare deploy. The CSP already limits
      // this script to the specific origin (static.cloudflareinsights.com).
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
    {/* Named slot for page-specific head elements that must live in <head> and
        cannot go through the default slot (which renders inside <main>), e.g.
        a discovery <link rel="alternate">. Empty on every page that does not
        pass one. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {net.network === 'preprod' && (
      <span class="preprod-flag" role="status">⚠ Preprod testnet</span>
    )}
    <header class="site-header">
      {/* Header and footer keep one fixed width on every page (the wide shell),
          while main varies per page type (reading / default / wide). If they
          followed the page's `wide` prop, the logo and nav links would shift
          sideways on every navigation between list and detail pages. */}
      <div class="site-header__inner container container--wide">
        <a class="brand" href="/" aria-label="DRepTalk home">
          <LogoMark style="height:38px;width:38px;color:var(--muted)" />
          <span class="brand__word">DRep<span class="grad-text">Talk</span></span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              class="site-nav__link"
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >{link.shortLabel ? (
              <>
                <span class="site-nav__label--full">{link.label}</span>
                <span class="site-nav__label--short">{link.shortLabel}</span>
              </>
            ) : link.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <SearchTrigger client:idle helpEntries={helpEntries} initialScope={searchScope ?? scopeForPath(pathname)} />
          {/* Share the current page. Only shown in the installed standalone app,
              where there is no address bar to copy or share the URL from. */}
          <span class="header-share"><ShareButton iconOnly ariaLabel="Share this page" /></span>
          <ThemeToggle />
          {sessionUser && (
            <a
              class="notif-bell"
              href="/notifications/"
              aria-label={unreadCount > 0 ? `Notifications, ${unreadCount} unread` : 'Notifications'}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
              </svg>
              {unreadCount > 0 && <span class="notif-bell__badge">{unreadCount > 9 ? '9+' : unreadCount}</span>}
            </a>
          )}
          <div class="header-actions__cta">
            <RoleEntry account={account} />
          </div>

          <details class="mobile-menu" data-auto-dismiss>
            <summary class="mobile-menu__btn" aria-label="Open menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6" />
                <line x1="3" y1="12" x2="21" y2="12" />
                <line x1="3" y1="18" x2="21" y2="18" />
              </svg>
            </summary>
            <div class="mobile-menu__panel">
              {navLinks.map((link) => (
                <a
                  class="mobile-menu__link"
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >{link.label}</a>
              ))}
              <RoleEntry layout="flat" account={account} />
              {/* Install entry: a plain link to the guide by default, so it works
                  on iOS, Firefox, etc. without browser sniffing; Chromium's
                  beforeinstallprompt upgrades it to the native install prompt.
                  Hidden once already installed. */}
              <a class="mobile-menu__link install-hint" data-install-hint href="/help/add-to-home-screen/">
                Install app
              </a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class:list={['container', { 'container--wide': wide, 'container--reading': readingWidth }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner container container--wide">
        <div class="site-footer__brand">
          <a class="brand" href="/" aria-label="DRepTalk home">
            <LogoMark style="height:34px;width:34px;color:var(--muted)" />
            <span class="brand__word">DRep<span class="grad-text">Talk</span></span>
          </a>
          <p class="site-footer__tagline">A calmer, accountable home for Cardano governance.</p>
        </div>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="/help/">Help</a>
          <a href="/privacy/">Privacy</a>
          <a href="/imprint/">Imprint</a>
          <a
            class="site-footer__github"
            href="https://x.com/dreptalkcom"
            rel="noopener"
            target="_blank"
            aria-label="DRepTalk on X"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            class="site-footer__github"
            href="https://github.com/katomm/dreptalk.com"
            rel="noopener"
            target="_blank"
            aria-label="DRepTalk on GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.75.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
            </svg>
          </a>
        </nav>
      </div>
    </footer>

    <script>
      // Native <details> only toggles via its own <summary>, so any floating
      // dropdown built on one (the header account/sign-in pill, the mobile menu,
      // the governance list's Sort/Type controls) would stay open, overlaying
      // the page, until reclicked. Dismiss every open [data-auto-dismiss] menu on
      // an outside click, on Escape, and on scroll (the sticky header keeps an
      // open panel pinned over the content below). Bundled once; the strict CSP
      // forbids inline handlers.
      const OPEN = 'details[data-auto-dismiss][open]';

      function closeMenus(keepFor?: EventTarget | null) {
        // Keep a menu open only when the interaction happened inside it (e.g. a
        // scroll within the panel); anything else, including a non-Node target
        // like window, closes it.
        for (const details of document.querySelectorAll<HTMLDetailsElement>(OPEN)) {
          if (keepFor instanceof Node && details.contains(keepFor)) continue;
          details.open = false;
        }
      }

      document.addEventListener('click', (event) => closeMenus(event.target));
      window.addEventListener('scroll', (event) => closeMenus(event.target), true);
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const open = document.querySelector<HTMLDetailsElement>(OPEN);
        if (!open) return;
        closeMenus();
        open.querySelector<HTMLElement>('summary')?.focus();
      });
    </script>

    <script>
      // One delegated copy-to-clipboard listener for every .copy-btn[data-copy]
      // on the page, i.e. the SSR CopyButton (src/components/CopyButton.astro).
      // Global here so a button works even on pages that mount it in a fragment.
      // Bundled once; the strict CSP forbids inline handlers. React CopyButton
      // islands set their own onClick and carry no data-copy, so they are ignored.
      document.addEventListener('click', (event) => {
        const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('.copy-btn[data-copy]');
        const value = btn?.dataset.copy;
        if (!btn || value == null) return;
        navigator.clipboard
          .writeText(value)
          .then(() => {
            btn.classList.add('is-copied');
            setTimeout(() => btn.classList.remove('is-copied'), 1500);
          })
          .catch(() => {
            // Clipboard can be blocked (no permission / insecure context); ignore.
          });
      });
    </script>

    <script>
      // Deep-link a single item (a shared vote+rationale link, #voter-<id> on the
      // Positions tab or #vote-<gaId> on a profile). The browser's native hash
      // scroll cannot open a collapsed <details> row, so on load and on hashchange
      // we expand the target and every <details> around it (a row's own expansion
      // plus any "show more" fold), scroll it into view, and flash a highlight.
      function revealHashTarget() {
        const raw = location.hash.slice(1);
        if (!raw) return;
        let id: string;
        try {
          id = decodeURIComponent(raw);
        } catch {
          id = raw;
        }
        const el = document.getElementById(id);
        if (!el) return;
        // Open the target if it is a <details>, plus every ancestor <details>.
        for (let node: Element | null = el; node; node = node.parentElement) {
          if (node instanceof HTMLDetailsElement) node.open = true;
        }
        // Open the row's own expansion when the anchor sits on a wrapper (the
        // Positions tab puts the id on the <li>, the <details> is its child).
        for (const d of el.querySelectorAll('details')) d.open = true;
        // Expand first, then scroll, so the final position accounts for the row
        // having opened. scroll-margin-top on the targets keeps it clear of the
        // sticky header.
        el.scrollIntoView({ block: 'start' });
        el.classList.remove('is-share-target');
        // Force a reflow so re-adding the class restarts the flash animation when
        // the same link is followed twice in a row.
        void (el as HTMLElement).offsetWidth;
        el.classList.add('is-share-target');
      }
      addEventListener('hashchange', revealHashTarget);
      if (document.readyState === 'loading') {
        addEventListener('DOMContentLoaded', revealHashTarget);
      } else {
        revealHashTarget();
      }
    </script>

    <script>
      // "Install app" entry in the mobile menu. It is a plain link to the guide
      // by default (so iOS, Firefox, etc. get sensible manual instructions with
      // no browser sniffing). On Chromium, beforeinstallprompt is deferred and
      // the entry fires the native install prompt instead of following the link.
      // Hidden when already installed. Bundled once; the strict CSP forbids
      // inline handlers.
      import { isStandaloneApp } from '@/scripts/standalone.js';

      interface InstallPromptEvent extends Event {
        prompt: () => Promise<void>;
        userChoice: Promise<{ outcome: string }>;
      }
      const installEntry = document.querySelector<HTMLAnchorElement>('[data-install-hint]');
      if (installEntry) {
        if (isStandaloneApp()) {
          installEntry.hidden = true;
        } else {
          let deferredPrompt: InstallPromptEvent | null = null;
          window.addEventListener('beforeinstallprompt', (event) => {
            event.preventDefault();
            deferredPrompt = event as InstallPromptEvent;
          });
          installEntry.addEventListener('click', (event) => {
            if (!deferredPrompt) return; // no native prompt: the link opens the guide
            event.preventDefault();
            const dp = deferredPrompt;
            deferredPrompt = null;
            void dp.prompt();
            void dp.userChoice.catch(() => {});
          });
          window.addEventListener('appinstalled', () => {
            installEntry.hidden = true;
          });
        }
      }
    </script>

    <script>
      // Pull-to-refresh for the installed iOS app. iOS home-screen apps have no
      // address bar, no reload button, and no native pull gesture, so without
      // this the only way to refresh a page is relaunching the app. Android
      // standalone keeps Chrome's built-in pull-to-refresh and browser tabs
      // have their own reload UI, so the script stays inert everywhere else.
      // Styles live in global.css (.ptr-indicator): the stylesheet owns all
      // position/opacity math, the script only writes the --ptr-pull and
      // --ptr-progress custom properties and toggles state classes. Bundled;
      // the strict CSP forbids inline handlers.
      import { isStandaloneApp } from '@/scripts/standalone.js';

      // iPadOS reports itself as macOS; the touch-point count tells them apart.
      const ptrIOS =
        /iPhone|iPad|iPod/.test(navigator.userAgent) ||
        (navigator.userAgent.includes('Mac') && navigator.maxTouchPoints > 1);
      if (isStandaloneApp() && ptrIOS) {
        // Distances are in damped pixels: raw finger travel past the slop is
        // multiplied by 0.5, so arming takes ~120px of actual pull.
        const SLOP = 10;
        const DAMPING = 0.5;
        const THRESHOLD = 55;
        const MAX_PULL = 90;

        // Created on the first engaged pull, not on page load: most page views
        // never pull, and as an MPA every navigation would otherwise pay for it.
        let indicator: HTMLDivElement | null = null;
        function getIndicator(): HTMLDivElement {
          if (!indicator) {
            indicator = document.createElement('div');
            indicator.className = 'ptr-indicator';
            indicator.setAttribute('aria-hidden', 'true');
            indicator.innerHTML =
              '<svg class="ptr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" /></svg>' +
              '<svg class="ptr-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9" stroke-dasharray="42" stroke-dashoffset="14" /></svg>';
            document.body.appendChild(indicator);
          }
          return indicator;
        }

        let startX = 0;
        let startY = 0;
        let startTarget: EventTarget | null = null;
        let tracking = false;
        let engaged = false;
        let refreshing = false;
        let distance = 0;

        const scroller = () => document.scrollingElement || document.documentElement;

        // A pull that starts inside a scrollable panel (an open dropdown, an
        // overflowing code block) should scroll that panel, never refresh.
        function insideNestedScroller(from: EventTarget | null): boolean {
          let node = from instanceof Element ? from : null;
          for (; node && node !== document.body; node = node.parentElement) {
            if (node.scrollHeight > node.clientHeight + 1) {
              const overflowY = getComputedStyle(node).overflowY;
              if (overflowY === 'auto' || overflowY === 'scroll') return true;
            }
          }
          return false;
        }

        function render() {
          const el = getIndicator();
          el.style.setProperty('--ptr-pull', `${distance}px`);
          el.style.setProperty('--ptr-progress', String(Math.min(distance / THRESHOLD, 1)));
          el.classList.toggle('is-armed', distance >= THRESHOLD);
        }

        // Clearing the inline custom properties lets the stylesheet's resting
        // (or .is-refreshing) values take over, animated via .is-settling.
        function settleBack() {
          engaged = false;
          distance = 0;
          const el = getIndicator();
          el.classList.add('is-settling');
          el.classList.remove('is-armed');
          el.style.removeProperty('--ptr-pull');
          el.style.removeProperty('--ptr-progress');
        }

        function onTouchMove(event: TouchEvent) {
          if (!tracking) return;
          if (event.touches.length !== 1) {
            tracking = false;
            if (engaged) settleBack();
            return;
          }
          const dx = event.touches[0].clientX - startX;
          const dy = event.touches[0].clientY - startY;
          if (!engaged) {
            // Upward or mostly-horizontal movement is a scroll or swipe (a
            // negative dy always fails this test).
            if (Math.abs(dx) > dy) {
              tracking = false;
              return;
            }
            if (dy < SLOP) return;
            // The costlier qualification runs once per actual pull, not on
            // every tap: no refresh once the page has scrolled, while an
            // overlay is up (native dialogs, the search palette and other
            // role="dialog" overlays, which only exist in the DOM while
            // open), or from inside a scrollable panel.
            if (
              scroller().scrollTop > 0 ||
              document.querySelector('dialog[open], [role="dialog"]') ||
              insideNestedScroller(startTarget)
            ) {
              tracking = false;
              return;
            }
            engaged = true;
            getIndicator().classList.remove('is-settling');
          }
          // Suppress the iOS rubber-band bounce while the indicator follows
          // the finger. Normal scrolling is untouched: the listener returns
          // above before ever calling preventDefault.
          event.preventDefault();
          distance = Math.min((dy - SLOP) * DAMPING, MAX_PULL);
          render();
        }

        function onRelease() {
          document.removeEventListener('touchmove', onTouchMove);
          document.removeEventListener('touchend', onRelease);
          document.removeEventListener('touchcancel', onRelease);
          if (!tracking) return;
          tracking = false;
          if (!engaged) return;
          if (distance >= THRESHOLD) {
            refreshing = true;
            const el = getIndicator();
            el.classList.add('is-refreshing', 'is-settling');
            el.style.removeProperty('--ptr-pull');
            el.style.removeProperty('--ptr-progress');
            location.reload();
          } else {
            settleBack();
          }
        }

        document.addEventListener(
          'touchstart',
          (event) => {
            if (refreshing || tracking || event.touches.length !== 1) return;
            if (scroller().scrollTop > 0) return;
            tracking = true;
            engaged = false;
            startX = event.touches[0].clientX;
            startY = event.touches[0].clientY;
            startTarget = event.target;
            // The non-passive move listener exists only for the duration of a
            // gesture that began at the top of the page; ordinary scrolling
            // elsewhere never has a non-passive touch listener registered.
            document.addEventListener('touchmove', onTouchMove, { passive: false });
            document.addEventListener('touchend', onRelease, { passive: true });
            document.addEventListener('touchcancel', onRelease, { passive: true });
          },
          { passive: true },
        );
      }
    </script>

    <style>
      /* Preprod testnet flag: a fixed pill shown only on the preprod deployment
         so the test network is unmistakable. Hidden on mainnet. */
      .preprod-flag {
        position: fixed;
        bottom: max(12px, env(safe-area-inset-bottom, 0px));
        right: max(12px, env(safe-area-inset-right, 0px));
        z-index: 50;
        background: #fde68a;
        color: #7c5800;
        border: 1px solid #f0c000;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 700;
      }
      /* ---- Header ------------------------------------------------------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--border);
        /* In the installed standalone app the header can sit under the device
           status bar / notch; the inset is 0 in a normal browser tab. */
        padding-top: env(safe-area-inset-top, 0px);
      }
      /* Header share control: only meaningful in the installed standalone app,
         where there is no address bar to copy or share the URL from. Hidden in
         a normal browser tab. */
      .header-share {
        display: none;
        align-items: center;
      }
      @media (display-mode: standalone) {
        .header-share {
          display: inline-flex;
        }
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        flex-shrink: 0;
      }
      .brand__word {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
        /* "DRep" muted like the mark; only "Talk" (.grad-text) keeps the gradient. */
        color: var(--muted);
        line-height: 1;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
      }
      .site-nav__link {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        padding: 0.45rem 0.7rem;
        border-radius: var(--radius-sm);
        /* A nav label never breaks into two lines; where space runs out the
           compact label below takes over instead. */
        white-space: nowrap;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      /* Compact-label swap: the full label yields to the short one in the zone
         between the mobile menu cutoff (820px) and a comfortably wide header. */
      .site-nav__label--short {
        display: none;
      }
      @media (max-width: 1080px) {
        .site-nav__label--full {
          display: none;
        }
        .site-nav__label--short {
          display: inline;
        }
      }
      .site-nav__link:hover {
        color: var(--fg);
        background: var(--surface);
      }
      .site-nav__link[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
      }
      /* Wrapper owns the responsive hide so the scoped media query below can
         match it (the RoleEntry root carries its own component scope). */
      .header-actions__cta {
        display: inline-flex;
        align-items: center;
      }
      .notif-bell {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        color: var(--muted);
        border: 1px solid var(--border);
        background: var(--surface);
      }
      .notif-bell:hover {
        color: var(--fg);
      }
      .notif-bell__badge {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-size: 0.625rem;
        font-weight: 700;
        line-height: 16px;
        text-align: center;
      }
      /* ---- Mobile menu -------------------------------------------------- */
      .mobile-menu {
        display: none;
        position: relative;
      }
      .mobile-menu__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--surface);
        color: var(--fg);
        cursor: pointer;
        list-style: none;
      }
      .mobile-menu__btn::-webkit-details-marker {
        display: none;
      }
      .mobile-menu[open] .mobile-menu__btn {
        border-color: var(--accent);
        color: var(--accent);
      }
      .mobile-menu__panel {
        position: absolute;
        right: 0;
        top: calc(100% + 0.6rem);
        min-width: 220px;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.5rem;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
      }
      .mobile-menu__link {
        color: var(--fg);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 500;
        padding: 0.6rem 0.7rem;
        border-radius: var(--radius-sm);
      }
      .mobile-menu__link:hover {
        background: var(--surface);
      }
      .mobile-menu__link[aria-current='page'] {
        color: var(--accent);
        font-weight: 600;
      }

      /* ---- Footer ------------------------------------------------------- */
      .site-footer {
        margin-top: 5rem;
        border-top: 1px solid var(--border);
        background: var(--surface);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 2rem;
        padding-top: 2.25rem;
        /* Clear the home indicator on notched phones in the installed app; the
           inset is 0 in a normal browser tab. */
        padding-bottom: calc(2.25rem + env(safe-area-inset-bottom, 0px));
      }
      .site-footer__brand {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-right: auto;
      }
      .site-footer__brand .brand__word {
        font-size: 1.1rem;
      }
      .site-footer__tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
      }
      .site-footer__links {
        display: flex;
        gap: 1.25rem;
      }
      .site-footer__links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
      }
      .site-footer__links a:hover {
        color: var(--fg);
      }
      .site-footer__github {
        display: inline-flex;
        align-items: center;
      }

      /* ---- Responsive --------------------------------------------------- */
      @media (max-width: 820px) {
        .site-nav,
        .header-actions__cta {
          display: none;
        }
        .header-actions {
          margin-left: auto;
        }
        .mobile-menu {
          display: block;
        }
      }

      /* Very narrow screens: the action row (search, theme, bell, burger)
         must fit beside the brand; tighter gaps, the search label is hidden
         via global.css. */
      @media (max-width: 480px) {
        .header-actions {
          gap: 0.35rem;
        }
        .site-header__inner {
          gap: 0.5rem;
        }
      }
    </style>
  </body>
</html>
