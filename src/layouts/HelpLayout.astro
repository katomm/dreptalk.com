---
// Shared chrome for the long-form content sections (help guides, glossary):
// breadcrumb, heading, optional "Last updated" line, and the prose styling
// for the rendered markdown in the slot.
import Layout from '@/layouts/Layout.astro';
import GlossaryTerms from '@/components/glossary/GlossaryTerms.astro';
import { isoDate } from '@/lib/format/date.js';

interface Props {
  title: string;
  description?: string;
  // Breadcrumb label for this page (the trailing "DRepTalk / {parent} / {crumb}" segment).
  crumb: string;
  // h1 text; defaults to the breadcrumb label when the two are the same.
  heading?: string;
  // Per-page OG card; Layout falls back to the site default when absent.
  ogImage?: string;
  // Middle breadcrumb segment; defaults to the help hub, the glossary passes its own.
  parent?: { href: string; label: string };
  // When set, renders a "Last updated" line above the content.
  updated?: Date;
  // Mark glossary terms in the prose with definition tooltips. Off on the
  // glossary's own pages, which are already densely cross-linked.
  glossaryTerms?: boolean;
  // URL of a decorative header illustration, at /help/<id>.webp and 360px for
  // the 180 CSS px this header draws it at. The help index and the OG card take
  // their own smaller renditions of the same drawing; all three are derived from
  // one master by `npm run assets:help`, which a new guide has to be run through.
  // Help guides pass this, the glossary does not.
  illustration?: string;
}

const { title, description, crumb, heading = crumb, ogImage, parent = { href: '/help/', label: 'Help' }, updated, glossaryTerms = false, illustration } = Astro.props;

// Public help pages: cache at the edge but keep them reasonably fresh.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---

<Layout title={title} description={description} ogImage={ogImage} searchScope="help">
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <a href={parent.href}>{parent.label}</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>{crumb}</span>
  </nav>

  <div class="help-head">
    <div class="help-head__text">
      <h1 style="margin:0 0 0.5rem;">{heading}</h1>
      {updated && (
        <p class="page-updated">Last updated {isoDate(updated)}</p>
      )}
    </div>
    {illustration && (
      <img class="help-head__illu" src={illustration} width="360" height="360" loading="lazy" alt="" />
    )}
  </div>

  <article class="prose">
    <slot />
  </article>

  {glossaryTerms && <GlossaryTerms hosts="article.prose" />}
</Layout>

<style>
  /* Desktop: the illustration hangs absolutely in the top right so it does
     not stretch the header row and push the body text down. The heading
     reserves its width; the prose column (64ch) stays clear of it anyway. */
  .help-head {
    position: relative;
  }
  .help-head__text {
    padding-right: 200px;
  }
  .help-head__illu {
    position: absolute;
    top: -1rem;
    right: 0;
    width: 180px;
    height: 180px;
  }
  /* The violet line art is drawn for light ground. On dark, a partial invert
     flips lightness (dark lines become light, pale fills calm down) while the
     hue rotation brings the color back to violet. */
  :global(html[data-theme='dark']) .help-head__illu {
    filter: invert(0.84) hue-rotate(180deg) saturate(1.5);
  }
  /* Below this width the 64ch prose column would run under the absolutely
     positioned illustration, so switch to the stacked, centered header. */
  @media (max-width: 900px) {
    .help-head {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      gap: 0.5rem;
    }
    .help-head__text {
      align-self: stretch;
      padding-right: 0;
    }
    .help-head__illu {
      position: static;
      width: 170px;
      height: 170px;
    }
  }

  .page-updated {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .prose {
    max-width: 64ch;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    line-height: 1.65;
    font-size: 0.9375rem;
  }
  .prose :global(h2) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.0625rem;
    color: var(--fg);
  }
  .prose :global(h3) {
    margin: 1.25rem 0 0.4rem;
    font-size: 0.9875rem;
    color: var(--fg);
  }
  /* Link color comes from the global .prose rules; no scoped copy here, its
     raised specificity would override the GlossaryTerms term styling. */
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin: 0.3rem 0;
  }
  .prose :global(strong) {
    color: var(--fg);
  }
  .prose :global(code) {
    font-size: 0.85em;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  /* Screenshots inside guides (sizing and radius come from the global img and
     .prose img rules). Captured in the light theme, so on dark they sit on
     their own light ground behind a border instead of blending in. */
  .prose :global(img.shot) {
    border: 1px solid var(--border);
    margin: 0.75rem 0 0.5rem;
    background: #fff;
  }
</style>
