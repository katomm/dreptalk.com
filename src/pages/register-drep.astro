---
import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import DRepService from '@/components/DRepService.tsx';
import { currentNetwork } from '@/lib/api/response';

// SSR so the island gets the deployment's real network (preprod or mainnet)
// instead of a hardcoded value. All wallet and chain work still happens in the
// client island; the island is non-custodial (the server never sees keys).
export const prerender = false;

// Resolve the network from the runtime env (CARDANO_NETWORK, defaults mainnet).
// The island uses it for the tx network and the explorer links.
const network = currentNetwork().network;

const siteOrigin = Astro.site?.origin ?? 'https://dreptalk.com';

// HowTo structured data targeting "how to register as a DRep" searches. The
// steps mirror the visible copy and the registration form below, which is what
// Google expects for HowTo results.
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to register as a Cardano DRep',
  description:
    'Register as a Delegated Representative for Cardano governance with your own wallet, set your DRep metadata, and submit the registration on-chain.',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Connect a CIP-95 wallet',
      text: 'Connect a CIP-95 capable wallet such as Lace, Eternl, or Typhon. Everything is signed locally; dreptalk.com never handles your private keys.',
    },
    {
      '@type': 'HowToStep',
      name: 'Set your DRep metadata',
      text: 'Add the profile other holders see when delegating: name, a short bio, links, and an optional avatar. You can edit this metadata here any time after registering.',
    },
    {
      '@type': 'HowToStep',
      name: 'Submit the registration',
      text: 'Your wallet submits the on-chain registration certificate. This locks a refundable 500 ADA deposit, returned in full when you later retire.',
    },
  ],
};

// Breadcrumb so search results show the DRepTalk > Register as a DRep trail,
// matching the structured-data pattern used across the site.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DRepTalk', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Register as a DRep', item: `${siteOrigin}/register-drep` },
  ],
};
---
<Layout
  title="Register as a DRep - DRepTalk"
  description="Register as a Cardano DRep with your wallet and manage your DRep metadata, name, bio, links, and avatar, in one place. Fully client-side and non-custodial: dreptalk.com never sees your keys, your wallet signs and submits the transaction."
>
  <JsonLd data={howToLd} />
  <JsonLd data={breadcrumbLd} />
  <h1>Register as a DRep</h1>
  <p style="color:var(--muted);max-width:38rem;margin-bottom:1rem;">
    Become a Delegated Representative for Cardano governance. Connect a CIP-95
    capable wallet, add a short profile, and your wallet will submit the on-chain
    registration. The deposit is refundable when you later retire. Everything is
    signed locally; dreptalk.com never handles your private keys.
  </p>
  <p style="color:var(--muted);max-width:38rem;margin-bottom:2rem;">
    This is also where you manage your DRep metadata: update your name, bio,
    links, and avatar any time, and your wallet signs the change on-chain. Read
    more in <a href="/help/managing-your-drep">managing your DRep</a>.
  </p>
  <DRepService network={network} client:load />
</Layout>
