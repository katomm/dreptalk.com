---
// src/pages/glossary/[...slug].astro
export const prerender = false;

import { getEntry, render } from 'astro:content';
import HelpLayout from '@/layouts/HelpLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { buildGlossaryBreadcrumbLd, buildDefinedTermLd } from '@/lib/glossary/jsonld.js';
import { isoDate } from '@/lib/format/date.js';

const { slug } = Astro.params;
const entry = slug ? await getEntry('glossary', slug) : undefined;
if (!entry) return new Response('Not found', { status: 404 });

const { Content } = await render(entry);
const d = entry.data;
const origin = Astro.site?.origin ?? 'https://dreptalk.com';

const breadcrumbLd = buildGlossaryBreadcrumbLd(origin, entry.id, d.term);
const definedTermLd = buildDefinedTermLd(origin, entry.id, d.term, d.description, d.updated);

// Public glossary pages: cache at the edge but keep them reasonably fresh.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---

<HelpLayout title={`${d.term} - Glossary - DRepTalk`} description={d.description} crumb={d.term} parentHref="/glossary/" parentLabel="Glossary">
  <JsonLd data={breadcrumbLd} />
  <JsonLd data={definedTermLd} />

  {d.updated && (
    <p class="entry-updated">Last updated {isoDate(d.updated)}</p>
  )}

  <article class="prose">
    <Content />
  </article>
</HelpLayout>

<style>
  .entry-updated {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .prose {
    max-width: 64ch;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--muted);
    line-height: 1.65;
    font-size: 0.9375rem;
  }
  .prose :global(h2) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.0625rem;
    color: var(--fg);
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin: 0.3rem 0;
  }
  .prose :global(strong) {
    color: var(--fg);
  }
</style>
