---
// /s/<txHash>:<index> — a CIP-179 survey reference (the id Tessera and
// on-chain anchors use) resolved to its thread, mirroring the /t/<gov-action-id>
// redirect for governance actions. Permanent: a survey's thread never changes.
export const prerender = false;

import NotFound from '@/components/NotFound.astro';
import { getTopicSlugBySurveyRef } from '@/lib/db/surveys.js';
import { env } from 'cloudflare:workers';

const { ref } = Astro.params;
const db = env.DB as D1Database | undefined;

// Canonical key form only (lowercase hex, no leading zeros in the index) —
// the same rule Tessera's API applies, so a link that works there works here.
const key = ref && /^[0-9a-f]{64}:(0|[1-9][0-9]*)$/.test(ref) ? ref : null;

const slug = key && db ? await getTopicSlugBySurveyRef(db, key) : null;
if (slug) return Astro.redirect(`/t/${slug}/`, 301);

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<NotFound noun="Survey" />
