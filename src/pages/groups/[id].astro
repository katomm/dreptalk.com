---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { checkPaymentAddress } from 'drep-groups';
import Layout from '@/layouts/Layout.astro';
import NotFound from '@/components/NotFound.astro';
import GroupActions from '@/components/groups/GroupActions.js';
import NotFoundPage from '../404.astro';
import { currentNetwork } from '@/lib/api/response';
import { txExplorerUrl } from '@/lib/config/network.js';
import {
  drepNamesForKeyHashes,
  getGroup,
  listClosingMembers,
  listMembers,
  listVerdicts,
  type MemberRow,
  pendingVerification,
  scriptDisplays,
  statusNote,
  treasuryScripts,
} from '@/lib/db/drepGroups.js';
import { drepPath } from '@/lib/dreps/profile.js';
import { isHttpUrl } from '@/lib/governance/metadata.js';
import { cacheControlForSynced, formatAda } from '@/lib/forum/view.js';
import { GROUP_PAGE_SIZE, RETENTION_KEEP_APPLIED, RETENTION_KEEP_NOT_APPLIED } from '@/lib/groups/constants.js';
import { drepGroupsAvailable } from '@/lib/groups/gate.js';
import {
  addressStatusLabel,
  describePolicy,
  eventLabel,
  memberSections,
  modeLabel,
  policyKeyHashes,
  reasonLabel,
  scriptFromJson,
  sectionParam,
  shortHash,
  statusNoteLabel,
} from '@/lib/groups/view.js';

const net = currentNetwork();
const available = drepGroupsAvailable(net.network);
const db = env.DB as D1Database | undefined;
const id = Astro.params.id ?? '';
// Group ids are lowercase bech32, an uppercase spelling moves to the canonical URL.
if (available && id !== id.toLowerCase()) return Astro.redirect(`/groups/${id.toLowerCase()}/${Astro.url.search}`, 301);
const group = available && db ? await getGroup(db, id) : null;
if (group) {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
} else {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const profile = group?.profile?.status === 'ok' ? group.profile : null;
// Profile links are checked when stored, and again here so only web links render.
const webLink = (u: string | null | undefined): string | null => (u && isHttpUrl(u) ? u : null);
const website = webLink(profile?.website);
const charter = webLink(profile?.charter);
const addresses = profile?.paymentAddresses ?? [];
const treasuryHashes = [...new Set(addresses.flatMap((a) => (a.treasuryScript ? [a.treasuryScript] : [])))];
const policyHashes = group ? [group.controlHash, ...(group.admissionHash ? [group.admissionHash] : [])] : [];

const [note, verification, sections, applied, notApplied, displays, treasury] =
  group && db
    ? await Promise.all([
        statusNote(db),
        // A closing group shows its own indicator, the verification count is not read then.
        group.closing ? null : pendingVerification(db, group.ref),
        Promise.all(
          memberSections(group, Astro.url.searchParams).map(async (s) => ({
            ...s,
            rows:
              s.kind === 'all'
                ? await listClosingMembers(db, group.ref, s.after)
                : await listMembers(db, group.ref, s.kind, s.after, GROUP_PAGE_SIZE),
          })),
        ),
        listVerdicts(db, group.ref, true, RETENTION_KEEP_APPLIED),
        listVerdicts(db, group.ref, false, RETENTION_KEEP_NOT_APPLIED),
        scriptDisplays(db, policyHashes),
        treasuryScripts(db, treasuryHashes),
      ])
    : [null, null, [], [], [], new Map<string, string>(), { displays: new Map<string, string>(), scripts: new Map() }];

const control = group ? scriptFromJson(displays.get(group.controlHash)) : null;
const admission = group?.admissionHash ? scriptFromJson(displays.get(group.admissionHash)) : null;
const admins = new Set([...policyKeyHashes(control), ...policyKeyHashes(admission)]);
const treasuryViews = new Map(treasuryHashes.map((h) => [h, scriptFromJson(treasury.displays.get(h))]));
const allKeys = [...admins, ...[...treasuryViews.values()].flatMap(policyKeyHashes)];
const names = db && allKeys.length > 0 ? await drepNamesForKeyHashes(db, allKeys) : new Map<string, string>();
// These pages exist on preprod only, so every address is checked as a testnet address.
const addressChecks = addresses
  .map((entry) => ({ entry, check: checkPaymentAddress(entry, 'testnet', treasury.scripts) }))
  .filter((a) => a.check.status !== 'invalid');

// The public profile the admins' editor starts from.
const editableProfile = profile
  ? {
      name: profile.name ?? '',
      ...(profile.description ? { description: profile.description } : {}),
      ...(website ? { website } : {}),
      ...(charter ? { charter } : {}),
      ...(profile.image ? { image: profile.image } : {}),
    }
  : null;
const title = profile?.name ?? (group ? shortHash(group.groupId) : '');
const noteText = statusNoteLabel(note);
const indicator = !group
  ? null
  : group.closing
    ? 'Memberships are being closed after the dissolution.'
    : verification && verification.queued > 0
      ? `Memberships still being verified: ${verification.capped ? '100 or more' : verification.queued}`
      : null;

const SECTION_TITLE = { all: 'Members', active: 'Members', pending: 'Requests', former: 'Former members' } as const;
const MARK = { retiring: 'retired, being updated', unapplied: 'registration change being verified' } as const;
const rowNote = (m: MemberRow, showState: boolean): string =>
  [
    showState && m.state === 'pending' ? 'Request' : '',
    m.state === 'closed' ? reasonLabel(m.reason) : '',
    m.mark ? MARK[m.mark] : '',
  ]
    .filter((s) => s !== '')
    .join(' · ');
// The query of a section's next page, the other sections keep their cursors.
const nextQuery = (kind: keyof typeof SECTION_TITLE, after: string): string => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set(sectionParam(kind), after);
  return `?${params.toString()}`;
};
---
{!available ? (
  <NotFoundPage />
) : !group ? (
  <NotFound noun="Group" />
) : (
  <Layout title={`${title} - DRep groups - DRepTalk`} description={`${modeLabel(group.mode)} DRep group with ${group.members} members.`} wide>
    <nav class="gr-crumbs"><a href="/">DRepTalk</a><span>/</span><a href="/groups/">Groups</a><span>/</span><span>{title}</span></nav>
    <h1>{title}</h1>
    <p class="gr-meta">{modeLabel(group.mode)}{group.status === 'dissolved' ? ' · Dissolved' : ''}{profile?.websiteVerifiedAt ? ' · Website verified' : ''}</p>
    <p class="gr-id"><code>{group.groupId}</code></p>
    {group.profile && group.profile.status !== 'ok' && <p class="gr-note">Profile unavailable.</p>}
    {profile?.description && <p>{profile.description}</p>}
    {(website || charter) && (
      <ul class="gr-links">
        {website && <li><a href={website} rel="nofollow noopener">Website</a></li>}
        {charter && <li><a href={charter} rel="nofollow noopener">Charter</a></li>}
      </ul>
    )}

    <section>
      <h2>{group.closing ? 'Members' : `Members (${group.members})`}</h2>
      <p class="gr-meta">Voting power of affiliated DReps: {formatAda(group.memberPower)}. Every member votes on their own.</p>
      <p class="gr-meta"><a href={`/dreps/?all=1&group=${group.groupId}`}>Show members in the DRep list</a></p>
      {noteText && <p class="gr-note">{noteText}</p>}
      {indicator && <p class="gr-note">{indicator}</p>}
      {sections.map((s) => {
        const primary = s.kind === 'active' || s.kind === 'all';
        const count = s.kind === 'pending' ? group.pending : s.kind === 'former' ? group.former : group.members;
        const show = primary || s.rows.length > 0 || s.after !== null || count > 0;
        const next = s.rows.length === GROUP_PAGE_SIZE ? s.rows[s.rows.length - 1].key : null;
        return show && (
          <>
            {!primary && <h3>{SECTION_TITLE[s.kind]} ({count})</h3>}
            {s.rows.length === 0 ? (
              primary ? <p class="gr-empty">No active members.</p> : null
            ) : (
              <ul class="gr-list">
                {s.rows.map((m) => {
                  const label = m.drepName ?? shortHash(m.drepId);
                  const extra = rowNote(m, s.kind === 'all');
                  return (
                    <li>
                      {m.state === 'closed' ? label : <a href={drepPath({ drepId: m.drepId, slug: m.drepSlug })}>{label}</a>}
                      {extra && <span class="gr-meta"> {extra}</span>}
                    </li>
                  );
                })}
              </ul>
            )}
            {next && (
              <nav class="gr-pager" aria-label={`${SECTION_TITLE[s.kind]} pages`}>
                <a href={`/groups/${group.groupId}/${nextQuery(s.kind, next)}`} rel="next">Next</a>
              </nav>
            )}
          </>
        );
      })}
      {/* The island reads the session's view itself, so this page stays cacheable. The anchor is server rendered so a link to the requests jumps on load. */}
      <div id="requests" class="gr-actions">
        <GroupActions client:load groupId={group.groupId} network={net.network} profile={editableProfile} />
      </div>
    </section>

    <section>
      <h2>Policies</h2>
      <dl class="gr-dl">
        <dt>Control</dt><dd>{describePolicy(control, names)}</dd>
        {group.mode === 'permissioned' && (<><dt>Admission</dt><dd>{describePolicy(admission, names)}</dd></>)}
      </dl>
    </section>

    {addressChecks.length > 0 && (
      <section>
        <h2>Payment addresses</h2>
        <ul class="gr-list">
          {addressChecks.map((a) => (
            <li>
              <code title={a.entry.address}>{shortHash(a.entry.address)}</code>{a.entry.purpose ? ` · ${a.entry.purpose}` : ''}
              <span class="gr-meta"> {addressStatusLabel(a.check.status)}{a.check.status === 'script-controlled' && a.entry.treasuryScript ? `: ${describePolicy(treasuryViews.get(a.entry.treasuryScript) ?? null, names, admins)}` : ''}</span>
            </li>
          ))}
        </ul>
        {group.profileSetHeight !== null && <p class="gr-meta">Profile last changed at block {group.profileSetHeight}.</p>}
      </section>
    )}

    <section>
      <h2>History</h2>
      <ul class="gr-list">
        {applied.map((v) => (
          <li>
            <a href={txExplorerUrl(net.network, v.txHash)} rel="noopener">{eventLabel(v.tag)}</a>
            <span class="gr-meta"> block {v.blockHeight}</span>
          </li>
        ))}
      </ul>
      {group.appliedEvents > applied.length && <p class="gr-meta">The latest {applied.length} applied events are listed.</p>}
      {notApplied.length > 0 && (
        <details>
          <summary>{group.notAppliedEvents} events referring to this group were not applied</summary>
          <ul class="gr-list">
            {notApplied.map((v) => (
              <li>
                <a href={txExplorerUrl(net.network, v.txHash)} rel="noopener">{eventLabel(v.tag)}</a>
                <span class="gr-meta"> block {v.blockHeight} · {v.reason ?? 'invalid'}</span>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
  </Layout>
)}
<style>
  .gr-crumbs { font-size: 0.875rem; color: var(--muted); margin-bottom: 1rem; display: flex; gap: 0.375rem; }
  .gr-meta, .gr-note, .gr-empty { color: var(--muted); font-size: 0.875rem; }
  .gr-id code { font-size: 0.8125rem; word-break: break-all; }
  .gr-list { list-style: none; padding: 0; display: grid; gap: 0.375rem; }
  .gr-links { list-style: none; padding: 0; display: flex; gap: 1rem; }
  .gr-dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
  .gr-actions { margin-top: 1.5rem; scroll-margin-top: 4rem; }
  .gr-pager { display: flex; gap: 1rem; margin-top: 0.75rem; font-size: 0.875rem; font-weight: 600; }
</style>
