---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import NotFoundPage from '../404.astro';
import { currentNetwork } from '@/lib/api/response';
import { listListedGroups } from '@/lib/db/drepGroups.js';
import { cacheControlForSynced, formatAda } from '@/lib/forum/view.js';
import { GROUP_PAGE_SIZE } from '@/lib/groups/constants.js';
import { drepGroupsAvailable } from '@/lib/groups/gate.js';
import { groupIdParam } from '@/lib/groups/ids.js';
import { modeLabel, shortHash } from '@/lib/groups/view.js';

const available = drepGroupsAvailable(currentNetwork().network);
const db = env.DB as D1Database | undefined;
// The cursor is "<power>.<groupId>". A bech32 id has no dot, so the first dot splits it.
const afterParam = Astro.url.searchParams.get('after');
const dot = afterParam?.indexOf('.') ?? -1;
const parsed = afterParam && dot > 0 ? { power: afterParam.slice(0, dot), groupId: afterParam.slice(dot + 1) } : null;
// A cursor that does not parse shows the first page, without a link back.
const after = parsed && /^\d+$/.test(parsed.power) && groupIdParam(parsed.groupId) ? parsed : null;
const groups = available && db ? await listListedGroups(db, after, GROUP_PAGE_SIZE) : [];
const last = groups.length === GROUP_PAGE_SIZE ? groups[groups.length - 1] : null;
const nextHref = last ? `/groups/?after=${encodeURIComponent(`${last.memberPower}.${last.groupId}`)}` : null;
if (available) {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
} else {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}
---
{!available ? (
  <NotFoundPage />
) : (
  <Layout title="DRep groups - DRepTalk" description="Groups, parties and councils of Cardano DReps, recorded on chain." wide>
    <nav class="gr-crumbs"><a href="/">DRepTalk</a><span>/</span><span>Groups</span></nav>
    <h1>DRep groups</h1>
    <p class="gr-intro">Groups record which DReps belong together, on chain under metadata label 8416. Open groups are self-declared, permissioned groups confirm every member. A group never votes, its members vote on their own. Groups with at least two members are listed, sorted by the voting power of their members.</p>
    {groups.length === 0 ? (
      <p class="gr-empty">No groups yet.</p>
    ) : (
      <ul class="gr-list">
        {groups.map((g) => (
          <li class="gr-item">
            <a href={`/groups/${g.groupId}/`}>{g.name ?? shortHash(g.groupId)}</a>
            <span class="gr-meta"><code title={g.groupId}>{shortHash(g.groupId)}</code> · {modeLabel(g.mode)} · {g.members} members · voting power of affiliated DReps {formatAda(g.memberPower)}{g.status === 'dissolved' ? ' · Dissolved' : ''}{g.websiteVerified ? ' · Website verified' : ''}</span>
          </li>
        ))}
      </ul>
    )}
    {(after || nextHref) && (
      <nav class="gr-pager" aria-label="Pagination">
        {after && <a href="/groups/" rel="prev">Previous</a>}
        {nextHref && <a href={nextHref} rel="next">Next</a>}
      </nav>
    )}
  </Layout>
)}
<style>
  .gr-crumbs { font-size: 0.875rem; color: var(--muted); margin-bottom: 1rem; display: flex; gap: 0.375rem; }
  .gr-intro { color: var(--muted); max-width: 46rem; }
  .gr-pager { display: flex; gap: 1rem; margin-top: 1.5rem; font-size: 0.875rem; font-weight: 600; }
  .gr-empty { color: var(--muted); }
  .gr-list { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  .gr-item { display: flex; flex-direction: column; gap: 0.125rem; }
  .gr-meta { font-size: 0.875rem; color: var(--muted); }
</style>
