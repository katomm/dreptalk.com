---
export const prerender = false;

import HelpLayout from '@/layouts/HelpLayout.astro';
import { GOV_SORTS, type GovSort } from '@/lib/governance/sort.js';

// One line per sort mode, keyed by mode so it stays aligned with GOV_SORTS (the same
// list that renders the sort tabs). Kept in plain language for a non-technical DRep.
const MODES: Record<GovSort, string> = {
  trending:
    'Where discussion and voting are happening now. Recent replies and ongoing votes lift an action; the score halves for every week without activity, so a busy old action does not sit at the top forever. Decided actions sink to the bottom.',
  new: 'Newest submission first, by the epoch the action was proposed on-chain. Every action is included.',
  closing:
    'Soonest to close first, by the expiry epoch. Only actions whose voting is still open are listed; decided ones drop out.',
  ratified:
    'Most recently decided first (enacted, expired, dropped, or closed). Useful for catching up on outcomes.',
};
---

<HelpLayout
  title="Sorting governance actions - DRepTalk"
  description="What the Trending, New, Closing Soon, and Recently Ratified sorts order by on the governance actions list."
  crumb="Sorting"
  heading="Sorting governance actions"
>
  <p style="color:var(--muted);max-width:62ch;line-height:1.6;">
    The governance actions list can be ordered four ways, chosen with the tabs above the
    list. Trending is the default, because a DRep usually wants to see where attention is
    right now rather than the newest submission.
  </p>

  <dl style="margin:1.75rem 0 0;display:grid;grid-template-columns:auto 1fr;gap:0.8rem 1rem;align-items:start;">
    {GOV_SORTS.map((s) => (
      <>
        <dt style="margin:0;font-weight:600;white-space:nowrap;">{s.label}</dt>
        <dd style="margin:0;font-size:0.9375rem;line-height:1.5;">{MODES[s.mode]}</dd>
      </>
    ))}
  </dl>

  <h2 style="margin:2rem 0 0.5rem;font-size:1.0625rem;">How Trending is scored</h2>
  <p style="color:var(--muted);max-width:62ch;line-height:1.6;">
    Each action gets a score from two parts. Engagement counts forum replies plus the
    number of on-chain votes cast, with the vote count damped so a few thousand votes do
    not drown out everything else. Recency measures how long since the last activity and
    halves every week. Decided actions are scored far lower so they settle at the bottom.
    An action with no comments yet still has a recency score, so it orders by its
    submission date, which is why a brand-new action can appear near the top before
    anyone has replied.
  </p>
</HelpLayout>
