---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { HELP_ARTICLES } from '@/lib/help/articles.js';

// Public help index; cache at the edge.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

// The one card pulled out as the entry point for new visitors. It spans the
// full grid width, so it leads the list to keep the two columns gap-free.
const FEATURED_HREF = '/help/managing-your-drep';

const featured = HELP_ARTICLES.find((a) => a.href === FEATURED_HREF);
const rest = HELP_ARTICLES.filter((a) => a.href !== FEATURED_HREF);
const PAGES = featured ? [featured, ...rest] : [...HELP_ARTICLES];
---

<Layout title="Help - DRepTalk" description="DRepTalk help: data freshness, governance action statuses, and more.">
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Help</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Help</h1>
  <p class="help-lede">
    Short pages explaining how DRepTalk works. More will be added over time.
  </p>

  <div class="help-list">
    {PAGES.map((d, i) => (
      <a
        href={d.href}
        class:list={['help-card', 'reveal', { 'help-card--featured': d.href === FEATURED_HREF }]}
        style={`--reveal-delay:${60 + i * 60}ms`}
      >
        <span class="help-card__body">
          <span class="help-card__head">
            <span class="help-card__title">{d.title}</span>
            {d.href === FEATURED_HREF && <span class="help-card__flag">Getting started</span>}
          </span>
          <p class="help-card__text">{d.text}</p>
        </span>
        <svg
          class="help-card__chev"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 5 7 7-7 7"/>
        </svg>
      </a>
    ))}
  </div>
</Layout>

<style>
  .help-lede {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.6;
  }

  .help-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  .help-card--featured {
    grid-column: 1 / -1;
  }
  @media (max-width: 800px) {
    .help-list {
      grid-template-columns: 1fr;
    }
  }

  .help-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .help-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .help-card:hover .help-card__chev {
    transform: translateX(3px);
    color: var(--accent);
  }

  .help-card__body {
    flex: 1;
    min-width: 0;
  }
  .help-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .help-card__title {
    display: block;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--accent);
  }
  .help-card__text {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .help-card__chev {
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .help-card--featured {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  .help-card__flag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
  }
  @media (max-width: 560px) {
    .help-card {
      padding: 0.95rem 1rem;
      gap: 0.85rem;
    }
    .help-card__chev {
      display: none;
    }
  }
</style>
