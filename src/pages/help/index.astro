---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_ORDER } from '@/lib/help/categories.js';

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const guides = await getCollection('guides');
const featured = guides.find((g) => g.data.featured);

// Group the non-featured guides by category, preserving CATEGORY_ORDER and
// sorting within each group by `order`.
const groups = CATEGORY_ORDER.map((cat) => ({
  category: cat,
  items: guides
    .filter((g) => g.data.category === cat && !g.data.featured)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((grp) => grp.items.length > 0);
---

<Layout title="Help - DRepTalk" description="DRepTalk help and guides: becoming a DRep, delegating, governance actions, and how DRepTalk works." ogImage="/og-help.jpg" searchScope="help">
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Help</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Help</h1>
  <p class="help-lede">
    Guides and short pages on becoming a DRep, delegating your voting power,
    Cardano governance, and how DRepTalk works. Looking up a single term
    instead? See the <a href="/glossary/">glossary</a>.
  </p>

  {featured && (
    <a href={`/help/${featured.id}/`} class="help-card help-card--featured reveal" style="--reveal-delay:60ms">
      <img class="help-card__illu" src={`/help/${featured.id}.webp`} width="96" height="96" loading="lazy" alt="" />
      <span class="help-card__body">
        <span class="help-card__head">
          <span class="help-card__title">{featured.data.cardLabel}</span>
          <span class="help-card__flag">Featured</span>
        </span>
        <p class="help-card__text">{featured.data.description}</p>
      </span>
      <svg class="help-card__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
    </a>
  )}

  {groups.map((grp) => (
    <section class="help-group">
      <h2 class="help-group__title">{grp.category}</h2>
      <div class="help-list">
        {grp.items.map((g, i) => (
          <a href={`/help/${g.id}/`} class="help-card reveal" style={`--reveal-delay:${60 + i * 60}ms`}>
            <img class="help-card__illu" src={`/help/${g.id}.webp`} width="64" height="64" loading="lazy" alt="" />
            <span class="help-card__body">
              <span class="help-card__head">
                <span class="help-card__title">{g.data.cardLabel}</span>
              </span>
              <p class="help-card__text">{g.data.description}</p>
            </span>
            <svg class="help-card__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>

<style>
  .help-lede {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.6;
  }
  .help-lede a {
    color: var(--accent);
  }

  .help-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  .help-card--featured {
    grid-column: 1 / -1;
  }
  @media (max-width: 800px) {
    .help-list {
      grid-template-columns: 1fr;
    }
  }

  .help-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .help-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .help-card:hover .help-card__chev {
    transform: translateX(3px);
    color: var(--accent);
  }

  .help-card__body {
    flex: 1;
    min-width: 0;
  }
  .help-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .help-card__title {
    display: block;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--accent);
  }
  .help-card__text {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .help-card__chev {
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .help-card__illu {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
  }
  /* The violet line art is drawn for light ground. On dark, a partial invert
     flips lightness (dark lines become light, pale fills calm down) while the
     hue rotation brings the color back to violet. */
  :global(html[data-theme='dark']) .help-card__illu {
    filter: invert(0.84) hue-rotate(180deg) saturate(1.5);
  }
  .help-card--featured .help-card__illu {
    width: 96px;
    height: 96px;
  }

  .help-card--featured {
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  .help-card__flag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
  }
  @media (max-width: 560px) {
    /* Grid instead of flex: the illustration sits next to the title line
       only, the description flows below at full card width. */
    .help-card {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      padding: 0.95rem 1rem;
      gap: 0 0.85rem;
    }
    .help-card__body {
      display: contents;
    }
    .help-card__chev {
      display: none;
    }
    .help-card__illu {
      width: 80px;
      height: 80px;
    }
    .help-card--featured .help-card__illu {
      width: 96px;
      height: 96px;
    }
    .help-card__text {
      grid-column: 1 / -1;
      margin-top: 0.6rem;
    }
  }

  .help-group {
    margin-top: 2rem;
  }
  .help-group__title {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .help-list {
    margin-top: 0;
  }
  .help-card--featured {
    margin-top: 1.25rem;
  }
</style>
