---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';

// Public docs index; cache at the edge.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const DOCS = [
  {
    href: '/docs/data-freshness',
    title: 'Data freshness',
    text: 'How often each on-chain value (governance tallies and status, DRep profiles, vote badges) is refreshed. Cached, not live.',
  },
  {
    href: '/docs/governance-statuses',
    title: 'Governance action statuses',
    text: 'What each status label means (active, ratified, enacted, expired, dropped, closed, pending), grouped by action type.',
  },
];
---

<Layout title="Docs - DRepTalk" description="DRepTalk documentation: data freshness, governance action statuses, and more.">
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Docs</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Docs</h1>
  <p style="color:var(--muted);max-width:60ch;line-height:1.6;">
    Short reference pages about how DRepTalk works. More will be added over time.
  </p>

  <div style="display:flex;flex-direction:column;gap:1rem;margin-top:1.5rem;">
    {DOCS.map((d) => (
      <a
        href={d.href}
        style="display:block;border:1px solid var(--border);border-radius:0.5rem;padding:1rem 1.25rem;text-decoration:none;color:inherit;"
      >
        <span style="font-weight:600;color:var(--accent);">{d.title}</span>
        <p style="margin:0.3rem 0 0;font-size:0.9375rem;color:var(--muted);line-height:1.5;">{d.text}</p>
      </a>
    ))}
  </div>
</Layout>
