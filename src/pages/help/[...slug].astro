---
// src/pages/help/[...slug].astro
export const prerender = false;

import { getEntry } from 'astro:content';
import HelpLayout from '@/layouts/HelpLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ReleaseList from '@/components/ReleaseList.astro';
import { buildBreadcrumbLd } from '@/lib/jsonld/breadcrumb.js';
import { buildArticleLd, buildFaqLd } from '@/lib/help/jsonld.js';
import { splitAtRelated } from '@/lib/help/related.js';
import { splitInlineCode } from '@/lib/help/inlineCode.js';
import { ogCardVersion } from '@/lib/og/version.js';
import { fetchReleases } from '@/lib/github/releases.js';

const { slug } = Astro.params;
const entry = slug ? await getEntry('guides', slug) : undefined;
if (!entry) return new Response('Not found', { status: 404 });

const d = entry.data;

// Guides flagged with `showReleases` append the GitHub release listing below
// their prose.
const releases = d.showReleases ? await fetchReleases() : [];
const now = Date.now();
const origin = Astro.site?.origin ?? 'https://dreptalk.com';

const breadcrumbLd = buildBreadcrumbLd(origin, [
  { name: 'Help', path: '/help/' },
  { name: d.cardLabel, path: `/help/${entry.id}/` },
]);
const articleLd = buildArticleLd(origin, entry.id, d.title, d.description, d.updated);
const faqLd = buildFaqLd(d.faqs);

// Guides are plain markdown, so the content store already holds their final
// HTML. Frontmatter FAQs render as a visible section between the guide text
// and its Related list, so the page shows what the FAQ data describes.
const faqs = d.faqs ?? [];
const { body, related } = splitAtRelated(entry.rendered?.html ?? '');
---

<HelpLayout title={`${d.title} - DRepTalk`} description={d.description} crumb={d.cardLabel} heading={d.title} updated={d.updated} glossaryTerms illustration={`/help/${entry.id}.webp`} ogImage={`/og/help/${entry.id}.png?v=${ogCardVersion([d.title, d.description, d.category, d.updated?.getTime()])}`}>
  <JsonLd data={breadcrumbLd} />
  <JsonLd data={articleLd} />
  {faqLd && <JsonLd data={faqLd} />}

  <Fragment set:html={body} />
  {faqs.length > 0 && (
    <>
      <h2 id="frequently-asked-questions">Frequently asked questions</h2>
      {faqs.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{splitInlineCode(f.a).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</p>
        </>
      ))}
    </>
  )}
  <Fragment set:html={related} />
  {/* Rendered inside .prose on purpose: it aligns with the content column and
      lets GlossaryTerms mark up the release summaries like the rest of the guide. */}
  {d.showReleases && <ReleaseList releases={releases} now={now} />}
</HelpLayout>
