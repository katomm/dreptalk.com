---
export const prerender = false;

import HelpLayout from '@/layouts/HelpLayout.astro';
import { statusBadge, TONE_COLORS } from '@/lib/governance/view.js';

// Each group's rows: the status value (rendered with the real badge styling) and
// a one-line explanation. Kept in sync with statusBadge() and deriveStatus().
const SYNC = [
  { status: 'pending', text: 'We have found the action on-chain but have not yet synced its current status and tallies.' },
];
const ENACTABLE = [
  { status: 'active', text: 'Voting is open; the action has not been decided yet.' },
  { status: 'ratified', text: 'Reached the required approval thresholds and is queued for enactment. Brief; you will usually see Enacted instead.' },
  { status: 'enacted', text: 'Ratified and applied on-chain. The successful end state.' },
  { status: 'expired', text: 'The voting window ended without ratification, the action ran out of time.' },
  { status: 'dropped', text: 'Removed from the proposal set without expiring, for example when a competing action of the same type was enacted, making this one moot.' },
];
const INFO = [
  { status: 'active', text: 'Voting is open.' },
  { status: 'closed', text: 'The voting window ended. Info actions have no on-chain effect and can never be ratified or enacted, so they simply close.' },
];

function badgeStyle(status: string): string {
  const color = TONE_COLORS[statusBadge(status).tone];
  return `display:inline-block;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.03em;color:#fff;background:${color};border-radius:0.25rem;padding:0.15rem 0.45rem;white-space:nowrap;`;
}

const GROUPS = [
  { heading: 'While we are catching up', note: 'Our own sync state, not on-chain.', rows: SYNC },
  {
    heading: 'Enactable actions',
    note: 'Treasury withdrawals, parameter changes, new constitution, new committee, hard-fork initiation.',
    rows: ENACTABLE,
  },
  { heading: 'Info actions', note: 'Signalling only, no on-chain effect.', rows: INFO },
];
---

<HelpLayout
  title="Governance action statuses - DRepTalk"
  description="What each governance action status label means: active, ratified, enacted, expired, dropped, closed, and syncing."
  crumb="Governance statuses"
  heading="Governance action statuses"
>
  <p style="color:var(--muted);max-width:62ch;line-height:1.6;">
    Each governance action carries a status label derived from its on-chain lifecycle.
    The labels differ by action type: enactable actions can be ratified and enacted, while
    info actions only signal and never enact. All values are synced on a schedule and shown
    with an &ldquo;as of&rdquo; time (see <a href="/help/data-freshness">data freshness</a>).
  </p>

  {GROUPS.map((g) => (
    <section style="margin-top:1.75rem;">
      <h2 style="margin:0 0 0.25rem;font-size:1.0625rem;">{g.heading}</h2>
      <p style="margin:0 0 0.875rem;font-size:0.8125rem;color:var(--muted);">{g.note}</p>
      <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:0.6rem 0.875rem;align-items:start;">
        {g.rows.map((r) => (
          <>
            <dt style="margin:0;"><span style={badgeStyle(r.status)}>{statusBadge(r.status).label}</span></dt>
            <dd style="margin:0;font-size:0.9375rem;line-height:1.5;">{r.text}</dd>
          </>
        ))}
      </dl>
    </section>
  ))}
</HelpLayout>
