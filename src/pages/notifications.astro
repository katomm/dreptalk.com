---
// Personal notifications inbox: merges the recipient's personal rows (reply,
// mention) with the broadcast governance activity (gov_created, gov_status),
// newest first, capped at 50 rows. Session-gated, no pagination in Phase 1.
// Opening the inbox marks everything read (the header bell clears with this
// render), while the unread highlighting still shows the pre-visit state.
// The filterable, time-grouped list itself renders in the NotificationsInbox
// island; this page only assembles the serializable items.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import NotificationSettings from '@/components/NotificationSettings.tsx';
import TelegramSettings from '@/components/TelegramSettings.tsx';
import NotificationsInbox from '@/components/NotificationsInbox.tsx';
import { runtimeEnv } from '@/lib/api/response';
import { getNotificationsPage, getNotifSeenAt, markAllRead } from '@/lib/db/notifications';
import { listChannels, getPrefs, NOTIFICATION_EVENT_TYPES } from '@/lib/db/notificationChannels';
import { getUserById } from '@/lib/db/users.js';
import type { NotificationEventType } from '@/lib/db/notificationChannels';
import { toClientChannels } from '@/lib/notifications/channelView';
import type { ClientChannel } from '@/lib/notifications/channelView';
import { loadActivityFeed } from '@/lib/forum/activityFeed.js';
import { getTopicsByIds } from '@/lib/db/forum.js';
import { getDrepsByIds } from '@/lib/db/dreps.js';
import { getGovernanceActionSlugsByIds } from '@/lib/db/governance.js';
import { loadAuthorIdentities, authorProfileHref } from '@/lib/forum/author.js';
import { statusBadge, isTerminalStatus } from '@/lib/governance/view.js';
import type { InboxItem } from '@/lib/notifications/inboxView.js';
import { delegationLabel } from '@/lib/delegation/format.js';
import { parseDelegationChangePayload } from '@/lib/delegation/payload.js';
import { parseDrepEventPayload } from '@/lib/delegation/notifyPayload.js';
import { drepPath } from '@/lib/dreps/profile.js';
import { parseDrepStatsPayload, formatDrepStatsSummary } from '@/lib/notifications/drepStats.js';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}
const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;
const vapidPublicKey = env.VAPID_PUBLIC_KEY ?? '';
const telegramBotUsername = (env.TELEGRAM_BOT_USERNAME as string | undefined) ?? '';

// One verb per personal kind; a future 'message' or 'delegation' kind only
// needs a new entry here, not another template branch.
const PERSONAL_VERBS: Record<string, string> = {
  reply: 'replied in',
  mention: 'mentioned you in',
};

let items: InboxItem[] = [];
let pushChannels: ClientChannel[] = [];
let telegramChannels: ClientChannel[] = [];
// Fallback before a session-gated read has run: every event type defaults to
// enabled, derived from NOTIFICATION_EVENT_TYPES so a widened union can never
// drift out of sync with this seed again.
const allPrefsEnabled = Object.fromEntries(NOTIFICATION_EVENT_TYPES.map((t) => [t, true])) as Record<
  NotificationEventType,
  boolean
>;
let pushPrefs = allPrefsEnabled;
let telegramPrefs = allPrefsEnabled;
// The DRep stats digest targets ACCOUNTS linked to a DRep, so the matrix
// group keys on the account row, not the session roles: the delegator door
// deliberately mints ['member'] sessions even when it routed to a DRep
// account (Decision A), and that DRep still gets the digest and must see the
// toggle. For everyone else the group is hidden (the pref itself stays
// default-on and harmless).
let showDrepStats = false;
if (db) {
  // Read the cursor (and the personal rows' read state) BEFORE marking, so
  // unread highlighting reflects the state the user is coming from, not the
  // state after this page marks everything seen.
  const [seenAt, personal, gov, channelRows, pPrefs, tPrefs, account] = await Promise.all([
    getNotifSeenAt(db, user.id),
    getNotificationsPage(db, user.id, 30),
    loadActivityFeed(db, { filter: 'governance', limit: 30 }),
    listChannels(db, user.id),
    getPrefs(db, user.id, 'webpush'),
    getPrefs(db, user.id, 'telegram'),
    getUserById(db, user.id),
  ]);
  // Client-safe projection: id, dates, label and an endpoint fingerprint reach
  // the islands; the stored subscription (endpoint, keys) stays server-side.
  const clientChannels = await toClientChannels(channelRows);
  pushChannels = clientChannels.filter((c) => c.channel === 'webpush');
  telegramChannels = clientChannels.filter((c) => c.channel === 'telegram');
  pushPrefs = pPrefs;
  telegramPrefs = tPrefs;
  showDrepStats = account?.is_drep === true;

  const topicIds = [...new Set(personal.map((n) => n.topic_id).filter((id): id is string => !!id))];
  // Collect the `to`-DRep ids from delegation_changed payloads for a single
  // batch name lookup; a malformed payload is skipped here too, since the row
  // itself is dropped where it is actually parsed, below.
  const delegationDrepIds = new Set<string>();
  for (const n of personal) {
    if (n.type !== 'delegation_changed') continue;
    const p = parseDelegationChangePayload(n.payload);
    if (p?.to.type === 'drep') delegationDrepIds.add(p.to.drepId);
  }
  // Collect every vote-event governance-action id up front for a single batch
  // slug lookup, mirroring delegationDrepIds above; a malformed payload is
  // skipped here too, since the row itself is dropped where it is parsed below.
  const voteEventGaIds = new Set<string>();
  for (const n of personal) {
    if (n.type !== 'delegator_drep_voted' && n.type !== 'delegator_drep_re_voted') continue;
    const p = parseDrepEventPayload(n.payload);
    if (p?.gaId) voteEventGaIds.add(p.gaId);
  }
  const [topicsById, identities, delegationDreps, gaSlugs] = await Promise.all([
    getTopicsByIds(db, topicIds),
    loadAuthorIdentities(db, personal.map((n) => n.actor_id)),
    getDrepsByIds(db, [...delegationDrepIds]),
    getGovernanceActionSlugsByIds(db, [...voteEventGaIds]),
    // Opening the inbox counts as reading it: mark everything read so the
    // header bell clears on this very render (the layout queries the count
    // after this frontmatter runs). Safe to batch with the reads above, since
    // the unread flags below are computed from seenAt and the personal rows
    // fetched before this point.
    markAllRead(db, user.id, Date.now()),
  ]);

  const personalItems: InboxItem[] = personal.flatMap((n): InboxItem[] => {
    if (n.type === 'device_paired') {
      return [
        {
          kind: 'device_paired' as const,
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: 'A new device was paired',
          // Links to the page where the pairing can be undone.
          href: '/devices/',
          pill: null,
        },
      ];
    }
    if (n.type === 'delegation_changed') {
      const p = parseDelegationChangePayload(n.payload);
      if (!p) return [];
      const toName = p.to.type === 'drep' ? (delegationDreps.get(p.to.drepId)?.name ?? null) : null;
      return [
        {
          kind: 'delegation_changed' as const,
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: `Your delegation changed to ${delegationLabel(p.to, toName)}`,
          href: '/home/',
          pill: null,
        },
      ];
    }
    if (n.type === 'delegator_drep_voted' || n.type === 'delegator_drep_re_voted') {
      const p = parseDrepEventPayload(n.payload);
      if (!p) return [];
      const actionTitle = p.title ?? 'a governance action';
      const verbPhrase = n.type === 'delegator_drep_voted' ? 'voted on' : 'changed a vote on';
      const slug = p.gaId ? gaSlugs.get(p.gaId) : null;
      return [
        {
          kind: n.type as 'delegator_drep_voted' | 'delegator_drep_re_voted',
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: `Your DRep ${verbPhrase} ${actionTitle}`,
          href: slug ? `/t/${slug}/` : null,
          pill: null,
        },
      ];
    }
    if (n.type === 'delegator_drep_status_changed') {
      const p = parseDrepEventPayload(n.payload);
      if (!p?.drepId || !p.to) return [];
      return [
        {
          kind: 'delegator_drep_status_changed' as const,
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: `Your DRep is now ${p.to.effective}`,
          href: drepPath({ drepId: p.drepId }),
          pill: null,
        },
      ];
    }
    if (n.type === 'drep_stats') {
      const p = parseDrepStatsPayload(n.payload);
      if (!p) return [];
      return [
        {
          kind: 'drep_stats' as const,
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: formatDrepStatsSummary(p),
          href: drepPath({ drepId: p.drepId }),
          pill: null,
        },
      ];
    }
    const topic = n.topic_id ? topicsById.get(n.topic_id) : undefined;
    if (!topic || topic.deleted) return [];
    const discussionTab = topic.source === 'governance' ? '?tab=discussion' : '';
    const anchor = n.post_id ? `#post-${n.post_id}` : '';
    const actor = n.actor_id ? identities.describe(n.actor_id) : null;
    return [
      {
        kind: n.type as 'reply' | 'mention',
        createdAt: n.created_at,
        unread: n.read_at === null,
        actorName: actor?.displayName ?? null,
        actorHref: actor ? authorProfileHref(actor) : null,
        verb: PERSONAL_VERBS[n.type] ?? null,
        title: topic.title,
        href: `/t/${topic.slug}/${discussionTab}${anchor}`,
        pill: null,
      },
    ];
  });

  const govItems: InboxItem[] = gov.events.map((e) => {
    // gov_created rows get a "New" pill; status changes reuse the shared
    // status badge (same labels and tones as the governance pages).
    const pill =
      e.kind === 'gov_status' && e.statusTransition
        ? { ...statusBadge(e.statusTransition.to), outline: isTerminalStatus(e.statusTransition.to) }
        : { label: 'New', tone: 'active' as const, outline: false };
    return {
      kind: e.kind as 'gov_created' | 'gov_status',
      createdAt: e.createdAt,
      // Unread is decided by detection time, the same value the header badge
      // counts on (govThreadsSinceSql). createdAt is the on-chain submission
      // time and can predate the seen cursor for an action discovered just
      // now, which would make the badge count a row this page never shows as
      // unread. The row still renders (and sorts) at its true submission date.
      unread: (e.notifiedAt ?? e.createdAt) > seenAt,
      actorName: null,
      actorHref: null,
      verb: null,
      title: e.topic.title,
      href: `/t/${e.topic.slug}/`,
      pill,
    };
  });

  items = [...personalItems, ...govItems].sort((a, b) => b.createdAt - a.createdAt).slice(0, 50);
}

const now = Date.now();
---
<Layout title="Notifications" noindex wide>
  <div class="notif-head">
    <div>
      <h1>Notifications</h1>
      <p class="notif-sub">Stay up to date with what matters to you.</p>
    </div>
    <div class="notif-head__actions">
      <a class="notif-settingslink" href="#notification-settings">Notification settings</a>
      {/* Push notifications are set up here but only work on a signed-in device,
          so this is the natural place to find the pairing page from. */}
      <a class="notif-settingslink" href="/devices/">Devices</a>
    </div>
  </div>

  <NotificationsInbox items={items} now={now} client:load />

  {/* Notification settings live with the inbox they configure; collapsed so
      the page stays a reading surface. Open by default only while nothing is
      connected AND at least one channel is available, nudging first-time
      setup. */}
  <details
    id="notification-settings"
    class="notif-settings"
    open={pushChannels.length === 0 && telegramChannels.length === 0 && (vapidPublicKey !== '' || telegramBotUsername !== '')}
  >
    <summary>Notification settings</summary>
    <div class="notif-settings__body">
      <p class="nset__sub">Choose how you'd like to be notified and what you want to hear about.</p>
      <NotificationSettings
        channels={pushChannels}
        prefs={pushPrefs}
        vapidPublicKey={vapidPublicKey}
        showDrepStats={showDrepStats}
        client:load
      />
      {telegramBotUsername !== '' && (
        <TelegramSettings
          channels={telegramChannels}
          prefs={telegramPrefs}
          botUsername={telegramBotUsername}
          showDrepStats={showDrepStats}
          client:load
        />
      )}
    </div>
  </details>

</Layout>

<style>
  .notif-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .notif-head h1 { margin: 0; }
  .notif-sub {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .notif-head__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .notif-settingslink {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.4rem 0.75rem;
  }
  .notif-settingslink:hover { background: var(--surface); }
  .notif-settings {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
  }
  .notif-settings summary {
    padding: 0.65rem 0.9rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--fg);
  }
  .notif-settings__body {
    padding: 0.25rem 0.9rem 0.9rem;
  }
</style>
