---
// Personal notifications inbox: merges the recipient's personal rows (reply,
// mention) with the broadcast governance activity (gov_created, gov_status),
// newest first, capped at 50 rows. Session-gated, no pagination in Phase 1.
// The filterable, time-grouped list itself renders in the NotificationsInbox
// island; this page only assembles the serializable items.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import NotificationSettings from '@/components/NotificationSettings.tsx';
import TelegramSettings from '@/components/TelegramSettings.tsx';
import NotificationsInbox from '@/components/NotificationsInbox.tsx';
import { runtimeEnv } from '@/lib/api/response';
import { getNotificationsPage, getNotifSeenAt } from '@/lib/db/notifications';
import { listChannels, getPrefs } from '@/lib/db/notificationChannels';
import { toClientChannels } from '@/lib/notifications/channelView';
import type { ClientChannel } from '@/lib/notifications/channelView';
import { loadActivityFeed } from '@/lib/forum/activityFeed.js';
import { getTopicsByIds } from '@/lib/db/forum.js';
import { loadAuthorIdentities, authorProfileHref } from '@/lib/forum/author.js';
import { statusBadge, isTerminalStatus } from '@/lib/governance/view.js';
import type { InboxItem } from '@/lib/notifications/inboxView.js';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}
const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;
const vapidPublicKey = env.VAPID_PUBLIC_KEY ?? '';
const telegramBotUsername = (env.TELEGRAM_BOT_USERNAME as string | undefined) ?? '';

// One verb per personal kind; a future 'message' or 'delegation' kind only
// needs a new entry here, not another template branch.
const PERSONAL_VERBS: Record<string, string> = {
  reply: 'replied in',
  mention: 'mentioned you in',
};

let items: InboxItem[] = [];
let pushChannels: ClientChannel[] = [];
let telegramChannels: ClientChannel[] = [];
let pushPrefs = { reply: true, mention: true, governance: true };
let telegramPrefs = { reply: true, mention: true, governance: true };
if (db) {
  // Read the cursor BEFORE anything else so unread highlighting reflects the
  // state the user is coming from, not the state after this page marks it seen.
  const [seenAt, personal, gov, channelRows, pPrefs, tPrefs] = await Promise.all([
    getNotifSeenAt(db, user.id),
    getNotificationsPage(db, user.id, 30),
    loadActivityFeed(db, { filter: 'governance', limit: 30 }),
    listChannels(db, user.id),
    getPrefs(db, user.id, 'webpush'),
    getPrefs(db, user.id, 'telegram'),
  ]);
  // Client-safe projection: id, dates, label and an endpoint fingerprint reach
  // the islands; the stored subscription (endpoint, keys) stays server-side.
  const clientChannels = await toClientChannels(channelRows);
  pushChannels = clientChannels.filter((c) => c.channel === 'webpush');
  telegramChannels = clientChannels.filter((c) => c.channel === 'telegram');
  pushPrefs = pPrefs;
  telegramPrefs = tPrefs;

  const topicIds = [...new Set(personal.map((n) => n.topic_id).filter((id): id is string => !!id))];
  const [topicsById, identities] = await Promise.all([
    getTopicsByIds(db, topicIds),
    loadAuthorIdentities(db, personal.map((n) => n.actor_id)),
  ]);

  const personalItems: InboxItem[] = personal.flatMap((n): InboxItem[] => {
    if (n.type === 'device_paired') {
      return [
        {
          kind: 'device_paired' as const,
          createdAt: n.created_at,
          unread: n.read_at === null,
          actorName: null,
          actorHref: null,
          verb: null,
          title: 'A new device was paired',
          // Links to the page where the pairing can be undone.
          href: '/devices/',
          pill: null,
        },
      ];
    }
    const topic = n.topic_id ? topicsById.get(n.topic_id) : undefined;
    if (!topic || topic.deleted) return [];
    const discussionTab = topic.source === 'governance' ? '?tab=discussion' : '';
    const anchor = n.post_id ? `#post-${n.post_id}` : '';
    const actor = n.actor_id ? identities.describe(n.actor_id) : null;
    return [
      {
        kind: n.type as 'reply' | 'mention',
        createdAt: n.created_at,
        unread: n.read_at === null,
        actorName: actor?.displayName ?? null,
        actorHref: actor ? authorProfileHref(actor) : null,
        verb: PERSONAL_VERBS[n.type] ?? null,
        title: topic.title,
        href: `/t/${topic.slug}/${discussionTab}${anchor}`,
        pill: null,
      },
    ];
  });

  const govItems: InboxItem[] = gov.events.map((e) => {
    // gov_created rows get a "New" pill; status changes reuse the shared
    // status badge (same labels and tones as the governance pages).
    const pill =
      e.kind === 'gov_status' && e.statusTransition
        ? { ...statusBadge(e.statusTransition.to), outline: isTerminalStatus(e.statusTransition.to) }
        : { label: 'New', tone: 'active' as const, outline: false };
    return {
      kind: e.kind as 'gov_created' | 'gov_status',
      createdAt: e.createdAt,
      unread: e.createdAt > seenAt,
      actorName: null,
      actorHref: null,
      verb: null,
      title: e.topic.title,
      href: `/t/${e.topic.slug}/`,
      pill,
    };
  });

  items = [...personalItems, ...govItems].sort((a, b) => b.createdAt - a.createdAt).slice(0, 50);
}

const now = Date.now();
const unreadCount = items.filter((r) => r.unread).length;
---
<Layout title="Notifications" noindex wide>
  <div class="notif-head">
    <div>
      <h1>Notifications</h1>
      <p class="notif-sub">Stay up to date with what matters to you.</p>
    </div>
    <div class="notif-head__actions">
      {/* Always rendered so the mechanism stays discoverable; disabled when
          there is nothing unread. */}
      <form method="post" action="/api/notifications/read">
        <button class="notif-markread" type="submit" disabled={unreadCount === 0}>
          Mark all as read
        </button>
      </form>
      <a class="notif-settingslink" href="#notification-settings">Notification settings</a>
    </div>
  </div>

  <NotificationsInbox items={items} now={now} client:load />

  {/* Notification settings live with the inbox they configure; collapsed so
      the page stays a reading surface. Open by default only while nothing is
      connected AND at least one channel is available, nudging first-time
      setup. */}
  <details
    id="notification-settings"
    class="notif-settings"
    open={pushChannels.length === 0 && telegramChannels.length === 0 && (vapidPublicKey !== '' || telegramBotUsername !== '')}
  >
    <summary>Notification settings</summary>
    <div class="notif-settings__body">
      <p class="nset__sub">Choose how you'd like to be notified and what you want to hear about.</p>
      <NotificationSettings
        channels={pushChannels}
        prefs={pushPrefs}
        vapidPublicKey={vapidPublicKey}
        client:load
      />
      {telegramBotUsername !== '' && (
        <TelegramSettings
          channels={telegramChannels}
          prefs={telegramPrefs}
          botUsername={telegramBotUsername}
          client:load
        />
      )}
    </div>
  </details>

</Layout>

<style>
  .notif-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .notif-head h1 { margin: 0; }
  .notif-sub {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .notif-head__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .notif-markread {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
  }
  .notif-markread:hover:not(:disabled) { background: var(--surface); }
  .notif-markread:disabled {
    color: var(--muted);
    cursor: default;
    opacity: 0.7;
  }
  .notif-settingslink {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.4rem 0.75rem;
  }
  .notif-settingslink:hover { background: var(--surface); }
  .notif-settings {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
  }
  .notif-settings summary {
    padding: 0.65rem 0.9rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--fg);
  }
  .notif-settings__body {
    padding: 0.25rem 0.9rem 0.9rem;
  }
</style>
