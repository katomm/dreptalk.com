---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import NotFound from '@/components/NotFound.astro';
import TopicRow from '@/components/TopicRow.astro';
import GovActionRow from '@/components/GovActionRow.astro';
import { getCategory, isDiscussion, GOVERNANCE_CATEGORY_SLUG } from '../../../config/categories.js';
import { getTopicsByCategory, getAllTopicsByCategory, type Topic } from '@/lib/db/forum.js';
import { getAllGovernanceActions } from '@/lib/db/governance.js';
import {
  parseGovSort,
  sortGovActionTopics,
  GOV_SORTS,
  parseGovStatus,
  filterByStatus,
  countByStatus,
  GOV_STATUSES,
  type GovActionTopic,
  type GovStatusFilter,
  type GovSort,
} from '@/lib/governance/sort.js';
import { getTotalDrepVotingPower, getVotedPowerByGaIds } from '@/lib/db/stakeParticipation.js';
import { stakeParticipation, type StakeParticipation } from '@/lib/governance/view.js';
import { loadAuthorIdentities } from '@/lib/forum/author.js';
import { parsePage, pageToOffset, cacheControlFor, SITE_ORIGIN } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const category = slug ? getCategory(slug) : undefined;

const notFound = !category;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const db = env.DB as D1Database | undefined;

const PAGE_SIZE = 30;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);
const now = Date.now();

const isGovernanceCategory = category?.slug === GOVERNANCE_CATEGORY_SLUG;
// Governance actions get their own sort modes (a DRep wants trending / closing
// soon, not the newest submission); discussion categories stay activity-ordered.
const sort = parseGovSort(Astro.url.searchParams.get('sort'));
// Status filter tab (all/active/enacted/expired) and which metric column to show.
const status = parseGovStatus(Astro.url.searchParams.get('status'));
const metric: 'stake' | 'sentiment' =
  Astro.url.searchParams.get('metric') === 'sentiment' ? 'sentiment' : 'stake';

let topics: Topic[] = [];
let govTotal = 0;
// Governance overview state: the joined+filtered+paged rows plus the per-page
// stake-participation map and tab counts. Empty for non-governance categories.
let pageRows: GovActionTopic[] = [];
let stakeByTopic = new Map<string, StakeParticipation | null>();
let statusCounts: Record<GovStatusFilter, number> = { all: 0, active: 0, enacted: 0, expired: 0 };

if (category && db) {
  if (isGovernanceCategory) {
    // The action set is small, so load all topics and all actions (param-less,
    // under D1's bound-parameter cap), join, filter by status, sort in memory,
    // then page. No N+1.
    const [all, allActions] = await Promise.all([
      getAllTopicsByCategory(db, category.slug),
      getAllGovernanceActions(db),
    ]);
    const actionByTopic = new Map(allActions.filter((a) => a.topicId).map((a) => [a.topicId!, a]));
    const rows: GovActionTopic[] = all
      .map((t) => ({ topic: t, action: actionByTopic.get(t.id) }))
      .filter((r): r is GovActionTopic => !!r.action);
    // Tab counts over the full (unpaged) set; computed before filtering/paging.
    statusCounts = countByStatus(rows);
    const filtered = filterByStatus(rows, status);
    const sorted = sortGovActionTopics(filtered, sort, now);
    govTotal = sorted.length;
    pageRows = sorted.slice(offset, offset + PAGE_SIZE);
    topics = pageRows.map((r) => r.topic);
    // Stake participation: exactly one total-power query and one batched
    // voted-power query for just this page's actions (no per-row queries).
    const gaIds = pageRows.map((r) => r.action.id);
    const [totalPower, votedByGa] = await Promise.all([
      getTotalDrepVotingPower(db),
      getVotedPowerByGaIds(db, gaIds),
    ]);
    stakeByTopic = new Map(
      pageRows.map((r) => [r.topic.id, stakeParticipation(votedByGa.get(r.action.id) ?? 0, totalPower)]),
    );
  } else {
    topics = await getTopicsByCategory(db, category.slug, { limit: PAGE_SIZE, offset });
  }
}

const identities = db && topics.length ? await loadAuthorIdentities(db, topics.map((t) => t.author_id)) : null;

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;

// Show composer only for authenticated users on discussion (non-governance) categories.
const user = Astro.locals.user;
const showComposer = !!user && !!category && isDiscussion(category.slug);

const prevPage = page > 1 ? page - 1 : null;
const nextPage = isGovernanceCategory
  ? (offset + PAGE_SIZE < govTotal ? page + 1 : null)
  : (topics.length === PAGE_SIZE ? page + 1 : null);

// Page links preserve the active status, sort, and metric for the governance
// category so paging stays within the selected view.
const pageHref = (p: number) =>
  isGovernanceCategory
    ? `/c/${category!.slug}?status=${status}&sort=${sort}&metric=${metric}&page=${p}`
    : `/c/${category!.slug}?page=${p}`;

// Governance control links (tabs, metric toggle, sort) all share the same query
// string and only vary one param; this keeps them in sync and resets to page 1.
const ctrlHref = (o: { status?: GovStatusFilter; sort?: GovSort; metric?: 'stake' | 'sentiment' }) =>
  `/c/${category!.slug}?status=${o.status ?? status}&sort=${o.sort ?? sort}&metric=${o.metric ?? metric}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DRepTalk',
      item: siteOrigin + '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category?.name ?? 'Category',
      item: siteOrigin + `/c/${slug}`,
    },
  ],
};
---

{notFound ? (
  <NotFound noun="Category" />
) : (
  <Layout
    title={`${category.name} - DRepTalk`}
    description={category.description}
  >
    <JsonLd data={breadcrumbLd} />

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <span>{category.name}</span>
    </nav>

    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.5rem;">
      <div>
        <h1 style="margin:0 0 0.25rem;">{category.name}</h1>
        <p style="margin:0;color:var(--muted);font-size:0.875rem;">
          {category.description}
          {isGovernanceCategory && (
            <>
              {' '}
              <a href="/help/governance-statuses" style="color:var(--accent);">What do the status labels mean?</a>
            </>
          )}
        </p>
      </div>
    </div>

    {isGovernanceCategory && (
      <div class="ga-controls">
        <nav class="ga-tabs" aria-label="Filter by status">
          {GOV_STATUSES.map((s) => (
            <a
              class="ga-tab"
              aria-current={s.mode === status ? 'page' : undefined}
              href={ctrlHref({ status: s.mode })}
            >
              {s.label} <span class="ga-tab__n">{statusCounts[s.mode]}</span>
            </a>
          ))}
        </nav>
        <div class="ga-controls__right">
          <div class="ga-toggle" role="group" aria-label="Metric">
            <a
              class={`ga-toggle__opt ${metric === 'stake' ? 'on' : ''}`}
              href={ctrlHref({ metric: 'stake' })}
            >
              Stake Participation
            </a>
            <a
              class={`ga-toggle__opt ${metric === 'sentiment' ? 'on' : ''}`}
              href={ctrlHref({ metric: 'sentiment' })}
            >
              Community Sentiment
            </a>
          </div>
          <nav class="ga-sort" aria-label="Sort">
            {GOV_SORTS.map((s) => (
              <a
                class={`ga-sort__opt ${s.mode === sort ? 'on' : ''}`}
                href={ctrlHref({ sort: s.mode })}
              >
                {s.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    )}

    {isGovernanceCategory ? (
      pageRows.length === 0 ? (
        <p style="color:var(--muted);">No governance actions in this view.</p>
      ) : (
        <div class="ga-list" data-metric={metric}>
          <div class="ga-list__head">
            <span>Governance Action</span>
            <span>{metric === 'stake' ? 'Stake Participation' : 'Community Sentiment'}</span>
            <span>DRep Participation</span>
            <span>Time Left</span>
          </div>
          {pageRows.map((r) => (
            <GovActionRow
              topic={r.topic}
              action={r.action}
              proposer={identities ? identities.describe(r.topic.author_id).displayName : undefined}
              stake={stakeByTopic.get(r.topic.id) ?? null}
              href={`/t/${r.topic.slug}`}
            />
          ))}
        </div>
      )
    ) : topics.length === 0 ? (
      <p style="color:var(--muted);">No topics yet in this category.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:0;">
        {topics.map((topic) => (
          <TopicRow
            topic={topic}
            now={now}
            author={identities ? identities.describe(topic.author_id) : undefined}
          />
        ))}
      </div>
    )}

    {(prevPage || nextPage) && (
      <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
        {prevPage && (
          <a href={pageHref(prevPage)}>Previous page</a>
        )}
        {nextPage && (
          <a href={pageHref(nextPage)}>Next page</a>
        )}
      </nav>
    )}

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Start a new topic</h2>
        <Composer client:load mode="topic" categorySlug={category.slug} />
      </section>
    )}
  </Layout>
)}

<style>
  /* Governance overview controls: status tabs on the left, metric toggle and
     sort links on the right. Wrap onto stacked rows on narrow screens. */
  .ga-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }
  .ga-controls__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  /* Status tabs as calm pills with a count. */
  .ga-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .ga-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.12s, background 0.12s, border-color 0.12s;
  }
  .ga-tab:hover {
    color: var(--fg);
  }
  .ga-tab[aria-current='page'] {
    color: var(--fg);
    background: var(--surface-2);
    border-color: var(--fg);
    font-weight: 600;
  }
  .ga-tab__n {
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 0 0.4em;
    min-width: 1.4em;
    text-align: center;
  }
  .ga-tab[aria-current='page'] .ga-tab__n {
    background: var(--surface);
  }

  /* Metric toggle as a segmented control; the active option uses --accent. */
  .ga-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }
  .ga-toggle__opt {
    padding: 0.375rem 0.75rem;
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface);
    transition: color 0.12s, background 0.12s;
  }
  .ga-toggle__opt + .ga-toggle__opt {
    border-left: 1px solid var(--border);
  }
  .ga-toggle__opt:hover {
    color: var(--fg);
  }
  .ga-toggle__opt.on {
    color: var(--on-accent);
    background: var(--accent);
  }

  /* Sort as a row of small links; the active one is emphasized. */
  .ga-sort {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }
  .ga-sort__opt {
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--muted);
  }
  .ga-sort__opt:hover {
    color: var(--fg);
  }
  .ga-sort__opt.on {
    color: var(--fg);
    font-weight: 600;
  }

  /* The list and its header row. The header grid MUST match GovActionRow's
     row grid (columns, gap, horizontal padding) so the labels align. */
  .ga-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .ga-list__head {
    display: grid;
    grid-template-columns: 2.6fr 1.6fr 1.1fr 1.3fr;
    gap: 18px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 600;
  }
  /* Rows collapse to a single column below 720px, so the header would no longer
     align; hide it there. */
  @media (max-width: 720px) {
    .ga-list__head {
      display: none;
    }
  }
</style>
