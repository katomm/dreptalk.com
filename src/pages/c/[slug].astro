---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import NotFound from '@/components/NotFound.astro';
import TopicRow from '@/components/TopicRow.astro';
import GovActionRow from '@/components/GovActionRow.astro';
import { getCategory, isDiscussion, GOVERNANCE_CATEGORY_SLUG } from '../../../config/categories.js';
import { getTopicsByCategory, getTopicsByIds, type Topic } from '@/lib/db/forum.js';
import { getGovernanceActionTopicIdsPage, getGovernanceActionsByTopicIds } from '@/lib/db/governance.js';
import {
  parseGovSort,
  GOV_SORTS,
  type GovActionTopic,
  type GovSort,
} from '@/lib/governance/sort.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import { stakeParticipation, overviewTally, type StakeParticipation } from '@/lib/governance/view.js';
import { loadAuthorIdentities } from '@/lib/forum/author.js';
import { proposerView } from '@/lib/identity/proposer.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, SITE_ORIGIN } from '@/lib/forum/view.js';
import { currentNetwork } from '@/lib/api/response.js';
// Raw inline script (pinned in the CSP by its hash in astro.config.mjs) that
// persists/restores the reader's sort + metric choice in localStorage.
import govPrefsRestoreJs from '@/scripts/gov-prefs-restore.js?raw';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const category = slug ? getCategory(slug) : undefined;
// Active network, passed to each row so it can turn an expiry epoch into a date.
const network = currentNetwork().network;

const notFound = !category;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const db = env.DB as D1Database | undefined;

const PAGE_SIZE = 30;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);
const now = Date.now();

const isGovernanceCategory = category?.slug === GOVERNANCE_CATEGORY_SLUG;
// Governance actions get their own sort modes (a DRep wants trending / closing
// soon, not the newest submission); discussion categories stay activity-ordered.
const sort = parseGovSort(Astro.url.searchParams.get('sort'));
// Which metric column to show (sentiment by default).
const metric: 'stake' | 'sentiment' =
  Astro.url.searchParams.get('metric') === 'stake' ? 'stake' : 'sentiment';

let topics: Topic[] = [];
let govTotal = 0;
// Governance overview state: the joined+sorted+paged rows plus the per-page
// stake-participation map. Empty for non-governance categories.
let pageRows: GovActionTopic[] = [];
let stakeByTopic = new Map<string, StakeParticipation | null>();
// Freshness of the cached on-chain numbers shown on this page (ms; null when
// nothing to disclose). Stake from the dreps sync, sentiment from per-action tallies.
let stakeAsOf: number | null = null;
let tallyAsOf: number | null = null;

if (category && db) {
  if (isGovernanceCategory) {
    // Order and page in the database (O(page size), not O(all actions)). Trending reads
    // the gov-sync-materialized trending_score; the other modes order by raw lifecycle
    // columns. Then hydrate just this page's ids with two batched by-id reads (no N+1).
    const { topicIds, total } = await getGovernanceActionTopicIdsPage(db, {
      categorySlug: category.slug,
      sort,
      limit: PAGE_SIZE,
      offset,
    });
    const [topicById, actionByTopic] = await Promise.all([
      getTopicsByIds(db, topicIds),
      getGovernanceActionsByTopicIds(db, topicIds),
    ]);
    // Preserve the database order; drop any id whose topic or action is missing
    // (a soft-delete racing the page read), mirroring the old inner-join filter.
    pageRows = topicIds
      .map((id) => {
        const topic = topicById.get(id);
        const action = actionByTopic.get(id);
        return topic && action ? { topic, action } : null;
      })
      .filter((r): r is GovActionTopic => r !== null);
    govTotal = total;
    topics = pageRows.map((r) => r.topic);
    // Stake participation is DRep turnout (voted DRep power / total DRep power);
    // we have no SPO turnout, so only DRep-led rows get a value. SPO-led rows
    // (hard fork, no-confidence, committee) leave the cell as a dash rather than
    // showing a DRep turnout that does not match their SPO sentiment bar.
    const stakeRows = pageRows.filter((r) => overviewTally(r.action)?.role !== 'SPO');
    // Voted power is the stored per-action field (populated by tally sync and
    // backfill). Only query total power when at least one shown row has it;
    // otherwise every cell is a dash and the query plus "as of" label are wasted.
    if (stakeRows.some((r) => r.action.drepVotedPower != null)) {
      const stake = await getActiveDrepStake(db);
      stakeAsOf = stake.asOf;
      stakeByTopic = new Map(
        stakeRows.map((r) => [
          r.topic.id,
          // No tally yet (drep_voted_power null) -> dash; a stored value (even 0) is real turnout.
          r.action.drepVotedPower == null ? null : stakeParticipation(r.action.drepVotedPower, stake.total),
        ]),
      );
    }
    // Sentiment staleness comes from the per-action tally sync time (in memory, no query).
    tallyAsOf = pageRows.reduce<number | null>(
      (mx, r) => (r.action.tallySyncedAt != null && (mx == null || r.action.tallySyncedAt > mx) ? r.action.tallySyncedAt : mx),
      null,
    );
  } else {
    topics = await getTopicsByCategory(db, category.slug, { limit: PAGE_SIZE, offset });
  }
}

const identities = db && topics.length ? await loadAuthorIdentities(db, topics.map((t) => t.author_id)) : null;

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;

// Show composer only for authenticated users on discussion (non-governance) categories.
const user = Astro.locals.user;
const showComposer = !!user && !!category && isDiscussion(category.slug);

const prevPage = page > 1 ? page - 1 : null;
const nextPage = isGovernanceCategory
  ? (offset + PAGE_SIZE < govTotal ? page + 1 : null)
  : (topics.length === PAGE_SIZE ? page + 1 : null);

// Page links preserve the active sort and metric for the governance category so
// paging stays within the selected view.
const pageHref = (p: number) =>
  isGovernanceCategory
    ? `/c/${category!.slug}?sort=${sort}&metric=${metric}&page=${p}`
    : `/c/${category!.slug}?page=${p}`;

// Governance control links (sort tabs, metric toggle) share the same query string
// and only vary one param; this keeps them in sync and resets to page 1.
const ctrlHref = (o: { sort?: GovSort; metric?: 'stake' | 'sentiment' }) =>
  `/c/${category!.slug}?sort=${o.sort ?? sort}&metric=${o.metric ?? metric}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DRepTalk',
      item: siteOrigin + '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category?.name ?? 'Category',
      item: siteOrigin + `/c/${slug}`,
    },
  ],
};
---

{notFound ? (
  <NotFound noun="Category" />
) : (
  <Layout
    title={`${category.name} - DRepTalk`}
    description={category.description}
  >
    <JsonLd data={breadcrumbLd} />

    {isGovernanceCategory && <script is:inline set:html={govPrefsRestoreJs} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <span>{category.name}</span>
    </nav>

    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.5rem;">
      <div>
        <h1 style="margin:0 0 0.25rem;">{category.name}</h1>
        <p style="margin:0;color:var(--muted);font-size:0.875rem;">
          {category.description}
          {isGovernanceCategory && (
            <>
              {' '}
              <a href="/help/governance-statuses" style="color:var(--accent);">What do the status labels mean?</a>
            </>
          )}
        </p>
      </div>
    </div>

    {isGovernanceCategory && (
      <div class="ga-controls">
        <nav class="ga-tabs" aria-label="Sort">
          {GOV_SORTS.map((s) => (
            <a
              class="ga-tab"
              aria-current={s.mode === sort ? 'true' : undefined}
              href={ctrlHref({ sort: s.mode })}
            >
              {s.label}
            </a>
          ))}
          <a class="ga-tab-help" href="/help/sorting">How sorting works</a>
        </nav>
        <div class="ga-controls__right">
          <div class="ga-toggle" role="group" aria-label="Metric">
            <a
              class={`ga-toggle__opt ${metric === 'stake' ? 'on' : ''}`}
              aria-current={metric === 'stake' ? 'true' : undefined}
              href={ctrlHref({ metric: 'stake' })}
            >
              Participation
            </a>
            <a
              class={`ga-toggle__opt ${metric === 'sentiment' ? 'on' : ''}`}
              aria-current={metric === 'sentiment' ? 'true' : undefined}
              href={ctrlHref({ metric: 'sentiment' })}
            >
              Sentiment
            </a>
          </div>
        </div>
      </div>
    )}

    {isGovernanceCategory ? (
      pageRows.length === 0 ? (
        <p style="color:var(--muted);">No governance actions in this view.</p>
      ) : (
        <>
        {/* data-metric drives which single metric shows below the wide breakpoint
           (for both the rows and the staleness notes); it is inert when wide. */}
        <div class="ga-wrap" data-metric={metric}>
        <div class="ga-list">
          <div class="ga-list__head">
            <span>Governance Action</span>
            <span class="ga-head__metric ga-head__metric--stake">Participation</span>
            <span class="ga-head__metric ga-head__metric--sentiment">Sentiment</span>
            <span>Activity</span>
            {/* The Time Left header doubles as a sort shortcut for Closing Soon
               (soonest expiry first); it mirrors the Closing Soon tab's state. */}
            <a
              class="ga-list__sortlink"
              href={ctrlHref({ sort: 'closing' })}
              aria-current={sort === 'closing' ? 'true' : undefined}
              aria-label="Sort by soonest closing"
            >
              Time Left{sort === 'closing' && <span class="ga-list__caret" aria-hidden="true">↑</span>}
            </a>
          </div>
          {pageRows.map((r) => {
            const pv = proposerView(r.action.returnAddress);
            const proposer = pv.kind === 'known' ? pv.name : pv.kind === 'unknown' ? pv.short : undefined;
            const proposerIcon = pv.kind === 'known' ? (pv.icon ?? undefined) : undefined;
            return (
              <GovActionRow
                topic={r.topic}
                action={r.action}
                proposer={proposer}
                proposerIcon={proposerIcon}
                stake={stakeByTopic.get(r.topic.id) ?? null}
                network={network}
                now={now}
                href={`/t/${r.topic.slug}`}
              />
            );
          })}
        </div>
        {/* Disclose how stale the cached on-chain numbers are. Both notes render
           when wide (both metrics visible); narrow screens hide the inactive one
           via data-metric. Same formatter/phrasing as the GA thread header. */}
        {stakeAsOf != null && (
          <p class="ga-asof ga-asof--stake">Stake data as of {formatRelativeTime(stakeAsOf, now)}. Cached, not live.</p>
        )}
        {tallyAsOf != null && (
          <p class="ga-asof ga-asof--sentiment">Tallies as of {formatRelativeTime(tallyAsOf, now)}. Cached, not live.</p>
        )}
        </div>
        </>
      )
    ) : topics.length === 0 ? (
      <p style="color:var(--muted);">No topics yet in this category.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:0;">
        {topics.map((topic) => (
          <TopicRow
            topic={topic}
            now={now}
            network={network}
            author={identities ? identities.describe(topic.author_id) : undefined}
          />
        ))}
      </div>
    )}

    {(prevPage || nextPage) && (
      <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
        {prevPage && (
          <a href={pageHref(prevPage)}>Previous page</a>
        )}
        {nextPage && (
          <a href={pageHref(nextPage)}>Next page</a>
        )}
      </nav>
    )}

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Start a new topic</h2>
        <Composer client:load mode="topic" categorySlug={category.slug} />
      </section>
    )}
  </Layout>
)}

<style>
  /* Governance overview controls: sort tabs on the left, metric toggle on the
     right. Wrap onto stacked rows on narrow screens. */
  .ga-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }
  .ga-controls__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  /* Sort tabs as calm pills; the active one is emphasized. */
  .ga-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .ga-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.12s, background 0.12s, border-color 0.12s;
  }
  .ga-tab:hover {
    color: var(--fg);
  }
  .ga-tab[aria-current='true'] {
    color: var(--fg);
    background: var(--surface-2);
    border-color: var(--fg);
    font-weight: 600;
  }

  /* Quiet help affordance trailing the sort tabs: a muted link, not a pill. */
  .ga-tab-help {
    align-self: center;
    margin-left: 0.25rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }
  .ga-tab-help:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  /* Metric toggle as a segmented control; the active option uses --accent. */
  .ga-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }
  .ga-toggle__opt {
    padding: 0.375rem 0.75rem;
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface);
    transition: color 0.12s, background 0.12s;
  }
  .ga-toggle__opt + .ga-toggle__opt {
    border-left: 1px solid var(--border);
  }
  .ga-toggle__opt:hover {
    color: var(--fg);
  }
  .ga-toggle__opt.on {
    color: var(--on-accent);
    background: var(--accent);
  }

  /* The list and its header row. The header grid MUST match GovActionRow's
     row grid (columns, gap, horizontal padding) so the labels align. */
  .ga-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .ga-list__head {
    display: grid;
    grid-template-columns: 2.2fr 1.2fr 1.3fr 0.95fr 1.35fr;
    gap: 18px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 600;
  }
  /* The Time Left header is a sort shortcut; it inherits the calm header look and
     gets emphasized when its sort (Closing Soon) is active. */
  .ga-list__sortlink {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    color: inherit;
    text-decoration: none;
    transition: color 0.12s;
  }
  .ga-list__sortlink:hover {
    color: var(--fg);
  }
  .ga-list__sortlink[aria-current='true'] {
    color: var(--fg);
  }
  .ga-list__caret {
    font-size: 0.9em;
  }
  /* Wide screens show both metric columns, so the toggle (which only chooses one)
     is redundant; the rows show both regardless. It returns below the breakpoint. */
  @media (min-width: 1001px) {
    .ga-controls__right {
      display: none;
    }
  }

  /* Below the wide breakpoint the header drops to four columns and shows only the
     metric the toggle selects, mirroring the rows (data-metric on .ga-wrap). */
  @media (max-width: 1000px) {
    .ga-list__head {
      grid-template-columns: 2.6fr 1.6fr 1.1fr 1.3fr;
    }
    /* Header label and staleness note share the toggle: stake shows by default,
       sentiment swaps in. Grouped so the two targets never drift apart. */
    .ga-head__metric--sentiment,
    .ga-asof--sentiment {
      display: none;
    }
    [data-metric='sentiment'] .ga-head__metric--stake,
    [data-metric='sentiment'] .ga-asof--stake {
      display: none;
    }
    [data-metric='sentiment'] .ga-head__metric--sentiment,
    [data-metric='sentiment'] .ga-asof--sentiment {
      display: block;
    }
  }

  /* Rows collapse to a single column below 720px, so the header would no longer
     align; hide it there. */
  @media (max-width: 720px) {
    .ga-list__head {
      display: none;
    }
    /* Rows become standalone cards on mobile (see GovActionRow), so drop the
       table's top border and space the cards apart instead. */
    .ga-list {
      border-top: none;
      gap: 12px;
    }
  }

  /* Staleness footnote: the cached on-chain numbers are never live. */
  .ga-asof {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
</style>
