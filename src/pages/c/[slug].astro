---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import NotFound from '@/components/NotFound.astro';
import TopicRow from '@/components/TopicRow.astro';
import GovActionRow from '@/components/GovActionRow.astro';
import Pager from '@/components/Pager.astro';
import { getCategory, isDiscussion, GOVERNANCE_CATEGORY_SLUG, BUDGET_CATEGORY_SLUG } from '../../../config/categories.js';
import { getTopicsByCategory, getTopicsByIds, type Topic } from '@/lib/db/forum.js';
import { getGovernanceActionTopicIdsPage, getGovernanceActionsByTopicIds } from '@/lib/db/governance.js';
import { getProtocolParams, type ProtocolParams } from '@/lib/db/protocolParams.js';
import { loadTreasuryOverview, type TreasuryOverviewData } from '@/lib/treasury/overview.js';
import TreasuryOverview from '@/components/ncl/TreasuryOverview.astro';
import {
  parseGovSort,
  GOV_SORTS,
  type GovActionTopic,
  type GovSort,
} from '@/lib/governance/sort.js';
import { GOV_ACTION_TYPES, parseGovType } from '@/lib/governance/types.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import { loadAuthorIdentities } from '@/lib/forum/author.js';
import { proposerView } from '@/lib/identity/proposer.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, SITE_ORIGIN } from '@/lib/forum/view.js';
import { currentNetwork } from '@/lib/api/response.js';
// Raw inline script (pinned in the CSP by its hash in astro.config.mjs) that
// persists/restores the reader's sort choice in localStorage.
import govPrefsRestoreJs from '@/scripts/gov-prefs-restore.js?raw';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const category = slug ? getCategory(slug) : undefined;
// Active network, passed to each row so it can turn an expiry epoch into a date.
const network = currentNetwork().network;

const notFound = !category;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const db = env.DB as D1Database | undefined;

const PAGE_SIZE = 30;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);
const now = Date.now();

const isGovernanceCategory = category?.slug === GOVERNANCE_CATEGORY_SLUG;
const isBudgetCategory = category?.slug === BUDGET_CATEGORY_SLUG;
// OG card per category kind: the governance-actions overview gets its own card,
// other discussion categories share the generic discussion card. The budget
// category is finalized to the current treasury card after the overview loads,
// deriving the period id (never a hardcoded period that silently rots).
let categoryOgImage = isGovernanceCategory ? '/og-governance-actions.jpg' : '/og/discussion.png';
// Governance actions are the flagship, most-shared category, so give them a
// fuller SEO title and meta description. The meta description is deliberately
// separate from the on-page category.description below (which stays a short
// human subtitle) so SEO copy does not bloat the visible page text. Other
// categories keep the generic pattern.
const metaTitle = isGovernanceCategory
  ? 'Cardano Governance Actions - On-Chain Proposals - DRepTalk'
  : `${category?.name ?? ''} - DRepTalk`;
const metaDescription = isGovernanceCategory
  ? 'Every on-chain Cardano governance action gets its own thread. Track treasury withdrawals, parameter changes, and votes, with live tallies and DRep deliberation.'
  : (category?.description ?? '');
// Governance actions get their own sort modes (a DRep wants trending / closing
// soon, not the newest submission); discussion categories stay activity-ordered.
const sort = parseGovSort(Astro.url.searchParams.get('sort'));
// Optional action-type filter (?type=). Unknown/absent -> null (all types). Unlike
// sort this is a transient filter, so it is deliberately not persisted.
const typeFilter = parseGovType(Astro.url.searchParams.get('type'));

let topics: Topic[] = [];
let govTotal = 0;
// Governance overview state: the joined+sorted+paged rows. Empty for
// non-governance categories.
let pageRows: GovActionTopic[] = [];
// Current protocol params, so a ParameterChange row can show its old→new pair,
// and each row's CC participation can divide by the current committee size.
let govParamsRawJson: string | null = null;
let committeeSize: number | null = null;
// Full protocol params, so each threshold-type row can place its ratification
// threshold marker (the same marker the detail card shows).
let overviewParams: ProtocolParams | null = null;
// Total active DRep voting power, the denominator for each row's DRep
// participation bar. Null when the sync has not populated it yet.
let drepStakeTotal: number | null = null;
// Freshness of the cached on-chain numbers shown on this page (ms; null when
// nothing to disclose). Stake from the dreps sync, tallies from per-action sync.
let stakeAsOf: number | null = null;
let tallyAsOf: number | null = null;
// Treasury overview embedded above the thread list, budget category only, so
// no other category pays for this extra query.
let treasuryOverview: TreasuryOverviewData | null = null;

if (category && db) {
  if (isBudgetCategory) {
    treasuryOverview = await loadTreasuryOverview(db);
    const periodId = treasuryOverview?.currentStatus?.period.id;
    if (periodId) categoryOgImage = `/og/treasury/${periodId}.png`;
  }
  if (isGovernanceCategory) {
    // Order and page in the database (O(page size), not O(all actions)). Trending reads
    // the gov-sync-materialized trending_score; the other modes order by raw lifecycle
    // columns. Then hydrate just this page's ids with two batched by-id reads (no N+1).
    const { topicIds, total } = await getGovernanceActionTopicIdsPage(db, {
      categorySlug: category.slug,
      sort,
      limit: PAGE_SIZE,
      offset,
      type: typeFilter,
    });
    const [topicById, actionByTopic, protoParams, stake] = await Promise.all([
      getTopicsByIds(db, topicIds),
      getGovernanceActionsByTopicIds(db, topicIds),
      getProtocolParams(db),
      getActiveDrepStake(db),
    ]);
    govParamsRawJson = protoParams?.rawJson ?? null;
    committeeSize = protoParams?.committeeSize ?? null;
    overviewParams = protoParams ?? null;
    drepStakeTotal = stake.total > 0 ? stake.total : null;
    stakeAsOf = stake.asOf;
    // Preserve the database order; drop any id whose topic or action is missing
    // (a soft-delete racing the page read), mirroring the old inner-join filter.
    pageRows = topicIds
      .map((id) => {
        const topic = topicById.get(id);
        const action = actionByTopic.get(id);
        return topic && action ? { topic, action } : null;
      })
      .filter((r): r is GovActionTopic => r !== null);
    govTotal = total;
    topics = pageRows.map((r) => r.topic);
    // Tally staleness comes from the per-action tally sync time (in memory, no query).
    tallyAsOf = pageRows.reduce<number | null>(
      (mx, r) => (r.action.tallySyncedAt != null && (mx == null || r.action.tallySyncedAt > mx) ? r.action.tallySyncedAt : mx),
      null,
    );
  } else {
    topics = await getTopicsByCategory(db, category.slug, { limit: PAGE_SIZE, offset });
  }
}

const identities = db && topics.length ? await loadAuthorIdentities(db, topics.map((t) => t.author_id)) : null;

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;

// Show composer only for authenticated users on discussion (non-governance) categories.
const user = Astro.locals.user;
const showComposer = !!user && !!category && isDiscussion(category.slug);

const prevPage = page > 1 ? page - 1 : null;
const nextPage = isGovernanceCategory
  ? (offset + PAGE_SIZE < govTotal ? page + 1 : null)
  : (topics.length === PAGE_SIZE ? page + 1 : null);
// A total page count is only known for the governance category (it has a real
// row count); non-governance categories page by the "full page ⇒ maybe more"
// heuristic, so the pager shows just the current page there.
const totalPages = isGovernanceCategory ? Math.max(1, Math.ceil(govTotal / PAGE_SIZE)) : null;

// Shared query tail for governance links: keeps sort, and the type filter when
// one is active (omitted for "all types" so the default URL stays clean).
const govQuery = (o: { sort?: GovSort; type?: string | null }) => {
  const t = o.type === undefined ? typeFilter : o.type;
  const typeParam = t ? `&type=${encodeURIComponent(t)}` : '';
  return `sort=${o.sort ?? sort}${typeParam}`;
};

// Page links preserve the active sort and type for the governance category so
// paging stays within the selected view.
const pageHref = (p: number) =>
  isGovernanceCategory
    ? `/c/${category!.slug}?${govQuery({})}&page=${p}`
    : `/c/${category!.slug}?page=${p}`;

// Governance control links (sort tabs, type filter) share the same query string
// and only vary one param; this keeps them in sync and resets to page 1.
const ctrlHref = (o: { sort?: GovSort; type?: string | null }) =>
  `/c/${category!.slug}?${govQuery(o)}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DRepTalk',
      item: siteOrigin + '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category?.name ?? 'Category',
      item: siteOrigin + `/c/${slug}`,
    },
  ],
};
---

{notFound ? (
  <NotFound noun="Category" />
) : (
  <Layout
    title={metaTitle}
    description={metaDescription}
    ogImage={categoryOgImage}
  >
    <JsonLd data={breadcrumbLd} />

    {isGovernanceCategory && <script is:inline set:html={govPrefsRestoreJs} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <span>{category.name}</span>
    </nav>

    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.5rem;">
      <div>
        <h1 style="margin:0 0 0.25rem;">{category.name}</h1>
        <p style="margin:0;color:var(--muted);font-size:0.875rem;">
          {category.description}
        </p>
      </div>
    </div>

    {treasuryOverview && (
      <TreasuryOverview data={treasuryOverview} detailHref="/treasury" />
    )}

    {isGovernanceCategory && (
      <div class="ga-controls">
        <nav class="ga-tabs" aria-label="Sort">
          {GOV_SORTS.map((s) => (
            <a
              class="ga-tab"
              aria-current={s.mode === sort ? 'true' : undefined}
              href={ctrlHref({ sort: s.mode })}
            >
              {s.label}
            </a>
          ))}
        </nav>
        <div class="ga-controls__right">
          <details class="ga-typefilter">
            <summary class="ga-typefilter__summary">
              <span class="ga-typefilter__label">Type</span>
              <span class="ga-typefilter__value">
                {typeFilter ? GOV_ACTION_TYPES.find((t) => t.value === typeFilter)?.label : 'All types'}
              </span>
              <span class="ga-typefilter__caret" aria-hidden="true">▾</span>
            </summary>
            <div class="ga-typefilter__menu" role="menu">
              <a
                class="ga-typefilter__opt"
                aria-current={typeFilter === null ? 'true' : undefined}
                href={ctrlHref({ type: null })}
              >
                All types
              </a>
              {GOV_ACTION_TYPES.map((t) => (
                <a
                  class="ga-typefilter__opt"
                  aria-current={typeFilter === t.value ? 'true' : undefined}
                  href={ctrlHref({ type: t.value })}
                >
                  {t.label}
                </a>
              ))}
            </div>
          </details>
        </div>
      </div>
    )}

    {isGovernanceCategory ? (
      pageRows.length === 0 ? (
        typeFilter ? (
          <p style="color:var(--muted);">
            No {GOV_ACTION_TYPES.find((t) => t.value === typeFilter)?.label} actions.{' '}
            <a href={ctrlHref({ type: null })}>Clear filter</a>
          </p>
        ) : (
          <p style="color:var(--muted);">No governance actions in this view.</p>
        )
      ) : (
        <>
        <div class="ga-wrap">
        <div class="ga-list">
          <div class="ga-list__head">
            <span>Governance Action</span>
            <span>Voting</span>
            <span>Activity</span>
            {/* The Time Left header doubles as a sort shortcut for Closing Soon
               (soonest expiry first); it mirrors the Closing Soon tab's state. */}
            <a
              class="ga-list__sortlink"
              href={ctrlHref({ sort: 'closing' })}
              aria-current={sort === 'closing' ? 'true' : undefined}
              aria-label="Sort by soonest closing"
            >
              Time Left{sort === 'closing' && <span class="ga-list__caret" aria-hidden="true">↑</span>}
            </a>
          </div>
          {pageRows.map((r) => {
            const pv = proposerView(r.action.returnAddress);
            const proposer = pv.kind === 'known' ? pv.name : pv.kind === 'unknown' ? pv.short : undefined;
            const proposerIcon = pv.kind === 'known' ? (pv.icon ?? undefined) : undefined;
            return (
              <GovActionRow
                topic={r.topic}
                action={r.action}
                proposer={proposer}
                proposerIcon={proposerIcon}
                drepStakeTotal={drepStakeTotal}
                committeeSize={committeeSize}
                params={overviewParams}
                network={network}
                now={now}
                href={`/t/${r.topic.slug}`}
                epochParamsJson={govParamsRawJson}
              />
            );
          })}
        </div>
        {/* Disclose how stale the cached on-chain numbers are: DRep stake from the
           dreps sync, tallies from per-action sync. Same formatter/phrasing as the
           GA thread header. */}
        {stakeAsOf != null && (
          <p class="ga-asof">Stake data as of {formatRelativeTime(stakeAsOf, now)}. Cached, not live.</p>
        )}
        {tallyAsOf != null && (
          <p class="ga-asof">Tallies as of {formatRelativeTime(tallyAsOf, now)}. Cached, not live.</p>
        )}
        </div>
        </>
      )
    ) : topics.length === 0 ? (
      <p style="color:var(--muted);">No topics yet in this category.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:0;">
        {topics.map((topic) => (
          <TopicRow
            topic={topic}
            now={now}
            network={network}
            author={identities ? identities.describe(topic.author_id) : undefined}
          />
        ))}
      </div>
    )}

    <Pager
      prevHref={prevPage ? pageHref(prevPage) : null}
      nextHref={nextPage ? pageHref(nextPage) : null}
      page={page}
      totalPages={totalPages}
      label="Topic list pagination"
    />

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Start a new topic</h2>
        <Composer client:load mode="topic" categorySlug={category.slug} />
      </section>
    )}
  </Layout>
)}

<style>
  /* Governance overview controls: sort tabs on the left, type filter on the
     right. Wrap onto stacked rows on narrow screens. */
  .ga-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }
  .ga-controls__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  /* Type filter: a details/summary disclosure styled to match the other pill
     controls, with an absolutely positioned menu of plain links (no client JS). */
  .ga-typefilter { position: relative; }
  .ga-typefilter__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .ga-typefilter__summary::-webkit-details-marker { display: none; }
  .ga-typefilter__label { color: var(--muted); }
  .ga-typefilter__value { font-weight: 600; }
  .ga-typefilter[open] .ga-typefilter__caret { transform: rotate(180deg); }
  .ga-typefilter__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
    z-index: 20;
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 0.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .ga-typefilter__opt {
    padding: 0.4rem 0.6rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    color: var(--fg);
    text-decoration: none;
  }
  .ga-typefilter__opt:hover { background: var(--surface-2); }
  .ga-typefilter__opt[aria-current='true'] { color: var(--accent); font-weight: 600; }

  /* Sort tabs as calm pills; the active one is emphasized. */
  .ga-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .ga-tab {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.12s, background 0.12s, border-color 0.12s;
  }
  .ga-tab:hover {
    color: var(--fg);
  }
  .ga-tab[aria-current='true'] {
    color: var(--fg);
    background: var(--surface-2);
    border-color: var(--fg);
    font-weight: 600;
  }

  /* The list and its header row. The header grid MUST match GovActionRow's
     row grid (columns, gap, horizontal padding) so the labels align. */
  .ga-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .ga-list__head {
    display: grid;
    grid-template-columns: 2.2fr 1.7fr 0.9fr 1.3fr;
    gap: 18px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-weight: 600;
  }
  /* The Time Left header is a sort shortcut; it inherits the calm header look and
     gets emphasized when its sort (Closing Soon) is active. */
  .ga-list__sortlink {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    color: inherit;
    text-decoration: none;
    transition: color 0.12s;
  }
  .ga-list__sortlink:hover {
    color: var(--fg);
  }
  .ga-list__sortlink[aria-current='true'] {
    color: var(--fg);
  }
  .ga-list__caret {
    font-size: 0.9em;
  }

  /* Mirror GovActionRow's tightened four-column grid at the same breakpoint. */
  @media (max-width: 1000px) {
    .ga-list__head {
      grid-template-columns: 2fr 1.7fr 0.8fr 1.1fr;
    }
  }

  /* Rows collapse to a single column below 720px, so the header would no longer
     align; hide it there. */
  @media (max-width: 720px) {
    .ga-list__head {
      display: none;
    }
    /* Rows become standalone cards on mobile (see GovActionRow), so drop the
       table's top border and space the cards apart instead. */
    .ga-list {
      border-top: none;
      gap: 12px;
    }
  }

  /* Staleness footnote: the cached on-chain numbers are never live. */
  .ga-asof {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
</style>
