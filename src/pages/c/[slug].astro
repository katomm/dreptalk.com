---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import NotFound from '@/components/NotFound.astro';
import TopicRow from '@/components/TopicRow.astro';
import { getCategory, isDiscussion, GOVERNANCE_CATEGORY_SLUG } from '../../../config/categories.js';
import { getTopicsByCategory, getAllTopicsByCategory, type Topic } from '@/lib/db/forum.js';
import { getAllGovernanceActions, type GovernanceAction } from '@/lib/db/governance.js';
import { parseGovSort, sortGovActionTopics, GOV_SORTS, type GovActionTopic } from '@/lib/governance/sort.js';
import { loadAuthorIdentities } from '@/lib/forum/author.js';
import { parsePage, pageToOffset, cacheControlFor, SITE_ORIGIN } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const category = slug ? getCategory(slug) : undefined;

const notFound = !category;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const db = env.DB as D1Database | undefined;

const PAGE_SIZE = 30;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);
const now = Date.now();

const isGovernanceCategory = category?.slug === GOVERNANCE_CATEGORY_SLUG;
// Governance actions get their own sort modes (a DRep wants trending / closing
// soon, not the newest submission); discussion categories stay activity-ordered.
const sort = parseGovSort(Astro.url.searchParams.get('sort'));

let topics: Topic[] = [];
let govByTopic = new Map<string, GovernanceAction>();
let govTotal = 0;

if (category && db) {
  if (isGovernanceCategory) {
    // The action set is small, so load all topics and all actions (param-less,
    // under D1's bound-parameter cap), join, sort in memory, then page. No N+1.
    const [all, allActions] = await Promise.all([
      getAllTopicsByCategory(db, category.slug),
      getAllGovernanceActions(db),
    ]);
    const actionByTopic = new Map(allActions.filter((a) => a.topicId).map((a) => [a.topicId!, a]));
    const rows: GovActionTopic[] = all
      .map((t) => ({ topic: t, action: actionByTopic.get(t.id) }))
      .filter((r): r is GovActionTopic => !!r.action);
    const sorted = sortGovActionTopics(rows, sort, now);
    govTotal = sorted.length;
    const pageRows = sorted.slice(offset, offset + PAGE_SIZE);
    topics = pageRows.map((r) => r.topic);
    govByTopic = new Map(pageRows.map((r) => [r.topic.id, r.action]));
  } else {
    topics = await getTopicsByCategory(db, category.slug, { limit: PAGE_SIZE, offset });
  }
}

const identities = db && topics.length ? await loadAuthorIdentities(db, topics.map((t) => t.author_id)) : null;

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;

// Show composer only for authenticated users on discussion (non-governance) categories.
const user = Astro.locals.user;
const showComposer = !!user && !!category && isDiscussion(category.slug);

const prevPage = page > 1 ? page - 1 : null;
const nextPage = isGovernanceCategory
  ? (offset + PAGE_SIZE < govTotal ? page + 1 : null)
  : (topics.length === PAGE_SIZE ? page + 1 : null);

// Page links preserve the active sort for the governance category.
const pageHref = (p: number) =>
  isGovernanceCategory ? `/c/${category!.slug}?sort=${sort}&page=${p}` : `/c/${category!.slug}?page=${p}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DRepTalk',
      item: siteOrigin + '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: category?.name ?? 'Category',
      item: siteOrigin + `/c/${slug}`,
    },
  ],
};
---

{notFound ? (
  <NotFound noun="Category" />
) : (
  <Layout
    title={`${category.name} - DRepTalk`}
    description={category.description}
  >
    <JsonLd data={breadcrumbLd} />

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <span>{category.name}</span>
    </nav>

    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1.5rem;">
      <div>
        <h1 style="margin:0 0 0.25rem;">{category.name}</h1>
        <p style="margin:0;color:var(--muted);font-size:0.875rem;">
          {category.description}
          {isGovernanceCategory && (
            <>
              {' '}
              <a href="/help/governance-statuses" style="color:var(--accent);">What do the status labels mean?</a>
            </>
          )}
        </p>
      </div>
    </div>

    {isGovernanceCategory && (
      <nav aria-label="Sort" style="display:flex;gap:0.25rem;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-bottom:1.25rem;">
        {GOV_SORTS.map((s) => (
          <a
            href={`/c/${category.slug}?sort=${s.mode}`}
            aria-current={s.mode === sort ? 'page' : undefined}
            style={`padding:0.5rem 0.75rem;font-size:0.875rem;text-decoration:none;border-bottom:2px solid ${s.mode === sort ? 'var(--accent)' : 'transparent'};color:${s.mode === sort ? 'var(--fg)' : 'var(--muted)'};font-weight:${s.mode === sort ? '600' : '400'};`}
          >
            {s.label}
          </a>
        ))}
      </nav>
    )}

    {topics.length === 0 ? (
      <p style="color:var(--muted);">No topics yet in this category.</p>
    ) : (
      <div style="display:flex;flex-direction:column;gap:0;">
        {topics.map((topic) => (
          <TopicRow
            topic={topic}
            now={now}
            author={identities ? identities.describe(topic.author_id) : undefined}
            governance={govByTopic.get(topic.id)}
          />
        ))}
      </div>
    )}

    {(prevPage || nextPage) && (
      <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
        {prevPage && (
          <a href={pageHref(prevPage)}>Previous page</a>
        )}
        {nextPage && (
          <a href={pageHref(nextPage)}>Next page</a>
        )}
      </nav>
    )}

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Start a new topic</h2>
        <Composer client:load mode="topic" categorySlug={category.slug} />
      </section>
    )}
  </Layout>
)}
