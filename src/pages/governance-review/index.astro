---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import ReviewCard from '@/components/review/ReviewCard.astro';
import { loadEditions } from '@/lib/review/editions.js';
import { resolveNetwork } from '@/lib/config/network';
import { cacheControlFor } from '@/lib/forum/view.js';

const editions = await loadEditions();
// Mainnet only, like the editions themselves: the card dates come from mainnet
// epoch boundaries whatever network this worker runs on.
const cfg = resolveNetwork('mainnet');
Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
---

<Layout
  title="Cardano Governance Review - DRepTalk"
  description="Dated reviews of Cardano governance, a few epochs at a time: what was decided, who moved it, and what the numbers say."
  readingWidth
>
  <nav class="rv-crumbs" aria-label="Breadcrumb">
    <a href="/">DRepTalk</a><span aria-hidden="true">/</span><span>Governance Review</span>
  </nav>
  <h1>Governance Review</h1>
  <p class="rv-intro">
    The decisions, the voting behind them and the shifts in power shaping Cardano governance, a few epochs at a time.
  </p>
  {editions.length === 0 && <p class="rv-empty">The first edition is on its way.</p>}
  <div class="rv-list">{editions.map((e, i) => <ReviewCard edition={e} cfg={cfg} lead={i === 0} />)}</div>
  {
    editions.length > 0 && (
      <p class="rv-method">
        Every edition is written from the data behind the <a href="/analytics/">analytics</a> pages, and the figures it
        uses are frozen and published with it. Each page names its own source at the end.
      </p>
    )
  }
</Layout>

<style>
  .rv-crumbs { display: flex; gap: 0.5rem; font-size: 0.875rem; color: var(--muted); margin: 1rem 0 0.5rem; }
  .rv-intro { color: var(--muted); max-width: 62ch; line-height: 1.6; }
  .rv-empty { color: var(--muted); margin-top: 2rem; }
  .rv-list { display: grid; gap: 1.5rem; margin-top: 2rem; }
  .rv-method { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; line-height: 1.55; max-width: 62ch; }
</style>
