---
export const prerender = false;
import { getEntry, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ReviewFacts from '@/components/review/ReviewFacts.astro';
import ReviewAlsoDecided from '@/components/review/ReviewAlsoDecided.astro';
import ReviewNumbers from '@/components/review/ReviewNumbers.astro';
import ReviewSources from '@/components/review/ReviewSources.astro';
import { loadEditions, editionSlug, formatWindowDates } from '@/lib/review/editions.js';
import { govActionHref } from '@/lib/review/links.js';
import { parseSlug, parseEditionNumber } from '@/lib/review/windows.js';
import { buildBreadcrumbLd } from '@/lib/jsonld/breadcrumb.js';
import { resolveNetwork } from '@/lib/config/network';
import { cacheControlFor } from '@/lib/forum/view.js';
import { ogCardVersion } from '@/lib/og/version.js';
import ReviewSubscribe from '@/components/review/ReviewSubscribe.astro';

const slug = Astro.params.slug ?? '';
// /governance-review/41/ is the short way to cite an edition. The epochs slug
// stays the canonical address, so the number only redirects to it.
const number = parseEditionNumber(slug);
if (number !== null) {
  const byNumber = (await loadEditions()).find((e) => e.data.edition === number);
  if (!byNumber) return new Response('Not found', { status: 404 });
  return Astro.redirect(`/governance-review/${editionSlug(byNumber)}/`, 301);
}
if (!parseSlug(slug)) return new Response('Not found', { status: 404 });
const entry = await getEntry('review', slug);
if (!entry) return new Response('Not found', { status: 404 });
const d = entry.data;
// The Governance Review is mainnet only. Editions are mainnet facts bundled
// into every deployment, so the window dates read mainnet regardless of the
// network this worker runs on.
const cfg = resolveNetwork('mainnet');
const { Content, headings } = await render(entry);
// The outline lists the chapter headings of the edition body. Astro's markdown
// pipeline already gives every heading an id from its text, and `headings`
// carries those same slugs, so the links match the rendered H2 elements.
const outline = headings.filter((h) => h.depth === 2);
const editions = await loadEditions();
const i = editions.findIndex((e) => editionSlug(e) === slug);
const newer = i > 0 ? editions[i - 1] : null;
const older = i >= 0 && i < editions.length - 1 ? editions[i + 1] : null;
const origin = Astro.site?.origin ?? 'https://dreptalk.com';
const dates = formatWindowDates(d.epochFrom, d.epochTo, cfg);
const lastCorrection = d.corrections.at(-1)?.date;
const actionTitles = new Map([...d.alsoDecided, ...d.openActions].map((r) => [r.id, r.title]));
// The frozen data pack next to the edition file is the source of every number
// on this page. Linking the file in the repository lets a reader check any
// figure against the exact snapshot the edition was written from.
// The pack file never changes after publication (corrections edit the article,
// not its data). The readable link points at the file on main, the pinned link
// is content-addressed: the git blob hash stored in the frontmatter (checked
// against the file by a test) resolves to exactly the bytes the edition was
// written from, whatever happens to the branch.
const packPath = `src/content/review/${slug}.pack.json`;
const packUrl = `https://github.com/katomm/dreptalk.com/blob/main/${packPath}`;
const packBlobUrl = `https://api.github.com/repos/katomm/dreptalk.com/git/blobs/${d.packBlob}`;
const packBlobShort = d.packBlob.slice(0, 12);
const dataAsOf = new Date(d.dataAsOf).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.standfirst,
  url: `${origin}/governance-review/${slug}/`,
  datePublished: d.published.toISOString().slice(0, 10),
  ...(lastCorrection ? { dateModified: lastCorrection.toISOString().slice(0, 10) } : {}),
  inLanguage: 'en',
  about: d.featuredActions.map((id) => ({
    '@type': 'Thing',
    // The action's own title, from the frozen rows. An id is a locator, not a name.
    name: actionTitles.get(id) ?? id,
    url: `${origin}${govActionHref(id)}`,
  })),
  publisher: { '@type': 'Organization', name: 'DRepTalk', url: origin },
};
const crumbs = buildBreadcrumbLd(origin, [
  { name: 'Governance Review', path: '/governance-review/' },
  { name: `Epochs ${d.epochFrom} to ${d.epochTo}`, path: `/governance-review/${slug}/` },
]);
const ogImage = `/og/governance-review/${slug}.png?v=${ogCardVersion([d.title, d.epochFrom, d.epochTo, d.ogFigure.value, d.ogFigure.label])}`;
Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
---

<Layout title={`${d.title} - Governance Review - DRepTalk`} description={d.standfirst} ogImage={ogImage}>
  <JsonLd data={articleLd} />
  <JsonLd data={crumbs} />
  <div class="rv-layout">
  <article class="rv">
    <p class="rv-kicker">
      <a href="/governance-review/">Governance Review</a><span>No. {d.edition}</span><span>Epochs {d.epochFrom} to {d.epochTo}</span><span
        >{dates}</span
      >
    </p>
    <h1 class="rv-title">{d.title}</h1>
    <p class="rv-stand">{d.standfirst}</p>
    <ReviewFacts facts={d.facts} />
    {
      d.corrections.length > 0 && (
        <aside class="rv-corrections">
          <strong>Corrections.</strong>
          {d.corrections.map((c) => (
            <span>
              {c.date.toISOString().slice(0, 10)}: {c.note}{' '}
            </span>
          ))}
        </aside>
      )
    }
    <div class="rv-body prose"><Content /></div>
    <ReviewAlsoDecided rows={d.alsoDecided} open={d.openActions} featured={d.featuredActions} epochTo={d.epochTo} />
    <ReviewNumbers numbers={d.numbers} from={d.epochFrom} to={d.epochTo} />
    <ReviewSources external={d.external} />
    <ReviewSubscribe class="rv-subscribe" />
  </article>
  {/* On a wide screen this is the sticky column next to the article: the
      outline, the data note and the edition links. Below the breakpoint the
      outline is hidden and the other two follow the article, in the same place
      and order they had before the sidebar existed. Rendered once, placed by CSS. */}
  <aside class="rv-side">
    {
      outline.length > 0 && (
        <nav class="rv-toc" aria-label="On this page">
          <p class="rv-side__title">On this page</p>
          <ol class="rv-toc__list">
            {outline.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="rv-data">
      Data behind this edition: a snapshot of the site's governance data taken {dataAsOf}, frozen as{' '}
      <a href={packUrl} rel="noopener">{slug}.pack.json</a> next to the article. Every on-chain figure above traces to a field in that file, and what was read from proposal documents and published rationales is listed above with its source. Its git blob hash{' '}
      <a href={packBlobUrl} rel="noopener" title={d.packBlob}><code>{packBlobShort}</code></a> pins the exact bytes, whatever later happens to the branch.
    </p>
    {
      (older || newer) && (
        <nav class="rv-pager" aria-label="Other editions">
          {older && <a href={`/governance-review/${editionSlug(older)}/`}>Older: epochs {older.data.epochFrom} to {older.data.epochTo}</a>}
          {newer && (
            <a class="rv-pager__newer" href={`/governance-review/${editionSlug(newer)}/`}>
              Newer: epochs {newer.data.epochFrom} to {newer.data.epochTo}
            </a>
          )}
        </nav>
      )
    }
  </aside>
  </div>
</Layout>

<script>
  // Marks the outline link of the section the reader is in. The observer
  // watches the chapter headings: a heading entering the top band of the
  // viewport becomes current, and one leaving it upwards hands back to the
  // heading before it. Bundled script, no inline handler, so the strict CSP
  // needs no hash for it.
  const toc = document.querySelector<HTMLElement>('.rv-toc');
  const links = toc ? Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) : [];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((el): el is HTMLElement => el !== null);
  if (toc && targets.length > 0 && 'IntersectionObserver' in window) {
    const setCurrent = (el: HTMLElement | null) => {
      for (const a of links) {
        const on = el !== null && a.hash === `#${el.id}`;
        a.classList.toggle('is-current', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    let current: HTMLElement | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            current = el;
          } else if (el === current && entry.boundingClientRect.top > 0) {
            // Scrolled back above this heading: the chapter before it is current again.
            const i = targets.indexOf(el);
            current = i > 0 ? targets[i - 1] : null;
          }
        }
        setCurrent(current);
      },
      { rootMargin: '0px 0px -75% 0px' }
    );
    for (const t of targets) observer.observe(t);
  }
</script>

<style is:global>
  /* Chart figures come from the markdown transform as raw HTML, so their styles
     are global on purpose and scoped by the rv- prefix. Colour tokens map onto the
     site theme variables so charts follow light and dark mode. */
  .rv :global(.rv-subscribe) { margin-top: 2.5rem; }
  .rv { --rv-s1: var(--accent); --rv-s2: #eb6834; --rv-s3: #7b8590; --rv-ink: var(--fg); --rv-ink-2: var(--muted); --rv-grid: var(--border); --rv-card: var(--surface); }
  .rv-chart { margin: 1.5rem 0 2rem; background: var(--rv-card); border: 1px solid var(--rv-grid); border-radius: var(--radius-sm); padding: 1rem 1rem 0.75rem; }
  .rv-chart__title { font-weight: 700; font-size: 0.95rem; margin: 0 0 0.1rem; }
  .rv-chart__sub { font-size: 0.8rem; color: var(--rv-ink-2); margin: 0 0 0.75rem; }
  .rv-chart svg { width: 100%; height: auto; display: block; overflow: visible; }
  .rv-chart figcaption { font-size: 0.8rem; color: var(--rv-ink-2); margin-top: 0.6rem; line-height: 1.45; }
  .rv-legend { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.8rem; color: var(--rv-ink-2); margin: 0 0 0.6rem; }
  .rv-legend i { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .rv-svg text { font-size: 11.5px; fill: var(--rv-ink-2); }
  .rv-svg .rv-grid { stroke: var(--rv-grid); }
  .rv-svg .rv-axis { stroke: var(--rv-grid); }
  .rv-svg .rv-thr { stroke: var(--rv-ink); stroke-dasharray: 4 4; }
  .rv-svg .rv-lbl, .rv-svg .rv-ann { fill: var(--rv-ink); }
  .rv-svg .rv-muted { fill: var(--rv-ink-2); }
  .rv-svg .rv-line { fill: none; stroke-width: 2.5; stroke-linejoin: round; }
  /* A polyline carries its series colour as a stroke only. The shared fill on
     the next two rules is for dots, bars and legend swatches, and would flood
     the area under a line's own path if it applied to the polyline too. */
  .rv-svg .rv-line.rv-s1 { stroke: var(--rv-s1); }
  .rv-svg .rv-line.rv-s2 { stroke: var(--rv-s2); }
  .rv-svg .rv-dot.rv-s1, .rv-svg .rv-bar.rv-s1, .rv-legend i.rv-s1 { stroke: var(--rv-s1); fill: var(--rv-s1); background: var(--rv-s1); }
  .rv-svg .rv-dot.rv-s2, .rv-svg .rv-bar.rv-s2, .rv-legend i.rv-s2 { stroke: var(--rv-s2); fill: var(--rv-s2); background: var(--rv-s2); }
  .rv-svg .rv-bar.rv-s3, .rv-svg .rv-dot.rv-s3, .rv-legend i.rv-s3 { fill: var(--rv-s3); background: var(--rv-s3); }
  .rv-svg .rv-dot { stroke: var(--rv-card); stroke-width: 2; }
  .rv-svg .rv-hit { fill: transparent; }
  .rv-svg .rv-lead { fill: none; stroke: var(--rv-grid); stroke-width: 1; }
  .rv-svg .rv-area { fill: var(--rv-s1); opacity: 0.08; }
  .rv-svg .rv-shade { fill: var(--rv-s2); opacity: 0.1; }
  .rv-svg .rv-bar.rv-dim { opacity: 0.35; }
  .rv-svg .rv-seat { stroke-width: 2; fill: var(--rv-card); }
  .rv-svg .rv-seat.rv-ending, .rv-legend i.rv-ending { stroke: var(--rv-s2); background: var(--rv-s2); }
  .rv-svg .rv-seat.rv-staying, .rv-legend i.rv-staying { stroke: var(--rv-s1); background: var(--rv-s1); }
  /* Ballot matrix: a tinted cell per decision with a symbol on top, and a
     before/after row whose two dots are joined by a line. */
  .rv-svg .rv-cell { fill: var(--rv-card); stroke: var(--rv-grid); }
  .rv-svg .rv-cell.rv-s1 { fill: var(--rv-s1); opacity: 0.22; }
  .rv-svg .rv-cell.rv-s2 { fill: var(--rv-s2); opacity: 0.22; }
  .rv-svg .rv-cell.rv-s3 { fill: var(--rv-s3); opacity: 0.22; }
  .rv-svg .rv-sym { font-size: 14px; font-weight: 700; fill: var(--rv-ink); }
  .rv-svg .rv-sym.rv-none { fill: var(--rv-ink-2); }
  .rv-legend i.rv-none { background: var(--rv-card); border: 1px solid var(--rv-grid); }
  .rv-svg .rv-link { stroke: var(--rv-ink-2); stroke-width: 3; opacity: 0.5; }
  /* Spending limit bar: paid, approved and free segments inside one frame. */
  .rv-svg .rv-seg.rv-s2 { fill: var(--rv-s2); opacity: 0.75; }
  .rv-svg .rv-seg.rv-s1 { fill: var(--rv-s1); opacity: 0.75; }
  .rv-svg .rv-seg.rv-none { fill: var(--rv-card); }
  .rv-svg .rv-frame { fill: none; stroke: var(--rv-ink-2); }
</style>

<style>
  /* Two columns inside the normal wrap: the article keeps its reading width,
     the sidebar takes the rest. Below the breakpoint the whole thing is the
     single reading column the page had before, with the sidebar's remaining
     parts following the article. Same shape as the /ga/ action pages. */
  .rv-layout { max-width: 46rem; margin: 0 auto; }
  .rv, .rv-side { min-width: 0; }
  .rv-toc { display: none; }
  @media (min-width: 1080px) {
    .rv-layout { max-width: none; display: grid; grid-template-columns: minmax(0, 46rem) minmax(0, 1fr); gap: 2.5rem; align-items: start; }
    .rv-side { position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; padding-top: 1rem; }
    .rv-toc { display: block; }
    .rv-side .rv-data { margin-top: 1.75rem; font-size: 0.78rem; }
    .rv-side .rv-pager { flex-direction: column; gap: 0.5rem; margin-top: 1.5rem; }
    .rv-side .rv-pager__newer { margin-left: 0; }
  }
  .rv-side__title { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin: 0 0 0.5rem; }
  .rv-toc__list { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); font-size: 0.85rem; line-height: 1.35; }
  .rv-toc__list a { display: block; padding: 0.3rem 0 0.3rem 0.75rem; margin-left: -1px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; }
  .rv-toc__list a:hover { color: var(--fg); }
  .rv-toc__list a.is-current { color: var(--fg); border-left-color: var(--accent); }
  .rv-toc__list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  /* A chapter jumped to from the outline sits a little below the viewport edge. */
  .rv-body :global(h2) { scroll-margin-top: 1rem; }
  .rv-kicker { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 1rem 0 0; }
  .rv-kicker a { color: var(--accent); text-decoration: none; }
  .rv-title { font-size: clamp(1.9rem, 4.5vw, 2.7rem); line-height: 1.08; letter-spacing: -0.02em; margin: 0.75rem 0 1rem; text-wrap: balance; }
  .rv-stand { font-size: 1.15rem; line-height: 1.5; color: var(--muted); margin: 0 0 1.75rem; }
  .rv-corrections { border-left: 3px solid var(--accent); padding: 0.5rem 0.9rem; margin: 0 0 1.5rem; font-size: 0.9rem; }
  .rv-data { font-size: 0.85rem; color: var(--muted); line-height: 1.5; margin: 1.5rem 0 0; }
  .rv-pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.9rem; }
  /* Keeps the newer link on the right even when it is the only one. */
  .rv-pager__newer { margin-left: auto; }
</style>
