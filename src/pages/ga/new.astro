---
// Submit a governance action: Beta, preprod-only. Linked from the account
// menu and the /home/ card, both marked Beta, not from the main nav. Gated
// twice: mainnet returns a bare 404 (reveals nothing), then a signed-out
// visitor is redirected to /login/ like the other session-gated pages. The
// API routes this island calls gate independently too, so this page gate is
// a UX convenience, not the security boundary.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import SubmitGovAction from '@/components/SubmitGovAction.tsx';
import { currentNetwork } from '@/lib/api/response';
import { govActionSubmissionAvailable } from '@/lib/governance/submissionGate';

const net = currentNetwork();
if (!govActionSubmissionAvailable(net.network)) {
  return new Response('Not found', { status: 404 });
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const network = net.network;
---
<Layout title="Submit a governance action (Beta) - DRepTalk" description="Beta preprod tool for submitting a governance action." noindex={true}>
  <div class="callout callout--warning" role="status">
    <div class="callout__body">
      Beta, preprod only. Submitting locks the governance action deposit
      (1000 tADA on preprod), refunded when the action is finalized.
    </div>
  </div>

  <h1 style="margin:1.5rem 0 0.5rem;">Submit a governance action</h1>
  <p style="margin:0 0 1.5rem;max-width:62ch;font-size:0.9375rem;line-height:1.6;color:var(--muted);">
    Draft and submit a Cardano governance InfoAction with your wallet.
    Everything is signed locally; dreptalk.com never handles your private keys.
  </p>

  <SubmitGovAction network={network} client:load />
</Layout>
