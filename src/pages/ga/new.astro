---
// Submit a governance action. Linked from the account menu and the /home/
// card, not from the main nav. A signed-out visitor
// is redirected to /login/ like the other session-gated pages. The API routes
// this island calls gate independently too, so this page gate is a UX
// convenience, not the security boundary.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import SubmitGovAction from '@/components/SubmitGovAction.tsx';
import { currentNetwork, runtimeEnv } from '@/lib/api/response';
import { loadSessionHeader } from '@/lib/forum/sessionHeader';
import { listOpenProposalDrafts } from '@/lib/db/proposalDrafts';

const net = currentNetwork();
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const network = net.network;
// Resolved the way /home/ resolves its greeting, so "Sign as author" prefills
// the same name the user sees elsewhere on the site.
const [account] = await loadSessionHeader(Astro.locals, user.id);
const displayName = account.displayName;
// SSR prop, no dedicated route (see the design doc's decision 3): the "Link a
// Proposal Draft" control needs the list once per page load, not on every
// keystroke.
const db = runtimeEnv(Astro.locals).DB as D1Database | undefined;
const openDrafts = db ? await listOpenProposalDrafts(db, user.id) : [];
// What draftSlugsFromReferences compares a reference's URL against, not the
// browser's own origin.
const siteOrigin = net.siteOrigin;
---
<Layout title="Submit a governance action - DRepTalk" description="Draft and submit a Cardano governance action from your wallet." noindex={true}>
  <div class="callout callout--warning" role="status">
    <div class="callout__body">
      Submitting locks the governance action deposit shown below,
      refunded when the action is finalized.
    </div>
  </div>

  <h1 style="margin:1.5rem 0 0.5rem;">Submit a governance action</h1>
  <p style="margin:0 0 1.5rem;max-width:62ch;font-size:0.9375rem;line-height:1.6;color:var(--muted);">
    Draft and submit a Cardano governance action with your wallet: an info action, a motion of
    no confidence, a hard fork, a new constitution, a committee update, a treasury withdrawal or a parameter change. Everything is signed locally, dreptalk.com never handles your private keys.
    <a href="/help/submit-a-governance-action/">How submitting works</a>
  </p>

  <SubmitGovAction network={network} displayName={displayName} openDrafts={openDrafts} siteOrigin={siteOrigin} client:load />
</Layout>
