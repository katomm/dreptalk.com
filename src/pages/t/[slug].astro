  }
  .thread-related__item-meta {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .thread-related__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .thread-share-btn {
    flex-shrink: 0;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .thread-share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Two-column layout: main content on the left, sidebar on the right.
     Single column on mobile (sidebar stacks below). */
  .ga-detail-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }
  /* Grid items default to min-width:auto, so wide content (long ids, the tab
     bar, stat cards) forces the track wider than the viewport and the whole
     page scrolls sideways on a phone. min-width:0 lets the track shrink and the
     content wrap or scroll within it instead. */
  .ga-detail-layout__main,
  .ga-detail-layout__sidebar {
    min-width: 0;
  }
  /* The main column stacks its blocks (overview, rationale highlights, join CTA)
     itself, so they flow directly one after another regardless of the sidebar's
     height (no gap where a short overview meets a taller sidebar). */
  .ga-detail-layout__main {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .ga-detail-layout__sidebar {
    position: sticky;
    top: 1.5rem;
  }
  .vote-panel-wrapper {
    margin-bottom: 1.5rem;
  }
  .vote-panel-title {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }
  /* Overview SPO-count jump link: a small tappable CTA into the Votes tab,
     not a plain inline anchor. */
  .ga-spo-jump {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .ga-spo-jump:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: var(--accent);
  }
  @media (max-width: 900px) {
    .ga-detail-layout {
      grid-template-columns: 1fr;
    }
    .ga-detail-layout__sidebar {
      position: static;
    }
    /* Overview tab, mobile: lead with the status card, then the headline metrics
       and rationale (the main column), then the remaining detail cards (voting
       info, top participants, proposer, related). display:contents dissolves both
       sidebar wrappers so the cards become items of this single-column grid and
       can be ordered around the main column. The status card is always the
       sidebar's first child; the rest keep their source order after the main.
       On the other tabs the sidebar is untouched and stacks below the content the
       user navigated to. */
    .ga-detail-layout--sidebar-first {
      gap: 1.25rem;
    }
    .ga-detail-layout--sidebar-first .ga-detail-layout__sidebar,
    .ga-detail-layout--sidebar-first :global(.ga-sidebar) {
      display: contents;
    }
    .ga-detail-layout--sidebar-first :global(.ga-sidebar > *) {
      order: 3;
      min-width: 0;
    }
    .ga-detail-layout--sidebar-first :global(.ga-sidebar > :first-child) {
      order: 1;
    }
    /* The main column dissolves too, so its blocks (overview, highlights, join)
       become items of this single-column grid and can be ordered around the
       sidebar cards. */
    .ga-detail-layout--sidebar-first .ga-detail-layout__main {
      display: contents;
    }
    .ga-detail-layout--sidebar-first .ga-overview-block {
      order: 2;
      min-width: 0;
    }
    /* The DRep vote CTA leads the column, ahead of the status card. */
    .ga-detail-layout--sidebar-first .vote-panel-wrapper {
      order: 0;
    }
    /* Then the rationale highlights (after the voting info + detail cards), and the
       join-discussion bridge last. */
    .ga-detail-layout--sidebar-first :global(.ga-highlights) {
      order: 4;
      min-width: 0;
    }
    .ga-detail-layout--sidebar-first :global(.ga-join) {
      order: 5;
      min-width: 0;
    }
  }
</style>
