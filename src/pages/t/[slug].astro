---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import NotFound from '@/components/NotFound.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import ThreadPosts from '@/components/ThreadPosts.astro';
import TitleEditor from '@/components/TitleEditor.astro';
import GaTabs from '@/components/ga/GaTabs.astro';
import GaOverview from '@/components/ga/GaOverview.astro';
import GaRationaleHighlights from '@/components/ga/GaRationaleHighlights.astro';
import GaJoinDiscussion from '@/components/ga/GaJoinDiscussion.astro';
import GaPositions from '@/components/ga/GaPositions.astro';
import GaOnchain from '@/components/ga/GaOnchain.astro';
import GaHistory from '@/components/ga/GaHistory.astro';
import GaSidebar from '@/components/ga/GaSidebar.astro';
import GlossaryTerms from '@/components/glossary/GlossaryTerms.astro';
import ShareButton from '@/components/ShareButton.astro';
import SurveyCard from '@/components/survey/SurveyCard.astro';
import LinkedSurveyCard from '@/components/survey/LinkedSurveyCard.astro';
import RespondPanel from '@/components/survey/RespondPanel.astro';
import {
  getLinkedSurveyForAction,
  getSurveyByTopicId,
  getSurveyGovLinks,
  getSurveySyncState,
  getViewerSurveyResponse,
} from '@/lib/db/surveys.js';
import { surveyState } from '@/lib/surveys/state.js';
import { surveysEnabled } from '@/lib/surveys/switch.js';
import { parseSurveyDefinition } from '@/lib/surveys/view.js';
import type { SurveyDefinition } from 'cip-179';
import { getTopicBySlug, getThreadPage, type ThreadPage } from '@/lib/db/forum.js';
import { getRelatedTopics } from '@/lib/db/discussions.js';
import { detectIdentifier } from '@/lib/search/identifiers.js';
import { resolveIdentifier } from '@/lib/db/search.js';
import { loadViewerPostState, emptyViewerPostState } from '@/lib/forum/viewerPostState.js';
import {
  getGovernanceActionByTopicId,
  getRelatedActions,
  getCompareCandidates,
  getCompareActionBySlug,
  type RelatedActionRow,
  type CompareCandidateRow,
  type CompareAction,
} from '@/lib/db/governance.js';
import { headlineComposition, isSpoLedType, isCcEligible } from '@/lib/governance/view.js';
import { lateVoterIds } from '@/lib/governance/lateVotes.js';
import { getVotesByGaId, getActionVoters, countActionVoters, getViewerVote, getActionSpoVoters, countActionSpoVoters, getActionVoterRank, getVoteTrendRows, listDrepVotePowers, type ActionVoterRow, type TrendVoteRow } from '@/lib/db/drepVotes.js';
import { getCommitteeVotes, getCommitteeTimeline, getActionCcVoteRows, committeeEpochForAction } from '@/lib/db/committee.js';
import { buildVoteConcentration, requiredYesPower, type VoteConcentrationView } from '@/lib/analytics/voteConcentration.js';
import { buildActionVoteChanges, describeActionVoteChanges } from '@/lib/analytics/voteChangeView.js';
import { readThresholdSnapshot } from '@/lib/governance/thresholds.js';
import type { CcVote } from '@/lib/koios/corrections.js';
import { getAllCcMemberNames } from '@/lib/db/ccMemberName.js';
import { buildCcNameIndex } from '@/lib/governance/ccNames.js';
import { buildCcPositions, type CcPositionRow } from '@/lib/governance/ccPositions.js';
import { activeCommitteeSizeAt } from '@/lib/koios/committeeTimeline.js';
import { computeVoteTrendSeries, buildTrendChart, type TrendChart } from '@/lib/governance/voteTrend.js';
import { assembleTrendInputs } from '@/lib/governance/voteTrendAssembly.js';
import { epochFromUnix, resolveNetwork } from '@/lib/config/network.js';
import {
  getActionRationales,
  getActionRationaleStatuses,
  countActionRationales,
  getRationaleHighlights,
  type RationaleHighlight,
} from '@/lib/db/actionRationale.js';
import { getActionVoteHistory, type SupersededVote } from '@/lib/db/voteHistory.js';
import { getDrepsByIds, type Drep } from '@/lib/db/dreps.js';
import { getPoolsByIds, type Pool } from '@/lib/db/pools.js';
import { getSelfDrepId } from '@/lib/db/users.js';
import VotePanel from '@/components/VotePanel.js';
import MultisigVotePanel from '@/components/MultisigVotePanel.js';
import { parseDrepId } from '@/lib/cardano/identity.js';
import { loadAuthorIdentities, systemAuthor, authorProfileHref, type AuthorDescriptor } from '@/lib/forum/author.js';
import { loadMandates } from '@/lib/forum/mandate.js';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { isWriter } from '@/lib/auth/roles.js';
import { currentNetwork } from '@/lib/api/response.js';
import { listPostIdsWithDocs } from '@/lib/db/cip100.js';
import { originForNetwork, threadManifestUrl } from '@/lib/cip100/origin.js';
import { getCategory } from '../../../config/categories.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, truncateId, excerptFromHtml, SITE_ORIGIN } from '@/lib/forum/view.js';
import { parseGaTab } from '@/lib/governance/tab.js';
import { ogCardVersion } from '@/lib/og/version.js';
import { decodeOnchainChanges } from '@/lib/governance/onchain.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import NclPanel from '@/components/ncl/NclPanel.astro';
import NclMiniCard from '@/components/ncl/NclMiniCard.astro';
import { NCL_PERIODS } from '../../../config/ncl-periods.js';
import { nclStatusFor, currentNclPeriod } from '@/lib/governance/ncl.js';
import { getEnactedTreasuryWithdrawals, getNclActionLinks, type NclActionLink } from '@/lib/db/treasury.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

const db = env.DB as D1Database | undefined;

// A pasted governance-action id routes to its discussion: resolve it to the
// canonical topic slug and 301-redirect, mirroring the DRep id->slug redirect.
// Covers the bech32 gov_action1... form (vote links) and the CIP-129 hex form
// that explorer.cardano.org deep-links with (64-hex tx hash + hex index byte,
// no '#'). Real topic slugs always carry a hyphen, so they never collide with
// the hyphen-free identifier forms. Detection and resolution are the same
// helpers the search uses, so both stay one source of truth.
if (slug && db) {
  const ident = detectIdentifier(slug);
  if (ident?.kind === 'gov-action' && (ident.by === 'proposal_id' || ident.by === 'id')) {
    const hit = await resolveIdentifier(db, ident);
    if (hit) return Astro.redirect(hit.href, 301);
  }
}

const topic = slug && db ? await getTopicBySlug(db, slug) : null;

// getTopicBySlug already filters deleted threads, so a null is the whole gate.
const notFound = !topic;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

const thread: ThreadPage = topic && db
  ? await getThreadPage(db, topic.id, { limit: PAGE_SIZE, offset })
  : { topLevel: [], childrenByParent: new Map(), openingPost: null, participants: null };

// Every post on the page (top-level and replies) for the batched lookups below.
const pagePosts = [...thread.topLevel, ...[...thread.childrenByParent.values()].flat()];

// Post ids on this page that have an emitted CIP-100 document, i.e. are safe to
// show a Cite link for. A post inside its edit grace window, or one the cron
// has not reached yet, has no version index at all: a visible link would 404.
const citablePostIds = topic && db ? await listPostIdsWithDocs(db, topic.id) : new Set<string>();

const category = topic ? getCategory(topic.category_slug) : undefined;

// Resolve author identities for the topic header and every post on this page in
// exactly two batched queries (users, then dreps). No per-post lookups (no N+1).
const isGovernanceTopic = topic?.source === 'governance';
const isSurveyTopic = topic?.source === 'survey';

const identities = db
  ? await loadAuthorIdentities(db, [topic?.author_id, ...pagePosts.map((p) => p.author_id)])
  : null;

const describe = (authorId: string): AuthorDescriptor =>
  identities ? identities.describe(authorId) : { authorId, displayName: truncateId(authorId) };

// Co-proposer mandate badges: one batched lookup for the topic and every post
// on this page, keyed by their persisted proposer_grant_id (never the
// author's current session).
const mandates = db
  ? await loadMandates(db, [topic?.proposer_grant_id, ...pagePosts.map((p) => p.proposer_grant_id)])
  : new Map<string, string>();

// The first post of a system-sourced topic (governance action or survey)
// carries the system identity even if its author_id is not literally gov-sync.
const topicAuthor: AuthorDescriptor = topic
  ? isGovernanceTopic || isSurveyTopic
    ? systemAuthor(topic.author_id)
    : describe(topic.author_id)
  : { authorId: '', displayName: '' };

// Related topics for user topics only, shown as a slim section below the thread
// (governance topics keep their own GaSidebar). Same category, most recent first.
let relatedTopics: { title: string; slug: string; replies: number; lastPostAt: number }[] = [];
if (db && topic && !isGovernanceTopic) {
  const related = await getRelatedTopics(db, topic.category_slug, topic.id, { limit: 5 });
  relatedTopics = related.map((r) => ({
    title: r.title,
    slug: r.slug,
    replies: Math.max(0, r.post_count - 1),
    lastPostAt: r.last_post_at,
  }));
}

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const netCfg = currentNetwork();
const network = netCfg.network;

// CIP-100 discovery, layer 1: the thread manifest. A per-post alternate is not
// possible, posts have no pages of their own, they live at /t/<slug>/#post-<id>.
// The page carries one canonical alternate, and this same URL is also set as an
// HTTP Link header so a consumer can find it with a HEAD request and no HTML
// parsing. Not siteOrigin: astro.config.mjs hardcodes site to the mainnet apex
// and the preprod build does not override it, so Astro.site would publish
// mainnet URLs from a page served on preprod (see sitemap-cip100.xml.ts).
const cip100Origin = originForNetwork(network === 'preprod' ? 'preprod' : 'mainnet');
// Not notFound: a deleted topic's manifest answers 410, so a 404 page must not
// hint at it either.
const cip100ManifestUrl = !notFound && topic ? threadManifestUrl(cip100Origin, topic.id) : null;
if (cip100ManifestUrl) {
  Astro.response.headers.set('Link', `<${cip100ManifestUrl}>; rel="alternate"; type="application/ld+json"`);
}

const user = Astro.locals.user;

// Only on-chain writers can flag, so the flagged-id set is loaded for them only.
// Per-post flag/visibility policy lives in postViewerContext (via PostArticle).
const viewerIsWriter = !!user && isWriter(user.roles);

// The opening-post author may edit the title of their own non-locked user topic.
const canEditTitle =
  !!user && viewerIsWriter && !!topic && topic.source === 'user' &&
  topic.author_id === user.id && !topic.locked;

// Governance-action enrichment (header values) and the viewer's own post state
// (flags + reactions, one batched round-trip) are independent, so load them
// together. The per-author votes then need govAction.id, so that one follows.
// All read from D1 ("as of").
const [govAction, viewerPostState, surveyRow] = await Promise.all([
  isGovernanceTopic && db && topic
    ? getGovernanceActionByTopicId(db, topic.id)
    : Promise.resolve(null),
  db && user && viewerIsWriter
    ? loadViewerPostState(db, user.id, pagePosts.map((p) => p.id))
    : Promise.resolve(emptyViewerPostState()),
  isSurveyTopic && db && topic ? getSurveyByTopicId(db, topic.id) : Promise.resolve(null),
]);
const { flaggedPostIds, reactions: viewerReactions } = viewerPostState;

// The stored wire record decodes with the same cip-179 codec the sync used to
// write it. Linkage renders both ways: the survey card names its linking
// actions, an action's sidebar names its linked survey.
const surveyDefinition: SurveyDefinition | null = surveyRow
  ? parseSurveyDefinition(surveyRow.definitionJson)
  : null;
const [surveyLinks, linkedSurvey, viewerSurveyResponse, surveySync] = await Promise.all([
  surveyRow && db ? getSurveyGovLinks(db, surveyRow.ref) : Promise.resolve([]),
  db && govAction?.proposalId
    ? getLinkedSurveyForAction(db, govAction.proposalId)
    : Promise.resolve(null),
  surveyRow && db && user
    ? getViewerSurveyResponse(db, surveyRow.ref, user.id)
    : Promise.resolve(null),
  surveyRow && db ? getSurveySyncState(db) : Promise.resolve(null),
]);

// If this action defines or challenges an NCL period, show its live tracker.
const nclPeriod = govAction
  ? NCL_PERIODS.find(
      (p) => p.definingActionIds.includes(govAction.id) || p.relatedActionIds.includes(govAction.id),
    )
  : undefined;
let nclProps: {
  status: ReturnType<typeof nclStatusFor>;
  definingLinks: NclActionLink[];
  relatedLinks: NclActionLink[];
} | null = null;
if (nclPeriod && db) {
  // Independent reads; run them concurrently.
  const [withdrawals, links] = await Promise.all([
    getEnactedTreasuryWithdrawals(db),
    getNclActionLinks(db, [...nclPeriod.definingActionIds, ...nclPeriod.relatedActionIds]),
  ]);
  const pick = (ids: string[]) => ids.map((id) => links.get(id)).filter((l): l is NclActionLink => !!l);
  nclProps = {
    status: nclStatusFor(nclPeriod, withdrawals),
    definingLinks: pick(nclPeriod.definingActionIds),
    relatedLinks: pick(nclPeriod.relatedActionIds),
  };
}

// TreasuryWithdrawals sidebar card: tells the reader this withdrawal counts
// toward its NCL period and how full that cap already is. Separate from
// nclProps above (which only applies to the InfoActions that define/challenge
// a period). Guarded to TreasuryWithdrawals so no extra fetch happens on any
// other action type.
let nclMiniCardProps: {
  periodLabel: string;
  consumedPct: number;
  remainingLovelace: bigint;
  ceilingLovelace: bigint;
  overviewHref: string;
} | null = null;
if (govAction?.type === 'TreasuryWithdrawals' && db) {
  // Prefer the action's own enacted epoch; only fall back to the synced
  // protocol-params epoch when it has none, so an already-enacted withdrawal
  // (the common case) does not re-fetch params that are loaded again below.
  const anchorEpoch = govAction.enactedEpoch ?? (await getProtocolParams(db))?.epoch ?? null;
  const period = anchorEpoch != null ? currentNclPeriod(NCL_PERIODS, anchorEpoch) : undefined;
  if (period) {
    const s = nclStatusFor(period, await getEnactedTreasuryWithdrawals(db));
    nclMiniCardProps = {
      periodLabel: period.label,
      consumedPct: s.consumedPct,
      remainingLovelace: s.remainingLovelace,
      ceilingLovelace: period.ceilingLovelace,
      overviewHref: '/treasury/',
    };
  }
}

// Other actions from the same proposer, for the sidebar (needs the action's
// id to exclude itself and its return_address to match the proposer).
const related: RelatedActionRow[] = isGovernanceTopic && govAction && db
  ? await getRelatedActions(db, {
      excludeId: govAction.id,
      returnAddress: govAction.returnAddress,
      limit: 6,
    })
  : [];
const govVotes = govAction && db ? await getVotesByGaId(db, govAction.id) : new Map<string, { role: string; vote: string; meta_url: string | null; voted_power: number | null }>();

// DRep vote panel: only for logged-in DReps on votable (active) actions.
// Gate on ga.status === 'active'; deriveStatus already accounts for expiry boundary.
const isDrep = user?.roles?.includes('drep') ?? false;
const isVotable = govAction?.status === 'active';
const viewerDrepId =
  isDrep && (isGovernanceTopic || isSurveyTopic) && db ? await getSelfDrepId(db, user) : null;
const viewerVote =
  isDrep && isVotable && viewerDrepId && db && govAction
    ? await getViewerVote(db, govAction.id, viewerDrepId)
    : null;

// A script-credential DRep cannot sign votes directly: it needs the multisig
// initiate/co-sign flow instead of the key-DRep VotePanel.
const isScriptDrep = viewerDrepId ? parseDrepId(viewerDrepId)?.kind === 'script' : false;

// The answering panel: the survey must be able to take a DRep answer (decided
// once in state.ts, for the card and the record API too), the stored
// definition must have decoded (the widget renders from it), and the viewer
// must be a key-credential DRep — the panel then checks the wallet against
// that very DRep, so a signed-in account cannot put another wallet's answer
// on chain and be left with a row nothing settles; the record API's 403 for
// a script DRep is the backstop, not the guard. It also needs the mirror to
// still be configured: everything that follows an answer — settling the
// optimistic row against the chain, or aging it to failed — happens in the
// sync, so with TESSERA_BACKEND_URL gone a submitted answer would sit
// "confirming…" forever against a row nothing refreshes.
const canAnswerSurvey =
  !!surveyRow &&
  surveyState(surveyRow, now, netCfg).answerable &&
  surveyDefinition !== null &&
  surveysEnabled(env) &&
  !!viewerDrepId &&
  !isScriptDrep;

// Governance detail page extras: tab, protocol params, stake participation.
const tab = parseGaTab(Astro.url.searchParams.get('tab'));

// voter= deep link (share links, the vote page's back link, search hits):
// resolve which page of the positions list currently renders that voter,
// instead of trusting a pinned page number that rots as new votes arrive and
// the ranking shifts. Falls back to the plain page param when the voter has no
// live vote in the addressed role. The CC list is unpaginated, so its links
// carry no voter=. Only the positions queries and GaPositions use this page;
// the discussion thread keeps the raw page param.
const voterParam = Astro.url.searchParams.get('voter');
const positionsRoleParam = Astro.url.searchParams.get('role');
let positionsPage = page;
if (tab === 'positions' && voterParam && positionsRoleParam !== 'cc' && govAction && db) {
  const rank = await getActionVoterRank(db, govAction.id, voterParam, positionsRoleParam === 'spo' ? 'SPO' : 'DRep');
  if (rank != null) positionsPage = Math.floor(rank / PAGE_SIZE) + 1;
}

// Positions tab: paginated voter list. Top participants and total count are always
// loaded (sidebar card + tab badge). Resolved in parallel; voter rows only on the
// positions tab. DRep identities fetched once via a single getDrepsByIds call.
// Overview "Rationale highlights": a balanced top-N Yes + top-N No DRep rationales
// (with text, non-abstain), loaded only on the default Overview tab where they render.
const RATIONALE_HIGHLIGHT_PER_VOTE = 2;
const [topVoters, positionVoters, positionsTotal, rationaleHighlights] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getActionVoters(db, govAction.id, { limit: 5 }),
      tab === 'positions'
        ? getActionVoters(db, govAction.id, { limit: PAGE_SIZE, offset: pageToOffset(positionsPage, PAGE_SIZE) })
        : Promise.resolve([] as Awaited<ReturnType<typeof getActionVoters>>),
      countActionVoters(db, govAction.id),
      tab === 'overview'
        ? getRationaleHighlights(db, govAction.id, RATIONALE_HIGHLIGHT_PER_VOTE)
        : Promise.resolve([] as RationaleHighlight[]),
    ])
  : ([[], [], 0, []] as [ActionVoterRow[], ActionVoterRow[], number, RationaleHighlight[]]);

// Resolve DRep identities for the voter lists and the highlights in a single
// batch query (no N+1). Highlight voters may not appear in the top-5, so include them.
const voterIds = [
  ...new Set([
    ...topVoters.map((v) => v.voter_id),
    ...positionVoters.map((v) => v.voter_id),
    ...rationaleHighlights.map((h) => h.voter_id),
  ]),
];
const drepsMap = db && voterIds.length > 0
  ? await getDrepsByIds(db, voterIds)
  : new Map<string, Drep>();

// SPO voters for the positions tab role segment, plus their pool identities.
const spoTotal = isGovernanceTopic && govAction && db
  ? await countActionSpoVoters(db, govAction.id)
  : 0;
const spoVoters = tab === 'positions' && govAction && db
  ? await getActionSpoVoters(db, govAction.id, { limit: PAGE_SIZE, offset: pageToOffset(positionsPage, PAGE_SIZE) })
  : ([] as Awaited<ReturnType<typeof getActionSpoVoters>>);
const poolIds = [...new Set(spoVoters.map((v) => v.voter_id))];
const poolsMap = db && poolIds.length > 0 ? await getPoolsByIds(db, poolIds) : new Map<string, Pool>();

// Rationales plus superseded votes (voters who changed their vote) for the
// positions tab, both keyed by voter_id and loaded together only when needed.
const [rationales, voteHistory] = tab === 'positions' && db && govAction
  ? await Promise.all([getActionRationales(db, govAction.id), getActionVoteHistory(db, govAction.id)])
  : [new Map<string, { bodyHtml: string | null; source: string; voterRole: string }>(), new Map<string, SupersededVote[]>()];

// Net vote-change summaries per role for the Positions tab. History alone
// cannot say a vote changed (anchor-only re-votes archive too), so the
// classifier compares each voter's first recorded vote with the current one.
const drepChanges = tab === 'positions' && govAction ? buildActionVoteChanges(voteHistory, govVotes, 'DRep') : null;
const spoChanges = tab === 'positions' && govAction ? buildActionVoteChanges(voteHistory, govVotes, 'SPO') : null;
const drepChangeLine = drepChanges ? describeActionVoteChanges(drepChanges) : null;

// Votes cast too late to count in the frozen tally (on/after the ratification
// epoch). Shown distinctly on the Positions tab so they don't read as counted.
const notCountedVoters = govAction
  ? lateVoterIds([...positionVoters, ...spoVoters], govAction, network)
  : new Set<string>();

// Action-wide rationale count (cheap): drives the sidebar "See all" link on every tab.
const rationaleCount = db && govAction ? await countActionRationales(db, govAction.id) : 0;

// Only compute these for governance topics with a synced action.
const [params, activeDrepStake] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getProtocolParams(db),
      // Stake participation is only meaningful for DRep-led types. SPO-led types
      // (hard fork) do not show DRep turnout, mirroring the list page logic.
      isSpoLedType(govAction.type) ? Promise.resolve(null) : getActiveDrepStake(db),
    ])
  : [null, null];

// Total active DRep voting power: the denominator for the Voting Information card's
// DRep composition and turnout. Null for SPO-led types (activeDrepStake skipped) or
// when there is no positive total yet.
const drepStakeTotal =
  activeDrepStake && activeDrepStake.total > 0 ? activeDrepStake.total : null;

// Voting-trend data (DRep/SPO power rows + CC votes/timeline): loaded once for any
// governance topic, not just the History tab, because the sidebar's teaser
// sparkline (built below) shows on every tab. The History tab's full chart reuses
// these same rows, so this is the only load.
const trend = isGovernanceTopic && govAction && db
  ? await Promise.all([getVoteTrendRows(db, govAction.id), getCommitteeVotes(db, govAction.id), getCommitteeTimeline(db)])
  : null;
const trendRows = trend?.[0] ?? [];
const ccVotes = trend?.[1] ?? [];
const committee = trend?.[2] ?? { members: [], hotToCold: new Map() };

// Voting-trend comparison: an optional second action drawn dotted over the same
// chart. History tab only, so no other tab pays for these reads. The param is a
// topic slug because action ids contain a `#index` suffix.
const compareSlug = tab === 'history' ? Astro.url.searchParams.get('compare') : null;
let compareCandidates: CompareCandidateRow[] = [];
let compare: { action: CompareAction; trendRows: TrendVoteRow[]; ccVotes: CcVote[] } | null = null;
if (db && govAction && tab === 'history') {
  compareCandidates = await getCompareCandidates(db, { excludeId: govAction.id, type: govAction.type, limit: 6 });
  if (compareSlug) {
    const target = await getCompareActionBySlug(db, compareSlug);
    // Comparing an action with itself would just double every line.
    if (target && target.id !== govAction.id) {
      const [rows, cc] = await Promise.all([getVoteTrendRows(db, target.id), getCommitteeVotes(db, target.id)]);
      compare = { action: target, trendRows: rows, ccVotes: cc };
    }
  }
}

// CC segment on the Positions tab: the breakdown row per active committee member,
// eligible at the same epoch the CC tally itself uses (committeeEpochForAction),
// so the two never disagree. Reuses params.epoch and committee loaded above
// instead of a second protocol-params read.
const currentEpoch = params?.epoch ?? null;
const ccEpoch = govAction ? committeeEpochForAction(govAction.decidedEpoch, currentEpoch) : null;

let ccRows: CcPositionRow[] = [];
let ccTotal = 0;
if (db && govAction && tab === 'positions' && committee.members.length > 0 && ccEpoch != null && isCcEligible(govAction.type)) {
  const [ccVoteRows, nameRows, ccRationales] = await Promise.all([
    getActionCcVoteRows(db, govAction.id),
    getAllCcMemberNames(db),
    getActionRationaleStatuses(db, govAction.id),
  ]);
  const nameIndex = buildCcNameIndex(nameRows, committee.hotToCold);
  ccRows = buildCcPositions({
    members: committee.members,
    hotToCold: committee.hotToCold,
    votes: ccVoteRows,
    epoch: ccEpoch,
    currentEpoch,
    nameIndex,
    rationales: ccRationales,
  });
  ccTotal = activeCommitteeSizeAt(committee.members, ccEpoch);
}

// Effective voting concentration for the Positions tab's DRep list: computed
// from the voted power of every live DRep vote. The threshold reading uses the
// frozen per-action snapshot only, on the same ratification denominator as
// the full-stake bar's marker (yes plus the No side), so the two never disagree.
let voteConcentration: VoteConcentrationView | null = null;
let concThresholdPct: number | null = null;
if (db && govAction && tab === 'positions') {
  const powers = await listDrepVotePowers(db, govAction.id);
  concThresholdPct = readThresholdSnapshot(govAction.thresholdsJson)?.drep ?? null;
  const required = requiredYesPower(govAction.drepYesPower, govAction.drepNoSidePower, concThresholdPct);
  // Skew guard: the per-vote rows sync separately from the tally counts, so a
  // freshly decided action can hold fewer vote rows than the tally counted.
  // Late votes only ever push the row count above the tally count.
  const tallyCount = (govAction.drepYes ?? 0) + (govAction.drepNo ?? 0) + (govAction.drepAbstain ?? 0);
  voteConcentration = powers.length >= tallyCount ? buildVoteConcentration(powers, required) : null;
}

// Compact multi-body step sparkline for the Voting Information card's teaser link
// into the History tab. Built from the same trend rows loaded above, no second
// read. Null when there is no vote data yet.
let miniChart: TrendChart | null = null;
if (govAction && (trendRows.length || ccVotes.length)) {
  const cfg = resolveNetwork(network);
  const { window, lineEnd, inputs } = assembleTrendInputs({ action: govAction, trendRows, ccVotes, committee, cfg, nowSec: Math.floor(now / 1000) });
  // Line stops at the current epoch; the axis spans the full window (see VotingTrendChart).
  const series = computeVoteTrendSeries(inputs, { start: window.start, end: lineEnd });
  miniChart = buildTrendChart(series, { width: 260, height: 56, padLeft: 2, padRight: 2, padTop: 4, padBottom: 4, domain: [window.start, window.end] });
}
const trendHref = topic ? `/t/${topic.slug}/?tab=history` : '';

// Decode the on-chain payload for the Overview's "On-chain changes" block. Old→new
// reads the cached epoch_params blob; both are null-safe and render nothing if absent.
const onchainChanges = govAction
  ? decodeOnchainChanges(govAction.onchainPayload ?? null, params?.rawJson ?? null, network)
  : null;

// Committee member names for the Overview's "On-chain changes" block: only read
// on the Overview tab (where it renders) and only when the payload actually adds
// or removes members. Current names only, no as-of lookup.
let committeeNames = new Map<string, string>();
if (db && tab === 'overview' && onchainChanges?.kind === 'committee' && committee.members.length > 0) {
  const idx = buildCcNameIndex(await getAllCcMemberNames(db), committee.hotToCold);
  for (const m of [...onchainChanges.added, ...onchainChanges.removed]) {
    const name = idx.byCold(m.coldKeyHex);
    if (name) committeeNames.set(m.coldKeyHex, name);
  }
}

const prevPage = page > 1 ? page - 1 : null;
// Pagination counts top-level posts; replies render with their parent.
const nextPage = thread.topLevel.length === PAGE_SIZE ? page + 1 : null;

const firstPostDate = topic
  ? new Date(topic.created_at).toISOString()
  : new Date().toISOString();

// Meta description / schema text from the opening post; deeper pages (where
// the thread page does not carry it) fall back to a generic line.
const openingExcerpt = thread.openingPost?.body_html
  ? excerptFromHtml(thread.openingPost.body_html)
  : '';
const metaDescription =
  openingExcerpt || (topic ? `Discussion of ${topic.title} on DRepTalk.` : 'Discussion on DRepTalk.');

// One author node shapes the required `name` (Google flags a missing author.name
// as a critical error) and the recommended `url` the same way everywhere an
// author appears, the topic author and every comment author, so a reply author
// can never reintroduce the missing-name error. A governance-sourced author is
// the platform (Organization); everyone else is a Person linking to their
// DRep/pool profile when one exists.
const authorNode = (a: AuthorDescriptor) => {
  if (a.isSystem) return { '@type': 'Organization', name: 'DRepTalk', url: siteOrigin + '/' };
  const profileUrl = authorProfileHref(a);
  return {
    '@type': 'Person',
    name: a.displayName,
    identifier: a.authorId,
    ...(profileUrl ? { url: siteOrigin + profileUrl } : {}),
  };
};

// Google recommends the on-page replies as a `comment` array (a missing
// `comment` is a non-critical warning). The opening post is the posting itself,
// not a comment; hidden (flagged) and text-empty posts carry nothing readable,
// so both are skipped. Built from data already loaded for the page, no extra
// queries.
const commentLd = topic
  ? pagePosts
      .filter((p) => p.id !== thread.openingPost?.id && !p.hidden)
      .map((p) => {
        const text = excerptFromHtml(p.body_html, 500);
        return text
          ? {
              '@type': 'Comment',
              author: authorNode(describe(p.author_id)),
              datePublished: new Date(p.created_at).toISOString(),
              text,
              url: siteOrigin + `/t/${topic.slug}/#post-${p.id}`,
            }
          : null;
      })
      .filter((c): c is NonNullable<typeof c> => c !== null)
  : [];

const discussionLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'DiscussionForumPosting',
      headline: topic.title,
      author: authorNode(topicAuthor),
      datePublished: firstPostDate,
      url: siteOrigin + `/t/${topic.slug}/`,
      commentCount: Math.max(0, topic.post_count - 1),
      ...(openingExcerpt ? { text: openingExcerpt } : {}),
      ...(commentLd.length ? { comment: commentLd } : {}),
    }
  : null;

const breadcrumbLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'DRepTalk',
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name ?? 'Category',
          item: siteOrigin + `/c/${topic.category_slug}/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: topic.title,
          item: siteOrigin + `/t/${topic.slug}/`,
        },
      ],
    }
  : null;

// OG card: one dynamic endpoint per thread renders the governance-action card or
// the discussion card depending on the topic; the site default applies only when
// the topic is missing. The `?v=` token fingerprints the card's visible content
// (title, reply count, the resolved author name/avatar, gov status) so a scraper
// that caches the image by URL refetches when any of that changes; it covers the
// case where an author's name resolves only after the link was first shared. The
// endpoint ignores the query and always renders current content.
//
// The live tally is included, but only as a coarse bucket (the leading body's
// yes-share floored to 5%), so the URL changes when support moves meaningfully,
// above all when it crosses the 50% line a floored-to-5 bucket boundary sits on,
// without churning the token on every single vote. This is the same figure the
// card headlines (headlineComposition), so token and image stay in step.
const ogTally = govAction ? headlineComposition(govAction) : null;
const ogTallyBucket = ogTally ? Math.floor(ogTally.yesPct / 5) * 5 : null;
const ogVersion = topic
  ? ogCardVersion([
      topic.title,
      topic.post_count,
      topicAuthor.displayName,
      topicAuthor.imageHash,
      govAction?.status,
      ogTallyBucket,
    ])
  : undefined;
const ogImage = topic ? `/og/t/${topic.slug}.png?v=${ogVersion}` : undefined;
---

{notFound ? (
  <NotFound noun="Topic" />
) : (
  <Layout
    title={`${topic.title} - DRepTalk`}
    description={metaDescription}
    ogImage={ogImage}
    wide={isGovernanceTopic}
    readingWidth={!isGovernanceTopic}
  >
    {cip100ManifestUrl && (
      <link rel="alternate" type="application/ld+json" href={cip100ManifestUrl} slot="head" />
    )}
    {discussionLd && <JsonLd data={discussionLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      {category
        ? <a href={`/c/${topic.category_slug}/`}>{category.name}</a>
        : <a href={`/c/${topic.category_slug}/`}>{topic.category_slug}</a>
      }
    </nav>

    <div style="margin-bottom:1.5rem;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <div style="min-width:0;flex:1;">
        <h1 style="margin:0 0 0.5rem;line-height:1.3;">{topic.title}</h1>
        {canEditTitle && <TitleEditor topicId={topic.id} title={topic.title} />}
        {/* User topics: the opening post right below already carries the author,
            date, and post count, so no byline here. Governance keeps its byline
            (its tabbed layout does not repeat it). Topic-state markers stay. */}
        {(isGovernanceTopic || topic.title_edited_at || topic.pinned || topic.locked) && (
          <div style="font-size:0.8125rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
            {isGovernanceTopic && (
              <Fragment>
                <AuthorIdentity
                  author={topicAuthor}
                  size={AVATAR_SIZE.card}
                  mandate={topic.proposer_grant_id ? mandates.get(topic.proposer_grant_id) : undefined}
                />
                <span>{formatRelativeTime(topic.created_at, now)}</span>
                <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
              </Fragment>
            )}
            {topic.title_edited_at && <span>(title edited)</span>}
            {topic.pinned && <span style="background:var(--accent);color:var(--on-accent);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">pinned</span>}
            {topic.locked && <span style="background:var(--muted);color:var(--on-badge);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">locked</span>}
          </div>
        )}
      </div>
      <ShareButton url={new URL(Astro.url.pathname, Astro.url.origin).href} title={topic.title} ariaLabel="Share this page" />

    </div>

    {isGovernanceTopic && govAction ? (
      // Two-column tabbed layout for governance actions.
      <>
        <GaTabs
          slug={topic.slug}
          active={tab}
          commentCount={Math.max(0, topic.post_count - 1)}
          positionsCount={positionsTotal}
        />
        <div class:list={['ga-detail-layout', { 'ga-detail-layout--sidebar-first': tab === 'overview' }]}>
          <div class="ga-detail-layout__main">
            {tab === 'discussion' ? (
              <ThreadPosts
                topic={topic}
                thread={thread}
                govVotes={govVotes}
                user={user}
                topicAuthor={topicAuthor}
                describe={describe}
                flaggedPostIds={flaggedPostIds}
                viewerReactions={viewerReactions}
                isGovernanceTopic={isGovernanceTopic}
                prevPage={prevPage}
                nextPage={nextPage}
                now={now}
                mandates={mandates}
                citablePostIds={citablePostIds}
              />
            ) : tab === 'positions' ? (
              <GaPositions
                voters={positionVoters}
                dreps={drepsMap}
                spoVoters={spoVoters}
                pools={poolsMap}
                spoTotal={spoTotal}
                total={positionsTotal}
                page={positionsPage}
                pageSize={PAGE_SIZE}
                slug={topic.slug}
                rationales={rationales}
                notCounted={notCountedVoters}
                voteHistory={voteHistory}
                now={now}
                ccRows={ccRows}
                ccTotal={ccTotal}
                concentration={voteConcentration}
                concentrationThresholdPct={concThresholdPct}
                drepChanges={drepChanges}
                spoChanges={spoChanges}
                drepChangeLine={drepChangeLine}
              />
            ) : tab === 'onchain' ? (
              <GaOnchain action={govAction} network={network} />
            ) : tab === 'history' ? (
              <GaHistory action={govAction} network={network} trendRows={trendRows} ccVotes={ccVotes} committee={committee} params={params} now={now} compare={compare} compareCandidates={compareCandidates} compareSlug={compareSlug} slug={topic.slug} />
            ) : (
              <>
                <div class="ga-overview-block">
                  {spoTotal > 0 && (
                    <a class="ga-spo-jump" href={`/t/${topic.slug}/?tab=positions&role=spo`}>
                      {spoTotal} {spoTotal === 1 ? 'SPO' : 'SPOs'} voted on this action, see how
                    </a>
                  )}
                  <GaOverview action={govAction} onchain={onchainChanges} committeeNames={committeeNames} />
                  {nclProps && (
                    <NclPanel
                      status={nclProps.status}
                      windowWithdrawals={[]}
                      definingLinks={nclProps.definingLinks}
                      relatedLinks={nclProps.relatedLinks}
                      compact={true}
                    />
                  )}
                </div>
                {/* Highlights + join sit in the main column so they flow directly
                    below the overview on desktop (no gap waiting on the taller
                    sidebar). On mobile the column dissolves and they reorder after
                    the sidebar cards (see --sidebar-first). */}
                <GaRationaleHighlights
                  highlights={rationaleHighlights}
                  dreps={drepsMap}
                  slug={topic.slug}
                  totalRationales={rationaleCount}
                />
                <GaJoinDiscussion
                  slug={topic.slug}
                  commentCount={Math.max(0, topic.post_count - 1)}
                  loggedIn={!!user}
                  locked={!!topic.locked}
                />
              </>
            )}
          </div>
          <div class="ga-detail-layout__sidebar">
            {/* Vote CTA leads the sidebar (above the status card) for a logged-in
                DRep on a votable action. It renders only in that case, so other
                viewers still see the status card first. */}
            {isDrep && isVotable && (
              <div class="vote-panel-wrapper">
                <h3 class="vote-panel-title">Cast your vote</h3>
                {isScriptDrep ? (
                  <MultisigVotePanel
                    client:load
                    mode="initiate"
                    gaId={govAction.id}
                    scriptDrepId={viewerDrepId!}
                    network={network}
                  />
                ) : (
                  <VotePanel
                    client:load
                    gaId={govAction.id}
                    network={network}
                    initialViewerVote={viewerVote}
                  />
                )}
              </div>
            )}
            <GaSidebar
              action={govAction}
              params={params}
              drepStakeTotal={drepStakeTotal}
              network={network}
              topVoters={topVoters}
              dreps={drepsMap}
              related={related}
              slug={topic.slug}
              positionsTotal={positionsTotal}
              rationaleCount={rationaleCount}
              now={now}
              miniChart={miniChart}
              trendHref={trendHref}
            >
              {nclMiniCardProps && (
                <NclMiniCard slot="after-status" {...nclMiniCardProps} />
              )}
              {linkedSurvey && (
                <LinkedSurveyCard
                  slot="after-status"
                  survey={linkedSurvey.survey}
                  topicSlug={linkedSurvey.topicSlug}
                  cfg={netCfg}
                  now={now}
                />
              )}
            </GaSidebar>
          </div>
        </div>
      </>
    ) : (
      // Non-governance topics: a single focused reading column. A survey topic
      // leads with its mirrored survey card.
      <div class="thread-single">
        {surveyRow && (
          <SurveyCard
            survey={surveyRow}
            definition={surveyDefinition}
            links={surveyLinks}
            cfg={netCfg}
            now={now}
            appUrl={env.TESSERA_APP_URL}
            asOf={surveySync?.tesseraFetchedAt ?? null}
            viewerResponse={viewerSurveyResponse}
          />
        )}
        {surveyRow && canAnswerSurvey && viewerDrepId && (
          <RespondPanel
            survey={surveyRow}
            network={network}
            epoch={epochFromUnix(now / 1000, netCfg)}
            drepId={viewerDrepId}
          />
        )}
        <ThreadPosts
          topic={topic}
          thread={thread}
          govVotes={govVotes}
          user={user}
          topicAuthor={topicAuthor}
          describe={describe}
          flaggedPostIds={flaggedPostIds}
          viewerReactions={viewerReactions}
          isGovernanceTopic={isGovernanceTopic}
          prevPage={prevPage}
          nextPage={nextPage}
          now={now}
          startIndex={offset}
          mandates={mandates}
          citablePostIds={citablePostIds}
        />
        {relatedTopics.length > 0 && (
          <section class="thread-related">
            <h2 class="thread-related__title">Related topics</h2>
            {relatedTopics.map((r) => (
              <a class="thread-related__item" href={`/t/${r.slug}/`}>
                <span class="thread-related__item-title">{r.title}</span>
                <span class="thread-related__item-meta">{r.replies} {r.replies === 1 ? 'reply' : 'replies'} &middot; {formatRelativeTime(r.lastPostAt, now)}</span>
              </a>
            ))}
            <a class="thread-related__all" href={`/c/${topic.category_slug}/`}>View all in this category</a>
          </section>
        )}
      </div>
    )}

    {/* Term tooltips only on the synced governance prose (abstract, proposer
        rationale, vote rationales), never on user-authored posts. */}
    {isGovernanceTopic && govAction && (
      <GlossaryTerms hosts=".ga-abstract__body, .ga-rationale .prose, .ga-positions__rationale-body, .ga-highlights__body" />
    )}
  </Layout>
)}

<style>
  /* User-topic thread body wrapper. The reading width is set on <main> via the
     Layout `readingWidth` prop, so breadcrumb, title, and posts all align. */
  .thread-single {
    min-width: 0;
  }
  .thread-related {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .thread-related__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .thread-related__item {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .thread-related__item:first-of-type {
    border-top: 0;
  }
  .thread-related__item-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }
  .thread-related__item:hover .thread-related__item-title {
    text-decoration: underline;
  }
  .thread-related__item-meta {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .thread-related__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  /* Two-column layout: main content on the left, sidebar on the right.
     Single column on mobile (sidebar stacks below). */
  .ga-detail-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }
  /* Grid items default to min-width:auto, so wide content (long ids, the tab
     bar, stat cards) forces the track wider than the viewport and the whole
     page scrolls sideways on a phone. min-width:0 lets the track shrink and the
     content wrap or scroll within it instead. */
  .ga-detail-layout__main,
  .ga-detail-layout__sidebar {
    min-width: 0;
  }
  /* The main column stacks its blocks (overview, rationale highlights, join CTA)
     itself, so they flow directly one after another regardless of the sidebar's
     height (no gap where a short overview meets a taller sidebar). */
  .ga-detail-layout__main {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .ga-detail-layout__sidebar {
    position: sticky;
    top: 1.5rem;
  }
  .vote-panel-wrapper {
    margin-bottom: 1.5rem;
  }
  .vote-panel-title {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }
  /* Overview SPO-count jump link: a small tappable CTA into the Votes tab,
     not a plain inline anchor. */
  .ga-spo-jump {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .ga-spo-jump:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: var(--accent);
  }
  @media (max-width: 900px) {
    .ga-detail-layout {
      grid-template-columns: 1fr;
    }
    .ga-detail-layout__sidebar {
      position: static;
    }
    /* Overview tab, mobile: lead with the status card, then the headline metrics
       and rationale (the main column), then the remaining detail cards (voting
       info, top participants, proposer, related). display:contents dissolves both
       sidebar wrappers so the cards become items of this single-column grid and
       can be ordered around the main column. The status card is always the
       sidebar's first child; the rest keep their source order after the main.
       On the other tabs the sidebar is untouched and stacks below the content the
       user navigated to. */
    .ga-detail-layout--sidebar-first {
      gap: 1.25rem;
    }
    .ga-detail-layout--sidebar-first .ga-detail-layout__sidebar,
    .ga-detail-layout--sidebar-first :global(.ga-sidebar) {
      display: contents;
    }
    .ga-detail-layout--sidebar-first :global(.ga-sidebar > *) {
      order: 3;
      min-width: 0;
    }
    .ga-detail-layout--sidebar-first :global(.ga-sidebar > :first-child) {
      order: 1;
    }
    /* The main column dissolves too, so its blocks (overview, highlights, join)
       become items of this single-column grid and can be ordered around the
       sidebar cards. */
    .ga-detail-layout--sidebar-first .ga-detail-layout__main {
      display: contents;
    }
    .ga-detail-layout--sidebar-first .ga-overview-block {
      order: 2;
      min-width: 0;
    }
    /* The DRep vote CTA leads the column, ahead of the status card. */
    .ga-detail-layout--sidebar-first .vote-panel-wrapper {
      order: 0;
    }
    /* Then the rationale highlights (after the voting info + detail cards), and the
       join-discussion bridge last. */
    .ga-detail-layout--sidebar-first :global(.ga-highlights) {
      order: 4;
      min-width: 0;
    }
    .ga-detail-layout--sidebar-first :global(.ga-join) {
      order: 5;
      min-width: 0;
    }
  }
</style>
