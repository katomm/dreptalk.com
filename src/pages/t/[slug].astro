    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .thread-related__item:first-of-type {
    border-top: 0;
  }
  .thread-related__item-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
  }
  .thread-related__item:hover .thread-related__item-title {
