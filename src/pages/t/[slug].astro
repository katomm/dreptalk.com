---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import { getTopicBySlug, getPostsByTopic } from '@/lib/db/forum.js';
import { getCategory } from '../../../config/categories.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime } from '@/lib/forum/view.js';

const { slug } = Astro.params;

const env = (Astro.locals as App.Locals).runtime?.env ?? {};
const db = env.DB as D1Database | undefined;

const topic = slug && db ? await getTopicBySlug(db, slug) : null;

if (!topic || topic.deleted) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

const posts = topic && db
  ? await getPostsByTopic(db, topic.id, { limit: PAGE_SIZE, offset })
  : [];

const category = topic ? getCategory(topic.category_slug) : undefined;

Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));

const siteOrigin = Astro.site?.origin ?? 'https://dreptalk.com';
const now = Date.now();

const user = Astro.locals.user;
const showComposer = !!user && !!topic && !topic.locked;

const prevPage = page > 1 ? page - 1 : null;
const nextPage = posts.length === PAGE_SIZE ? page + 1 : null;

const firstPostAuthor = topic?.author_id ?? '';
const firstPostDate = topic
  ? new Date(topic.created_at).toISOString()
  : new Date().toISOString();

const discussionLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'DiscussionForumPosting',
      headline: topic.title,
      author: {
        '@type': 'Person',
        identifier: firstPostAuthor,
      },
      datePublished: firstPostDate,
      url: siteOrigin + `/t/${topic.slug}`,
    }
  : null;

const breadcrumbLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'DRepTalk',
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name ?? 'Category',
          item: siteOrigin + `/c/${topic.category_slug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: topic.title,
          item: siteOrigin + `/t/${topic.slug}`,
        },
      ],
    }
  : null;
---

{(!topic || topic.deleted) ? (
  <html lang="en">
    <head><title>Topic not found - DRepTalk</title></head>
    <body>
      <main style="max-width:56rem;margin:0 auto;padding:1.5rem;">
        <h1>Topic not found</h1>
        <p><a href="/">Back to home</a></p>
      </main>
    </body>
  </html>
) : (
  <Layout
    title={`${topic.title} - DRepTalk`}
    description={`Discussion: ${topic.title}`}
  >
    {discussionLd && <JsonLd data={discussionLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      {category
        ? <a href={`/c/${topic.category_slug}`}>{category.name}</a>
        : <a href={`/c/${topic.category_slug}`}>{topic.category_slug}</a>
      }
    </nav>

    <div style="margin-bottom:1.5rem;">
      <h1 style="margin:0 0 0.5rem;line-height:1.3;">{topic.title}</h1>
      <div style="font-size:0.8125rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
        <span>by {topic.author_id.slice(0, 16)}{topic.author_id.length > 16 ? '...' : ''}</span>
        <span>{formatRelativeTime(topic.created_at, now)}</span>
        <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
        {topic.pinned && <span style="background:var(--accent);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">pinned</span>}
        {topic.locked && <span style="background:var(--muted);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">locked</span>}
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:0;">
      {posts.map((post) => (
        <article style="border-top:1px solid var(--border);padding:1.25rem 0;" id={`post-${post.id}`}>
          <div style="font-size:0.8125rem;color:var(--muted);margin-bottom:0.75rem;display:flex;gap:0.75rem;">
            <span>{post.author_id.slice(0, 16)}{post.author_id.length > 16 ? '...' : ''}</span>
            <span>{formatRelativeTime(post.created_at, now)}</span>
            {post.edited_at && <span>(edited)</span>}
          </div>
          <div class="prose" set:html={post.body_html} />
        </article>
      ))}
    </div>

    {(prevPage || nextPage) && (
      <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
        {prevPage && (
          <a href={`/t/${topic.slug}?page=${prevPage}`}>Previous page</a>
        )}
        {nextPage && (
          <a href={`/t/${topic.slug}?page=${nextPage}`}>Next page</a>
        )}
      </nav>
    )}

    {topic.locked && (
      <p style="margin-top:2rem;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:0.375rem;color:var(--muted);font-size:0.875rem;">
        This topic is locked and no longer accepts new replies.
      </p>
    )}

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Reply</h2>
        <Composer client:load mode="post" topicId={topic.id} />
      </section>
    )}
  </Layout>
)}
