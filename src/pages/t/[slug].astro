---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import NotFound from '@/components/NotFound.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import ThreadPosts from '@/components/ThreadPosts.astro';
import GaTabs from '@/components/ga/GaTabs.astro';
import GaOverview from '@/components/ga/GaOverview.astro';
import GaPositions from '@/components/ga/GaPositions.astro';
import GaOnchain from '@/components/ga/GaOnchain.astro';
import GaHistory from '@/components/ga/GaHistory.astro';
import GaSidebar from '@/components/ga/GaSidebar.astro';
import { getTopicBySlug, getThreadPage, getTopicStats, type ThreadPage } from '@/lib/db/forum.js';
import { loadViewerPostState, emptyViewerPostState } from '@/lib/forum/viewerPostState.js';
import { getGovernanceActionByTopicId, getRelatedActions, type RelatedActionRow } from '@/lib/db/governance.js';
import { threadOgImage, stakeParticipation, overviewTally, isSpoLedType } from '@/lib/governance/view.js';
import { getVotesByGaId, getActionVoters, countActionVoters, type ActionVoterRow } from '@/lib/db/drepVotes.js';
import { getDrepsByIds, type Drep } from '@/lib/db/dreps.js';
import { loadAuthorIdentities, systemAuthor, type AuthorDescriptor } from '@/lib/forum/author.js';
import { isWriter } from '@/lib/auth/roles.js';
import { currentNetwork } from '@/lib/api/response.js';
import { getCategory } from '../../../config/categories.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, truncateId, excerptFromHtml, SITE_ORIGIN } from '@/lib/forum/view.js';
import { parseGaTab } from '@/lib/governance/tab.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

const db = env.DB as D1Database | undefined;

const topic = slug && db ? await getTopicBySlug(db, slug) : null;

const notFound = !topic || topic.deleted;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

const thread: ThreadPage = topic && db
  ? await getThreadPage(db, topic.id, { limit: PAGE_SIZE, offset })
  : { topLevel: [], childrenByParent: new Map() };

// Every post on the page (top-level and replies) for the batched lookups below.
const pagePosts = [...thread.topLevel, ...[...thread.childrenByParent.values()].flat()];

const category = topic ? getCategory(topic.category_slug) : undefined;

// Resolve author identities for the topic header and every post on this page in
// exactly two batched queries (users, then dreps). No per-post lookups (no N+1).
const isGovernanceTopic = topic?.source === 'governance';

const identities = db
  ? await loadAuthorIdentities(db, [topic?.author_id, ...pagePosts.map((p) => p.author_id)])
  : null;

const describe = (authorId: string): AuthorDescriptor =>
  identities ? identities.describe(authorId) : { authorId, displayName: truncateId(authorId) };

// The first post of a governance-sourced topic carries the system identity even
// if its author_id is not literally gov-sync.
const topicAuthor: AuthorDescriptor = topic
  ? isGovernanceTopic
    ? systemAuthor(topic.author_id)
    : describe(topic.author_id)
  : { authorId: '', displayName: '' };

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const network = currentNetwork().network;

const user = Astro.locals.user;

// Only on-chain writers can flag, so the flagged-id set is loaded for them only.
// Per-post flag/visibility policy lives in postViewerContext (via PostArticle).
const viewerIsWriter = !!user && isWriter(user.roles);

// Governance-action enrichment (header values) and the viewer's own post state
// (flags + reactions, one batched round-trip) are independent, so load them
// together. The per-author votes then need govAction.id, so that one follows.
// All read from D1 ("as of").
const [govAction, viewerPostState, topicStats] = await Promise.all([
  isGovernanceTopic && db && topic
    ? getGovernanceActionByTopicId(db, topic.id)
    : Promise.resolve(null),
  db && user && viewerIsWriter
    ? loadViewerPostState(db, user.id, pagePosts.map((p) => p.id))
    : Promise.resolve(emptyViewerPostState()),
  db && topic ? getTopicStats(db, topic.id) : Promise.resolve(null),
]);
const { flaggedPostIds, reactions: viewerReactions } = viewerPostState;

// Load related actions now that govAction is known (needs its id, type, returnAddress).
const related: RelatedActionRow[] = isGovernanceTopic && govAction && db
  ? await getRelatedActions(db, {
      excludeId: govAction.id,
      type: govAction.type,
      returnAddress: govAction.returnAddress,
      limit: 6,
    })
  : [];
const govVotes = govAction && db ? await getVotesByGaId(db, govAction.id) : new Map<string, { role: string; vote: string }>();

// Governance detail page extras: tab, protocol params, stake participation, tally.
const tab = parseGaTab(Astro.url.searchParams.get('tab'));

// Positions tab: paginated voter list. Top participants and total count are always
// loaded (sidebar card + tab badge). Resolved in parallel; voter rows only on the
// positions tab. DRep identities fetched once via a single getDrepsByIds call.
const [topVoters, positionVoters, positionsTotal] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getActionVoters(db, govAction.id, { limit: 5 }),
      tab === 'positions'
        ? getActionVoters(db, govAction.id, { limit: PAGE_SIZE, offset: pageToOffset(page, PAGE_SIZE) })
        : Promise.resolve([] as Awaited<ReturnType<typeof getActionVoters>>),
      countActionVoters(db, govAction.id),
    ])
  : ([[], [], 0] as [ActionVoterRow[], ActionVoterRow[], number]);

// Resolve DRep identities for both lists in a single batch query (no N+1).
const voterIds = [
  ...new Set([...topVoters.map((v) => v.voter_id), ...positionVoters.map((v) => v.voter_id)]),
];
const drepsMap = db && voterIds.length > 0
  ? await getDrepsByIds(db, voterIds)
  : new Map<string, Drep>();

// Only compute these for governance topics with a synced action.
const [params, activeDrepStake] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getProtocolParams(db),
      // Stake participation is only meaningful for DRep-led types. SPO-led types
      // (hard fork) do not show DRep turnout, mirroring the list page logic.
      isSpoLedType(govAction.type) ? Promise.resolve(null) : getActiveDrepStake(db),
    ])
  : [null, null];

const stake =
  govAction && activeDrepStake && govAction.drepVotedPower != null
    ? stakeParticipation(govAction.drepVotedPower, activeDrepStake.total)
    : null;

const tally = govAction ? overviewTally(govAction) : null;

// Number of CC members who voted (honest quorum proxy).
const ccSize = govAction
  ? (govAction.ccYes ?? 0) + (govAction.ccNo ?? 0) + (govAction.ccAbstain ?? 0)
  : 0;

const prevPage = page > 1 ? page - 1 : null;
// Pagination counts top-level posts; replies render with their parent.
const nextPage = thread.topLevel.length === PAGE_SIZE ? page + 1 : null;

const firstPostAuthor = topic?.author_id ?? '';
const firstPostDate = topic
  ? new Date(topic.created_at).toISOString()
  : new Date().toISOString();

// Meta description / schema text from the opening post (page 1's first
// top-level post); deeper pages fall back to a generic line.
const openingExcerpt =
  page === 1 && thread.topLevel[0]?.body_html ? excerptFromHtml(thread.topLevel[0].body_html) : '';
const metaDescription =
  openingExcerpt || (topic ? `Discussion of ${topic.title} on DRepTalk.` : 'Discussion on DRepTalk.');

const discussionLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'DiscussionForumPosting',
      headline: topic.title,
      author: {
        '@type': 'Person',
        identifier: firstPostAuthor,
      },
      datePublished: firstPostDate,
      url: siteOrigin + `/t/${topic.slug}`,
      commentCount: Math.max(0, topic.post_count - 1),
      ...(openingExcerpt ? { text: openingExcerpt } : {}),
    }
  : null;

const breadcrumbLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'DRepTalk',
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name ?? 'Category',
          item: siteOrigin + `/c/${topic.category_slug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: topic.title,
          item: siteOrigin + `/t/${topic.slug}`,
        },
      ],
    }
  : null;

// OG card: per governance-action type, a generic discussion card, or the site
// default for a governance topic whose action has not synced yet.
const ogImage = threadOgImage(govAction, isGovernanceTopic);
---

{notFound ? (
  <NotFound noun="Topic" />
) : (
  <Layout
    title={`${topic.title} - DRepTalk`}
    description={metaDescription}
    ogImage={ogImage}
  >
    {discussionLd && <JsonLd data={discussionLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      {category
        ? <a href={`/c/${topic.category_slug}`}>{category.name}</a>
        : <a href={`/c/${topic.category_slug}`}>{topic.category_slug}</a>
      }
    </nav>

    <div style="margin-bottom:1.5rem;">
      <h1 style="margin:0 0 0.5rem;line-height:1.3;">{topic.title}</h1>
      <div style="font-size:0.8125rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
        <AuthorIdentity author={topicAuthor} />
        <span>{formatRelativeTime(topic.created_at, now)}</span>
        <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
        {topic.pinned && <span style="background:var(--accent);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">pinned</span>}
        {topic.locked && <span style="background:var(--muted);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">locked</span>}
      </div>
    </div>

    {isGovernanceTopic && govAction ? (
      // Two-column tabbed layout for governance actions.
      <>
        <GaTabs
          slug={topic.slug}
          active={tab}
          commentCount={Math.max(0, topic.post_count - 1)}
          positionsCount={positionsTotal}
        />
        <div class:list={['ga-detail-layout', { 'ga-detail-layout--sidebar-first': tab === 'overview' }]}>
          <div class="ga-detail-layout__main">
            {tab === 'discussion' ? (
              <ThreadPosts
                topic={topic}
                thread={thread}
                stats={topicStats}
                govVotes={govVotes}
                user={user}
                topicAuthor={topicAuthor}
                describe={describe}
                flaggedPostIds={flaggedPostIds}
                viewerReactions={viewerReactions}
                isGovernanceTopic={isGovernanceTopic}
                page={page}
                prevPage={prevPage}
                nextPage={nextPage}
                now={now}
                pageQueryPrefix="?tab=discussion&page="
              />
            ) : tab === 'positions' ? (
              <GaPositions
                voters={positionVoters}
                dreps={drepsMap}
                total={positionsTotal}
                page={page}
                pageSize={PAGE_SIZE}
                slug={topic.slug}
              />
            ) : tab === 'onchain' ? (
              <GaOnchain action={govAction} network={network} />
            ) : tab === 'history' ? (
              <GaHistory action={govAction} network={network} />
            ) : (
              <GaOverview
                action={govAction}
                stake={stake}
                tally={tally}
                now={now}
              />
            )}
          </div>
          <div class="ga-detail-layout__sidebar">
            <GaSidebar
              action={govAction}
              params={params}
              ccSize={ccSize}
              network={network}
              topVoters={topVoters}
              dreps={drepsMap}
              related={related}
            />
          </div>
        </div>
      </>
    ) : (
      // Non-governance topics: single-column thread.
      <ThreadPosts
        topic={topic}
        thread={thread}
        stats={topicStats}
        govVotes={govVotes}
        user={user}
        topicAuthor={topicAuthor}
        describe={describe}
        flaggedPostIds={flaggedPostIds}
        viewerReactions={viewerReactions}
        isGovernanceTopic={isGovernanceTopic}
        page={page}
        prevPage={prevPage}
        nextPage={nextPage}
        now={now}
        pageQueryPrefix="?page="
      />
    )}
  </Layout>
)}

<style>
  /* Two-column layout: main content on the left, sidebar on the right.
     Single column on mobile (sidebar stacks below). */
  .ga-detail-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }
  /* Grid items default to min-width:auto, so wide content (long ids, the tab
     bar, stat cards) forces the track wider than the viewport and the whole
     page scrolls sideways on a phone. min-width:0 lets the track shrink and the
     content wrap or scroll within it instead. */
  .ga-detail-layout__main,
  .ga-detail-layout__sidebar {
    min-width: 0;
  }
  .ga-detail-layout__sidebar {
    position: sticky;
    top: 1.5rem;
  }
  @media (max-width: 900px) {
    .ga-detail-layout {
      grid-template-columns: 1fr;
    }
    .ga-detail-layout__sidebar {
      position: static;
    }
    /* The sidebar (status, voting info, participants) leads only on the
       overview tab, where it is the at-a-glance summary. On the other tabs
       the content the user navigated to (the posts, the voter list) comes
       first and the sidebar stacks below it. */
    .ga-detail-layout--sidebar-first .ga-detail-layout__sidebar {
      order: -1;
    }
  }
</style>
