---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Composer from '@/components/Composer.tsx';
import NotFound from '@/components/NotFound.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import FlagButton from '@/components/FlagButton.tsx';
import GovernanceHeader from '@/components/GovernanceHeader.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import { getTopicBySlug, getPostsByTopic } from '@/lib/db/forum.js';
import { getFlaggedPostIds } from '@/lib/db/postFlags.js';
import { getGovernanceActionByTopicId } from '@/lib/db/governance.js';
import { getVotesByGaId } from '@/lib/db/drepVotes.js';
import { loadAuthorIdentities, systemAuthor, type AuthorDescriptor } from '@/lib/forum/author.js';
import { isWriter } from '@/lib/auth/roles.js';
import { postViewerContext } from '@/lib/forum/postVisibility.js';
import { currentNetwork } from '@/lib/api/response.js';
import { getCategory } from '../../../config/categories.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, truncateId, excerptFromHtml, SITE_ORIGIN } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

const db = env.DB as D1Database | undefined;

const topic = slug && db ? await getTopicBySlug(db, slug) : null;

const notFound = !topic || topic.deleted;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

const posts = topic && db
  ? await getPostsByTopic(db, topic.id, { limit: PAGE_SIZE, offset })
  : [];

const category = topic ? getCategory(topic.category_slug) : undefined;

// Resolve author identities for the topic header and every post on this page in
// exactly two batched queries (users, then dreps). No per-post lookups (no N+1).
const isGovernanceTopic = topic?.source === 'governance';

const identities = db
  ? await loadAuthorIdentities(db, [topic?.author_id, ...posts.map((p) => p.author_id)])
  : null;

const describe = (authorId: string): AuthorDescriptor =>
  identities ? identities.describe(authorId) : { authorId, displayName: truncateId(authorId) };

// The first post of a governance-sourced topic carries the system identity even
// if its author_id is not literally gov-sync.
const topicAuthor: AuthorDescriptor = topic
  ? isGovernanceTopic
    ? systemAuthor(topic.author_id)
    : describe(topic.author_id)
  : { authorId: '', displayName: '' };

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const network = currentNetwork().network;

const user = Astro.locals.user;
const showComposer = !!user && !!topic && !topic.locked;

// Only on-chain writers can flag, so the flagged-id set is loaded for them only.
// Per-post flag/visibility policy lives in postViewerContext.
const viewerIsWriter = !!user && isWriter(user.roles);

// Governance-action enrichment (header values) and the flagged-id set are
// independent (different tables), so load them together. The per-author votes
// then need govAction.id, so that one follows. All read from D1 ("as of").
const [govAction, flaggedPostIds] = await Promise.all([
  isGovernanceTopic && db && topic
    ? getGovernanceActionByTopicId(db, topic.id)
    : Promise.resolve(null),
  db && user && viewerIsWriter && posts.length
    ? getFlaggedPostIds(db, user.id, posts.map((p) => p.id))
    : Promise.resolve(new Set<string>()),
]);
const govVotes = govAction && db ? await getVotesByGaId(db, govAction.id) : new Map<string, { role: string; vote: string }>();

const prevPage = page > 1 ? page - 1 : null;
const nextPage = posts.length === PAGE_SIZE ? page + 1 : null;

const firstPostAuthor = topic?.author_id ?? '';
const firstPostDate = topic
  ? new Date(topic.created_at).toISOString()
  : new Date().toISOString();

// Meta description / schema text from the opening post (posts[0] on page 1);
// deeper pages fall back to a generic line.
const openingExcerpt = page === 1 && posts[0]?.body_html ? excerptFromHtml(posts[0].body_html) : '';
const metaDescription =
  openingExcerpt || (topic ? `Discussion of ${topic.title} on DRepTalk.` : 'Discussion on DRepTalk.');

const discussionLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'DiscussionForumPosting',
      headline: topic.title,
      author: {
        '@type': 'Person',
        identifier: firstPostAuthor,
      },
      datePublished: firstPostDate,
      url: siteOrigin + `/t/${topic.slug}`,
      commentCount: Math.max(0, topic.post_count - 1),
      ...(openingExcerpt ? { text: openingExcerpt } : {}),
    }
  : null;

const breadcrumbLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'DRepTalk',
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name ?? 'Category',
          item: siteOrigin + `/c/${topic.category_slug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: topic.title,
          item: siteOrigin + `/t/${topic.slug}`,
        },
      ],
    }
  : null;
---

{notFound ? (
  <NotFound noun="Topic" />
) : (
  <Layout
    title={`${topic.title} - DRepTalk`}
    description={metaDescription}
  >
    {discussionLd && <JsonLd data={discussionLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      {category
        ? <a href={`/c/${topic.category_slug}`}>{category.name}</a>
        : <a href={`/c/${topic.category_slug}`}>{topic.category_slug}</a>
      }
    </nav>

    <div style="margin-bottom:1.5rem;">
      <h1 style="margin:0 0 0.5rem;line-height:1.3;">{topic.title}</h1>
      <div style="font-size:0.8125rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
        <AuthorIdentity author={topicAuthor} />
        <span>{formatRelativeTime(topic.created_at, now)}</span>
        <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
        {topic.pinned && <span style="background:var(--accent);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">pinned</span>}
        {topic.locked && <span style="background:var(--muted);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">locked</span>}
      </div>
    </div>

    {govAction && page === 1 && (
      <GovernanceHeader action={govAction} network={network} now={now} />
    )}

    <div style="display:flex;flex-direction:column;gap:0;">
      {posts.map((post, i) => {
        // The opening post of a governance-sourced topic (page 1, index 0) shows
        // the System identity even when its author_id is not literally gov-sync.
        const author =
          isGovernanceTopic && page === 1 && i === 0
            ? topicAuthor
            : describe(post.author_id);

        const { canSeeContent, canFlag } = postViewerContext(post, user, !!author.isSystem);
        // Per-post vote badge: match the author's DRep id to the on-chain votes.
        const authorVote = author.drepId ? govVotes.get(author.drepId) : undefined;

        return (
          <article style="border-top:1px solid var(--border);padding:1.25rem 0;" id={`post-${post.id}`}>
            <div style="font-size:0.8125rem;color:var(--muted);margin-bottom:0.75rem;display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
              <AuthorIdentity author={author} />
              {authorVote && <VoteBadge vote={authorVote.vote} />}
              <span>{formatRelativeTime(post.created_at, now)}</span>
              {post.edited_at && <span>(edited)</span>}
              {post.hidden && canSeeContent && (
                <span style="background:var(--muted);color:#fff;border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">hidden by the community</span>
              )}
              {canFlag && (
                <FlagButton
                  client:visible
                  postId={post.id}
                  initialFlagged={flaggedPostIds.has(post.id)}
                  initialCount={post.flag_count}
                  initialHidden={post.hidden}
                />
              )}
            </div>
            {canSeeContent ? (
              <div class="prose" set:html={post.body_html} />
            ) : (
              <p style="margin:0;color:var(--muted);font-style:italic;font-size:0.9375rem;">
                This post was hidden after being flagged by the community.
              </p>
            )}
          </article>
        );
      })}
    </div>

    {(prevPage || nextPage) && (
      <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
        {prevPage && (
          <a href={`/t/${topic.slug}?page=${prevPage}`}>Previous page</a>
        )}
        {nextPage && (
          <a href={`/t/${topic.slug}?page=${nextPage}`}>Next page</a>
        )}
      </nav>
    )}

    {topic.locked && (
      <p style="margin-top:2rem;padding:0.875rem 1rem;border:1px solid var(--border);border-radius:0.375rem;color:var(--muted);font-size:0.875rem;">
        This topic is locked and no longer accepts new replies.
      </p>
    )}

    {showComposer && (
      <section style="margin-top:2.5rem;border-top:1px solid var(--border);padding-top:2rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Reply</h2>
        <Composer client:load mode="post" topicId={topic.id} />
      </section>
    )}
  </Layout>
)}
