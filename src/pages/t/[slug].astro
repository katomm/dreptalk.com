---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import NotFound from '@/components/NotFound.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import ThreadPosts from '@/components/ThreadPosts.astro';
import TitleEditor from '@/components/TitleEditor.astro';
import GaTabs from '@/components/ga/GaTabs.astro';
import GaOverview from '@/components/ga/GaOverview.astro';
import GaRationaleHighlights from '@/components/ga/GaRationaleHighlights.astro';
import GaJoinDiscussion from '@/components/ga/GaJoinDiscussion.astro';
import GaPositions from '@/components/ga/GaPositions.astro';
import GaOnchain from '@/components/ga/GaOnchain.astro';
import GaHistory from '@/components/ga/GaHistory.astro';
import GaSidebar from '@/components/ga/GaSidebar.astro';
import { getTopicBySlug, getThreadPage, type ThreadPage } from '@/lib/db/forum.js';
import { getRelatedTopics } from '@/lib/db/discussions.js';
import { detectIdentifier } from '@/lib/search/identifiers.js';
import { resolveIdentifier } from '@/lib/db/search.js';
import { loadViewerPostState, emptyViewerPostState } from '@/lib/forum/viewerPostState.js';
import { getGovernanceActionByTopicId, getRelatedActions, type RelatedActionRow } from '@/lib/db/governance.js';
import { isSpoLedType } from '@/lib/governance/view.js';
import { lateVoterIds } from '@/lib/governance/lateVotes.js';
import { getVotesByGaId, getActionVoters, countActionVoters, getViewerVote, getActionSpoVoters, countActionSpoVoters, type ActionVoterRow } from '@/lib/db/drepVotes.js';
import {
  getActionRationales,
  countActionRationales,
  getRationaleHighlights,
  type RationaleHighlight,
} from '@/lib/db/actionRationale.js';
import { getDrepsByIds, type Drep } from '@/lib/db/dreps.js';
import { getPoolsByIds, type Pool } from '@/lib/db/pools.js';
import { getUserById } from '@/lib/db/users.js';
import VotePanel from '@/components/VotePanel.js';
import MultisigVotePanel from '@/components/MultisigVotePanel.js';
import { parseDrepId } from '@/lib/cardano/identity.js';
import { loadAuthorIdentities, systemAuthor, authorProfileHref, type AuthorDescriptor } from '@/lib/forum/author.js';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { isWriter } from '@/lib/auth/roles.js';
import { currentNetwork } from '@/lib/api/response.js';
import { getCategory } from '../../../config/categories.js';
import { parsePage, pageToOffset, cacheControlFor, formatRelativeTime, truncateId, excerptFromHtml, SITE_ORIGIN } from '@/lib/forum/view.js';
import { parseGaTab } from '@/lib/governance/tab.js';
import { ogCardVersion } from '@/lib/og/version.js';
import { decodeOnchainChanges } from '@/lib/governance/onchain.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import NclPanel from '@/components/ncl/NclPanel.astro';
import NclMiniCard from '@/components/ncl/NclMiniCard.astro';
import { NCL_PERIODS } from '../../../config/ncl-periods.js';
import { nclStatusFor, currentNclPeriod } from '@/lib/governance/ncl.js';
import { getEnactedTreasuryWithdrawals, getNclActionLinks, type NclActionLink } from '@/lib/db/treasury.js';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

const db = env.DB as D1Database | undefined;

// A pasted governance-action id routes to its discussion: resolve it to the
// canonical topic slug and 301-redirect, mirroring the DRep id->slug redirect.
// Covers the bech32 gov_action1... form (vote links) and the CIP-129 hex form
// that explorer.cardano.org deep-links with (64-hex tx hash + hex index byte,
// no '#'). Real topic slugs always carry a hyphen, so they never collide with
// the hyphen-free identifier forms. Detection and resolution are the same
// helpers the search uses, so both stay one source of truth.
if (slug && db) {
  const ident = detectIdentifier(slug);
  if (ident?.kind === 'gov-action' && (ident.by === 'proposal_id' || ident.by === 'id')) {
    const hit = await resolveIdentifier(db, ident);
    if (hit) return Astro.redirect(hit.href, 301);
  }
}

const topic = slug && db ? await getTopicBySlug(db, slug) : null;

const notFound = !topic || topic.deleted;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

const thread: ThreadPage = topic && db
  ? await getThreadPage(db, topic.id, { limit: PAGE_SIZE, offset })
  : { topLevel: [], childrenByParent: new Map(), openingPost: null, stats: null };

// Every post on the page (top-level and replies) for the batched lookups below.
const pagePosts = [...thread.topLevel, ...[...thread.childrenByParent.values()].flat()];

const category = topic ? getCategory(topic.category_slug) : undefined;

// Resolve author identities for the topic header and every post on this page in
// exactly two batched queries (users, then dreps). No per-post lookups (no N+1).
const isGovernanceTopic = topic?.source === 'governance';

const identities = db
  ? await loadAuthorIdentities(db, [topic?.author_id, ...pagePosts.map((p) => p.author_id)])
  : null;

const describe = (authorId: string): AuthorDescriptor =>
  identities ? identities.describe(authorId) : { authorId, displayName: truncateId(authorId) };

// The first post of a governance-sourced topic carries the system identity even
// if its author_id is not literally gov-sync.
const topicAuthor: AuthorDescriptor = topic
  ? isGovernanceTopic
    ? systemAuthor(topic.author_id)
    : describe(topic.author_id)
  : { authorId: '', displayName: '' };

// Related topics for user topics only, shown as a slim section below the thread
// (governance topics keep their own GaSidebar). Same category, most recent first.
let relatedTopics: { title: string; slug: string; replies: number; lastPostAt: number }[] = [];
if (db && topic && !topic.deleted && !isGovernanceTopic) {
  const related = await getRelatedTopics(db, topic.category_slug, topic.id, { limit: 5 });
  relatedTopics = related.map((r) => ({
    title: r.title,
    slug: r.slug,
    replies: Math.max(0, r.post_count - 1),
    lastPostAt: r.last_post_at,
  }));
}

if (!notFound) {
  Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const network = currentNetwork().network;

const user = Astro.locals.user;

// Only on-chain writers can flag, so the flagged-id set is loaded for them only.
// Per-post flag/visibility policy lives in postViewerContext (via PostArticle).
const viewerIsWriter = !!user && isWriter(user.roles);

// The opening-post author may edit the title of their own non-locked user topic.
const canEditTitle =
  !!user && viewerIsWriter && !!topic && topic.source === 'user' &&
  topic.author_id === user.id && !topic.locked;

// Governance-action enrichment (header values) and the viewer's own post state
// (flags + reactions, one batched round-trip) are independent, so load them
// together. The per-author votes then need govAction.id, so that one follows.
// All read from D1 ("as of").
const [govAction, viewerPostState] = await Promise.all([
  isGovernanceTopic && db && topic
    ? getGovernanceActionByTopicId(db, topic.id)
    : Promise.resolve(null),
  db && user && viewerIsWriter
    ? loadViewerPostState(db, user.id, pagePosts.map((p) => p.id))
    : Promise.resolve(emptyViewerPostState()),
]);
const { flaggedPostIds, reactions: viewerReactions } = viewerPostState;

// If this action defines or challenges an NCL period, show its live tracker.
const nclPeriod = govAction
  ? NCL_PERIODS.find(
      (p) => p.definingActionIds.includes(govAction.id) || p.relatedActionIds.includes(govAction.id),
    )
  : undefined;
let nclProps: {
  status: ReturnType<typeof nclStatusFor>;
  definingLinks: NclActionLink[];
  relatedLinks: NclActionLink[];
} | null = null;
if (nclPeriod && db) {
  // Independent reads; run them concurrently.
  const [withdrawals, links] = await Promise.all([
    getEnactedTreasuryWithdrawals(db),
    getNclActionLinks(db, [...nclPeriod.definingActionIds, ...nclPeriod.relatedActionIds]),
  ]);
  const pick = (ids: string[]) => ids.map((id) => links.get(id)).filter((l): l is NclActionLink => !!l);
  nclProps = {
    status: nclStatusFor(nclPeriod, withdrawals),
    definingLinks: pick(nclPeriod.definingActionIds),
    relatedLinks: pick(nclPeriod.relatedActionIds),
  };
}

// TreasuryWithdrawals sidebar card: tells the reader this withdrawal counts
// toward its NCL period and how full that cap already is. Separate from
// nclProps above (which only applies to the InfoActions that define/challenge
// a period). Guarded to TreasuryWithdrawals so no extra fetch happens on any
// other action type.
let nclMiniCardProps: {
  periodLabel: string;
  consumedPct: number;
  remainingLovelace: bigint;
  ceilingLovelace: bigint;
  overviewHref: string;
} | null = null;
if (govAction?.type === 'TreasuryWithdrawals' && db) {
  // Prefer the action's own enacted epoch; only fall back to the synced
  // protocol-params epoch when it has none, so an already-enacted withdrawal
  // (the common case) does not re-fetch params that are loaded again below.
  const anchorEpoch = govAction.enactedEpoch ?? (await getProtocolParams(db))?.epoch ?? null;
  const period = anchorEpoch != null ? currentNclPeriod(NCL_PERIODS, anchorEpoch) : undefined;
  if (period) {
    const s = nclStatusFor(period, await getEnactedTreasuryWithdrawals(db));
    nclMiniCardProps = {
      periodLabel: period.label,
      consumedPct: s.consumedPct,
      remainingLovelace: s.remainingLovelace,
      ceilingLovelace: period.ceilingLovelace,
      overviewHref: '/treasury/',
    };
  }
}

// Other actions from the same proposer, for the sidebar (needs the action's
// id to exclude itself and its return_address to match the proposer).
const related: RelatedActionRow[] = isGovernanceTopic && govAction && db
  ? await getRelatedActions(db, {
      excludeId: govAction.id,
      returnAddress: govAction.returnAddress,
      limit: 6,
    })
  : [];
const govVotes = govAction && db ? await getVotesByGaId(db, govAction.id) : new Map<string, { role: string; vote: string; meta_url: string | null }>();

// DRep vote panel: only for logged-in DReps on votable (active) actions.
// Gate on ga.status === 'active'; deriveStatus already accounts for expiry boundary.
const isDrep = user?.roles?.includes('drep') ?? false;
const isVotable = govAction?.status === 'active';
const dbUser = isDrep && isGovernanceTopic && db ? await getUserById(db, user!.id) : null;
const viewerDrepId = isDrep ? (dbUser?.drep_id ?? null) : null;
const viewerVote =
  isDrep && isVotable && viewerDrepId && db && govAction
    ? await getViewerVote(db, govAction.id, viewerDrepId)
    : null;

// A script-credential DRep cannot sign votes directly: it needs the multisig
// initiate/co-sign flow instead of the key-DRep VotePanel.
const isScriptDrep = viewerDrepId ? parseDrepId(viewerDrepId)?.kind === 'script' : false;

// Governance detail page extras: tab, protocol params, stake participation.
const tab = parseGaTab(Astro.url.searchParams.get('tab'));

// Positions tab: paginated voter list. Top participants and total count are always
// loaded (sidebar card + tab badge). Resolved in parallel; voter rows only on the
// positions tab. DRep identities fetched once via a single getDrepsByIds call.
// Overview "Rationale highlights": a balanced top-N Yes + top-N No DRep rationales
// (with text, non-abstain), loaded only on the default Overview tab where they render.
const RATIONALE_HIGHLIGHT_PER_VOTE = 2;
const [topVoters, positionVoters, positionsTotal, rationaleHighlights] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getActionVoters(db, govAction.id, { limit: 5 }),
      tab === 'positions'
        ? getActionVoters(db, govAction.id, { limit: PAGE_SIZE, offset: pageToOffset(page, PAGE_SIZE) })
        : Promise.resolve([] as Awaited<ReturnType<typeof getActionVoters>>),
      countActionVoters(db, govAction.id),
      tab === 'overview'
        ? getRationaleHighlights(db, govAction.id, RATIONALE_HIGHLIGHT_PER_VOTE)
        : Promise.resolve([] as RationaleHighlight[]),
    ])
  : ([[], [], 0, []] as [ActionVoterRow[], ActionVoterRow[], number, RationaleHighlight[]]);

// Resolve DRep identities for the voter lists and the highlights in a single
// batch query (no N+1). Highlight voters may not appear in the top-5, so include them.
const voterIds = [
  ...new Set([
    ...topVoters.map((v) => v.voter_id),
    ...positionVoters.map((v) => v.voter_id),
    ...rationaleHighlights.map((h) => h.voter_id),
  ]),
];
const drepsMap = db && voterIds.length > 0
  ? await getDrepsByIds(db, voterIds)
  : new Map<string, Drep>();

// SPO voters for the positions tab role segment, plus their pool identities.
const spoTotal = isGovernanceTopic && govAction && db
  ? await countActionSpoVoters(db, govAction.id)
  : 0;
const spoVoters = tab === 'positions' && govAction && db
  ? await getActionSpoVoters(db, govAction.id, { limit: PAGE_SIZE, offset: pageToOffset(page, PAGE_SIZE) })
  : ([] as Awaited<ReturnType<typeof getActionSpoVoters>>);
const poolIds = [...new Set(spoVoters.map((v) => v.voter_id))];
const poolsMap = db && poolIds.length > 0 ? await getPoolsByIds(db, poolIds) : new Map<string, Pool>();

// Rationales for the positions tab: keyed by voter_id, loaded only when needed.
const rationales = tab === 'positions' && db && govAction
  ? await getActionRationales(db, govAction.id)
  : new Map<string, { bodyHtml: string | null; source: string }>();

// Votes cast too late to count in the frozen tally (on/after the ratification
// epoch). Shown distinctly on the Positions tab so they don't read as counted.
const notCountedVoters = govAction
  ? lateVoterIds([...positionVoters, ...spoVoters], govAction, network)
  : new Set<string>();

// Action-wide rationale count (cheap): drives the sidebar "See all" link on every tab.
const rationaleCount = db && govAction ? await countActionRationales(db, govAction.id) : 0;

// Only compute these for governance topics with a synced action.
const [params, activeDrepStake] = isGovernanceTopic && govAction && db
  ? await Promise.all([
      getProtocolParams(db),
      // Stake participation is only meaningful for DRep-led types. SPO-led types
      // (hard fork) do not show DRep turnout, mirroring the list page logic.
      isSpoLedType(govAction.type) ? Promise.resolve(null) : getActiveDrepStake(db),
    ])
  : [null, null];

// Total active DRep voting power: the denominator for the Voting Information card's
// DRep composition and turnout. Null for SPO-led types (activeDrepStake skipped) or
// when there is no positive total yet.
const drepStakeTotal =
  activeDrepStake && activeDrepStake.total > 0 ? activeDrepStake.total : null;

// Decode the on-chain payload for the Overview's "On-chain changes" block. Old→new
// reads the cached epoch_params blob; both are null-safe and render nothing if absent.
const onchainChanges = govAction
  ? decodeOnchainChanges(govAction.onchainPayload ?? null, params?.rawJson ?? null, network)
  : null;

const prevPage = page > 1 ? page - 1 : null;
// Pagination counts top-level posts; replies render with their parent.
const nextPage = thread.topLevel.length === PAGE_SIZE ? page + 1 : null;

const firstPostDate = topic
  ? new Date(topic.created_at).toISOString()
  : new Date().toISOString();

// Meta description / schema text from the opening post; deeper pages (where
// the thread page does not carry it) fall back to a generic line.
const openingExcerpt = thread.openingPost?.body_html
  ? excerptFromHtml(thread.openingPost.body_html)
  : '';
const metaDescription =
  openingExcerpt || (topic ? `Discussion of ${topic.title} on DRepTalk.` : 'Discussion on DRepTalk.');

// The author node needs a name (Google flags a missing author.name as a
// critical error) and, where the author has a public profile, a url. A
// governance-sourced topic is authored by the platform, so it resolves to the
// DRepTalk organization; a user topic resolves to the person, linking to their
// DRep/pool profile when one exists.
const authorProfileUrl = authorProfileHref(topicAuthor);
const authorLd = topicAuthor.isSystem
  ? {
      '@type': 'Organization',
      name: 'DRepTalk',
      url: siteOrigin + '/',
    }
  : {
      '@type': 'Person',
      name: topicAuthor.displayName,
      identifier: topicAuthor.authorId,
      ...(authorProfileUrl ? { url: siteOrigin + authorProfileUrl } : {}),
    };

const discussionLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'DiscussionForumPosting',
      headline: topic.title,
      author: authorLd,
      datePublished: firstPostDate,
      url: siteOrigin + `/t/${topic.slug}/`,
      commentCount: Math.max(0, topic.post_count - 1),
      ...(openingExcerpt ? { text: openingExcerpt } : {}),
    }
  : null;

const breadcrumbLd = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'DRepTalk',
          item: siteOrigin + '/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category?.name ?? 'Category',
          item: siteOrigin + `/c/${topic.category_slug}/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: topic.title,
          item: siteOrigin + `/t/${topic.slug}/`,
        },
      ],
    }
  : null;

// OG card: one dynamic endpoint per thread renders the governance-action card or
// the discussion card depending on the topic; the site default applies only when
// the topic is missing. The `?v=` token fingerprints the card's visible content
// (title, reply count, the resolved author name/avatar, gov status) so a scraper
// that caches the image by URL refetches when any of that changes; it covers the
// case where an author's name resolves only after the link was first shared. The
// endpoint ignores the query and always renders current content.
const ogVersion = topic
  ? ogCardVersion([
      topic.title,
      topic.post_count,
      topicAuthor.displayName,
      topicAuthor.imageHash,
      govAction?.status,
    ])
  : undefined;
const ogImage = topic ? `/og/t/${topic.slug}.png?v=${ogVersion}` : undefined;
---

{notFound ? (
  <NotFound noun="Topic" />
) : (
  <Layout
    title={`${topic.title} - DRepTalk`}
    description={metaDescription}
    ogImage={ogImage}
    readingWidth={!isGovernanceTopic}
  >
    {discussionLd && <JsonLd data={discussionLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      {category
        ? <a href={`/c/${topic.category_slug}/`}>{category.name}</a>
        : <a href={`/c/${topic.category_slug}/`}>{topic.category_slug}</a>
      }
    </nav>

    <div style="margin-bottom:1.5rem;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <div style="min-width:0;flex:1;">
        <h1 style="margin:0 0 0.5rem;line-height:1.3;">{topic.title}</h1>
        {canEditTitle && <TitleEditor topicId={topic.id} title={topic.title} />}
        {/* User topics: the opening post right below already carries the author,
            date, and post count, so no byline here. Governance keeps its byline
            (its tabbed layout does not repeat it). Topic-state markers stay. */}
        {(isGovernanceTopic || topic.title_edited_at || topic.pinned || topic.locked) && (
          <div style="font-size:0.8125rem;color:var(--muted);display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
            {isGovernanceTopic && (
              <Fragment>
                <AuthorIdentity author={topicAuthor} size={AVATAR_SIZE.post} />
                <span>{formatRelativeTime(topic.created_at, now)}</span>
                <span>{topic.post_count} {topic.post_count === 1 ? 'post' : 'posts'}</span>
              </Fragment>
            )}
            {topic.title_edited_at && <span>(title edited)</span>}
            {topic.pinned && <span style="background:var(--accent);color:var(--on-accent);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">pinned</span>}
            {topic.locked && <span style="background:var(--muted);color:var(--on-badge);border-radius:0.25rem;padding:0.125rem 0.375rem;font-size:0.75rem;">locked</span>}
          </div>
        )}
      </div>
      {!isGovernanceTopic && (
        <button type="button" class="thread-share-btn" data-copy-link data-copied-label="Copied">
          Share
        </button>
      )}
    </div>

    {isGovernanceTopic && govAction ? (
      // Two-column tabbed layout for governance actions.
      <>
        <GaTabs
          slug={topic.slug}
          active={tab}
          commentCount={Math.max(0, topic.post_count - 1)}
          positionsCount={positionsTotal}
        />
        <div class:list={['ga-detail-layout', { 'ga-detail-layout--sidebar-first': tab === 'overview' }]}>
          <div class="ga-detail-layout__main">
            {tab === 'discussion' ? (
              <ThreadPosts
                topic={topic}
                thread={thread}
                govVotes={govVotes}
                user={user}
                topicAuthor={topicAuthor}
                describe={describe}
                flaggedPostIds={flaggedPostIds}
                viewerReactions={viewerReactions}
                isGovernanceTopic={isGovernanceTopic}
                prevPage={prevPage}
                nextPage={nextPage}
                now={now}
              />
            ) : tab === 'positions' ? (
              <GaPositions
                voters={positionVoters}
                dreps={drepsMap}
                spoVoters={spoVoters}
                pools={poolsMap}
                spoTotal={spoTotal}
                total={positionsTotal}
                page={page}
                pageSize={PAGE_SIZE}
                slug={topic.slug}
                rationales={rationales}
                notCounted={notCountedVoters}
              />
            ) : tab === 'onchain' ? (
              <GaOnchain action={govAction} network={network} />
            ) : tab === 'history' ? (
              <GaHistory action={govAction} network={network} />
            ) : (
              <>
                <div class="ga-overview-block">
                  {spoTotal > 0 && (
                    <a class="ga-spo-jump" href={`/t/${topic.slug}/?tab=positions&role=spo`}>
                      {spoTotal} {spoTotal === 1 ? 'SPO' : 'SPOs'} voted on this action, see how
                    </a>
                  )}
                  <GaOverview action={govAction} onchain={onchainChanges} />
                  {nclProps && (
                    <NclPanel
                      status={nclProps.status}
                      windowWithdrawals={[]}
                      definingLinks={nclProps.definingLinks}
                      relatedLinks={nclProps.relatedLinks}
                      compact={true}
                    />
                  )}
                </div>
                {/* Highlights + join sit in the main column so they flow directly
                    below the overview on desktop (no gap waiting on the taller
                    sidebar). On mobile the column dissolves and they reorder after
                    the sidebar cards (see --sidebar-first). */}
                <GaRationaleHighlights
                  highlights={rationaleHighlights}
                  dreps={drepsMap}
                  slug={topic.slug}
                  totalRationales={rationaleCount}
                />
                <GaJoinDiscussion
                  slug={topic.slug}
                  commentCount={Math.max(0, topic.post_count - 1)}
                  loggedIn={!!user}
                  locked={!!topic.locked}
                />
              </>
            )}
          </div>
          <div class="ga-detail-layout__sidebar">
            {/* Vote CTA leads the sidebar (above the status card) for a logged-in
                DRep on a votable action. It renders only in that case, so other
                viewers still see the status card first. */}
            {isDrep && isVotable && (
              <div class="vote-panel-wrapper">
                <h3 class="vote-panel-title">Cast your vote</h3>
                {isScriptDrep ? (
                  <MultisigVotePanel
                    client:load
                    mode="initiate"
                    gaId={govAction.id}
                    scriptDrepId={viewerDrepId!}
                    network={network}
                  />
                ) : (
                  <VotePanel
                    client:load
                    gaId={govAction.id}
                    network={network}
                    initialViewerVote={viewerVote}
                  />
                )}
              </div>
            )}
            <GaSidebar
              action={govAction}
              params={params}
              drepStakeTotal={drepStakeTotal}
              network={network}
              topVoters={topVoters}
              dreps={drepsMap}
              related={related}
              slug={topic.slug}
              positionsTotal={positionsTotal}
              rationaleCount={rationaleCount}
              now={now}
            >
              {nclMiniCardProps && (
                <NclMiniCard slot="after-status" {...nclMiniCardProps} />
              )}
            </GaSidebar>
          </div>
        </div>
      </>
    ) : (
      // Non-governance topics: a single focused reading column.
      <div class="thread-single">
        <ThreadPosts
          topic={topic}
          thread={thread}
          govVotes={govVotes}
          user={user}
          topicAuthor={topicAuthor}
          describe={describe}
          flaggedPostIds={flaggedPostIds}
          viewerReactions={viewerReactions}
          isGovernanceTopic={isGovernanceTopic}
          prevPage={prevPage}
          nextPage={nextPage}
          now={now}
          startIndex={offset}
        />
        {relatedTopics.length > 0 && (
          <section class="thread-related">
            <h2 class="thread-related__title">Related topics</h2>
            {relatedTopics.map((r) => (
              <a class="thread-related__item" href={`/t/${r.slug}/`}>
                <span class="thread-related__item-title">{r.title}</span>
                <span class="thread-related__item-meta">{r.replies} {r.replies === 1 ? 'reply' : 'replies'} &middot; {formatRelativeTime(r.lastPostAt, now)}</span>
              </a>
            ))}
            <a class="thread-related__all" href={`/c/${topic.category_slug}/`}>View all in this category</a>
          </section>
        )}
      </div>
    )}
  </Layout>
)}

<style>
  /* User-topic thread body wrapper. The reading width is set on <main> via the
     Layout `readingWidth` prop, so breadcrumb, title, and posts all align. */
  .thread-single {
    min-width: 0;
  }
  .thread-related {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
