---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ActivityFeed from '@/components/ActivityFeed.astro';
import Avatar from '@/components/Avatar.astro';
import { getCategories } from '../../config/categories.js';
import { getCategoryStats } from '@/lib/db/forum.js';
import { getLatestGovernanceAction, getLatestActionWithVotes } from '@/lib/db/governance.js';
import { getActionVoters } from '@/lib/db/drepVotes.js';
import { getDrepsByIds } from '@/lib/db/dreps.js';
import { voterDescriptor, authorProfileHref } from '@/lib/forum/author.js';
import { heroRingSlots, HERO_RING_RADII } from '@/lib/hero/ring.js';
import { loadActivityFeed } from '@/lib/forum/activityFeed.js';
import { readableType, statusBadge, voteTone, TONE_COLORS } from '@/lib/governance/view.js';
import { cacheControlFor, formatRelativeTime } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';

const db = env.DB as D1Database | undefined;
const now = Date.now();
const user = Astro.locals.user;

// The hero "live voting" scene shows the strongest DRep voters actively (avatar
// plus a vote badge) ringed by fainter "ghost" voters, so it reads as a vote in
// progress. We pull a few more than we show to fill both rings from one query.
const HERO_MIN_ACTIVE = 8; // fewest active voters that still reads as a full ring
const HERO_MAX_ACTIVE = 10; // most active pills on the inner ring
const HERO_MAX_GHOSTS = 8; // most ghost avatars on the outer ring
const HERO_FETCH = HERO_MAX_ACTIVE + HERO_MAX_GHOSTS; // voters pulled in one query

// Category stats, the activity feed, and the voted-hero candidate are
// independent; load them together. votedHero is the newest action that already
// has enough DRep voters to drive the live ring.
const [stats, feed, votedHero] = db
  ? await Promise.all([
      getCategoryStats(db),
      loadActivityFeed(db, { limit: 8 }).then((r) => r.events),
      getLatestActionWithVotes(db, { minVoters: HERO_MIN_ACTIVE }),
    ])
  : [new Map<string, { topicCount: number; lastPostAt: number | null }>(), [], null];

// Fall back to the plain newest action only when none has enough voters yet, so
// the common path (a voted action exists) skips this query entirely.
const latestHero = !votedHero && db ? await getLatestGovernanceAction(db) : null;
const heroAction = votedHero ?? latestHero;

// Resolve the voted action's top voters into pill data (identicon seed + stored
// avatar hash + the vote), then split into the strongest as "active" and the
// remainder as "ghosts". dreps are batched in one follow-up query.
const hero =
  db && votedHero
    ? await (async () => {
        const voters = await getActionVoters(db, votedHero.action.id, { limit: HERO_FETCH });
        const dreps = await getDrepsByIds(db, voters.map((v) => v.voter_id));
        const rows = voters.map((v) => ({ descriptor: voterDescriptor(v, dreps), vote: v.vote }));
        return { active: rows.slice(0, HERO_MAX_ACTIVE), ghosts: rows.slice(HERO_MAX_ACTIVE, HERO_FETCH) };
      })()
    : { active: [] as { descriptor: ReturnType<typeof voterDescriptor>; vote: string }[], ghosts: [] as { descriptor: ReturnType<typeof voterDescriptor>; vote: string }[] };

// Only light the real scene when the inner ring is full enough; a sparse ring
// would read as broken, so otherwise we keep the decorative placeholder ring.
const showScene = hero.active.length >= HERO_MIN_ACTIVE;

// Ring positions: for the real scene, exactly as many slots as we have voters;
// otherwise a small decorative ring of six placeholders.
const ringSlots = showScene ? heroRingSlots(hero.active.length, hero.ghosts.length) : heroRingSlots(6, 0);
const activeSlots = ringSlots.filter((s) => s.kind === 'active');
const ghostSlots = ringSlots.filter((s) => s.kind === 'ghost');

// Reveal timing (pure CSS): the card is already in; votes then pop over ~1.1s.
// The base offset lets the card settle; the per-index step spreads pops into
// roughly three waves, which the status dots track.
const REVEAL_BASE_MS = 520;
const REVEAL_STEP_MS = 110;

// SVG guide-ring radii in the 0..320 viewBox, derived from the shared fractions
// so the dashed ellipses line up with the pill positions.
const VIEWBOX = 320;
const ringActive = { rx: HERO_RING_RADII.active.rx * VIEWBOX, ry: HERO_RING_RADII.active.ry * VIEWBOX };
const ringGhost = { rx: HERO_RING_RADII.ghost.rx * VIEWBOX, ry: HERO_RING_RADII.ghost.ry * VIEWBOX };

// Maps a vote to the badge glyph kind + label shown on an active pill.
function voteBadgeKind(vote: string): 'yes' | 'no' | 'abstain' {
  const v = vote.toLowerCase();
  if (v === 'yes') return 'yes';
  if (v === 'no') return 'no';
  return 'abstain';
}

const categories = getCategories();

Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));

const siteOrigin = Astro.site?.origin ?? 'https://dreptalk.com';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DRepTalk',
  url: siteOrigin + '/',
  inLanguage: 'en',
  description: 'The public deliberation layer for Cardano governance.',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DRepTalk',
      item: siteOrigin + '/',
    },
  ],
};

// Hero card: a live preview of the newest governance action, falling back to a
// static placeholder when the DB holds none yet (fresh deploy / local dev). The
// shape is identical in both branches so the card markup stays single-sourced.
const heroCard = heroAction
  ? (() => {
      const a = heroAction.action;
      const badge = statusBadge(a.status);
      return {
        label: readableType(a.type),
        title: a.title as string,
        badge: badge.label,
        tone: TONE_COLORS[badge.tone],
        href: `/t/${heroAction.slug}`,
      };
    })()
  : {
      label: 'Governance Action',
      title: 'Treasury Withdrawal',
      badge: 'Active',
      tone: TONE_COLORS.active,
      href: null as string | null,
    };

// A real action makes the card a link to its thread; the placeholder stays a
// plain (decorative) div.
const HeroCardTag = heroCard.href ? 'a' : 'div';

// Hero feature rows: each is a small icon plus a title and supporting line.
const heroFeatures = [
  {
    title: 'Governance Actions are imported automatically',
    body: 'Every on-chain action gets its own discussion space.',
    icon: 'auto',
  },
  {
    title: 'Public to read, signed to post.',
    body: 'Anyone can follow along; DReps, SPOs, CC members, and proposers post by wallet signature.',
    icon: 'shield',
  },
  {
    title: 'Better discussion. Better decisions.',
    body: 'Share perspectives, challenge ideas, and inform your vote.',
    icon: 'spark',
  },
];
---

<Layout
  title="DRepTalk - Cardano Governance Forum"
  description="The public deliberation layer for Cardano governance. DReps discuss every on-chain governance action in its own thread."
>
  <JsonLd data={websiteLd} />
  <JsonLd data={breadcrumbLd} />

  <section class="hero">
    <div class="hero__copy">
      <h1 class="hero__title reveal" style="--reveal-delay:0ms">
        Where DReps discuss <span class="grad-text">governance.</span>
      </h1>
      <p class="hero__subtitle reveal" style="--reveal-delay:60ms">
        DRepTalk is the public deliberation layer for Cardano governance.
      </p>

      <ul class="hero__features reveal" style="--reveal-delay:120ms">
        {heroFeatures.map((f) => (
          <li class="feature">
            <span class="feature__icon" aria-hidden="true">
              {f.icon === 'auto' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6" /><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M3 22v-6h6" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /></svg>
              )}
              {f.icon === 'shield' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
              )}
              {f.icon === 'spark' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3" /><path d="M12 18v3" /><path d="M5.6 5.6l2.1 2.1" /><path d="M16.3 16.3l2.1 2.1" /><path d="M3 12h3" /><path d="M18 12h3" /><circle cx="12" cy="12" r="3.5" /></svg>
              )}
            </span>
            <span class="feature__text">
              <strong class="feature__title">{f.title}</strong>
              <span class="feature__body">{f.body}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="hero__cta reveal" style="--reveal-delay:180ms">
        <a class="btn btn-primary" href="/c/governance-actions">Browse Governance Actions</a>
        {!user && <a class="btn btn-secondary" href="/login">Sign in to post</a>}
      </div>
    </div>

    <div class="hero__visual reveal" style="--reveal-delay:160ms" aria-hidden={heroCard.href ? undefined : 'true'}>
      <div class="hero-scene">
        <div class="hero-scene__glow" aria-hidden="true"></div>

        <svg class="hero-scene__rings" aria-hidden="true" viewBox="0 0 320 320" preserveAspectRatio="xMidYMid meet">
          <g class="ring-guides">
            <ellipse cx="160" cy="160" rx={ringActive.rx} ry={ringActive.ry} />
            <ellipse cx="160" cy="160" rx={ringGhost.rx} ry={ringGhost.ry} />
          </g>
          {showScene && (
            <g class="ring-links">
              {activeSlots.map((s, i) => (
                <line
                  x1="160"
                  y1="160"
                  x2={s.x * 320}
                  y2={s.y * 320}
                  style={`--enter-delay:${REVEAL_BASE_MS + i * REVEAL_STEP_MS}ms`}
                />
              ))}
            </g>
          )}
        </svg>

        {showScene && (
          <div class="hero-ghosts" aria-hidden="true">
            {ghostSlots.map((s, i) => {
              const g = hero.ghosts[i];
              return (
                <span class="ghost" style={`left:${s.x * 100}%; top:${s.y * 100}%; --enter-delay:${300 + i * 60}ms`}>
                  <Avatar seed={g.descriptor.identiconSeed ?? g.descriptor.authorId} imageHash={g.descriptor.imageHash} size={22} />
                </span>
              );
            })}
          </div>
        )}

        <HeroCardTag
          class="gov-card"
          href={heroCard.href}
          aria-label={heroCard.href ? `Latest governance action: ${heroCard.title}, ${heroCard.badge}` : undefined}
        >
          <span class="gov-card__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V10l7-5 7 5v11" /><path d="M9 21v-6h6v6" /><path d="M3 10h18" /></svg>
          </span>
          <span class="gov-card__label">{heroCard.label}</span>
          <span class="gov-card__title">{heroCard.title}</span>
          <span class="gov-card__badge" style={`--tone:${heroCard.tone}`}>{heroCard.badge}</span>
        </HeroCardTag>

        {showScene ? (
          <div class="hero-voters">
            {activeSlots.map((s, i) => {
              const p = hero.active[i];
              const kind = voteBadgeKind(p.vote);
              const label = kind === 'yes' ? 'Yes' : kind === 'no' ? 'No' : 'Abstain';
              return (
                <a
                  class:list={['pill', 'pill--vote', `vote-${kind}`]}
                  href={authorProfileHref(p.descriptor)}
                  style={`--px:${s.x * 100}; --py:${s.y * 100}; --enter-delay:${REVEAL_BASE_MS + i * REVEAL_STEP_MS}ms; --tone:${TONE_COLORS[voteTone(p.vote)]}`}
                  title={`${p.descriptor.displayName} voted ${label}`}
                  aria-label={`${p.descriptor.displayName} voted ${label}, view profile`}
                >
                  <Avatar seed={p.descriptor.identiconSeed ?? p.descriptor.authorId} imageHash={p.descriptor.imageHash} size={28} />
                  <span class="pill__badge">
                    <span class="pill__badge-icon" aria-hidden="true">
                      {kind === 'yes' && (
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      )}
                      {kind === 'no' && (
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                      )}
                      {kind === 'abstain' && (
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /></svg>
                      )}
                    </span>
                    <span class="pill__badge-label">{label}</span>
                  </span>
                  <span class="pill__name">{p.descriptor.displayName}</span>
                </a>
              );
            })}
          </div>
        ) : (
          activeSlots.map((s) => (
            <span class="pill pill--placeholder" aria-hidden="true" style={`left:${s.x * 100}%; top:${s.y * 100}%`}>
              <span class="pill__avatar"></span>
              <span class="pill__bubble"></span>
            </span>
          ))
        )}
      </div>

      {showScene && (
        <div class="hero-status" aria-hidden="true">
          <span class="hero-status__text">DReps are casting their votes...</span>
          <span class="hero-status__dots">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </span>
        </div>
      )}
    </div>
  </section>

  <aside class="announce reveal" style="--reveal-delay:220ms" aria-label="Open source">
    <span class="announce__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.75.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
    </span>
    <div class="announce__text">
      <strong class="announce__title">Open source, by design</strong>
      <span class="announce__body">DRepTalk is built in the open so the community can verify and shape it.</span>
    </div>
    <a class="announce__link" href="https://github.com/katomm/dreptalk.com" rel="noopener" target="_blank">View on GitHub</a>
  </aside>

  <section id="categories" class="categories" aria-labelledby="categories-heading">
    <div class="categories__head">
      <div class="categories__head-row">
        <h2 id="categories-heading">Discussions</h2>
      </div>
      <p>Browse categories and the latest activity across the forum.</p>
    </div>

    <div class="discussions-grid">
      <section aria-label="Categories">
        <h3 class="section-label">Categories</h3>
        <div style="display:flex;flex-direction:column;">
          {categories.map((c) => {
            const s = stats.get(c.slug);
            return (
              <a href={`/c/${c.slug}`} style="border-bottom:1px solid var(--border);padding:0.75rem 0;text-decoration:none;color:inherit;display:block;">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <span aria-hidden="true" style={`width:0.5rem;height:0.5rem;border-radius:999px;flex-shrink:0;background:${c.kind === 'governance' ? 'var(--accent)' : 'var(--muted)'};`}></span>
                  <span style="font-weight:600;color:var(--fg);">{c.name}</span>
                  <span style="margin-left:auto;font-size:0.8125rem;color:var(--muted);">{s?.topicCount ?? 0}</span>
                </div>
                <p style="margin:0.3rem 0 0 1rem;font-size:0.8125rem;color:var(--muted);">{c.description}</p>
                {s?.lastPostAt && (
                  <p style="margin:0.2rem 0 0 1rem;font-size:0.75rem;color:var(--muted);">Last activity {formatRelativeTime(s.lastPostAt, now)}</p>
                )}
              </a>
            );
          })}
        </div>
      </section>

      <ActivityFeed
        events={feed}
        now={now}
        title="Latest activity"
        subtitle="A summary of what's happening in governance."
        viewAllHref="/discussions"
      />
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ----------------------------------------------------------- */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 3rem;
    padding: 3rem 0 2.5rem;
    /* The .reveal animation leaves a residual transform on later sections, each
       creating a stacking context; give the hero its own so the entry dropdown
       overlays them instead of being painted under the announcement banner. */
    position: relative;
    z-index: 1;
  }
  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: normal;
    margin: 0;
    max-width: 16ch;
  }
  .hero__subtitle {
    margin: 1.1rem 0 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
  }

  .hero__features {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .feature {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .feature__icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .feature__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .feature__title {
    font-weight: 600;
    font-size: 0.975rem;
    color: var(--fg);
    line-height: 1.35;
  }
  .feature__body {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .hero__cta {
    margin-top: 2rem;
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ---- Hero visual (network of participants around a governance action) -- */
  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero-scene {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
  }
  .hero-scene__glow {
    position: absolute;
    inset: 4%;
    border-radius: 28px;
    background:
      radial-gradient(45% 45% at 35% 30%, rgba(139, 92, 246, 0.28), transparent 70%),
      radial-gradient(45% 45% at 70% 40%, rgba(59, 130, 246, 0.24), transparent 70%),
      radial-gradient(45% 50% at 55% 72%, rgba(45, 212, 191, 0.22), transparent 70%);
    filter: blur(6px);
  }
  .hero-scene__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Subtle dashed guide ellipses that give the ring structure without the old
     heavy gradient lines. */
  .ring-guides ellipse {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    opacity: 0.7;
  }
  /* One faint dashed spoke per active voter, from the card to the voter. */
  .ring-links line {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.28;
  }

  .gov-card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64%;
    min-width: 210px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'icon label label'
      'icon title badge';
    align-items: center;
    gap: 0.15rem 0.65rem;
    padding: 1rem 1.1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  /* When backed by a real action the card links to its thread. */
  a.gov-card:hover,
  a.gov-card:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--accent);
    outline: none;
  }
  .gov-card__icon {
    grid-area: icon;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    color: #fff;
    background: var(--grad);
  }
  .gov-card__label {
    grid-area: label;
    min-width: 0;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gov-card__title {
    grid-area: title;
    font-weight: 700;
    font-size: 1rem;
    color: var(--fg);
    line-height: 1.2;
    /* Real proposal titles vary in length; clamp to two lines so the card keeps
       its shape. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .gov-card__badge {
    grid-area: badge;
    justify-self: end;
    font-size: 0.65rem;
    font-weight: 600;
    /* --tone is set inline from the action's status badge color. */
    color: var(--tone, var(--accent));
    background: color-mix(in srgb, var(--tone, var(--accent)) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone, var(--accent)) 38%, transparent);
    border-radius: 999px;
    padding: 0.1rem 0.45rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* The active voters live in an overlay layer that fills the scene; on desktop
     each pill is absolutely positioned on the ring from its --px/--py fractions.
     The layer itself ignores pointer events so only the pills are interactive. */
  .hero-voters {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-voters .pill {
    pointer-events: auto;
  }

  /* Active voter: a centered avatar with a vote-badge chip tucked under it; the
