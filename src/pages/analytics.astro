          <EpochSeriesChart title="DReps for 50% of delegated power" points={metricSeries(chartStats, 'minCoalition50', starts.minCoalition50)} sinceEpoch={starts.minCoalition50} note="Fewer DReps means more concentrated." />
          <EpochSeriesChart title="DReps for 67% of delegated power" points={metricSeries(chartStats, 'minCoalition67', starts.minCoalition67)} sinceEpoch={starts.minCoalition67} note="Fewer DReps means more concentrated." />
        </div>
      </section>
    )}
  </section>

  <p class="hub-back"><a href="/dreps/">Browse the DRep directory</a></p>
</Layout>

