            {droppedActions.map((d) => (
              <li class="hub-dropped__row">
                <span class="hub-dropped__title">{d.href ? <a href={d.href}>{d.title ?? readableType(d.type)}</a> : (d.title ?? readableType(d.type))}</span>
                <span class="hub-dropped__meta">
                  <span class="hub-dropped__type">{readableType(d.type)}</span>
                  {d.droppedEpoch != null && <span class="hub-dropped__epoch">Dropped in epoch {d.droppedEpoch}</span>}
                  {d.epochsLeft != null && <span class="hub-dropped__early">{d.epochsLeft} {d.epochsLeft === 1 ? 'epoch' : 'epochs'} of voting left</span>}
                </span>
                <p class="hub-dropped__reason">
                  {d.supersededBy ? (
                    <>Superseded by {d.supersededBy.href ? <a href={d.supersededBy.href}>{d.supersededBy.title ?? readableType(d.supersededBy.type)}</a> : (d.supersededBy.title ?? readableType(d.supersededBy.type))}, enacted{d.supersededBy.epoch != null && ` in epoch ${d.supersededBy.epoch}`}. Both actions extended the same predecessor, so enacting one left the other no path to enactment.</>
                  ) : (
                    'The chain records no enacted action that took its place, so this page does not name a reason.'
                  )}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="hub-throughput__footnote">Closed is the outcome of info actions, which conclude without enactment. Timing is counted in epochs because decisions are recorded per epoch.{throughput.dropped > droppedActions.length && ` ${throughput.dropped - droppedActions.length} further dropped ${throughput.dropped - droppedActions.length === 1 ? 'action is' : 'actions are'} not listed.`}{throughput.active > 0 && ` ${throughput.active} ${throughput.active === 1 ? 'action is' : 'actions are'} still open.`}</p>
    </div>
  </section>
  )}

  {commonSince != null && (
    <p class="hub-pagenote">The trend charts on this page draw data from epoch {commonSince} on, the first epoch these metrics can be measured reliably. A chart whose series begins later states its own start. <a href="/help/governance-analytics/">Why charts start where they start</a></p>
