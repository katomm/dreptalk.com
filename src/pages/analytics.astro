---
// Public governance analytics hub: network-wide health, participation,
// concentration and the default delegation options, tracked per epoch. All
// reads are D1 only (no Koios calls here), and every representative metric
// excludes the two predefined auto-voting options (see dreps/special.ts),
// which get their own default-options layer below instead.
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import DrepStatIcon from '@/components/DrepStatIcon.astro';
import DrepConcentration from '@/components/DrepConcentration.tsx';
import EpochSeriesChart from '@/components/EpochSeriesChart.astro';
import { runtimeEnv } from '@/lib/api/response';
import { cacheControlForSynced, formatAda, formatAdaCompact } from '@/lib/forum/view.js';
import { listEpochStats } from '@/lib/db/governanceEpochStats.js';
import { getDefaultDelegationCurrent } from '@/lib/db/defaultDelegation.js';
import { getDrepActivityBreakdown } from '@/lib/db/drepActivityBreakdown.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { listDrepsForConcentration } from '@/lib/db/dreps.js';
import { listDecidedActionsForRepresentation } from '@/lib/db/effectiveRepresentation.js';
import { listDrepVotePowersByAction } from '@/lib/db/drepVotes.js';
import { listDecidedVoteChangeRows, countVoteChangeCoverage } from '@/lib/db/voteChangeStats.js';
import { listDecidedActionRationaleCoverage, countRationaleAddedViaRevote } from '@/lib/db/rationaleCoverage.js';
import { listDecidedCcActions, listDecidedCcVoteRows, getCommitteeTimeline, type CcVoteRow } from '@/lib/db/committee.js';
import { getAllCcMemberNames } from '@/lib/db/ccMemberName.js';
import { readableType, TONE_BAR_COLORS } from '@/lib/governance/view.js';
import { buildCcNameIndex } from '@/lib/governance/ccNames.js';
import { computeConcentration } from '@/lib/dreps/concentration.js';
import { buildThresholdMarkers, buildCoalitionTable } from '@/lib/dreps/thresholdMarkers.js';
import { seriesStartFromRows } from '@/lib/analytics/epochStatsContract.js';
import { buildVitals, contiguousPrefix, defaultOptionsComparison, metricSeries, netChange, rowBeforeEpoch } from '@/lib/analytics/hubView.js';
import { buildEffRep } from '@/lib/analytics/effRepView.js';
import { buildVoteChangeView } from '@/lib/analytics/voteChangeView.js';
import { buildRationaleCoverage } from '@/lib/analytics/rationaleCoverageView.js';
import { buildCcPanel, selectExtremes } from '@/lib/analytics/ccPanelView.js';
import { ogCardVersion } from '@/lib/og/version.js';

// The site's governance actions list route, same href as the header nav's
// "Governance Actions" link (src/lib/config/nav.ts).
const ACTIONS_LIST_HREF = '/c/governance-actions/';

const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;
if (db) Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));

const [stats, defaults, activity, params, concRows, repActions] = db
  ? await Promise.all([
      listEpochStats(db),
      getDefaultDelegationCurrent(db),
      getDrepActivityBreakdown(db),
      getProtocolParams(db),
      listDrepsForConcentration(db),
      listDecidedActionsForRepresentation(db),
    ])
  : [[], { abstain: null, noConfidence: null }, null, null, [], []];

// Charts only ever draw the gapless head of the series: during the one-time
// epoch backfill the stored rows are a growing prefix plus the live current
// epoch, and a line across that hole would read as data. Once the backfill
// has drained, chartStats === stats and the note below disappears for good.
const chartStats = contiguousPrefix(stats);
const backfillGap = chartStats.length < stats.length;

// All starts are derivable from the already-loaded rows, so this resolves
// them in memory instead of sequential DB round-trips (chartStats is [] with
// no db, and seriesStartFromRows([], _) is null, same as before).
const starts = {
  totalDrepPower: seriesStartFromRows(chartStats, 'totalDrepPower'),
  poweredDrepCount: seriesStartFromRows(chartStats, 'poweredDrepCount'),
  delegatorTotal: seriesStartFromRows(chartStats, 'delegatorTotal'),
  abstainPower: seriesStartFromRows(chartStats, 'abstainPower'),
  ancPower: seriesStartFromRows(chartStats, 'ancPower'),
  gini: seriesStartFromRows(chartStats, 'gini'),
  top10SharePct: seriesStartFromRows(chartStats, 'top10SharePct'),
  minCoalition50: seriesStartFromRows(chartStats, 'minCoalition50'),
  minCoalition67: seriesStartFromRows(chartStats, 'minCoalition67'),
};

const current = stats.length > 0 ? stats[stats.length - 1] : null;
// The true previous epoch's row, never a positional neighbor: mid-backfill
// stats[length - 2] would be an ancient epoch and every delta would lie.
const prev = current ? rowBeforeEpoch(stats, current.epoch) : null;
const vitals = buildVitals(current, prev, params?.circulationLovelace ?? null);
// Per-action vote powers for the concentration read, one batched query for the
// listed actions. Completeness gating happens in the builder: an action with
// any missing per-vote power renders no half-count, never a zero.
const votePowers = db ? await listDrepVotePowersByAction(db, repActions.map((a) => a.id)) : undefined;
const effRep = buildEffRep(repActions, votePowers);

// Vote-change analytics over all decided actions with swept history: one read
// for the classified pairs, one for the coverage denominators and the
// unclassifiable-pair disclosure.
const [changeRows, changeCoverage] = db
  ? await Promise.all([listDecidedVoteChangeRows(db), countVoteChangeCoverage(db)])
  : [[], { decidedSwept: 0, decidedUnswept: 0, orphanPairs: 0 }];
const voteChanges = buildVoteChangeView(changeRows, changeCoverage);

// Rationale coverage over decided actions: one aggregate read plus the
// re-vote-added count. Quality is never claimed, coverage is measured.
const [coverageRows, revoteAdded] = db
  ? await Promise.all([listDecidedActionRationaleCoverage(db), countRationaleAddedViaRevote(db)])
  : [[], 0];
const rationaleCoverage = buildRationaleCoverage(coverageRows, revoteAdded);

// Constitutional Committee panel: batch CC reads plus the shared committee
// timeline and name index, aggregated with the exact per-action logic the
// GA pages use.
const [ccActions, ccVotesByAction, committee, ccNameRows] = db
  ? await Promise.all([
      listDecidedCcActions(db),
      listDecidedCcVoteRows(db),
      getCommitteeTimeline(db),
      getAllCcMemberNames(db),
    ])
  : [[], new Map<string, CcVoteRow[]>(), { members: [], hotToCold: new Map<string, string>() }, []];
const ccPanel = buildCcPanel({
  actions: ccActions,
  votesByAction: ccVotesByAction,
  members: committee.members,
  hotToCold: committee.hotToCold,
  nameIndex: buildCcNameIndex(ccNameRows, committee.hotToCold),
  currentEpoch: params?.epoch ?? null,
});
const shortCold = (hex: string): string => `${hex.slice(0, 10)}...`;
// Best and worst five members by participation share. Under ten members
// everything is "top" and there is no separate bottom list.
const ccExtremes = selectExtremes(ccPanel.members, 5);
const tenureLabel = (t: { from: number; to: number | null }): string =>
  t.to == null ? `since epoch ${t.from}` : `epochs ${t.from} to ${t.to}`;

const fmtShare = (pct: number | null): string => (pct != null ? `${pct.toFixed(1)}%` : 'n/a');
// Medians can end in .5 with an even action count, render as-is.
const fmtCount = (n: number): string => (Number.isInteger(n) ? String(n) : n.toFixed(1));

// Parse lovelace defensively so a single malformed stored value cannot 500 the
// page (Koios writes plain integer strings, but the column is untrusted text).
// Same helper as the concentration donut on dreps/index.astro.
const toLovelace = (s: string | null): bigint => {
  try {
    return BigInt(s ?? '0');
  } catch {
    return 0n;
  }
};
const concentration = computeConcentration(
  concRows.map((r) => ({ drepId: r.drepId, name: r.name, slug: r.slug, power: toLovelace(r.votingPower) })),
);
const { markers, defaultThresholdPct, thresholdsAsOf } = buildThresholdMarkers(params);
// Smallest group per threshold, from the same distribution the island renders.
const coalitionRows = buildCoalitionTable(params, concentration.byPercent);

const abstainSeries = metricSeries(chartStats, 'abstainPower', starts.abstainPower);
const ancSeries = metricSeries(chartStats, 'ancPower', starts.ancPower);
const abstainDelta = netChange(
  defaults.abstain?.delegatorCount ?? null,
  prev?.abstainDelegators ?? null,
  (n) => n.toLocaleString('en-US'),
);
const ancDelta = netChange(
  defaults.noConfidence?.delegatorCount ?? null,
  prev?.ancDelegators ?? null,
  (n) => n.toLocaleString('en-US'),
);
// Non-null only once the two default pools and the represented total all
// parse, so the comparison line quietly disappears rather than half-render.
const defaultsComparison = defaultOptionsComparison(
  defaults.abstain?.votingPower,
  defaults.noConfidence?.votingPower,
  current?.totalDrepPower ?? null,
);

const fmtAdaCompact = (v: number) => formatAdaCompact(String(Math.round(v)));
const fmtTwoDec = (v: number) => v.toFixed(2);
const hasBackbone = current != null;

// Cache-busted by the same stats fields the OG card renders, so a scraper's
// cached image refreshes whenever any of those fields actually changes.
const ogImage = current
  ? `/og/analytics.png?v=${ogCardVersion([current.epoch, current.poweredDrepCount, current.recentlyVotingDrepCount, current.totalDrepPower, current.abstainPower])}`
  : undefined;

// formatAda renders a NULL amount as "0 ₳", which would misreport an absent
// reading as a real zero. A missing votingPower (fresh DB, or the row simply
// not synced yet) instead gets the same pending wording the delegator count
// already uses below.
const powerLabel = (votingPower: string | null | undefined): string =>
  votingPower != null ? formatAda(votingPower) : 'Voting power pending';

// The two default-option cards, grouped for the template so the grid renders
// from one map instead of two near-identical blocks.
const defaultCards = [
  {
    title: 'Always abstain',
    ariaLabel: 'Always abstain voting power per epoch',
    power: powerLabel(defaults.abstain?.votingPower),
    delegatorCount: defaults.abstain?.delegatorCount ?? null,
    chip: abstainDelta,
    series: abstainSeries,
    sinceEpoch: starts.abstainPower,
  },
  {
    title: 'Always no confidence',
    ariaLabel: 'Always no confidence voting power per epoch',
    power: powerLabel(defaults.noConfidence?.votingPower),
    delegatorCount: defaults.noConfidence?.delegatorCount ?? null,
    chip: ancDelta,
    series: ancSeries,
    sinceEpoch: starts.ancPower,
  },
];

// DRep activity as two composition bars, each pair of segments summing to
// the registered count. Guards the division so a fresh, empty table renders
// zero-width bars instead of NaN.
const activityBars = activity
  ? [
      {
        title: 'Registration state',
        segments: [
          { label: 'Active registrations', value: activity.active },
          { label: 'Inactive or retired', value: activity.inactiveCount },
        ],
        sub: `${activity.powered.toLocaleString('en-US')} of the active registrations hold delegated power`,
      },
      {
        title: 'Voting history',
        segments: [
          { label: 'Ever voted on chain', value: activity.everVoted },
          { label: 'Never voted', value: Math.max(0, activity.registered - activity.everVoted) },
        ],
      },
    ].map((bar) => ({
      ...bar,
      segments: bar.segments.map((seg) => ({
        ...seg,
        pct: activity.registered > 0 ? Math.min(100, (seg.value / activity.registered) * 100) : 0,
      })),
    }))
  : [];
---
<Layout
  title="Cardano Governance Analytics - DRepTalk"
  description="Health, participation, concentration and the default delegation options of Cardano governance, tracked per epoch."
  wide
  ogImage={ogImage}
>
  <nav class="hub-crumbs" aria-label="Breadcrumb">
    <a href="/">DRepTalk</a>
    <span aria-hidden="true">/</span>
    <span>Governance analytics</span>
  </nav>

  <h1>Governance analytics</h1>
  <p class="hub-intro">How healthy, representative and decentralized Cardano governance is right now, and how it moves per epoch. <a href="/help/governance-analytics/">How to read this page</a></p>

  {vitals.length > 0 && (
    <div class="drep-stats">
      {vitals.map((card) => (
        <div class={`drep-stat${card.alt ? ' drep-stat--alt' : ''}`}>
          <span class="drep-stat__icon"><DrepStatIcon name={card.icon} /></span>
          <span class="drep-stat__body">
            <span class="drep-stat__label">{card.label}</span>
            <span class="drep-stat__value">{card.value}</span>
            {card.trend && (
              <span class={`drep-stat__delta drep-stat__delta--${card.trend.direction}`}>
                {card.trend.direction !== 'flat' && (
                  <span class="drep-stat__arrow" aria-hidden="true">{card.trend.direction === 'up' ? '↑' : '↓'}</span>
                )}
                {card.trend.label}
              </span>
            )}
            {card.sub && <span class="drep-stat__sub">{card.sub}</span>}
          </span>
        </div>
      ))}
    </div>
  )}
  {current && <p class="hub-asof">As of epoch {current.epoch}</p>}
  {!hasBackbone && (
    <p class="hub-empty">Per-epoch data starts filling in with the next sync run. Vitals and the per-epoch trend charts fill in once the first epoch is recorded.</p>
  )}
  {backfillGap && (
    <p class="hub-empty">Historical epochs are still being backfilled. The trend charts show the epochs recorded so far and complete on their own over the next days, and panels that need the missing epochs appear as they fill in.</p>
  )}

  <section class="hub-chapter" aria-labelledby="chapter-today-title">
    <header class="hub-chapter__head">
      <p class="hub-chapter__eyebrow">Chapter</p>
      <h2 id="chapter-today-title" class="hub-chapter__title">Governance today</h2>
      <p class="hub-chapter__intro">The current state of DRep governance, the two default options kept apart, and how the core figures moved epoch by epoch.</p>
    </header>

    <section class="hub-defaults" aria-labelledby="hub-defaults-title">
      <h3 id="hub-defaults-title">The default options</h3>
      <p class="hub-defaults__lede">Not everyone delegates to a person. These two predefined options hold real voting weight, and they are kept apart from every DRep statistic on this site. <a href="/help/default-delegation-options/">What they do</a></p>
      <div class="hub-defaults__grid">
        {defaultCards.map((opt) => (
          <div class="hub-defaults__card">
            <h4 class="hub-defaults__name">{opt.title}</h4>
            <p class="hub-defaults__power">{opt.power}</p>
            <p class="hub-defaults__meta">
              <span>
                {opt.delegatorCount != null
                  ? `${opt.delegatorCount.toLocaleString('en-US')} ${opt.delegatorCount === 1 ? 'delegator' : 'delegators'}`
                  : 'Delegator count pending'}
              </span>
              {opt.chip && (
                <span class={`hub-defaults__chip hub-defaults__chip--${opt.chip.direction}`}>{opt.chip.label}</span>
              )}
            </p>
            <EpochSeriesChart title="Voting power" ariaLabel={opt.ariaLabel} points={opt.series} format={fmtAdaCompact} sinceEpoch={opt.sinceEpoch} />
          </div>
        ))}
      </div>
      {defaultsComparison && (
        <p class="hub-defaults__compare">Default options hold {defaultsComparison.defaultsLabel}, compared with {defaultsComparison.reprLabel} delegated to representative DReps.</p>
      )}
      <p class="hub-defaults__note">Changes are net movement per epoch. Arrivals and departures inside an epoch are not individually visible on chain aggregates, so this page never claims inflow or outflow.</p>
    </section>

    {hasBackbone && (
      <section class="hub-trends" aria-labelledby="hub-trends-title">
        <h3 id="hub-trends-title">Per-epoch trends</h3>
        <div class="hub-trends__grid">
          <EpochSeriesChart title="Delegated voting power" points={metricSeries(chartStats, 'totalDrepPower', starts.totalDrepPower)} format={fmtAdaCompact} sinceEpoch={starts.totalDrepPower} />
          <EpochSeriesChart title="DReps holding delegated power" points={metricSeries(chartStats, 'poweredDrepCount', starts.poweredDrepCount)} sinceEpoch={starts.poweredDrepCount} />
          <EpochSeriesChart title="Delegators" points={metricSeries(chartStats, 'delegatorTotal', starts.delegatorTotal)} sinceEpoch={starts.delegatorTotal} />
        </div>
      </section>
    )}
  </section>

  <section class="hub-chapter" aria-labelledby="chapter-representation-title">
    <header class="hub-chapter__head">
      <p class="hub-chapter__eyebrow">Chapter</p>
      <h2 id="chapter-representation-title" class="hub-chapter__title">Representation and participation</h2>
      <p class="hub-chapter__intro">How much of the delegated power actually shows up in votes, and who takes part.</p>
    </header>

    {effRep.rows.length > 0 && (
      <section class="hub-effrep" aria-labelledby="hub-effrep-title">
        <h3 id="hub-effrep-title">Effective representation</h3>
        <p class="hub-effrep__lede">Across the last {effRep.rows.length} decided actions, a median of {fmtShare(effRep.medianPowerSharePct)} of the delegated voting power was actually represented in the vote.{effRep.medianHalfCount != null && ` A median of ${fmtCount(effRep.medianHalfCount)} DReps was enough to cast half of the voted power.`}</p>
        <ul class="hub-effrep__rows">
          {effRep.rows.slice(0, 6).map((row) => (
            <li class="hub-effrep__row">
              <div class="hub-effrep__head">
                <span class="hub-effrep__title">
                  {row.href ? <a href={row.href}>{row.title}</a> : row.title}
                </span>
                <span class="hub-effrep__type">{readableType(row.type)}</span>
                <span class="hub-effrep__epoch">Epoch {row.decidedEpoch}</span>
              </div>
              <div class="hub-effrep__meter">
                <span class="hub-effrep__bar" aria-hidden="true"><span class="hub-effrep__fill" style={`width:${row.powerSharePct.toFixed(1)}%`}></span></span>
                <span class="hub-effrep__value">{fmtShare(row.powerSharePct)}</span>
              </div>
              {(row.countSharePct != null || row.halfCount != null) && (
                <p class="hub-effrep__note">{row.countSharePct != null && `${fmtShare(row.countSharePct)} of DReps voted`}{row.countSharePct != null && row.halfCount != null && ', '}{row.halfCount != null && `${row.halfCount} of ${row.voterCount} voters cast half of the voted power`}</p>
              )}
            </li>
          ))}
        </ul>
        <p class="hub-effrep__more">Showing the six most recent decided actions. <a href={ACTIONS_LIST_HREF}>View all governance actions</a></p>
        <p class="hub-effrep__footnote">Denominator: the delegated voting power in each action's decision epoch, the predefined default options excluded. Concentration reads use the voting power each DRep voted with and appear only when it is recorded for every vote.{effRep.skipped > 0 && ` ${effRep.skipped} older actions without epoch data are not shown.`}</p>
      </section>
    )}

    {activity && (
      <section class="hub-activity" aria-labelledby="hub-activity-title">
        <h3 id="hub-activity-title">DRep activity</h3>
        {activityBars.map((bar) => (
          <div class="hub-activity__group">
            <p class="hub-activity__title">{bar.title}</p>
            <div class="hub-activity__bar">
              {bar.segments.map((seg) => (
                <span class="hub-activity__seg" style={`width:${seg.pct.toFixed(1)}%`}></span>
              ))}
            </div>
            <ul class="hub-activity__legend">
              {bar.segments.map((seg) => (
                <li class="hub-activity__legend-item"><span class="hub-activity__legend-dot" aria-hidden="true"></span>{seg.label}: {seg.value.toLocaleString('en-US')}</li>
              ))}
            </ul>
            {bar.sub && <p class="hub-activity__sub">{bar.sub}</p>}
          </div>
        ))}
        <p class="hub-activity__stake">Stake still delegated to inactive DReps: {formatAda(activity.inactiveStake)} across {activity.inactiveCount.toLocaleString('en-US')} DReps.</p>
        <p class="hub-activity__note">Definitions: active registrations follow the on-chain registration state, voted counts any on-chain vote including later-changed ones, counts are live as of the latest sync.</p>
      </section>
    )}

    {ccPanel.considered > 0 && (
      <section class="hub-cc" aria-labelledby="hub-cc-title">
        <h3 id="hub-cc-title">Constitutional Committee</h3>
        <p class="hub-cc__lede">Across {ccPanel.considered} decided actions the committee could vote on, a median of {fmtShare(ccPanel.medianTurnoutPct)} of its members cast a vote.{ccPanel.splitCount > 0 && ` ${ccPanel.splitCount} ${ccPanel.splitCount === 1 ? 'action' : 'actions'} saw a split committee.`}{ccPanel.verdictBasis > 0 && ` ${ccPanel.belowThreshold} of ${ccPanel.verdictBasis} finished below the committee's approval threshold.`}</p>
        {ccPanel.medianLatencyDays != null && (
          <p class="hub-cc__latency">Committee votes came a median of {fmtCount(ccPanel.medianLatencyDays)} days after an action was submitted.</p>
        )}
        {ccExtremes.total > 0 && (
          <>
            <div class="hub-cc__lists">
              <div>
                <h4 class="hub-cc__subtitle">Highest participation</h4>
                <ul class="hub-cc__members">
                  {ccExtremes.top.map((m) => (
                    <li class="hub-cc__member">
                      <div class="hub-cc__member-head">
                        <span class="hub-cc__member-name">{m.name ?? shortCold(m.coldKeyHex)}</span>
                        <span class="hub-cc__member-tenure">{tenureLabel(m.tenure)}</span>
                        <span class="hub-cc__member-value">{m.voted} of {m.eligible}</span>
                      </div>
                      <div class="hub-cc__raster" role="img" aria-label={`Voted on ${m.voted} of ${m.eligible} eligible actions, oldest to newest`}>
                        {m.sequence.map((s) => (
                          <span class={`hub-cc__dot hub-cc__dot--${s}`}></span>
                        ))}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
              {ccExtremes.bottom.length > 0 && (
                <div>
                  <h4 class="hub-cc__subtitle">Lowest participation</h4>
                  <ul class="hub-cc__members">
                    {ccExtremes.bottom.map((m) => (
                      <li class="hub-cc__member">
                        <div class="hub-cc__member-head">
                          <span class="hub-cc__member-name">{m.name ?? shortCold(m.coldKeyHex)}</span>
                          <span class="hub-cc__member-tenure">{tenureLabel(m.tenure)}</span>
                          <span class="hub-cc__member-value">{m.voted} of {m.eligible}</span>
                        </div>
                        <div class="hub-cc__raster" role="img" aria-label={`Voted on ${m.voted} of ${m.eligible} eligible actions, oldest to newest`}>
                          {m.sequence.map((s) => (
                            <span class={`hub-cc__dot hub-cc__dot--${s}`}></span>
                          ))}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            <p class="hub-cc__raster-note">Each square is one decided action from the oldest to the newest, filled when the member voted, outlined when eligible without a vote, faded outside the member's eligibility window.</p>
          </>
        )}
        <p class="hub-cc__footnote">Eligibility follows the committee membership at each action's tally epoch, and only a member's final vote counts.{ccPanel.skipped > 0 && ` ${ccPanel.skipped} actions without a resolvable committee are not counted.`}{ccPanel.verdictBasis < ccPanel.considered && ` The threshold reading covers ${ccPanel.verdictBasis} actions with a frozen committee threshold.`}</p>
      </section>
    )}
  </section>

  <section class="hub-chapter" aria-labelledby="chapter-accountability-title">
    <header class="hub-chapter__head">
      <p class="hub-chapter__eyebrow">Chapter</p>
      <h2 id="chapter-accountability-title" class="hub-chapter__title">Accountability and behavior</h2>
      <p class="hub-chapter__intro">What DReps do beyond the vote itself: reconsidering positions and publishing rationales.</p>
    </header>

    {voteChanges.decidedSwept > 0 && voteChanges.changedCount + voteChanges.samePositionCount > 0 && (
      <section class="hub-votechange" aria-labelledby="hub-votechange-title">
        <h3 id="hub-votechange-title">Changed votes</h3>
        <p class="hub-votechange__lede">Across {voteChanges.decidedSwept} decided actions, {voteChanges.actionsWithChange} saw at least one DRep change their position. {voteChanges.changedCount} votes changed position in total, while {voteChanges.samePositionCount} re-votes kept the voter's position.</p>
        <div class="hub-cbar-group">
          {voteChanges.changedCount > 0 && (
            <div class="hub-cbar">
              <p class="hub-cbar__title">Where changed votes moved</p>
              <div class="hub-cbar__track" role="img" aria-label={`${voteChanges.toYes} changed to yes, ${voteChanges.toNo} to no, ${voteChanges.toAbstain} to abstain`}>
                <span class="hub-cbar__seg" style={`width:${((voteChanges.toYes / voteChanges.changedCount) * 100).toFixed(1)}%;background:${TONE_BAR_COLORS.positive}`}></span>
                <span class="hub-cbar__seg" style={`width:${((voteChanges.toNo / voteChanges.changedCount) * 100).toFixed(1)}%;background:${TONE_BAR_COLORS.negative}`}></span>
                <span class="hub-cbar__seg" style={`width:${((voteChanges.toAbstain / voteChanges.changedCount) * 100).toFixed(1)}%;background:${TONE_BAR_COLORS.neutral}`}></span>
              </div>
              <ul class="hub-cbar__legend">
                <li class="hub-cbar__legend-item"><span class="hub-cbar__dot" style={`background:${TONE_BAR_COLORS.positive}`}></span>To yes: {voteChanges.toYes}</li>
                <li class="hub-cbar__legend-item"><span class="hub-cbar__dot" style={`background:${TONE_BAR_COLORS.negative}`}></span>To no: {voteChanges.toNo}</li>
                <li class="hub-cbar__legend-item"><span class="hub-cbar__dot" style={`background:${TONE_BAR_COLORS.neutral}`}></span>To abstain: {voteChanges.toAbstain}</li>
              </ul>
            </div>
          )}
          {voteChanges.changedCount + voteChanges.samePositionCount > 0 && (
            <div class="hub-cbar">
              <p class="hub-cbar__title">Re-votes</p>
              <div class="hub-cbar__track" role="img" aria-label={`Position changed ${voteChanges.changedCount}, position kept ${voteChanges.samePositionCount}`}>
                <span class="hub-cbar__seg hub-cbar__seg--accent" style={`width:${((voteChanges.changedCount / (voteChanges.changedCount + voteChanges.samePositionCount)) * 100).toFixed(1)}%`}></span>
                <span class="hub-cbar__seg hub-cbar__seg--kept" style={`width:${((voteChanges.samePositionCount / (voteChanges.changedCount + voteChanges.samePositionCount)) * 100).toFixed(1)}%`}></span>
              </div>
              <ul class="hub-cbar__legend">
                <li class="hub-cbar__legend-item"><span class="hub-cbar__dot hub-cbar__dot--accent"></span>Position changed: {voteChanges.changedCount}</li>
                <li class="hub-cbar__legend-item"><span class="hub-cbar__dot hub-cbar__dot--kept"></span>Position kept: {voteChanges.samePositionCount}</li>
              </ul>
            </div>
          )}
        </div>
        {voteChanges.topActions.length > 0 && (
          <>
            <h4 class="hub-votechange__subtitle">Most reconsidered actions</h4>
            <ul class="hub-votechange__rows">
              {voteChanges.topActions.map((a) => (
                <li class="hub-votechange__row">
                  <span class="hub-votechange__title">{a.href ? <a href={a.href}>{a.title}</a> : a.title}</span>
                  <span class="hub-votechange__type">{readableType(a.type)}</span>
                  <span class="hub-votechange__epoch">Epoch {a.decidedEpoch}</span>
                  <span class="hub-votechange__count">{a.changedCount} changed</span>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="hub-votechange__footnote">Counts cover decided actions with a fully swept vote history and compare each voter's first recorded vote with the final one.{voteChanges.decidedUnswept > 0 && ` ${voteChanges.decidedUnswept} decided actions are still queued for the sweep.`}{voteChanges.orphanPairs > 0 && ` ${voteChanges.orphanPairs} re-votes whose final vote is not on record are left out.`}</p>
      </section>
    )}

    {rationaleCoverage.countPct != null && (
      <section class="hub-rationale" aria-labelledby="hub-rationale-title">
        <h3 id="hub-rationale-title">Vote rationales</h3>
        <div class="hub-tiles">
          <div class="hub-tile">
            <p class="hub-tile__value">{fmtShare(rationaleCoverage.countPct)}</p>
            <p class="hub-tile__label">Votes with a rationale link</p>
            <p class="hub-tile__sub">{rationaleCoverage.totalWithRationale.toLocaleString('en-US')} of {rationaleCoverage.totalVotes.toLocaleString('en-US')} votes</p>
          </div>
          {rationaleCoverage.powerPct != null && (
            <div class="hub-tile">
              <p class="hub-tile__value">{fmtShare(rationaleCoverage.powerPct)}</p>
              <p class="hub-tile__label">Voting power with a rationale link</p>
              <p class="hub-tile__sub">weighted by the voting power behind each vote</p>
            </div>
          )}
        </div>
        {rationaleCoverage.revoteAdded > 0 && (
          <p class="hub-rationale__lede">{rationaleCoverage.revoteAdded.toLocaleString('en-US')} rationales arrived later through a re-vote.</p>
        )}
        {rationaleCoverage.epochSeries.length > 1 && (
          <div class="hub-rationale__chart">
            <EpochSeriesChart title="Coverage of decided actions" ariaLabel="Median rationale coverage per decision epoch" points={rationaleCoverage.epochSeries} format={fmtShare} />
          </div>
        )}
        {rationaleCoverage.byType.length > 1 && (
          <ul class="hub-rationale__types">
            {rationaleCoverage.byType.map((t) => (
              <li class="hub-rationale__type"><span class="hub-rationale__type-name">{readableType(t.type)}</span><span class="hub-rationale__type-value">{fmtShare(t.medianPct)} median, {t.actions} {t.actions === 1 ? 'action' : 'actions'}</span></li>
            ))}
          </ul>
        )}
        {rationaleCoverage.best.length > 0 && (
          <div class="hub-rationale__lists">
            <div>
              <h4 class="hub-rationale__subtitle">Best covered</h4>
              <ul class="hub-rationale__rows">
                {rationaleCoverage.best.map((x) => (
                  <li class="hub-rationale__row"><span class="hub-rationale__row-title">{x.href ? <a href={x.href}>{x.title}</a> : x.title}</span><span class="hub-rationale__row-value">{fmtShare(x.pct)} of {x.votes}</span></li>
                ))}
              </ul>
            </div>
            {rationaleCoverage.worst.length > 0 && (
              <div>
                <h4 class="hub-rationale__subtitle">Least covered</h4>
                <ul class="hub-rationale__rows">
                  {rationaleCoverage.worst.map((x) => (
                    <li class="hub-rationale__row"><span class="hub-rationale__row-title">{x.href ? <a href={x.href}>{x.title}</a> : x.title}</span><span class="hub-rationale__row-value">{fmtShare(x.pct)} of {x.votes}</span></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
        <p class="hub-rationale__footnote">Coverage counts the rationale link attached to the vote on chain. A linked document is not always retrievable, so an action can read higher here than the readable rationales on its own page. Coverage measures presence, not quality.{rationaleCoverage.powerExcluded > 0 && ` The power-weighted figure leaves out ${rationaleCoverage.powerExcluded} actions with incomplete per-vote power.`}{rationaleCoverage.belowFloor > 0 && ` Best and least covered consider actions with at least 20 votes, ${rationaleCoverage.belowFloor} smaller ones are not ranked.`}</p>
      </section>
    )}
  </section>

  <section class="hub-chapter" aria-labelledby="chapter-decentralization-title">
    <header class="hub-chapter__head">
      <p class="hub-chapter__eyebrow">Chapter</p>
      <h2 id="chapter-decentralization-title" class="hub-chapter__title">Decentralization</h2>
