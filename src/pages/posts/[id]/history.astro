---
// src/pages/posts/[id]/history.astro
// Public, zero-JS edit history for one post: the no-JS / crawler fallback behind
// the "(edited)" marker (the thread enhances that link into an inline modal).
// Renders the same diff the modal does, driven by GET parameters instead of JS.
//
// The rich diff is injected with set:html. Its input is body_html, sanitized at
// write time, and richDiff adds only <span> wrappers and the fixed diff classes.
// The source view is built as JSX so Astro escapes the markdown text itself.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import NotFound from '@/components/NotFound.astro';
import { getPostHistory } from '@/lib/db/forum.js';
import { isModerator } from '@/lib/auth/roles.js';
import { richDiff } from '@/lib/forum/htmlDiff.js';
import { clampVersionPair, formatVersionTime, statText, versionLabel } from '@/lib/forum/historyView.js';
import { lineDiffWithWords } from '@/lib/forum/lineDiff.js';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const db = env.DB as D1Database | undefined;
const history = id && db ? await getPostHistory(db, id) : null;

const user = Astro.locals.user;
const canSee =
  history &&
  (!history.hidden ||
    (!!user && (user.id === history.authorId || isModerator(user.roles))));

const notFound = !history || !canSee;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Gated on the same condition the template below uses to pick NotFound. A 404
// response must not run diff work over a hidden post's bodies at all, not just
// withhold the markup that shows it.
const versions = notFound || !history ? [] : history.versions;
const params = Astro.url.searchParams;
const pair = clampVersionPair(params.get('from'), params.get('to'), versions.length);
const diff = pair ? richDiff(versions[pair.from].bodyHtml, versions[pair.to].bodyHtml) : null;
// A body the parser refused. The source view needs no parser, so it still works.
const sourceView = params.get('view') === 'source' || !!diff?.degraded;
const sourceLines =
  sourceView && pair ? lineDiffWithWords(versions[pair.from].bodyMd, versions[pair.to].bodyMd) : [];
---

{notFound || !history ? (
  <NotFound noun="Post history" />
) : (
  <Layout title={`Edit history - ${history.topicTitle} - DRepTalk`} description="Edit history for a post on DRepTalk." noindex={true}>
    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <a href={`/t/${history.topicSlug}/#post-${id}`}>{history.topicTitle}</a>
    </nav>

    <h1 style="margin:0 0 0.5rem;line-height:1.3;font-size:1.375rem;">Edit history</h1>

    {!pair || !diff ? (
      <p style="color:var(--muted);font-size:0.875rem;">This post has only one version.</p>
    ) : (
      <>
        <form method="get" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;font-size:0.875rem;margin:0 0 1.25rem;">
          <label>
            Compare
            <select name="from">
              {versions.map((v, i) => (
                <option value={i} selected={i === pair.from} disabled={i <= pair.to}>
                  {versionLabel(i, versions.length, v.current)}
                </option>
              ))}
            </select>
          </label>
          <label>
            to
            <select name="to">
              {versions.map((v, i) => (
                <option value={i} selected={i === pair.to}>
                  {versionLabel(i, versions.length, v.current)}
                </option>
              ))}
            </select>
          </label>
          <label>
            <input type="checkbox" name="view" value="source" checked={sourceView} disabled={diff.degraded} />
            Show markdown source
          </label>
          <button type="submit">Compare</button>
        </form>

        <p style="color:var(--muted);font-size:0.8125rem;margin:0 0 1rem;">
          {formatVersionTime(versions[pair.to].createdAt)}
          {!diff.degraded && <> &middot; {statText(diff.added, diff.removed, diff.changed)}</>}
        </p>

        {diff.degraded && (
          <p style="color:var(--muted);font-size:0.8125rem;margin:0 0 1rem;">
            A rendered diff is not available for these versions. Showing the markdown source instead.
          </p>
        )}

        {sourceView ? (
          <div class="diff-source" style="border:1px solid var(--border);border-radius:0.375rem;padding:0.75rem;overflow:auto;">
            {sourceLines.map((line) => (
              <div class={line.type === 'add' ? 'diff-line-add' : line.type === 'del' ? 'diff-line-del' : undefined}>
                <span style="opacity:0.5">{line.type === 'add' ? '+' : line.type === 'del' ? '-' : ' '} </span>
                {line.parts.map((p) =>
                  p.type === 'same' ? p.text : <span class={p.type === 'add' ? 'diff-add' : 'diff-del'}>{p.text}</span>,
                )}
              </div>
            ))}
          </div>
        ) : (
          <div class="prose" set:html={diff.html} />
        )}
      </>
    )}
  </Layout>
)}
