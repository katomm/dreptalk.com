---
// Account settings. Session-gated; the DRep section prefills from the synced
// dreps row so a DRep can update stale on-chain metadata or set it up for the
// first time. All on-chain actions live in the DrepSettings island and are
// non-custodial.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import DrepSettings from '@/components/DrepSettings.tsx';
import LinkStakeWallet from '@/components/LinkStakeWallet.tsx';
import { roleLabels, isWriter } from '@/lib/auth/roles';
import { truncateId } from '@/lib/forum/view';
import { currentNetwork, runtimeEnv } from '@/lib/api/response';
import { getSelfDrepId, getUserById } from '@/lib/db/users';
import { getDrepById } from '@/lib/db/dreps';
import { getFollow } from '@/lib/db/delegatorFollows';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;
const network = currentNetwork().network;

// Notification settings live on /notifications (next to the inbox they
// configure), not here.
const drepId = db && user.roles.includes('drep') ? await getSelfDrepId(db, user) : null;
const drep = drepId && db ? await getDrepById(db, drepId) : null;

// "Link your stake wallet" (Phase 3, Task 8) is writer-only: it lets a DRep,
// SPO, CC member or proposer prove ownership of their own stake wallet to
// track their delegation on the home page. Prefetch any existing link/track
// state so the island opens straight into the right view instead of always
// starting from the wallet picker.
const canLinkStake = isWriter(user.roles);
const selfRow = canLinkStake && db ? await getUserById(db, user.id) : null;
const stakeAddr = selfRow?.stake_addr ?? null;
const follow = stakeAddr && db ? await getFollow(db, user.id) : null;
const followDrep = follow?.delegation_type === 'drep' && follow.drep_id && db ? await getDrepById(db, follow.drep_id) : null;
const initialTracking = follow
  ? {
      resolutionStatus: follow.resolution_status,
      delegationType: follow.delegation_type,
      drepId: follow.drep_id,
      drepName: followDrep?.name ?? null,
    }
  : null;

// Prefill: synced on-chain metadata when available, empty form otherwise
// (covers DReps without any metadata yet).
const initialName = drep?.name ?? '';
const initialBio = drep?.bio ?? '';
const initialLinks = drep?.links ?? [];
const initialImage = drep?.imageUrl
  ? { url: drep.imageUrl, ...(drep.imageContentHash ? { sha256: drep.imageContentHash } : {}) }
  : null;
const initialMotivations = drep?.motivations ?? '';
const initialQualifications = drep?.qualifications ?? '';
const initialPaymentAddress = drep?.paymentAddress ?? '';
const initialDoNotList = drep?.doNotList ?? false;
---
<Layout
  title="Settings - DRepTalk"
  description="Manage your DRepTalk account and, for DReps, your on-chain profile metadata."
  noindex={true}
>
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Settings</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Settings</h1>
  <p style="margin:0;max-width:62ch;font-size:0.9375rem;line-height:1.6;color:var(--muted);">
    {drepId
      ? 'Manage your DRep profile metadata stored on-chain (CIP-119).'
      : 'Manage your DRepTalk account.'}
  </p>

  {drepId ? (
    <section style="margin-top:1.75rem;">
      <DrepSettings
        network={network}
        expectedDrepId={drepId}
        initialName={initialName}
        initialBio={initialBio}
        initialLinks={initialLinks}
        initialImage={initialImage}
        initialMotivations={initialMotivations}
        initialQualifications={initialQualifications}
        initialPaymentAddress={initialPaymentAddress}
        initialDoNotList={initialDoNotList}
        client:load
      />
    </section>
  ) : (
    <section style="margin-top:1.75rem;">
      <p style="margin:0 0 0.75rem;font-size:0.9375rem;color:var(--muted);">
        Signed in as{' '}
        <span
          style="font-family:ui-monospace, SFMono-Regular, Menlo, monospace;"
          title={user.id}
        >{truncateId(user.id, 28)}</span>{' '}
        ({roleLabels(user.roles).join(', ')})
      </p>
      <p style="margin:0;max-width:62ch;font-size:0.9375rem;color:var(--muted);">
        Settings specific to your role are not available yet. They will appear
        here as they are added.
      </p>
    </section>
  )}

  {canLinkStake && (
    <section id="link-stake-wallet" style="margin-top:1.75rem;max-width:32rem;">
      <LinkStakeWallet
        network={network}
        initialStakeAddr={stakeAddr}
        initialTracking={initialTracking}
        client:load
      />
    </section>
  )}
</Layout>
