---
// Settings index: redirects to the default settings tab. A DRep lands on their
// Profile tab (the on-chain metadata form); everyone else on Account. The tab
// sub-pages live under /settings/ (profile, account, danger). Session-gated.
export const prerender = false;

import { runtimeEnv } from '@/lib/api/response';
import { getSelfDrepId } from '@/lib/db/users';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;

// A DRep defaults to the Profile tab; everyone else to Account. The check lives
// in an if-condition (not the redirect expression) so this template-less page
// has no "unused variable" hint on the trailing return.
const isDrep = !!(db && user.roles.includes('drep') && (await getSelfDrepId(db, user)));
if (isDrep) {
  return Astro.redirect('/settings/profile/');
}
return Astro.redirect('/settings/account/');
---
