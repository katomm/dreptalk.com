---
// Operator-facing sync status page: last run per cron kind, duration, item and
// failure counts, first error, per-phase breakdown, and the next scheduled run.
// Read-only over the sync_runs table the gov-sync worker maintains; noindex and
// uncached so it always shows the live state. Data here is not sensitive (it
// mirrors what the public freshness page promises), so there is no auth gate.
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import { listSyncRuns, type SyncRun } from '@/lib/db/syncRuns.js';
import { countGivenUpMetaActions } from '@/lib/db/governance.js';
import { countGivenUpAvatars } from '@/lib/db/dreps.js';
import { AVATAR_FETCH_MAX_ATTEMPTS } from '@/lib/dreps/avatarStore.js';
import { META_EXTRACT_VERSION, META_REEXTRACT_MAX_ATTEMPTS } from '@/lib/governance/metadata.js';
import { errorMessage } from '@/lib/sync/runRecorder.js';
import { formatRelativeTime } from '@/lib/forum/view.js';
import {
  formatBerlinDateTime,
  formatBerlinTime,
  runDisplay,
  groupRunsByDay,
} from '@/lib/sync/statusView.js';
import { CRON_GOVERNANCE, CRON_VOTE_SYNC, CRON_DREP_SYNC, nextCronRunMs } from '@/lib/freshness.js';

const KINDS = [
  { kind: 'governance', label: 'Governance discovery + tallies', cron: CRON_GOVERNANCE },
  { kind: 'votes', label: 'Per-post vote lists + badges', cron: CRON_VOTE_SYNC },
  { kind: 'dreps', label: 'DRep profiles', cron: CRON_DREP_SYNC },
] as const;

const now = Date.now();
const db = env.DB as D1Database;

// The run history and the given-up count are independent reads; start both
// before awaiting so they overlap. Each keeps its own error handling: a missing
// sync_runs table surfaces as loadError, while a count failure (same likely
// cause) stays silent so the run history still renders.
const runsPromise = listSyncRuns(db, 30);
const givenUpPromise = countGivenUpMetaActions(db, META_EXTRACT_VERSION, META_REEXTRACT_MAX_ATTEMPTS).catch(() => 0);
const givenUpAvatarsPromise = countGivenUpAvatars(db, AVATAR_FETCH_MAX_ATTEMPTS).catch(() => 0);

let runs: SyncRun[] = [];
let loadError: string | null = null;
try {
  runs = await runsPromise;
} catch (err) {
  // Most likely the sync_runs migration has not been applied yet.
  loadError = errorMessage(err);
}

// Sources the syncs have permanently abandoned. They drop out of their retry
// queries, so without these counts they would silently disappear from view.
const givenUp = await givenUpPromise;
const givenUpAvatars = await givenUpAvatarsPromise;

const latestByKind = new Map<string, SyncRun>();
for (const run of runs) {
  if (!latestByKind.has(run.kind)) latestByKind.set(run.kind, run);
}

const groupedRuns = groupRunsByDay(runs);

const RUN_STATE_COLOR: Record<string, string> = {
  running: 'var(--muted)',
  killed: '#c0392b',
};

function fmtIn(ms: number | null): string {
  if (ms == null) return '-';
  const min = Math.max(0, Math.round((ms - now) / 60_000));
  return min < 60 ? `in ${min} min` : `in ${Math.floor(min / 60)}h ${min % 60}m`;
}

const STATUS_COLOR: Record<string, string> = {
  ok: '#2e7d32',
  partial: '#b26a00',
  error: '#c0392b',
  killed: '#c0392b',
  running: 'var(--muted)',
};

Astro.response.headers.set('Cache-Control', 'no-store');
// Operator dashboard: auto-refresh so a watched run updates without a manual
// reload. The Refresh header avoids an inline meta tag, keeping the strict CSP.
Astro.response.headers.set('Refresh', '60');
---

<Layout title="Sync status - DRepTalk" description="Last gov-sync runs: status, duration, items, errors." noindex>
  <h1>Sync status</h1>
  <p class="intro">
    Run history of the gov-sync cron worker. Each run records its phases, item counts,
    failures, and the first error. <strong>partial</strong> means some phase or some items
    failed but the run kept going; failed work is retried by the next scheduled run.
  </p>

  {loadError && <p class="error-text">Could not read sync_runs: {loadError} (is migration 0026 applied?)</p>}

  <div class="cards">
    {KINDS.map(({ kind, label, cron }) => {
      const latest = latestByKind.get(kind);
      const dur = latest ? runDisplay(latest, now) : null;
      return (
        <div class="card">
          <h2>{label}</h2>
          <dl>
            <dt>Status</dt>
            <dd class="status" style={`color:${STATUS_COLOR[latest?.status ?? 'running']};`}>
              {latest?.status ?? 'no runs yet'}
            </dd>
            <dt>Last run</dt>
            <dd>{latest ? formatRelativeTime(latest.startedAt, now) : '-'}</dd>
            <dt>Duration</dt>
            <dd>
              {dur ? <span style={`color:${RUN_STATE_COLOR[dur.state] ?? 'inherit'};`}>{dur.text}</span> : '-'}
            </dd>
            <dt>Items / failed</dt>
            <dd>{latest ? `${latest.items} / ${latest.failed}` : '-'}</dd>
            <dt>Next run</dt>
            <dd>{fmtIn(nextCronRunMs(cron, now))}</dd>
          </dl>
          {latest?.error && <p class="error-text small">{latest.error}</p>}
        </div>
      );
    })}
  </div>

  {givenUp > 0 && (
    <p class="given-up">
      {givenUp} governance {givenUp === 1 ? 'anchor' : 'anchors'} given up: metadata re-extraction
      failed {META_REEXTRACT_MAX_ATTEMPTS}+ times (anchor dead or hash-mismatched), so it is no
      longer retried and no longer counts toward a run's failed items.
    </p>
  )}

  {givenUpAvatars > 0 && (
    <p class="given-up">
      {givenUpAvatars} DRep {givenUpAvatars === 1 ? 'avatar' : 'avatars'} given up: image fetch
      failed {AVATAR_FETCH_MAX_ATTEMPTS}+ times (source dead, wrong type, or oversize), so it is no
      longer retried and no longer counts toward a run's failed items.
    </p>
  )}

  <h2 class="table-heading">Recent runs</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Started (Berlin)</th>
          <th>Kind</th>
          <th>Status</th>
          <th>Duration</th>
          <th>Items</th>
          <th>Failed</th>
          <th>Phases / error</th>
        </tr>
      </thead>
      <tbody>
        {groupedRuns.map((item) => {
          if (item.type === 'day') {
            return (
              <tr class="day-row">
                <th colspan="7" scope="colgroup">{item.label}</th>
              </tr>
            );
          }
          const run = item.run;
          const dur = runDisplay(run, now);
          return (
            <tr>
              <td class="nowrap" title={formatBerlinDateTime(run.startedAt)}>{formatBerlinTime(run.startedAt)}</td>
              <td>{run.kind}</td>
              <td class="status" style={`color:${STATUS_COLOR[run.status] ?? 'inherit'};`}>{run.status}</td>
              <td class="nowrap" style={`color:${RUN_STATE_COLOR[dur.state] ?? 'inherit'};`}>{dur.text}</td>
              <td>{run.items}</td>
              <td>{run.failed}</td>
              <td>
                {run.phases.length > 0 && (
                  <details>
                    <summary>{run.phases.filter((p) => p.ok).length}/{run.phases.length} phases ok</summary>
                    <ul>
                      {run.phases.map((p) => (
                        <li style={p.ok ? '' : `color:${STATUS_COLOR.error};`}>
                          {p.phase}: {p.ok ? 'ok' : 'failed'}, {Math.round(p.ms / 100) / 10}s, {p.items} items
                          {p.failed > 0 ? `, ${p.failed} failed` : ''}
                          {p.error ? ` (${p.error})` : ''}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
                {run.error && run.phases.length === 0 && <span class="break">{run.error}</span>}
              </td>
            </tr>
          );
        })}
        {runs.length === 0 && !loadError && (
          <tr><td colspan="7" class="empty">No sync runs recorded yet.</td></tr>
        )}
      </tbody>
    </table>
  </div>
</Layout>

<style>
  .intro {
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.6;
  }
  .error-text {
    color: #c0392b;
    word-break: break-word;
  }
  .error-text.small {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }
  .given-up {
    color: #b26a00;
    font-size: 0.875rem;
    max-width: 62ch;
    margin: -0.5rem 0 1.5rem;
  }
  .day-row th {
    padding: 0.75rem 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: 1.5rem 0;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }
  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }
  .card dl {
    margin: 0;
    font-size: 0.875rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
  }
  .card dt {
    color: var(--muted);
  }
  .card dd {
    margin: 0;
  }
  .status {
    font-weight: 600;
  }
  .table-heading {
    font-size: 1.125rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  thead tr {
    text-align: left;
    border-bottom: 2px solid var(--border);
  }
  tbody tr {
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th,
  td {
    padding: 0.5rem 0.75rem;
  }
  th:first-child,
  td:first-child {
    padding-left: 0;
  }
  .nowrap {
    white-space: nowrap;
  }
  .break {
    word-break: break-word;
  }
  .empty {
    padding: 1rem 0;
    color: var(--muted);
  }
  summary {
    cursor: pointer;
    color: var(--muted);
  }
  details ul {
    margin: 0.25rem 0 0;
    padding-left: 1rem;
  }
</style>
