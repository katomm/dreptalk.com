---
import Layout from '@/layouts/Layout.astro';
import WalletLogin from '@/components/WalletLogin.tsx';
import OfflineLogin from '@/components/OfflineLogin.tsx';
import { currentNetwork } from '@/lib/api/response';

export const prerender = false;

// SPO (Calidus) and CC members sign offline with cardano-signer and paste the
// result; DRep and Proposer connect a CIP-30 wallet. The role query param picks
// the flow (the server re-validates the role independently).
const roleParam = Astro.url.searchParams.get('role');
const offlineRole = roleParam === 'spo' || roleParam === 'cc' ? roleParam : null;

// Resolve the deployment network (CARDANO_NETWORK, defaults mainnet) so the DRep
// island builds the correct CIP-19 type-6 address header when signing.
const network = currentNetwork().network;
---
<Layout
  title="Sign in - DRepTalk"
  description="Sign in to DRepTalk with your Cardano governance identity. No password, no transaction; just a one-time signed challenge."
>
  <h1>Sign in</h1>
  {offlineRole ? (
    <OfflineLogin role={offlineRole} client:load />
  ) : (
    <>
      <p style="color:var(--muted);max-width:38rem;margin-bottom:2rem;">
        DRepTalk uses wallet-based authentication. Connect your Cardano wallet and sign a
        one-time challenge to prove ownership of your DRep or reward address. No password
        required, no transaction, no fees.
      </p>
      <WalletLogin network={network} client:load />
    </>
  )}
</Layout>
