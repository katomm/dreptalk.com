---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import TreasuryDonut from '@/components/ncl/TreasuryDonut.astro';
import NclPeriodsTable from '@/components/ncl/NclPeriodsTable.astro';
import { loadTreasuryOverview } from '@/lib/treasury/overview.js';
import { ogCardVersion } from '@/lib/og/version.js';

// Public, low-churn: withdrawals change at most a few times per epoch.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const db = env.DB as D1Database | undefined;
const data = db ? await loadTreasuryOverview(db) : null;

// Version the card URL by what it renders (consumed vs ceiling) so a share
// refetches once an enacted withdrawal moves the gauge.
const cur = data?.currentStatus;
const ogImage = cur
  ? `/og/treasury/${cur.period.id}.png?v=${ogCardVersion([cur.period.id, cur.consumedLovelace, cur.period.ceilingLovelace])}`
  : '/og.jpg';
---

<Layout
  title="Treasury and Net Change Limit - DRepTalk"
  description="How much of the Cardano treasury Net Change Limit has been consumed by enacted treasury withdrawals, and which governance actions set the limit."
  ogImage={ogImage}
>
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Treasury</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Treasury and Net Change Limit</h1>

  <p style="color:var(--muted);max-width:65ch;line-height:1.6;">
    The Net Change Limit caps how much ada may be withdrawn from the Cardano treasury in a period. It is set by
    an Info governance action, so it is a community agreement rather than an automatic on-chain rule. The figures
    below sum enacted treasury withdrawals against the limit each period.
  </p>

  {data?.treasuryLovelace != null && data?.currentStatus != null && (
    <div class="treasury-summary">
      <TreasuryDonut
        treasuryLovelace={data.treasuryLovelace}
        consumedLovelace={data.currentStatus.consumedLovelace}
        remainingLovelace={data.currentStatus.remainingLovelace}
        ceilingLovelace={data.currentStatus.period.ceilingLovelace}
        epoch={data.treasuryEpoch}
      />
      <p class="treasury-summary__caption">The Net Change Limit caps the outflows, not the total balance.</p>
    </div>
  )}

  {data && (
    <>
      <h2 style="font-size:1.125rem;margin:2rem 0 0.75rem;">Net Change Limit periods</h2>
      <NclPeriodsTable periods={data.periods} currentEpoch={data.currentEpoch} />
    </>
  )}

  <p style="color:var(--muted);font-size:0.8125rem;margin-top:1.5rem;">
    Limits are defined by Info governance actions and apply per epoch period.
  </p>
</Layout>

<style>
  .treasury-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.5rem 0 1rem;
    background: var(--surface-2);
  }
  .treasury-summary__caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
