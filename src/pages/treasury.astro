---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import NclPanel from '@/components/ncl/NclPanel.astro';
import { NCL_PERIODS } from '../../config/ncl-periods.js';
import { nclStatusFor } from '@/lib/governance/ncl.js';
import { getEnactedTreasuryWithdrawals, getNclActionLinks } from '@/lib/db/treasury.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { formatAda } from '@/lib/format/ada.js';

// Public, low-churn: withdrawals change at most a few times per epoch.
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const db = env.DB as D1Database | undefined;

const withdrawals = db ? await getEnactedTreasuryWithdrawals(db) : [];
const allIds = NCL_PERIODS.flatMap((p) => [...p.definingActionIds, ...p.relatedActionIds]);
const links = db ? await getNclActionLinks(db, allIds) : new Map();
const params = db ? await getProtocolParams(db) : null;
const currentEpoch = params?.epoch ?? null;
const treasuryLovelace = params?.treasuryLovelace ? BigInt(params.treasuryLovelace) : null;
const reservesLovelace = params?.reservesLovelace ? BigInt(params.reservesLovelace) : null;
const treasuryEpoch = params?.treasuryEpoch ?? null;

const linkList = (ids: string[]) => ids.map((id) => links.get(id)).filter((l): l is NonNullable<typeof l> => !!l);

// Newest period first.
const periods = [...NCL_PERIODS].sort((a, b) => b.startEpoch - a.startEpoch);
const cards = periods.map((p) => ({
  status: nclStatusFor(p, withdrawals),
  windowWithdrawals: withdrawals
    .filter((w) => w.enactedEpoch >= p.startEpoch && w.enactedEpoch <= p.endEpoch)
    .sort((a, b) => b.enactedEpoch - a.enactedEpoch),
  definingLinks: linkList(p.definingActionIds),
  relatedLinks: linkList(p.relatedActionIds),
}));

const currentId = periods.find((p) => currentEpoch != null && currentEpoch >= p.startEpoch && currentEpoch <= p.endEpoch)?.id ?? periods[0]?.id;
---

<Layout
  title="Treasury and Net Change Limit - DRepTalk"
  description="How much of the Cardano treasury Net Change Limit has been consumed by enacted treasury withdrawals, and which governance actions set the limit."
  ogImage={currentId ? `/og/treasury/${currentId}.png` : '/og.jpg'}
>
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Treasury</span>
  </nav>

  <h1 style="margin:0 0 0.5rem;">Treasury and Net Change Limit</h1>
  <p style="color:var(--muted);max-width:65ch;line-height:1.6;">
    The Net Change Limit caps how much ada may be withdrawn from the Cardano treasury in a period. It is set by
    an Info governance action, so it is a community agreement rather than an automatic on-chain rule. The figures
    below sum enacted treasury withdrawals against the limit each period.
  </p>

  {treasuryLovelace !== null && (
    <div class="treasury-summary">
      <div class="treasury-summary__figures">
        <div class="treasury-summary__figure">
          <span class="treasury-summary__label">Cardano Treasury</span>
          <span class="treasury-summary__value">{formatAda(String(treasuryLovelace))}</span>
        </div>
        {reservesLovelace !== null && (
          <div class="treasury-summary__figure">
            <span class="treasury-summary__label">Reserves</span>
            <span class="treasury-summary__value">{formatAda(String(reservesLovelace))}</span>
          </div>
        )}
      </div>
      {treasuryEpoch !== null && <p class="treasury-summary__epoch">as of Epoch {treasuryEpoch}</p>}
      <p class="treasury-summary__caption">The Net Change Limit caps the outflows, not the total balance.</p>
    </div>
  )}

  {cards.map((c) => (
    <NclPanel
      status={c.status}
      windowWithdrawals={c.windowWithdrawals}
      definingLinks={c.definingLinks}
      relatedLinks={c.relatedLinks}
      treasuryLovelace={treasuryLovelace}
    />
  ))}
</Layout>

<style>
  .treasury-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.5rem 0 1rem;
    background: var(--surface-2);
  }
  .treasury-summary__figures {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .treasury-summary__figure {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .treasury-summary__label {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .treasury-summary__value {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--fg);
  }
  .treasury-summary__epoch {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .treasury-summary__caption {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
