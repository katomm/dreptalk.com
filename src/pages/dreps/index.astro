---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import DrepConcentration from '@/components/DrepConcentration.tsx';
import DrepActionsMenu from '@/components/DrepActionsMenu.tsx';
import DrepStatIcon from '@/components/DrepStatIcon.astro';
import DrepSelfCard from '@/components/DrepSelfCard.astro';
import Pager from '@/components/Pager.astro';
import { listDreps, listDrepsForConcentration, getDrepRanking, type DrepRanking } from '@/lib/db/dreps.js';
import { getSelfDrepId } from '@/lib/db/users.js';
import { getVotingPowerEpochAggregates } from '@/lib/db/drepVotingPowerHistory.js';
import { computeConcentration } from '@/lib/dreps/concentration.js';
import { computeDrepStatTrends } from '@/lib/dreps/statTrend.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { influencePct } from '@/lib/dreps/profile.js';
import { computeVotingPowerDelta, formatTrendPct, absLovelace } from '@/lib/dreps/votingPowerTrend.js';
import { drepCredentialHexFromId } from '@/lib/cardano/identity.js';
import { currentNetwork } from '@/lib/api/response';
import { parsePage, pageToOffset, cacheControlForSynced, formatAda, formatAdaCompact } from '@/lib/forum/view.js';
import { drepDescriptor } from '@/lib/forum/author.js';

const db = env.DB as D1Database | undefined;
const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const activeOnly = Astro.url.searchParams.get('all') !== '1';
// Sort key from the query string; anything but "delegators" falls back to power.
const sort = Astro.url.searchParams.get('sort') === 'delegators' ? 'delegators' : 'power';
// Offset into the power-sorted listing; also the base for each row's rank number
// (rank = offset + row index + 1), so ranks stay continuous across pages.
const listOffset = pageToOffset(page, PAGE_SIZE);

// The directory listing, the concentration aggregate, and the cached protocol
// params are independent reads; fetch them concurrently so a cold (uncached)
// render pays one round-trip of latency, not three.
const [dreps, concentrationRows, params, powerAggregates] = db
  ? await Promise.all([
      listDreps(db, { activeOnly, limit: PAGE_SIZE, offset: listOffset, sort }),
      listDrepsForConcentration(db),
      getProtocolParams(db),
      getVotingPowerEpochAggregates(db),
    ])
  : [[], [], null, []];

// Voting power concentration: all active, non-special DReps as BigInt powers.
// Parse lovelace defensively so a single malformed row cannot 500 the page
// (Koios writes plain integer strings, but the column is untrusted text).
const toLovelace = (s: string | null): bigint => {
  try {
    return BigInt(s ?? '0');
  } catch {
    return 0n;
  }
};
const concentration = computeConcentration(
  concentrationRows.map((r) => ({ drepId: r.drepId, name: r.name, slug: r.slug, power: toLovelace(r.votingPower) })),
);

// Where the logged-in DRep stands in this exact listing (same filter + sort), for
// the pinned "this is you" card and to highlight their own row when it's on the
// visible page. Only runs when a DRep is signed in.
const selfDrepId = db ? await getSelfDrepId(db, Astro.locals.user) : null;
const selfRanking =
  db && selfDrepId ? await getDrepRanking(db, selfDrepId, { activeOnly, sort }) : null;

// The same total the donut uses (active, non-special), so a row's table share and
// the concentration view agree. Number is exact enough for the percent display.
const totalActivePower = Number(concentration.totalPower);

// Header stat cards. The current figures come from the live concentration (the
// authoritative active set); the "this epoch" deltas come from the per-epoch
// history aggregates (newest first). Deltas stay hidden until two epochs exist.
const statTrends = computeDrepStatTrends(powerAggregates[0], powerAggregates[1]);
// Average voting power per active DRep. BigInt division avoids the Number range
// (total lovelace exceeds it), then formatted compact like the row values.
const avgPowerLabel =
  concentration.drepCount > 0
    ? formatAdaCompact((BigInt(concentration.totalPower) / BigInt(concentration.drepCount)).toString())
    : formatAdaCompact('0');
// Concentration headline: the share of active voting power held by the ten largest
// DReps (topK carries more than ten, so slicing is safe).
const top10Pct = concentration.topK.slice(0, 10).reduce((acc, t) => acc + t.pct, 0);

// The four header cards, in mockup order. `trend` renders the "this epoch" chip;
// `sub` is a static caption for the card that has no epoch delta. The icon tint
// alternates (accent, positive) to match the directory's palette.
const statCards: {
  label: string;
  value: string;
  icon: 'people' | 'power' | 'gauge' | 'share';
  alt: boolean;
  trend?: (typeof statTrends)['activeDreps'];
  sub?: string;
}[] = [
  { label: 'Active DReps', value: concentration.drepCount.toLocaleString('en-US'), icon: 'people', alt: false, trend: statTrends.activeDreps },
  { label: 'Total voting power', value: formatAdaCompact(concentration.totalPower), icon: 'power', alt: true, trend: statTrends.totalPower },
  { label: 'Avg. voting power', value: avgPowerLabel, icon: 'gauge', alt: false, trend: statTrends.avgPower },
  { label: 'Top 10 control', value: `${top10Pct.toFixed(1)}%`, icon: 'share', alt: true, sub: 'held by the 10 largest' },
];

// Donut slider markers: each DRep voting threshold (dvt_* fraction) paired with
// the governance action it gates, grouped by rounded percent (several actions
// share a threshold). Canonical Conway genesis defaults label the markers before
// the protocol params have synced; synced params override them when present.
const DEFAULT_DVT: { fraction: number; label: string }[] = [
  { fraction: 0.67, label: 'No confidence' },
  { fraction: 0.67, label: 'Committee (normal state)' },
  { fraction: 0.6, label: 'Committee (no confidence)' },
  { fraction: 0.75, label: 'Constitution update' },
  { fraction: 0.6, label: 'Hard fork' },
  { fraction: 0.67, label: 'Protocol params (network)' },
  { fraction: 0.67, label: 'Protocol params (economic)' },
  { fraction: 0.67, label: 'Protocol params (technical)' },
  { fraction: 0.75, label: 'Protocol params (governance)' },
  { fraction: 0.67, label: 'Treasury withdrawal' },
];
const syncedDvt: { value: number | null; label: string }[] = params
  ? [
      { value: params.dvtTreasuryWithdrawal, label: 'Treasury withdrawal' },
      { value: params.dvtHardFork, label: 'Hard fork' },
      { value: params.dvtUpdateConstitution, label: 'Constitution update' },
      { value: params.dvtMotionNoConfidence, label: 'No confidence' },
      { value: params.dvtCommitteeNormal, label: 'Committee (normal state)' },
      { value: params.dvtCommitteeNoConfidence, label: 'Committee (no confidence)' },
      { value: params.dvtPpNetwork, label: 'Protocol params (network)' },
      { value: params.dvtPpEconomic, label: 'Protocol params (economic)' },
      { value: params.dvtPpTechnical, label: 'Protocol params (technical)' },
      { value: params.dvtPpGov, label: 'Protocol params (governance)' },
    ]
  : [];
const dvtSource = syncedDvt.some((d) => typeof d.value === 'number' && d.value > 0)
  ? syncedDvt
  : DEFAULT_DVT.map((d) => ({ value: d.fraction, label: d.label }));
const actionsByPct = new Map<number, string[]>();
for (const { value, label } of dvtSource) {
  if (typeof value === 'number' && value > 0) {
    const pct = Math.round(value * 100);
    const list = actionsByPct.get(pct);
    if (list) list.push(label);
    else actionsByPct.set(pct, [label]);
  }
}
// The raw grouped list is exhaustive (67% alone gates six action types), which
// reads as a wall of text in the marker hint. Collapse the busy thresholds to a
// short, illustrative phrase; others fall through to their grouped labels.
const MARKER_SUMMARY: Record<number, string> = {
  67: 'Treasury withdrawal and some network parameters',
};
const markers = [...actionsByPct.entries()].sort((a, b) => a[0] - b[0]).map(([pct, actions]) => {
  const summary = MARKER_SUMMARY[pct];
  return { pct, actions: summary ? [summary] : actions };
});
const markersPct = markers.map((m) => m.pct);
const defaultThresholdPct = markersPct.includes(67) ? 67 : (markersPct[Math.floor(markersPct.length / 2)] ?? 67);
const thresholdsAsOf = params ? new Date(params.syncedAt).toISOString().slice(0, 10) : null;

// The island uses the deployment's real network for the delegation tx + explorer links.
const network = currentNetwork().network;

Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));

const nextPage = dreps.length === PAGE_SIZE ? page + 1 : null;
const prevPage = page > 1 ? page - 1 : null;
const qs = (p: number) =>
  `?page=${p}${activeOnly ? '' : '&all=1'}${sort === 'delegators' ? '&sort=delegators' : ''}`;

// The 28-byte DRep credential the delegation tx targets. Prefer the stored Koios
// `hex`; fall back to deriving it from the drep id. Null disables the delegate
// action for that row (it stays viewable/copyable).
const credentialHexFor = (d: typeof dreps[number]): string | null =>
  d.hex ?? drepCredentialHexFromId(d.drepId);

// A row's share of the active voting power, formatted for the table. Sub-0.01%
// rounds to "<0.01%" rather than a misleading "0.00%".
const pctLabel = (pct: number): string => (pct < 0.01 ? '<0.01%' : `${pct.toFixed(2)}%`);

// The largest DRep share, used to scale the row bars. A bar is drawn relative to
// the leader (whose bar is full), not to an absolute 0..100% axis, so the bars
// stay legible (top shares are only a few percent) and comparable across pages.
const maxPct = concentration.topK[0]?.pct ?? 0;
const barWidth = (pct: number): string => {
  const w = maxPct > 0 ? Math.min((pct / maxPct) * 100, 100) : 0;
  return `${w.toFixed(2)}%`;
};

const deltaTitle = (dir: 'up' | 'down' | 'flat'): string =>
  dir === 'up'
    ? 'Voting power up since the previous epoch'
    : dir === 'down'
      ? 'Voting power down since the previous epoch'
      : 'Voting power unchanged since the previous epoch';

// The pinned self-card contents (rank line, identity, latest-epoch trend), derived
// once so the template stays declarative. Null unless a DRep is signed in and found.
const selfDescriptor = selfRanking ? drepDescriptor(selfRanking.drep) : null;
const selfDelta = selfRanking
  ? computeVotingPowerDelta(selfRanking.drep.votingPowerSnapshot, selfRanking.drep.votingPowerPrev)
  : null;
function selfStandingLine(r: DrepRanking): string {
  const n = (v: number): string => v.toLocaleString('en-US');
  if (r.rank != null)
    return `Rank #${n(r.rank)} of ${n(r.total)} by ${sort === 'delegators' ? 'delegators' : 'voting power'}`;
  if (activeOnly && !r.drep.active) return 'Retired, not in the active ranking';
  if (sort === 'delegators') return 'Delegator count pending';
  return `Not yet ranked (of ${n(r.total)})`;
}
const selfStanding = selfRanking ? selfStandingLine(selfRanking) : null;
---

{/* wide: all four primary-nav destinations share the wide shell, so the content
    column keeps one width while moving through the main nav. */}
<Layout title="Cardano DReps - Delegate Representatives - DRepTalk" description="Browse every Cardano DRep ranked by active voting power. See each delegate representative's voting record, delegation, and governance participation on DRepTalk." ogImage="/og-dreps.jpg" wide>
  <h1>DReps</h1>
  <p class="dreps-intro">
    Decentralized Representatives in Cardano governance, ranked by active voting power.
    New to this? Learn <a href="/help/delegate-to-a-drep/">how to delegate your voting power</a>
    or <a href="/help/become-a-drep/">how to become a DRep</a> yourself.
  </p>

  {concentration.drepCount > 0 && (
    <div class="drep-stats">
      {statCards.map((card) => (
        <div class={`drep-stat${card.alt ? ' drep-stat--alt' : ''}`}>
          <span class="drep-stat__icon"><DrepStatIcon name={card.icon} /></span>
          <span class="drep-stat__body">
            <span class="drep-stat__label">{card.label}</span>
            <span class="drep-stat__value">{card.value}</span>
            {card.trend ? (
              <span class={`drep-stat__delta drep-stat__delta--${card.trend.direction}`}>
                {card.trend.direction !== 'flat' && (
                  <span class="drep-stat__arrow" aria-hidden="true">{card.trend.direction === 'up' ? '↑' : '↓'}</span>
                )}
                {card.trend.label} this epoch
              </span>
            ) : card.sub ? (
              <span class="drep-stat__sub">{card.sub}</span>
            ) : null}
          </span>
        </div>
      ))}
    </div>
  )}

  <p class="dreps-filter">
    {activeOnly ? <a href="?all=1">Show all DReps</a> : <a href="?">Active only</a>}
    <span style="margin:0 0.5rem;color:var(--muted);" aria-hidden="true">&middot;</span>
    <a href="/dreps/movers/">Movers of the epoch</a>
  </p>

  <a class="drep-match-teaser" href="/match/">
    <strong>Find your DRep</strong>
    <span>Answer questions from real governance votes and see which DReps vote like you.</span>
  </a>

  {selfDescriptor && selfStanding && (
    <DrepSelfCard descriptor={selfDescriptor} standing={selfStanding}>
      {selfRanking!.drep.votingPower != null && (
        <span class="drep-self-power">{formatAdaCompact(selfRanking!.drep.votingPower)}</span>
      )}
      {selfDelta && (
        <span class={`drep-trend drep-trend--${selfDelta.direction}`} title={deltaTitle(selfDelta.direction)}>
          <span class="drep-trend__main">
            {selfDelta.direction === 'flat' ? (
              <span class="drep-trend__flat" aria-hidden="true"></span>
            ) : (
              <span class="drep-trend__arrow" aria-hidden="true">{selfDelta.direction === 'up' ? '▲' : '▼'}</span>
            )}
            {selfDelta.pct != null && <span class="drep-trend__pct">{formatTrendPct(selfDelta.pct)}</span>}
          </span>
        </span>
      )}
    </DrepSelfCard>
  )}

  {dreps.length === 0 ? (
    <p style="color:var(--muted);">No DReps found.</p>
  ) : (
    <table class="drep-table">
      <thead>
        <tr>
          <th scope="col" class="drep-table__rank-h"><span class="sr-only">Rank</span></th>
          <th scope="col">DRep</th>
          <th scope="col" class="drep-table__power-h">
            {sort === 'power' ? (
              <a href={`?${activeOnly ? '' : 'all=1'}`} aria-current="true">Voting power &darr;</a>
            ) : (
              <a href={`?${activeOnly ? '' : 'all=1'}`}>Voting power</a>
            )}
          </th>
          <th scope="col" class="drep-table__trend-h">Trend <span class="drep-table__trend-sub">(vs last epoch)</span></th>
          <th scope="col" class="drep-table__delegators-h">
            {sort === 'delegators' ? (
              <a href={`?${activeOnly ? '' : 'all=1'}`} aria-current="true">Delegators &darr;</a>
            ) : (
              <a href={`?sort=delegators${activeOnly ? '' : '&all=1'}`}>Delegators</a>
            )}
          </th>
          <th scope="col" class="drep-table__actions-h">Actions</th>
        </tr>
      </thead>
      <tbody>
        {dreps.map((d, i) => {
          const descriptor = drepDescriptor(d);
          const pct = influencePct(d.votingPower, totalActivePower);
          const delta = computeVotingPowerDelta(d.votingPowerSnapshot, d.votingPowerPrev);
          const cred = credentialHexFor(d);
          const rank = listOffset + i + 1;
          const isSelf = selfDrepId != null && d.drepId === selfDrepId;
          return (
            <tr class:list={{ 'drep-row--self': isSelf }}>
              <td class="drep-table__rank">#{rank}</td>
              <td>
                <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate>
                  <span slot="sub" class="drep-table__ranksub">#{rank}</span>
                </AuthorIdentity>
              </td>
              <td class="drep-table__power">
                <div class="drep-power">
                  <span class="drep-power__ada">
                    <span class="drep-power__ada-full">{formatAda(d.votingPower)}</span>
                    <span class="drep-power__ada-compact">{formatAdaCompact(d.votingPower)}</span>
                  </span>
                  {pct != null && (
                    <span class="drep-power__meter">
                      <span class="drep-power__pct">{pctLabel(pct)}</span>
                      <span class="drep-power__bar" aria-hidden="true">
                        <span class="drep-power__fill" style={`width:${barWidth(pct)}`}></span>
                      </span>
                    </span>
                  )}
                </div>
              </td>
              <td class="drep-table__trend">
                {delta && (
                  <span class={`drep-trend drep-trend--${delta.direction}`} title={deltaTitle(delta.direction)}>
                    <span class="drep-trend__main">
                      {delta.direction === 'flat' ? (
                        <span class="drep-trend__flat" aria-hidden="true"></span>
                      ) : (
                        <span class="drep-trend__arrow" aria-hidden="true">{delta.direction === 'up' ? '▲' : '▼'}</span>
                      )}
                      {delta.pct != null && <span class="drep-trend__pct">{formatTrendPct(delta.pct)}</span>}
                    </span>
                    {delta.direction !== 'flat' && (
                      <span class="drep-trend__ada">({formatAdaCompact(absLovelace(delta.deltaLovelace))})</span>
                    )}
                  </span>
                )}
              </td>
              <td class="drep-table__delegators">
                {d.delegatorCount != null ? d.delegatorCount.toLocaleString('en-US') : 'n/a'}
              </td>
              <td class="drep-table__actions">
                <span class="drep-row-actions">
                  {/* Desktop quick-action; hidden on mobile (the kebab carries it
                      there). Only shown when the DRep can actually receive a
                      delegation (script DReps without a credential cannot). */}
                  {cred && (
                    <button
                      type="button"
                      class="btn btn-secondary drep-delegate-btn"
                      data-drep-delegate
                      data-drep-id={d.drepId}
                      data-drep-slug={d.slug ?? ''}
                      data-drep-name={descriptor.displayName}
                      data-drep-cred={cred}
                      data-drep-script={d.hasScript ? '1' : '0'}
                      aria-label={`Delegate voting power to ${descriptor.displayName}`}
                    >
                      Delegate
                    </button>
                  )}
                  <button
                    type="button"
                    class="drep-action-btn"
                    data-drep-action
                    data-drep-id={d.drepId}
                    data-drep-slug={d.slug ?? ''}
                    data-drep-name={descriptor.displayName}
                    data-drep-cred={cred ?? ''}
                    data-drep-script={d.hasScript ? '1' : '0'}
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label={`Actions for ${descriptor.displayName}`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" />
                    </svg>
                  </button>
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}

  <Pager
    prevHref={prevPage ? qs(prevPage) : null}
    nextHref={nextPage ? qs(nextPage) : null}
    page={page}
    label="DReps pagination"
  />

  {concentration.drepCount > 0 && (
    <DrepConcentration
      client:visible
      topK={concentration.topK}
      byPercent={concentration.byPercent}
      drepCount={concentration.drepCount}
      totalLabel={concentration.totalLabel}
      markers={markers}
      defaultThresholdPct={defaultThresholdPct}
      thresholdsAsOf={thresholdsAsOf}
    />
  )}

  {dreps.length > 0 && <DrepActionsMenu client:idle network={network} />}
</Layout>

<style>
  /* Quiet banner linking to the /match/ quiz, reusing the directory's stat-tile
     tokens (border, radius, surface) so it reads as part of the page, not an ad. */
  .drep-match-teaser {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    margin: 0 0 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s ease;
  }
  .drep-match-teaser:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .drep-match-teaser strong {
    font-size: 0.9375rem;
  }
  .drep-match-teaser span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
