---
export const prerender = false;

import { requestDb } from '@/lib/db/requestDb.js';
import Layout from '@/layouts/Layout.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import DrepActionsMenu from '@/components/DrepActionsMenu.tsx';
import DrepRowActions from '@/components/DrepRowActions.astro';
import { loadTrackingViewer } from '@/lib/delegation/viewer';
import DrepSelfCard from '@/components/DrepSelfCard.astro';
import DrepTrendChip from '@/components/DrepTrendChip.astro';
import Pager from '@/components/Pager.astro';
import SortPrefRestore from '@/components/SortPrefRestore.astro';
import {
  listDreps,
  listDrepsForConcentration,
  getDrepRanking,
  getDrepById,
  getDrepOrderRow,
  getDrepsInOrder,
  listDrepOrderRows,
  countRegularVoters,
  type Drep,
  type DrepRanking,
} from '@/lib/db/dreps.js';
import {
  DEFAULT_DREP_LIST_SORT,
  DREP_LIST_SORTS,
  FIRST_GROUP_MIN_PARTICIPATION_PCT,
  drepListHref,
  drepListPage,
  explicitDrepListSort,
  firstGroupMiss,
  firstGroupStandingLine,
  orderDrepList,
  parseDrepListSort,
  utcDayKey,
  wholePercent,
  type DrepListSort,
  type DrepListUrlState,
  type DrepOrderRow,
} from '@/lib/dreps/listOrder.js';
import { MATCH_THRESHOLDS } from '@/lib/match/logic.js';
import '@/styles/seg.css';
import { getSelfDrepId } from '@/lib/db/users.js';
import { getVotingPowerEpochAggregates } from '@/lib/db/drepVotingPowerHistory.js';
import { computeConcentration } from '@/lib/dreps/concentration.js';
import { hubHref } from '@/lib/analytics/hubSections.js';
import { contiguousTail, recentSeries, GLANCE_WINDOW_EPOCHS } from '@/lib/analytics/hubView.js';
import { listLatestEpochStats } from '@/lib/db/governanceEpochStats.js';
import DonutRing from '@/components/DonutRing.astro';
import Sparkline from '@/components/Sparkline.astro';
import { computeDrepStatTrends } from '@/lib/dreps/statTrend.js';
import DrepStatCard from '@/components/DrepStatCard.astro';
import type { VitalCard } from '@/lib/statCard.js';
import { influencePct } from '@/lib/dreps/profile.js';
import { computeVotingPowerDelta } from '@/lib/dreps/votingPowerTrend.js';
import { drepCredentialHexFromId } from '@/lib/cardano/identity.js';
import { currentNetwork } from '@/lib/api/response';
import { parsePage, pageToOffset, cacheControlForSynced, formatAda, formatAdaCompact } from '@/lib/forum/view.js';
import { drepDescriptor } from '@/lib/forum/author.js';
import { drepGroupsAvailable } from '@/lib/groups/gate.js';
import { groupIdParam, groupIdString } from '@/lib/groups/ids.js';
import { shortGroupId } from '@/lib/groups/view.js';

const db = requestDb();
const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const activeOnly = Astro.url.searchParams.get('all') !== '1';
// Order of the list from the query string. A missing or unknown value is the
// default view (active DReps first). sortInUrl keeps whether the URL named one,
// so the in-list links carry the param only when the reader chose it.
const sortParam = Astro.url.searchParams.get('sort');
const sort = parseDrepListSort(sortParam);
const sortInUrl = explicitDrepListSort(sortParam);
// Voting power floor of the first group, the same floor the match quiz uses.
const floor = BigInt(MATCH_THRESHOLDS[currentNetwork().network].powerFloorLovelace);
// Offset into the ordered listing. In the two rankings it is also the base for
// each row's rank number (rank = offset + row index + 1), so ranks stay
// continuous across pages.
const listOffset = pageToOffset(page, PAGE_SIZE);
// Group filter, where DRep groups run. A malformed value, or groups tables that are not there yet, show the normal list.
const groupParam = drepGroupsAvailable(currentNetwork().network) ? groupIdParam(Astro.url.searchParams.get('group') ?? undefined) : null;
const groupRead =
  groupParam && db ? await (await import('@/lib/db/drepGroups.js')).getGroup(db, groupIdString(groupParam)) : undefined;
const groupRef = groupRead === undefined ? null : groupParam;
const groupId = groupRef ? groupIdString(groupRef) : null;
const groupName = groupRead?.profile?.name ?? null;
// URL state of the list. Every link inside the list is built from it through
// drepListHref, which always returns the full "/dreps/" path.
const listState: DrepListUrlState = { sortInUrl, all: !activeOnly, group: groupId };
const removeGroupHref = drepListHref(listState, { group: null });

// The directory listing (or, in the default view, the ordering columns of every
// DRep in the filter), the concentration aggregate, the power-history
// aggregates, the regular voter count, the signed-in DRep id and the tracking
// viewer are independent reads, fetch them concurrently so a cold (uncached)
// render pays one round-trip of latency, not several. One listing slot is filled per view, the other is null.
const user = Astro.locals.user;
const [listingReads, selfDrepId, trackingViewer] = await Promise.all([
  db
    ? Promise.all([
        sort === 'active' ? listDrepOrderRows(db, { activeOnly, group: groupRef ?? undefined }) : null,
        sort === 'active'
          ? null
          : listDreps(db, { activeOnly, limit: PAGE_SIZE, offset: listOffset, sort, group: groupRef ?? undefined }),
        listDrepsForConcentration(db),
        getVotingPowerEpochAggregates(db),
        // A short epoch window for the concentration teaser's trend line.
        listLatestEpochStats(db, GLANCE_WINDOW_EPOCHS),
        // The "Vote regularly" figure of the header band, global like the other three.
        countRegularVoters(db, FIRST_GROUP_MIN_PARTICIPATION_PCT),
      ])
    : null,
  // The signed-in DRep, for the pinned "this is you" card and the row highlight.
  db ? getSelfDrepId(db, user) : null,
  // The dialog offers delegation tracking after a successful delegation, which
  // needs to know whether this account has a stake wallet linked at all.
  loadTrackingViewer(db, user?.id ?? null),
]);
const [orderRows, rankingRows, concentrationRows, powerAggregates, recentEpochStats, regularVoterCount] =
  listingReads ?? [null, null, [], [], [], 0];

// Default view: the first group in today's order, then everyone else by
// participation. Only the visible page of full rows is loaded.
const order = orderRows ? orderDrepList(orderRows, { day: utcDayKey(Date.now()), floorLovelace: floor }) : null;
const orderRowById = new Map<string, DrepOrderRow>(orderRows ? orderRows.map((r) => [r.drepId, r]) : []);
const firstGroupSize = order?.firstGroupSize ?? 0;
// This page of the default view: its ids, the id the divider row goes before
// (null when this page has no divider) and whether a next page exists.
const orderPage = order ? drepListPage(order.ids, firstGroupSize, listOffset, PAGE_SIZE) : null;
const dividerBeforeId = orderPage?.dividerBeforeId ?? null;
const dreps: Drep[] = rankingRows ?? (db && orderPage ? await getDrepsInOrder(db, orderPage.pageIds) : []);
// Top-10 share per epoch for the teaser sparkline (the live figure above it
// comes from the current snapshot, the line from the stored epoch series).
const top10Series = recentSeries(contiguousTail(recentEpochStats), 'top10SharePct');

// Voting power concentration: all active, non-special DReps as BigInt powers.
// Parse lovelace defensively so a single malformed row cannot 500 the page
// (Koios writes plain integer strings, but the column is untrusted text).
const toLovelace = (s: string | null): bigint => {
  try {
    return BigInt(s ?? '0');
  } catch {
    return 0n;
  }
};
const concentration = computeConcentration(
  concentrationRows.map((r) => ({ drepId: r.drepId, name: r.name, slug: r.slug, power: toLovelace(r.votingPower) })),
);

function selfStandingLine(r: DrepRanking): string {
  const n = (v: number): string => v.toLocaleString('en-US');
  if (r.rank != null)
    return `Rank #${n(r.rank)} of ${n(r.total)} by ${sort === 'delegators' ? 'delegators' : 'voting power'}`;
  if (activeOnly && !r.drep.active) return 'Retired, not in the active ranking';
  if (sort === 'delegators') return 'Delegator count pending';
  return `Not yet ranked (of ${n(r.total)})`;
}

// The signed-in DRep's row and the standing line of the pinned "this is you" card.
// Under the rankings the card shows the rank in this listing (same filter and sort).
// In the default view it says whether the DRep is in the first group. The card
// ignores the group filter in every view. Both stay null when no DRep is found.
let selfDrep: Drep | null = null;
let selfStanding: string | null = null;
if (db && selfDrepId) {
  if (sort === 'active') {
    // Both rows must exist, a session can carry a DRep id that has no row yet.
    const [drep, orderRow] = await Promise.all([getDrepById(db, selfDrepId), getDrepOrderRow(db, selfDrepId)]);
    if (drep && orderRow) {
      selfDrep = drep;
      selfStanding = firstGroupStandingLine(firstGroupMiss(orderRow, floor), orderRow.participationPct, floor);
    }
  } else {
    const ranking = await getDrepRanking(db, selfDrepId, { activeOnly, sort });
    if (ranking) {
      selfDrep = ranking.drep;
      selfStanding = selfStandingLine(ranking);
    }
  }
}

// The same total the donut uses (active, non-special), so a row's table share and
// the concentration view agree. Number is exact enough for the percent display.
const totalActivePower = Number(concentration.totalPower);

// Header band figures. The current values come from the live concentration (the
// authoritative active set), the "this epoch" deltas from the per-epoch history
// aggregates (newest first). Deltas stay hidden until two epochs exist.
const statTrends = computeDrepStatTrends(powerAggregates[0], powerAggregates[1]);
// Concentration headline: the share of active voting power held by the ten largest
// DReps (topK carries more than ten, so slicing is safe).
const top10Pct = concentration.topK.slice(0, 10).reduce((acc, t) => acc + t.pct, 0);

// The four cells of the header band, in order. `trend` renders the "this epoch"
// line, `sub` is a static caption for a cell without an epoch delta.
const thisEpoch = (t: VitalCard['trend']) => t && { ...t, label: `${t.label} this epoch` };
const bandCells: VitalCard[] = [
  {
    label: 'Active DReps', icon: 'people', value: concentration.drepCount.toLocaleString('en-US'),
    trend: thisEpoch(statTrends.activeDreps),
  },
  {
    label: 'Vote regularly', icon: 'ballot',
    value: regularVoterCount.toLocaleString('en-US'),
    sub: `on at least ${FIRST_GROUP_MIN_PARTICIPATION_PCT}% of actions`,
  },
  {
    label: 'Total voting power', icon: 'power', value: formatAdaCompact(concentration.totalPower),
    trend: thisEpoch(statTrends.totalPower),
  },
  { label: 'Top 10 control', icon: 'share', value: `${top10Pct.toFixed(1)}%`, sub: 'held by the 10 largest' },
];

// DrepActionsMenu uses the deployment's real network for the delegation tx + explorer links.
const network = currentNetwork().network;

Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));

const nextPage = (orderPage ? orderPage.hasNext : dreps.length === PAGE_SIZE) ? page + 1 : null;
const prevPage = page > 1 ? page - 1 : null;
const pageHref = (p: number): string => drepListHref(listState, { page: p });

// Rule line above the default view's table, only when a first group exists and the page has rows.
const firstGroupRule =
  firstGroupSize === 1
    ? { lead: '1 DRep is shown first, in an order that changes every day. It voted', meets: 'meets' }
    : { lead: `${firstGroupSize.toLocaleString('en-US')} DReps are shown first, in an order that changes every day. They voted`, meets: 'meet' };

// Intro sentence and meta description by view. In the default view the rule
// line above the table explains the daily order.
const VIEW_COPY: Record<DrepListSort, { intro: string; meta: string }> = {
  active: {
    intro: 'Decentralized Representatives in Cardano governance.',
    meta: "Browse every Cardano DRep, with those who vote regularly shown first. See each delegate representative's voting record, delegation, and governance participation on DRepTalk.",
  },
  delegators: {
    intro: 'Decentralized Representatives in Cardano governance, ranked by number of delegators.',
    meta: "Browse every Cardano DRep ranked by number of delegators. See each delegate representative's voting record, delegation, and governance participation on DRepTalk.",
  },
  power: {
    intro: 'Decentralized Representatives in Cardano governance, ranked by active voting power.',
    meta: "Browse every Cardano DRep ranked by active voting power. See each delegate representative's voting record, delegation, and governance participation on DRepTalk.",
  },
};
// The default view's meta falls back to plain copy when the first group is
// empty, so the description does not promise an order the page cannot show.
const EMPTY_FIRST_GROUP_META =
  "Browse every Cardano DRep. See each delegate representative's voting record, delegation, and governance participation on DRepTalk.";
const introText = VIEW_COPY[sort].intro;
const metaDescription = sort === 'active' && firstGroupSize === 0 ? EMPTY_FIRST_GROUP_META : VIEW_COPY[sort].meta;

// The 28-byte DRep credential the delegation tx targets. Prefer the stored Koios
// `hex`; fall back to deriving it from the drep id. Null disables the delegate
// action for that row (it stays viewable/copyable).
const credentialHexFor = (d: typeof dreps[number]): string | null =>
  d.hex ?? drepCredentialHexFromId(d.drepId);

// A row's share of the active voting power, formatted for the table. Sub-0.01%
// rounds to "<0.01%" rather than a misleading "0.00%".
const pctLabel = (pct: number): string => (pct < 0.01 ? '<0.01%' : `${pct.toFixed(2)}%`);

// The largest DRep share, used to scale the row bars. A bar is drawn relative to
// the leader (whose bar is full), not to an absolute 0..100% axis, so the bars
// stay legible (top shares are only a few percent) and comparable across pages.
const maxPct = concentration.topK[0]?.pct ?? 0;
const barWidth = (pct: number): string => {
  const w = maxPct > 0 ? Math.min((pct / maxPct) * 100, 100) : 0;
  return `${w.toFixed(2)}%`;
};

const deltaTitle = (dir: 'up' | 'down' | 'flat'): string =>
  dir === 'up'
    ? 'Voting power up since the previous epoch'
    : dir === 'down'
      ? 'Voting power down since the previous epoch'
      : 'Voting power unchanged since the previous epoch';

// The pinned self-card contents (standing line, identity, latest-epoch trend), derived
// once so the template stays declarative. Null unless a DRep is signed in and found.
const selfDescriptor = selfDrep ? drepDescriptor(selfDrep) : null;
const selfDelta = selfDrep ? computeVotingPowerDelta(selfDrep.votingPowerSnapshot, selfDrep.votingPowerPrev) : null;
---

{/* wide: all four primary-nav destinations share the wide shell, so the content
    column keeps one width while moving through the main nav. */}
<Layout title="Cardano DReps - Delegate Representatives - DRepTalk" description={metaDescription} ogImage="/og-dreps.jpg" wide>
  <SortPrefRestore storageKey="dreptalk:dreps-sort" sorts={DREP_LIST_SORTS.map((s) => s.mode)} defaultSort={DEFAULT_DREP_LIST_SORT} />
  <div class="dreps-head">
    <h1>DReps</h1>
    <a class="btn btn-primary" href="/match/">Find your DRep</a>
  </div>
  <p class="dreps-intro">
    {introText}{' '}
    New to this? Learn <a href="/help/delegate-to-a-drep/">how to delegate your voting power</a>{' '}
    or <a href="/help/become-a-drep/">how to become a DRep</a> yourself.
  </p>

  {concentration.drepCount > 0 && (
    <div class="drep-stats">
      {bandCells.map((card) => <DrepStatCard card={card} />)}
    </div>
  )}

  {groupId && (
    <p class="dreps-filter">
      Showing members of <a href={`/groups/${groupId}/`}>{groupName ?? shortGroupId(groupId)}</a>
      <span style="margin:0 0.5rem;color:var(--muted);" aria-hidden="true">&middot;</span>
      <a href={removeGroupHref}>Remove group filter</a>
    </p>
  )}

  {selfDescriptor && selfStanding && (
    <DrepSelfCard descriptor={selfDescriptor} standing={selfStanding}>
      {selfDrep?.votingPower != null && (
        <span class="drep-self-power">{formatAdaCompact(selfDrep.votingPower)}</span>
      )}
      {selfDelta && (
        <DrepTrendChip delta={selfDelta} flatBar title={deltaTitle(selfDelta.direction)} showAda={false} />
      )}
    </DrepSelfCard>
  )}

  {/* Toolbar directly above the table: the order on the left, the filter links on the right. */}
  <div class="dreps-toolbar">
    <div class="seg" role="group" aria-label="Order of the list">
      {DREP_LIST_SORTS.map((o) => (
        <a
          class="seg__btn"
          href={drepListHref(listState, { sort: o.mode })}
          aria-current={o.mode === sort ? 'true' : undefined}
          rel="nofollow"
        >
          {o.label}
        </a>
      ))}
    </div>
    <span>
      {activeOnly ? (
        <a href={drepListHref(listState, { all: true })}>Show all DReps</a>
      ) : (
        <a href={drepListHref(listState, { all: false })}>Active only</a>
      )}
      <span style="margin:0 0.5rem;color:var(--muted);" aria-hidden="true">&middot;</span>
      <a href="/dreps/movers/">Movers of the epoch</a>
    </span>
  </div>

  {sort === 'active' && firstGroupSize > 0 && dreps.length > 0 && (
    <p class="dreps-filter">
      {firstGroupRule.lead} on at least {FIRST_GROUP_MIN_PARTICIPATION_PCT}% of governance actions and {firstGroupRule.meets}{' '}
      <a href="/help/delegate-to-a-drep/#how-the-drep-list-is-ordered">the other conditions for the first group</a>.
    </p>
  )}

  {dreps.length === 0 ? (
    <p style="color:var(--muted);">No DReps found.</p>
  ) : sort === 'active' ? (
    <table class="drep-table drep-table--active">
      <thead>
        <tr>
          <th scope="col">DRep</th>
          <th scope="col" class="drep-table__voted-h">Voted</th>
          <th scope="col" class="drep-table__rationales-h">Rationales</th>
          <th scope="col" class="drep-table__power-h">Voting power</th>
          <th scope="col" class="drep-table__delegators-h">Delegators</th>
          <th scope="col" class="drep-table__actions-h">Actions</th>
        </tr>
      </thead>
      <tbody>
        {dreps.map((d) => {
          const descriptor = drepDescriptor(d);
          const cred = credentialHexFor(d);
          const isSelf = selfDrepId != null && d.drepId === selfDrepId;
          const orderRow = orderRowById.get(d.drepId);
          const participation = orderRow?.participationPct ?? null;
          const voted = participation === null ? null : wholePercent(participation);
          const rationales = orderRow?.rationalePct ?? null;
          return (
            <>
              {d.drepId === dividerBeforeId && (
                <tr class="drep-table__divider">
                  <td>Other DReps, by share of actions voted on</td>
                  <td class="drep-table__voted"></td>
                  <td class="drep-table__rationales"></td>
                  <td class="drep-table__power"></td>
                  <td class="drep-table__delegators"></td>
                  <td class="drep-table__actions"></td>
                </tr>
              )}
              <tr class:list={{ 'drep-row--self': isSelf }}>
                <td>
                  <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate />
                </td>
                <td class="drep-table__voted">
                  {voted === null ? (
                    'n/a'
                  ) : (
                    <span class="drep-voted">
                      <span class="drep-voted__pct">{voted}%</span>
                      <span class="drep-voted__bar" aria-hidden="true">
                        <span class="drep-voted__fill" style={`width:${Math.min(Math.max(voted, 0), 100)}%`}></span>
                      </span>
                    </span>
                  )}
                </td>
                <td class="drep-table__rationales">{rationales === null ? 'n/a' : `${wholePercent(rationales)}%`}</td>
                <td class="drep-table__power">
                  <div class="drep-power">
                    <span class="drep-power__ada">
                      <span class="drep-power__ada-full">{formatAda(d.votingPower)}</span>
                      <span class="drep-power__ada-compact">{formatAdaCompact(d.votingPower)}</span>
                    </span>
                  </div>
                </td>
                <td class="drep-table__delegators">
                  {d.delegatorCount != null ? d.delegatorCount.toLocaleString('en-US') : 'n/a'}
                </td>
                <td class="drep-table__actions">
                  <DrepRowActions drep={d} name={descriptor.displayName} cred={cred} />
                </td>
              </tr>
            </>
          );
        })}
      </tbody>
    </table>
  ) : (
    <table class:list={['drep-table', { 'drep-table--by-delegators': sort === 'delegators' }]}>
      <thead>
        <tr>
          <th scope="col" class="drep-table__rank-h"><span class="sr-only">Rank</span></th>
          <th scope="col">DRep</th>
          <th scope="col" class="drep-table__power-h">Voting power</th>
          <th scope="col" class="drep-table__trend-h">Trend <span class="drep-table__trend-sub">(vs last epoch)</span></th>
          <th scope="col" class="drep-table__delegators-h">Delegators</th>
          <th scope="col" class="drep-table__actions-h">Actions</th>
        </tr>
      </thead>
      <tbody>
        {dreps.map((d, i) => {
          const descriptor = drepDescriptor(d);
          const pct = influencePct(d.votingPower, totalActivePower);
          const delta = computeVotingPowerDelta(d.votingPowerSnapshot, d.votingPowerPrev);
          const cred = credentialHexFor(d);
          const rank = listOffset + i + 1;
          const isSelf = selfDrepId != null && d.drepId === selfDrepId;
          return (
            <tr class:list={{ 'drep-row--self': isSelf }}>
              <td class="drep-table__rank">#{rank}</td>
              <td>
                <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate>
                  <span slot="sub" class="drep-table__ranksub">#{rank}</span>
                </AuthorIdentity>
              </td>
              <td class="drep-table__power">
                <div class="drep-power">
                  <span class="drep-power__ada">
                    <span class="drep-power__ada-full">{formatAda(d.votingPower)}</span>
                    <span class="drep-power__ada-compact">{formatAdaCompact(d.votingPower)}</span>
                  </span>
                  {pct != null && (
                    <span class="drep-power__meter">
                      <span class="drep-power__pct">{pctLabel(pct)}</span>
                      <span class="drep-power__bar" aria-hidden="true">
                        <span class="drep-power__fill" style={`width:${barWidth(pct)}`}></span>
                      </span>
                    </span>
                  )}
                </div>
              </td>
              <td class="drep-table__trend">
                {delta && <DrepTrendChip delta={delta} flatBar parens title={deltaTitle(delta.direction)} />}
              </td>
              <td class="drep-table__delegators">
                {d.delegatorCount != null ? d.delegatorCount.toLocaleString('en-US') : 'n/a'}
              </td>
              <td class="drep-table__actions">
                <DrepRowActions drep={d} name={descriptor.displayName} cred={cred} />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}

  <Pager
    prevHref={prevPage ? pageHref(prevPage) : null}
    nextHref={nextPage ? pageHref(nextPage) : null}
    page={page}
    label="DReps pagination"
  />

  {concentration.drepCount > 0 && (
    <a class="drep-conc-teaser drep-stat--alt" href={hubHref('decentralization')}>
      <DonutRing pct={top10Pct} class="drep-conc-teaser__ring" />
      <span class="drep-conc-teaser__text">
        <strong>Voting power concentration</strong>
        <span>The top 10 DReps hold {top10Pct.toFixed(1)}% of the delegated power. Explore the full picture, thresholds and trends in the decentralization chapter of the analytics page.</span>
      </span>
      {top10Series.length >= 2 && (
        <span class="drep-conc-teaser__trend">
          <Sparkline series={top10Series} />
          <span class="drep-conc-teaser__trend-label">Top-10 share, last {top10Series.length} epochs</span>
        </span>
      )}
    </a>
  )}

  {dreps.length > 0 && <DrepActionsMenu client:idle network={network} viewer={trackingViewer} />}
</Layout>

<style>
  /* Quiet banner linking to the /analytics/ page, reusing the directory's
     stat-tile tokens (border, radius, surface) so it reads as part of the page. */
  .drep-conc-teaser {
    display: flex;
    align-items: center;
    gap: 1rem;
