---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import DrepConcentration from '@/components/DrepConcentration.tsx';
import { listDreps, listDrepsForConcentration } from '@/lib/db/dreps.js';
import { computeConcentration } from '@/lib/dreps/concentration.js';
import { getDrepThresholds, DEFAULT_MARKERS } from '@/lib/dreps/thresholds.js';
import { parsePage, pageToOffset, cacheControlForSynced, formatAda } from '@/lib/forum/view.js';
import type { AuthorDescriptor } from '@/lib/forum/author.js';

const db = env.DB as D1Database | undefined;
const PAGE_SIZE = 50;
const page = parsePage(Astro.url.searchParams.get('page'));
const query = (Astro.url.searchParams.get('q') ?? '').slice(0, 64);
const activeOnly = Astro.url.searchParams.get('all') !== '1';

// The directory listing, the concentration aggregate, and the live thresholds
// are independent reads; fetch them concurrently so a cold (uncached) render
// pays one round-trip of latency, not three.
const [dreps, concentrationRows, storedThresholds] = db
  ? await Promise.all([
      listDreps(db, { activeOnly, query, limit: PAGE_SIZE, offset: pageToOffset(page, PAGE_SIZE) }),
      listDrepsForConcentration(db),
      getDrepThresholds(db),
    ])
  : [[], [], null];

// Voting power concentration: all active, non-special DReps as BigInt powers.
// Parse lovelace defensively so a single malformed row cannot 500 the page
// (Koios writes plain integer strings, but the column is untrusted text).
const toLovelace = (s: string | null): bigint => {
  try {
    return BigInt(s ?? '0');
  } catch {
    return 0n;
  }
};
const concentration = computeConcentration(
  concentrationRows.map((r) => ({ drepId: r.drepId, name: r.name, power: toLovelace(r.votingPower) })),
);
const markersPct = (storedThresholds?.markers ?? DEFAULT_MARKERS).map((m) => Math.round(m * 100));
const defaultThresholdPct = markersPct.includes(67) ? 67 : (markersPct[Math.floor(markersPct.length / 2)] ?? 67);
const thresholdsAsOf = storedThresholds ? new Date(storedThresholds.asOf).toISOString().slice(0, 10) : null;

Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));

const nextPage = dreps.length === PAGE_SIZE ? page + 1 : null;
const prevPage = page > 1 ? page - 1 : null;
const qs = (p: number) => `?page=${p}${query ? `&q=${encodeURIComponent(query)}` : ''}${activeOnly ? '' : '&all=1'}`;

const descriptorFor = (d: typeof dreps[number]): AuthorDescriptor => ({
  authorId: d.drepId,
  displayName: d.name ?? d.drepId,
  drepId: d.drepId,
  hasImage: !!d.imageUrl,
  identiconSeed: d.hex ?? d.drepId,
  badges: [],
});
---

<Layout title="DReps - DRepTalk" description="Browse Cardano DReps by voting power on DRepTalk.">
  <h1>DReps</h1>

  {concentration.drepCount > 0 && (
    <DrepConcentration
      client:visible
      topK={concentration.topK}
      byPercent={concentration.byPercent}
      drepCount={concentration.drepCount}
      totalLabel={concentration.totalLabel}
      markersPct={markersPct}
      defaultThresholdPct={defaultThresholdPct}
      thresholdsAsOf={thresholdsAsOf}
    />
  )}

  <form method="get" style="display:flex;gap:0.5rem;margin:1rem 0;flex-wrap:wrap;">
    <input type="search" name="q" value={query} placeholder="Search by name" style="flex:1;min-width:12rem;padding:0.5rem;border:1px solid var(--border);border-radius:var(--radius-sm);" />
    {!activeOnly && <input type="hidden" name="all" value="1" />}
    <button type="submit">Search</button>
  </form>

  <p style="font-size:0.8125rem;color:var(--muted);">
    {activeOnly
      ? <a href={`?all=1${query ? `&q=${encodeURIComponent(query)}` : ''}`}>Show all DReps</a>
      : <a href={query ? `?q=${encodeURIComponent(query)}` : '?'}>Active only</a>}
  </p>

  {dreps.length === 0 ? (
    <p style="color:var(--muted);">No DReps found.</p>
  ) : (
    <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:0.25rem;">
      {dreps.map((d) => (
        <li style="display:flex;align-items:center;gap:0.75rem;border-top:1px solid var(--border);padding:0.6rem 0;">
          <AuthorIdentity author={descriptorFor(d)} />
          <span style="margin-left:auto;color:var(--muted);font-size:0.875rem;">{formatAda(d.votingPower)}</span>
        </li>
      ))}
    </ul>
  )}

  {(prevPage || nextPage) && (
    <nav style="display:flex;gap:1rem;margin-top:1.5rem;font-size:0.875rem;">
      {prevPage && <a href={qs(prevPage)}>Previous</a>}
      {nextPage && <a href={qs(nextPage)}>Next</a>}
    </nav>
  )}
</Layout>
