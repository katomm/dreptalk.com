---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import NotFound from '@/components/NotFound.astro';
import DrepVotingStats from '@/components/DrepVotingStats.astro';
import { getDrepByIdOrSlug } from '@/lib/db/dreps.js';
import { linkDisplayLabel } from '@/lib/dreps/linkLabel.js';
import { getUserByDrepId } from '@/lib/db/users.js';
import { getPostsByAuthor } from '@/lib/db/forum.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import {
  getDrepVotingHistory, countDrepVotes,
  getDrepVoteBreakdown, getDrepRationaleStats, getDrepParticipation,
} from '@/lib/db/drepVotes.js';
import { getBadgeHolderCounts } from '@/lib/db/badgeAwards.js';
import { loadEarnedBadges, pickShowcase } from '@/lib/badges/gallery.js';
import BadgeTile from '@/components/BadgeTile.astro';
import { isIndexableProfile, influencePct, drepPath, isCanonicalDrepParam } from '@/lib/drep/profile.js';
import { drepCredentialHexFromId } from '@/lib/cardano/identity.js';
import { currentNetwork } from '@/lib/api/response';
import Avatar from '@/components/Avatar.astro';
import DelegateButton from '@/components/DelegateButton.tsx';
import {
  cacheControlForSynced, formatAda, formatRelativeTime, truncateId, excerptFromHtml, SITE_ORIGIN,
} from '@/lib/forum/view.js';

const { drepId } = Astro.params;
const db = env.DB as D1Database | undefined;

const drep = drepId && db ? await getDrepByIdOrSlug(db, drepId) : null;

// A slugged profile has exactly one canonical URL: requests for the raw id
// redirect permanently so links, crawlers, and caches converge on the slug.
if (drep && drepId && !isCanonicalDrepParam(drep, drepId)) {
  return Astro.redirect(drepPath(drep), 301);
}

if (!drep) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Forum activity + total active power + voting history load together (independent reads).
const drepUser = drep && db ? await getUserByDrepId(db, drep.drepId) : null;
const [posts, activeStake, votingHistory, votesCast, voteBreakdown, rationaleStats, participation, earnedBadges, holderCounts] =
  await Promise.all([
    drepUser && db ? getPostsByAuthor(db, drepUser.id, { limit: 20 }) : Promise.resolve([]),
    db ? getActiveDrepStake(db) : Promise.resolve({ total: 0, asOf: null }),
    drep && db ? getDrepVotingHistory(db, drep.drepId, { limit: 20 }) : Promise.resolve([]),
    drep && db ? countDrepVotes(db, drep.drepId) : Promise.resolve(0),
    drep && db ? getDrepVoteBreakdown(db, drep.drepId) : Promise.resolve({ yes: 0, no: 0, abstain: 0, total: 0 }),
    drep && db ? getDrepRationaleStats(db, drep.drepId) : Promise.resolve({ total: 0, without: 0, withRationale: 0 }),
    drep && db ? getDrepParticipation(db, drep.drepId, drep.registeredEpoch) : Promise.resolve(null),
    drep && db ? loadEarnedBadges(db, drep.drepId, drepUser?.id ?? null) : Promise.resolve([]),
    drep && db ? getBadgeHolderCounts(db) : Promise.resolve(new Map<string, number>()),
  ]);

const showcase = pickShowcase(earnedBadges, holderCounts, 3);

const hasMetadata = !!(drep?.name || drep?.bio);
const indexable = !!drep && isIndexableProfile({ hasMetadata, postCount: posts.length, votesCast });

if (drep) {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const displayName = drep?.name ?? (drep ? truncateId(drep.drepId, 18) : '');
const influence = drep ? influencePct(drep.votingPower, activeStake.total) : null;

// A DRep that deregistered its credential: still viewable for the governance
// record, but clearly marked and no longer delegatable (no voting power).
const isRetired = !!drep && drep.status === 'deregistered';
const statusLabel = drep ? (drep.active ? 'Active' : isRetired ? 'Retired' : drep.status) : '';
const canonical = drep ? `${siteOrigin}${drepPath(drep)}` : siteOrigin;

// Delegation CTA: the island needs the deployment's network and the 28-byte
// DRep credential (stored `hex`, else derived from the id). When neither
// resolves, the credential is null and the button is omitted.
const delegateNetwork = currentNetwork().network;
const delegateCredentialHex = drep ? (drep.hex ?? drepCredentialHexFromId(drep.drepId)) : null;

const personLd = drep
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: displayName,
      identifier: drep.drepId,
      url: canonical,
      ...(drep.bio ? { description: excerptFromHtml(drep.bio, 300) } : {}),
      ...(drep.imageContentHash ? { image: `${siteOrigin}/api/avatar/${drep.imageContentHash}` } : {}),
    }
  : null;
---

{!drep ? (
  <NotFound noun="DRep" />
) : (
  <Layout
    title={`${displayName} - DRep on DRepTalk`}
    description={drep.bio ? excerptFromHtml(drep.bio, 155) : `On-chain DRep profile and activity for ${displayName} on DRepTalk.`}
    noindex={!indexable}
    ogImage={`/og/drep/${drep.slug ?? drep.drepId}.png`}
  >
    {personLd && <JsonLd data={personLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <a href="/dreps">DReps</a>
    </nav>

    <header style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.5rem;">
      <Avatar seed={drep.hex ?? drep.drepId} imageHash={drep.imageContentHash} size={96} />
      <div style="min-width:0;">
        <h1 style="margin:0 0 0.25rem;overflow-wrap:anywhere;">{displayName}</h1>
        <div style="font-size:0.8125rem;color:var(--muted);word-break:break-all;">{drep.drepId}</div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.5rem;font-size:0.8125rem;">
          <span style={`border:1px solid var(--border);border-radius:999px;padding:0.15rem 0.5rem;${drep.active ? '' : 'color:var(--muted);'}`}>{statusLabel}</span>
          <span style="border:1px solid var(--border);border-radius:999px;padding:0.15rem 0.5rem;">{formatAda(drep.votingPower)} voting power</span>
          {influence != null && (
            <span style="border:1px solid var(--border);border-radius:999px;padding:0.15rem 0.5rem;">{influence.toFixed(2)}% influence</span>
          )}
        </div>
      </div>
    </header>

    {isRetired && (
      <p style="border:1px solid var(--border);border-radius:8px;padding:0.5rem 0.75rem;color:var(--muted);font-size:0.875rem;max-width:65ch;margin:0 0 1rem;">
        This DRep has retired: the credential was deregistered on-chain, so it no longer holds voting power or accepts delegation. The history below is kept for the governance record.
      </p>
    )}

    {drep.bio && <p style="color:var(--fg);max-width:65ch;">{drep.bio}</p>}

    {drep.links && drep.links.length > 0 && (
      <ul style="list-style:none;padding:0;display:flex;gap:1rem;flex-wrap:wrap;">
        {drep.links.map((l) => (
          <li><a href={l.uri} rel="nofollow noopener" target="_blank">{linkDisplayLabel(l)}</a></li>
        ))}
      </ul>
    )}

    {drep.motivations && (
      <section style="max-width:65ch;margin-top:0.5rem;">
        <h2 style="font-size:1rem;margin:0 0 0.25rem;">Motivations</h2>
        <p style="color:var(--fg);margin:0;white-space:pre-wrap;">{drep.motivations}</p>
      </section>
    )}
    {drep.qualifications && (
      <section style="max-width:65ch;margin-top:0.5rem;">
        <h2 style="font-size:1rem;margin:0 0 0.25rem;">Qualifications</h2>
        <p style="color:var(--fg);margin:0;white-space:pre-wrap;">{drep.qualifications}</p>
      </section>
    )}
    {drep.paymentAddress && (
      <p style="font-size:0.8125rem;color:var(--muted);margin-top:0.5rem;">
        Payment address: <span style="font-family:ui-monospace, SFMono-Regular, Menlo, monospace;word-break:break-all;">{drep.paymentAddress}</span>
      </p>
    )}

    <p style="font-size:0.75rem;color:var(--muted);">On-chain data as of {formatRelativeTime(drep.lastSyncedAt, now)}.</p>

    {delegateCredentialHex && !isRetired && (
      <div style="margin-top:1.5rem;">
        <DelegateButton
          client:idle
          network={delegateNetwork}
          target={{
            drepId: drep.drepId,
            slug: drep.slug,
            name: displayName,
            credentialHex: delegateCredentialHex,
            isScript: drep.hasScript,
          }}
        />
      </div>
    )}

    <section style="margin-top:2rem;">
        <h2 style="font-size:1.125rem;">
          Badges <span style="color:var(--muted);font-weight:400;">({earnedBadges.length})</span>
        </h2>
        {showcase.length === 0 ? (
          <p style="color:var(--muted);">
            No badges yet. <a href={`${drepPath(drep)}/badges`}>See what can be earned</a>.
          </p>
        ) : (
          <div style="display:flex;gap:1.5rem;align-items:flex-start;flex-wrap:wrap;">
            {showcase.map((t) => (
              <BadgeTile name={t.badge.name} image={t.image} tier={t.tier} size={80} />
            ))}
            <a href={`${drepPath(drep)}/badges`} style="align-self:center;font-size:0.9375rem;">
              All badges →
            </a>
          </div>
        )}
      </section>

    <section style="margin-top:2rem;">
      <h2 style="font-size:1.125rem;">Forum activity</h2>
      {posts.length === 0 ? (
        <p style="color:var(--muted);">No forum posts yet.</p>
      ) : (
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:0.75rem;">
          {posts.map((p) => (
            <li style="border-top:1px solid var(--border);padding-top:0.75rem;">
              <a href={`/t/${p.topic_slug}#post-${p.id}`} style="font-weight:600;">{p.topic_title}</a>
              <span style="color:var(--muted);font-size:0.8125rem;margin-left:0.5rem;">{formatRelativeTime(p.created_at, now)}</span>
              <p style="margin:0.25rem 0 0;color:var(--muted);font-size:0.9375rem;">{excerptFromHtml(p.body_html, 160)}</p>
            </li>
          ))}
        </ul>
      )}
    </section>

    <DrepVotingStats breakdown={voteBreakdown} rationale={rationaleStats} participation={participation} />

    <section id="voting-history" style="margin-top:2rem;">
      <h2 style="font-size:1.125rem;">Voting history <span style="color:var(--muted);font-weight:400;">({votesCast})</span></h2>
      {votingHistory.length === 0 ? (
        <p style="color:var(--muted);">No recorded on-chain votes.</p>
      ) : (
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
          {votingHistory.map((h) => (
            <li style="display:flex;gap:0.75rem;align-items:center;border-top:1px solid var(--border);padding-top:0.5rem;">
              <span style="font-weight:600;min-width:4rem;">{h.vote}</span>
              {h.topic_slug
                ? <a href={`/t/${h.topic_slug}`}>{h.title ?? h.ga_id}</a>
                : <span>{h.title ?? h.ga_id}</span>}
              <span style="color:var(--muted);font-size:0.8125rem;margin-left:auto;">{h.status}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </Layout>
)}
