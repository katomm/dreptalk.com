---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import NotFound from '@/components/NotFound.astro';
import ProfileSyncing from '@/components/ProfileSyncing.astro';
import DrepVotingStats from '@/components/DrepVotingStats.astro';
import DrepPowerSparkline from '@/components/DrepPowerSparkline.astro';
import DrepVoteRow from '@/components/DrepVoteRow.astro';
import DrepForumRow from '@/components/DrepForumRow.astro';
import DrepRecentActivityRow from '@/components/DrepRecentActivityRow.astro';
import voteAnchorHop from '@/scripts/profile-vote-anchor.js?raw';
import activityTabs from '@/scripts/profile-activity-tabs.js?raw';
import { getDrepByIdOrSlug } from '@/lib/db/dreps.js';
import { getDrepVotingPowerSeries } from '@/lib/db/drepVotingPowerHistory.js';
import { linkDisplayLabel, dedupeLinks } from '@/lib/dreps/linkLabel.js';
import { splitSocialLinks } from '@/lib/dreps/socialLinks.js';
import SocialLinkIcons from '@/components/SocialLinkIcons.astro';
import { getUserByDrepId, getSelfDrepId } from '@/lib/db/users.js';
import { getPostsByAuthor } from '@/lib/db/forum.js';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation.js';
import {
  getDrepVotingHistory, countDrepVotes,
  getDrepVoteBreakdown, getDrepRationaleStats, getDrepParticipation,
} from '@/lib/db/drepVotes.js';
import { getVoterVoteHistory } from '@/lib/db/voteHistory.js';
import { getBadgeHolderCounts } from '@/lib/db/badgeAwards.js';
import { loadEarnedBadges, pickShowcase } from '@/lib/badges/gallery.js';
import BadgeTile from '@/components/BadgeTile.astro';
import { isIndexableProfile, influencePct, formatSharePct, drepPath, isCanonicalDrepParam, drepMetaDescription, drepProfileSummary } from '@/lib/dreps/profile.js';
import { buildRecentActivity } from '@/lib/dreps/recentActivity.js';
import { voteChangeStat } from '@/lib/dreps/voteStatsView.js';
import { formatEpochDate } from '@/lib/governance/view.js';
import { drepCredentialHexFromId } from '@/lib/cardano/identity.js';
import { ogCardVersion } from '@/lib/og/version.js';
import { currentNetwork } from '@/lib/api/response';
import Avatar from '@/components/Avatar.astro';
import CopyButton from '@/components/CopyButton.astro';
import ShareButton from '@/components/ShareButton.astro';
import DelegateButton from '@/components/DelegateButton.tsx';
import {
  cacheControlForSynced, formatAda, formatAdaCompact, formatRelativeTime, truncateId, truncateIdMiddle, excerptFromHtml, SITE_ORIGIN,
} from '@/lib/forum/view.js';

const { drepId } = Astro.params;
const db = env.DB as D1Database | undefined;

// The activity section's tab, link-based like the governance-action page:
// the default All feed lives at the plain profile URL, other tabs at ?tab=<id>.
// Layout canonicalizes to the bare path, so tab URLs never compete in search.
const PROFILE_TABS = ['all', 'votes', 'discussions', 'rationales'] as const;
type ProfileTab = (typeof PROFILE_TABS)[number];
const tabParam = Astro.url.searchParams.get('tab') ?? '';
const activeTab: ProfileTab = (PROFILE_TABS as readonly string[]).includes(tabParam)
  ? (tabParam as ProfileTab)
  : 'all';

const drep = drepId && db ? await getDrepByIdOrSlug(db, drepId) : null;

// A slugged profile has exactly one canonical URL: requests for the raw id
// redirect permanently so links, crawlers, and caches converge on the slug.
if (drep && drepId && !isCanonicalDrepParam(drep, drepId)) {
  return Astro.redirect(drepPath(drep), 301);
}

// A signed-in DRep viewing their own not-yet-synced profile (fresh on-chain
// registration waiting for the next DRep sync run): the account menu links
// here before the row exists, so render a "profile syncing" notice instead of
// a bare 404. getSelfDrepId reads the drep id cached on the session, so this
// costs no query on regular renders (a legacy session pays one, on this miss
// path only).
let ownProfileSyncing = false;
if (!drep && db && drepId && Astro.locals.user) {
  ownProfileSyncing = (await getSelfDrepId(db, Astro.locals.user)) === drepId;
}

if (!drep) {
  if (!ownProfileSyncing) Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// True when the signed-in viewer is this DRep: their vote rows prompt them to
// share their own rationale instead of offering a generic copy-link action.
const isOwner =
  !!drep && !!db && !!Astro.locals.user && (await getSelfDrepId(db, Astro.locals.user)) === drep.drepId;

// Forum activity + total active power + voting history load together (independent reads).
const drepUser = drep && db ? await getUserByDrepId(db, drep.drepId) : null;
const [posts, activeStake, votingHistory, votesCast, voteBreakdown, rationaleStats, participation, earnedBadges, holderCounts, powerSeries, voteHistoryMap] =
  await Promise.all([
    drepUser && db ? getPostsByAuthor(db, drepUser.id, { limit: 20 }) : Promise.resolve([]),
    db ? getActiveDrepStake(db) : Promise.resolve({ total: 0, asOf: null }),
    drep && db
      ? getDrepVotingHistory(db, drep.drepId, {
          limit: 500,
          // Rationale bodies only render on the votes/rationales tabs. The other
          // tabs need mere presence, so skip dragging KBs of HTML through SSR.
          rationalePresenceOnly: activeTab !== 'votes' && activeTab !== 'rationales',
        })
      : Promise.resolve([]),
    drep && db ? countDrepVotes(db, drep.drepId) : Promise.resolve(0),
    drep && db ? getDrepVoteBreakdown(db, drep.drepId) : Promise.resolve({ yes: 0, no: 0, abstain: 0, total: 0 }),
    drep && db ? getDrepRationaleStats(db, drep.drepId) : Promise.resolve({ total: 0, without: 0, withRationale: 0 }),
    drep && db ? getDrepParticipation(db, drep.drepId, drep.registeredEpoch) : Promise.resolve(null),
    drep && db ? loadEarnedBadges(db, { role: 'drep', id: drep.drepId, userId: drepUser?.id ?? null }) : Promise.resolve([]),
    drep && db ? getBadgeHolderCounts(db) : Promise.resolve(new Map<string, number>()),
    drep && db ? getDrepVotingPowerSeries(db, drep.drepId) : Promise.resolve([]),
    drep && db ? getVoterVoteHistory(db, drep.drepId) : Promise.resolve(new Map()),
  ]);

const showcase = pickShowcase(earnedBadges, holderCounts, 3);

// Voting history: show the first few, fold the rest into a pure-HTML "Show more".
const HISTORY_HEAD = 5;
const historyHead = votingHistory.slice(0, HISTORY_HEAD);
const historyTail = votingHistory.slice(HISTORY_HEAD);

// Rationales tab: the votes that carry a resolvable rationale, same row shape.
const rationaleRows = votingHistory.filter((h) => h.rationale_html);

// Vote-change meta line: counted from the re-vote history already loaded for
// the "changed from X" chips, so it costs no extra query.
const changeStat = voteChangeStat(
  voteHistoryMap,
  new Map(votingHistory.map((h) => [h.ga_id, h.vote])),
);
const rationaleHead = rationaleRows.slice(0, HISTORY_HEAD);
const rationaleTail = rationaleRows.slice(HISTORY_HEAD);

// Recognized platform links (X, GitHub, ...) surface as icons in the header;
// everything else stays a text link in the About section.
const { social: socialLinks, rest: textLinks } = splitSocialLinks(dedupeLinks(drep?.links ?? []));

const hasMetadata = !!(drep?.name || drep?.bio);
const indexable = !!drep && isIndexableProfile({ hasMetadata, postCount: posts.length });

// Merged recent-activity feed for the All tab: votes, published rationales, and
// forum posts on one timeline (newest first, deterministic type order at equal
// timestamps).
const recentActivity = drep
  ? buildRecentActivity({ votes: votingHistory, posts, voterId: drep.drepId, cfg: currentNetwork() }, 15)
  : [];
const recentHead = recentActivity.slice(0, HISTORY_HEAD);
const recentTail = recentActivity.slice(HISTORY_HEAD);

// Tab bar entries: Discussions and Rationales only appear when they have rows.
const profileTabs = drep
  ? ([
      { id: 'all' as const, label: 'All', count: null },
      { id: 'votes' as const, label: 'Votes', count: votesCast },
      ...(posts.length > 0 ? [{ id: 'discussions' as const, label: 'Discussions', count: posts.length }] : []),
      ...(rationaleRows.length > 0 ? [{ id: 'rationales' as const, label: 'Rationales', count: rationaleRows.length }] : []),
    ])
  : [];
// Tab links carry the #activity anchor so the reload lands back at the section
// instead of the page top; scroll-margin keeps it clear of the sticky header.
const tabHref = (id: ProfileTab): string =>
  drep ? (id === 'all' ? `${drepPath(drep)}#activity` : `${drepPath(drep)}?tab=${id}#activity`) : '';
// A hand-typed ?tab= for a hidden (empty) tab falls back to the All feed.
const renderTab: ProfileTab = profileTabs.some((t) => t.id === activeTab) ? activeTab : 'all';

// Long About texts clamp to a few lines with a CSS-only "Read more", short ones
// render plain. A rough length gate is enough, exact overflow depends on the
// viewport anyway.
const CLAMP_THRESHOLD = 320;

if (drep) {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
}

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const now = Date.now();
const displayName = drep?.name ?? (drep ? truncateId(drep.drepId, 18) : '');
const influence = drep ? influencePct(drep.votingPower, activeStake.total) : null;

// A DRep that deregistered its credential: still viewable for the governance
// record, but clearly marked and no longer delegatable (no voting power).
const isRetired = !!drep && drep.status === 'deregistered';
// Always exactly one explicit status pill: role ("DRep" chip) and status never
// share a pill, and Active is stated rather than implied by absence.
const statusLabel = isRetired ? 'Retired' : drep?.active ? 'Active' : 'Inactive';
const share = formatSharePct(influence);
const canonical = drep ? `${siteOrigin}${drepPath(drep)}` : siteOrigin;

// Delegation CTA: the island needs the deployment's network and the 28-byte
// DRep credential (stored `hex`, else derived from the id). When neither
// resolves, the credential is null and the button is omitted.
const delegateNetwork = currentNetwork().network;
const delegateCredentialHex = drep ? (drep.hex ?? drepCredentialHexFromId(drep.drepId)) : null;

// The DRep profile as a Person entity: name, on-chain identifier, canonical URL,
// and (when present) bio + avatar. Kept as its own node so it stays a
// self-contained entity nested under the ProfilePage below.
const personLd = drep
  ? {
      '@type': 'Person',
      name: displayName,
      identifier: drep.drepId,
      url: canonical,
      ...(drep.bio ? { description: excerptFromHtml(drep.bio, 300) } : {}),
      ...(drep.imageContentHash ? { image: `${siteOrigin}/api/avatar/${drep.imageContentHash}` } : {}),
    }
  : null;

// Wrap the Person as the mainEntity of a ProfilePage. Google has dedicated
// profile-page rich-result handling, and a DRep page is exactly that: a person
// profile. The Person keeps its own name/identifier/url, the ProfilePage carries
// the page URL, so the page node and the subject it is about stay distinct.
const profilePageLd = personLd
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: canonical,
      mainEntity: personLd,
    }
  : null;

// Breadcrumb trail (DRepTalk / DReps / this profile), matching the visible nav
// below and the pattern used on threads and categories.
const breadcrumbLd = drep
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'DRepTalk', item: siteOrigin + '/' },
        { '@type': 'ListItem', position: 2, name: 'DReps', item: siteOrigin + '/dreps/' },
        { '@type': 'ListItem', position: 3, name: displayName, item: canonical },
      ],
    }
  : null;

// Fallback profile prose, shown when the DRep has no free-text bio so the page
// still carries unique, indexable content instead of only stat widgets. Built
// from the same on-chain reads already loaded above.
const powerFormatted =
  drep && drep.votingPower && Number(drep.votingPower) > 0 ? formatAdaCompact(drep.votingPower) : null;
const profileSummary = drep
  ? drepProfileSummary({
      displayName,
      active: drep.active,
      retired: isRetired,
      registeredEpoch: drep.registeredEpoch ?? null,
      votingPowerFormatted: powerFormatted,
      influencePct: influence,
      votesCast,
      breakdown: voteBreakdown,
      withRationale: rationaleStats.withRationale,
      participation,
      forumPosts: posts.length,
    })
  : '';
---

{!drep ? (
  ownProfileSyncing ? <ProfileSyncing kind="drep" id={drepId ?? ''} /> : <NotFound noun="DRep" />
) : (
  <Layout
    title={`${displayName} - DRep on DRepTalk`}
    description={drepMetaDescription({
      displayName,
      votingPowerFormatted: formatAdaCompact(drep.votingPower),
      votesCast,
      retired: isRetired,
    })}
    noindex={!indexable}
    wide
    preloadImage={drep.imageContentHash ? `/api/avatar/${drep.imageContentHash}` : null}
    ogImage={`/og/drep/${drep.slug ?? drep.drepId}.png?v=${ogCardVersion([
      displayName,
      drep.votingPower,
      votesCast,
      influence,
      participation?.voted,
      participation?.eligible,
      drep.active,
      drep.registeredEpoch,
      drep.imageContentHash,
    ])}`}
  >
    {profilePageLd && <JsonLd data={profilePageLd} />}
    {breadcrumbLd && <JsonLd data={breadcrumbLd} />}

    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <a href="/dreps/">DReps</a>
    </nav>

    <header class="drep-hd">
      <span class="drep-hd__avatar">
        <Avatar seed={drep.hex ?? drep.drepId} imageHash={drep.imageContentHash} size={96} />
      </span>
      <div class="drep-hd__main">
        <div class="drep-hd__tags">
          <span class="drep-hd__kind">DRep</span>
          <span class={`drep-hd__status${drep.active && !isRetired ? ' drep-hd__status--ok' : ''}`}>
            <span class="drep-hd__dot" aria-hidden="true"></span>
            {statusLabel}
          </span>
        </div>
        <div class="drep-hd__titlerow">
          <h1 class="drep-hd__name">{displayName}</h1>
          {delegateCredentialHex && !isRetired && (
            <div class="drep-hd__cta">
              <DelegateButton
                client:idle
                network={delegateNetwork}
                target={{
                  drepId: drep.drepId,
                  slug: drep.slug,
                  name: displayName,
                  credentialHex: delegateCredentialHex,
                  isScript: drep.hasScript,
                }}
              />
            </div>
          )}
          <ShareButton url={new URL(Astro.url.pathname, Astro.url.origin).href} title={`${displayName} on DRepTalk`} ariaLabel="Share this profile" />
        </div>
        <div class="drep-hd__id"><span title={drep.drepId}>{truncateIdMiddle(drep.drepId)}</span><CopyButton value={drep.drepId} label="Copy DRep id" /></div>
        <p class="drep-hd__power">
          <span class="drep-hd__powerval drep-hd__value--full">{formatAda(drep.votingPower)}</span>
          <span class="drep-hd__powerval drep-hd__value--compact">{formatAdaCompact(drep.votingPower)}</span>
          <span class="drep-hd__powercap">voting power</span>
        </p>
        {(drep.delegatorCount != null || share) && (
          <p class="drep-hd__subline">
            {drep.delegatorCount != null && (
              <span>{drep.delegatorCount.toLocaleString('en-US')} {drep.delegatorCount === 1 ? 'delegator' : 'delegators'}</span>
            )}
            {drep.delegatorCount != null && share && <span class="drep-hd__sep" aria-hidden="true">·</span>}
            {share && <span>{share} of active voting power</span>}
          </p>
        )}
        <SocialLinkIcons links={socialLinks} />
      </div>
    </header>

    {isRetired && (
      <p style="border:1px solid var(--border);border-radius:8px;padding:0.5rem 0.75rem;color:var(--muted);font-size:0.875rem;max-width:65ch;margin:0 0 1rem;">
        This DRep has retired: the credential was deregistered on-chain, so it no longer holds voting power or accepts delegation. The history below is kept for the governance record.
      </p>
    )}

    <section class="about">
      <h2 class="about__h">About</h2>
      <div class="about__grid">
        <div class="about__block about__block--main">
          {drep.bio ? (
            <Fragment>
              <h3 class="about__field">Objectives</h3>
              <p class={`about__text${drep.bio.length > CLAMP_THRESHOLD ? ' about__text--clamp' : ''}`}>{drep.bio}</p>
              {drep.bio.length > CLAMP_THRESHOLD && (
                <details class="about__more">
                  <summary><span class="about__more-show">Read more</span><span class="about__more-hide">Show less</span></summary>
                </details>
              )}
            </Fragment>
          ) : (
            <Fragment>
              <h3 class="about__field">Overview</h3>
              <p class="about__gen">Generated from public on-chain data</p>
              <p class="about__text about__text--muted">{profileSummary}</p>
            </Fragment>
          )}
          {textLinks.length > 0 && (
            <ul class="about__links">
              {textLinks.map((l) => (
                <li><a href={l.uri} rel="nofollow noopener" target="_blank">{linkDisplayLabel(l)}</a></li>
              ))}
            </ul>
          )}
        </div>
        {drep.motivations && (
          <div class="about__block">
            <h3 class="about__field">Motivations</h3>
            <p class={`about__text${drep.motivations.length > CLAMP_THRESHOLD ? ' about__text--clamp' : ''}`}>{drep.motivations}</p>
            {drep.motivations.length > CLAMP_THRESHOLD && (
              <details class="about__more">
                <summary><span class="about__more-show">Read more</span><span class="about__more-hide">Show less</span></summary>
              </details>
            )}
          </div>
        )}
        {drep.qualifications && (
          <div class="about__block">
            <h3 class="about__field">Qualifications</h3>
            <p class={`about__text${drep.qualifications.length > CLAMP_THRESHOLD ? ' about__text--clamp' : ''}`}>{drep.qualifications}</p>
            {drep.qualifications.length > CLAMP_THRESHOLD && (
              <details class="about__more">
                <summary><span class="about__more-show">Read more</span><span class="about__more-hide">Show less</span></summary>
              </details>
            )}
          </div>
        )}
      </div>
    </section>

    <DrepVotingStats breakdown={voteBreakdown} rationale={rationaleStats} participation={participation} changes={changeStat} />

    <div class="drep-summary">
      <DrepPowerSparkline series={powerSeries} />
      <section class="drep-summary__badges">
        <h2 class="drep-summary__h">Recognition <span class="drep-summary__count">({earnedBadges.length})</span></h2>
        {showcase.length === 0 ? (
          <p class="drep-summary__empty">
            No badges yet. <a href={`${drepPath(drep)}badges/`}>See what can be earned</a>.
          </p>
        ) : (
          <Fragment>
            <div class="drep-summary__badgegrid">
              {showcase.map((t) => (
                <BadgeTile name={t.badge.name} image={t.image} tier={t.tier} tip={t.badge.description} size={56} />
              ))}
            </div>
            <a href={`${drepPath(drep)}badges/`} class="drep-summary__all">View all {earnedBadges.length} badges</a>
          </Fragment>
        )}
      </section>
    </div>

    <section id="activity" class="vhist-section">
      <h2 class="vhist-section__title">Activity</h2>
      <nav class="ptabs" aria-label="Activity sections">
        {profileTabs.map((t) => (
          <a
            class={`ptabs__tab${renderTab === t.id ? ' ptabs__tab--active' : ''}`}
            href={tabHref(t.id)}
            aria-current={renderTab === t.id ? 'page' : undefined}
          >
            {t.label}{t.count != null && <span class="ptabs__count">({t.count})</span>}
          </a>
        ))}
      </nav>

      {renderTab === 'all' && (recentActivity.length === 0 ? (
        <p class="vhist__empty">No recorded activity yet.</p>
      ) : (
        <div class="ract">
          {recentHead.map((e) => <DrepRecentActivityRow e={e} now={now} />)}
          {recentTail.length > 0 && (
            <details class="vhist__more">
              <summary class="vhist__more-toggle">
                <span class="vhist__more-show">Show {recentTail.length} more</span>
                <span class="vhist__more-hide">Show less</span>
              </summary>
              {recentTail.map((e) => <DrepRecentActivityRow e={e} now={now} />)}
            </details>
          )}
        </div>
      ))}

      {renderTab === 'votes' && (votingHistory.length === 0 ? (
        <p class="vhist__empty">No recorded on-chain votes.</p>
      ) : (
        <div class="vhist">
          <div class="vhist__row vhist__row--head" aria-hidden="true">
            <span>Vote</span>
            <span>Action</span>
            <span>Rationale</span>
            <span>Outcome</span>
            <span class="vhist__when-h">Voted</span>
          </div>
          {historyHead.map((h) => <DrepVoteRow row={h} now={now} earlier={voteHistoryMap.get(h.ga_id) ?? []} permalinkBase={canonical} isOwner={isOwner} />)}
          {historyTail.length > 0 && (
            <details class="vhist__more">
              <summary class="vhist__more-toggle">
                <span class="vhist__more-show">Show {historyTail.length} more</span>
                <span class="vhist__more-hide">Show less</span>
              </summary>
              {historyTail.map((h) => <DrepVoteRow row={h} now={now} earlier={voteHistoryMap.get(h.ga_id) ?? []} permalinkBase={canonical} isOwner={isOwner} />)}
              {votesCast > votingHistory.length && (
                <p class="vhist__truncated">Showing the {votingHistory.length} most recent votes.</p>
              )}
            </details>
          )}
        </div>
      ))}

      {renderTab === 'discussions' && (
        <div class="factivity">
          {posts.map((p) => <DrepForumRow post={p} now={now} />)}
        </div>
      )}

      {renderTab === 'rationales' && (
        <div class="vhist">
          <div class="vhist__row vhist__row--head" aria-hidden="true">
            <span>Vote</span>
            <span>Action</span>
            <span>Rationale</span>
            <span>Outcome</span>
            <span class="vhist__when-h">Voted</span>
          </div>
          {rationaleHead.map((h) => <DrepVoteRow row={h} now={now} earlier={voteHistoryMap.get(h.ga_id) ?? []} permalinkBase={canonical} isOwner={isOwner} />)}
          {rationaleTail.length > 0 && (
            <details class="vhist__more">
              <summary class="vhist__more-toggle">
                <span class="vhist__more-show">Show {rationaleTail.length} more</span>
                <span class="vhist__more-hide">Show less</span>
              </summary>
              {rationaleTail.map((h) => <DrepVoteRow row={h} now={now} earlier={voteHistoryMap.get(h.ga_id) ?? []} permalinkBase={canonical} isOwner={isOwner} />)}
            </details>
          )}
        </div>
      )}
    </section>

    {renderTab !== 'votes' && <script is:inline set:html={voteAnchorHop} />}
    <script is:inline set:html={activityTabs} />

    <section class="ocd">
      <h2 class="ocd__h">On-chain profile details</h2>
      <dl class="ocd__grid">
        <div class="ocd__item">
          <dt class="ocd__dt">DRep ID</dt>
          <dd class="ocd__dd"><span class="ocd__mono" title={drep.drepId}>{truncateIdMiddle(drep.drepId)}</span><CopyButton value={drep.drepId} label="Copy DRep id" /></dd>
        </div>
        {drep.paymentAddress && (
          <div class="ocd__item">
            <dt class="ocd__dt">Payment address</dt>
            <dd class="ocd__dd"><span class="ocd__mono" title={drep.paymentAddress}>{truncateIdMiddle(drep.paymentAddress)}</span><CopyButton value={drep.paymentAddress} label="Copy payment address" /></dd>
          </div>
        )}
        {drep.registeredAt != null && (
          <div class="ocd__item">
            <dt class="ocd__dt">{isRetired ? 'Last registered' : 'Registered since'}</dt>
            <dd class="ocd__dd">{formatEpochDate(drep.registeredAt)}</dd>
          </div>
        )}
        {drep.metadataLastUpdatedAt != null && (
          <div class="ocd__item">
            <dt class="ocd__dt">Last metadata update</dt>
            <dd class="ocd__dd">{formatRelativeTime(drep.metadataLastUpdatedAt * 1000, now)}</dd>
          </div>
        )}
        <div class="ocd__item">
          <dt class="ocd__dt">Data freshness</dt>
          <dd class="ocd__dd">On-chain data as of {formatRelativeTime(drep.lastSyncedAt, now)}</dd>
        </div>
      </dl>
    </section>
  </Layout>
)}

<style>
  .drep-hd {
