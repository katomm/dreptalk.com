---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import AuthorIdentity from '@/components/AuthorIdentity.astro';
import DrepSelfCard from '@/components/DrepSelfCard.astro';
import { AVATAR_SIZE } from '@/lib/forum/avatarSizes.js';
import { listVotingPowerMovers, getDrepMoverStanding, type Drep } from '@/lib/db/dreps.js';
import { getSelfDrepId } from '@/lib/db/users.js';
import { computeVotingPowerDelta, formatTrendPct, absLovelace } from '@/lib/dreps/votingPowerTrend.js';
import { cacheControlForSynced, formatAdaCompact } from '@/lib/forum/view.js';
import { drepDescriptor } from '@/lib/forum/author.js';
import { ogCardVersion } from '@/lib/og/version.js';
import { currentEpochProgress } from '@/lib/config/network.js';
import { currentNetwork } from '@/lib/api/response.js';

const db = env.DB as D1Database | undefined;

// How far the currently running epoch has progressed, for the indicator under
// the intro: the standings turn over at the next boundary. Deterministic epoch
// math (no chain query); a stale edge cache only shifts the bar by minutes.
const epochProgress = currentEpochProgress(Date.now(), currentNetwork());
const epochPct = Math.round(epochProgress.fractionElapsed * 100);
const daysLeftLabel = `~${epochProgress.daysLeft} ${epochProgress.daysLeft === 1 ? 'day' : 'days'} left`;

// Top gainers and losers by per-epoch voting-power delta. The data (per-epoch
// snapshots) is already maintained for the directory's delta chip; this is a new
// view over it, no new pipeline.
const { gainers, losers, epoch } = db
  ? await listVotingPowerMovers(db, { limit: 10 })
  : { gainers: [] as Drep[], losers: [] as Drep[], epoch: null };

if (db) {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
}

// The logged-in DRep's own movement this epoch, for the pinned "your movement"
// card, so they see how they moved even when outside the top-ten lists. Only runs
// when a DRep is signed in.
const selfDrepId = db ? await getSelfDrepId(db, Astro.locals.user) : null;
const selfStandingData = db && selfDrepId ? await getDrepMoverStanding(db, selfDrepId) : null;
const selfDescriptor = selfStandingData ? drepDescriptor(selfStandingData.drep) : null;
const selfDelta = selfStandingData
  ? computeVotingPowerDelta(selfStandingData.drep.votingPowerSnapshot, selfStandingData.drep.votingPowerPrev)
  : null;
const selfStanding: string | null = selfStandingData
  ? selfStandingData.direction === 'flat' || selfStandingData.rank == null
    ? 'No change in voting power this epoch'
    : `#${selfStandingData.rank.toLocaleString('en-US')} of ${selfStandingData.total.toLocaleString('en-US')} ${
        selfStandingData.direction === 'up' ? 'gainers' : 'losers'
      } this epoch`
  : null;

const hasData = gainers.length > 0 || losers.length > 0;
const epochLabel = epoch != null ? `epoch ${epoch}` : 'the latest epoch';

// Dynamic OG card of the top gainers/losers, versioned by the epoch and the two
// leaders so a fresh scrape refetches once the standings turn over each epoch.
const ogImage = hasData
  ? `/og/dreps/movers.png?v=${ogCardVersion([
      epoch,
      gainers[0]?.drepId,
      gainers[0]?.votingPowerSnapshot,
      losers[0]?.drepId,
      losers[0]?.votingPowerSnapshot,
    ])}`
  : undefined;

const columns: { key: 'up' | 'down'; title: string; items: Drep[] }[] = [
  { key: 'up', title: 'Top gainers', items: gainers },
  { key: 'down', title: 'Top losers', items: losers },
];
---

<Layout
  title="Movers of the Epoch - Cardano DReps - DRepTalk"
  description="Which Cardano DReps gained or lost the most voting power this epoch. The biggest delegation shifts among Cardano's delegate representatives, updated every epoch on DRepTalk."
  ogImage={ogImage}
  wide
>
  <nav class="movers-crumbs" aria-label="Breadcrumb">
    <a href="/">DRepTalk</a>
    <span aria-hidden="true">/</span>
    <a href="/dreps/">DReps</a>
    <span aria-hidden="true">/</span>
    <span>Movers</span>
  </nav>

  <h1>Movers of the epoch</h1>
  <p class="movers-intro">
    The DReps whose voting power shifted the most in {epochLabel}, by delegation gained or lost versus the previous epoch.
  </p>

  <div
    class="epoch-meter"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={epochPct}
    aria-label={`Epoch ${epochProgress.epoch}, ${daysLeftLabel}`}
  >
    <div class="epoch-meter__head">
      <span class="epoch-meter__label">Epoch {epochProgress.epoch}</span>
      <span class="epoch-meter__left">{daysLeftLabel}</span>
    </div>
    <div class="epoch-meter__track">
      <div class="epoch-meter__fill" style={`width:${epochPct}%`}></div>
    </div>
  </div>

  {selfDescriptor && selfStanding && (
    <DrepSelfCard descriptor={selfDescriptor} standing={selfStanding} eyebrow="Your movement">
      {selfDelta && selfDelta.direction !== 'flat' ? (
        <span class={`drep-trend drep-trend--${selfDelta.direction}`}>
          <span class="drep-trend__main">
            <span class="drep-trend__arrow" aria-hidden="true">{selfDelta.direction === 'up' ? '▲' : '▼'}</span>
            {selfDelta.pct != null && <span class="drep-trend__pct">{formatTrendPct(selfDelta.pct)}</span>}
          </span>
          <span class="drep-trend__ada">{formatAdaCompact(absLovelace(selfDelta.deltaLovelace))}</span>
        </span>
      ) : (
        <span class="movers-self-flat">Unchanged</span>
      )}
    </DrepSelfCard>
  )}

  {!hasData ? (
    <p class="movers-none">Not enough epoch snapshots yet to rank movers. Check back next epoch.</p>
  ) : (
    <div class="movers-grid">
      {columns.map((col) => (
        <section class="movers-col">
          <h2 class={`movers-col__title movers-col__title--${col.key}`}>
            <span class="movers-col__icon" aria-hidden="true">{col.key === 'up' ? '▲' : '▼'}</span>
            {col.title}
          </h2>
          {col.items.length === 0 ? (
            <p class="movers-empty">No {col.key === 'up' ? 'gainers' : 'losers'} this epoch.</p>
          ) : (
            <ol class="movers-list">
              {col.items.map((d, i) => {
                const descriptor = drepDescriptor(d);
                const delta = computeVotingPowerDelta(d.votingPowerSnapshot, d.votingPowerPrev);
                return (
                  <li class="movers-row">
                    <span class="movers-rank">{i + 1}</span>
                    <div class="movers-identity">
                      <AuthorIdentity author={descriptor} size={AVATAR_SIZE.rowLead} truncate>
                        <span slot="sub" class="movers-power">{formatAdaCompact(d.votingPower)} voting power</span>
                      </AuthorIdentity>
                    </div>
                    {delta && (
                      <span class={`drep-trend drep-trend--${delta.direction}`}>
                        <span class="drep-trend__main">
                          <span class="drep-trend__arrow" aria-hidden="true">{delta.direction === 'up' ? '▲' : '▼'}</span>
                          {delta.pct != null && <span class="drep-trend__pct">{formatTrendPct(delta.pct)}</span>}
                        </span>
                        <span class="drep-trend__ada">{formatAdaCompact(absLovelace(delta.deltaLovelace))}</span>
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
          )}
        </section>
      ))}
    </div>
  )}

  <p class="movers-back"><a href="/dreps/">All DReps</a></p>
</Layout>

<style>
  .movers-crumbs {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1rem;
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .movers-crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .movers-crumbs a:hover {
    color: var(--fg);
  }

  .movers-intro {
    color: var(--muted);
    max-width: 60ch;
    margin: 0.4rem 0 1.5rem;
  }

  .epoch-meter {
    max-width: 32rem;
    margin: 0 0 2rem;
  }
  .epoch-meter__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.45rem;
  }
  .epoch-meter__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
  }
  .epoch-meter__left {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .epoch-meter__track {
    height: 5px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .epoch-meter__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
  }
  .movers-self-flat {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .movers-none {
    color: var(--muted);
  }

  .movers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 720px) {
    .movers-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .movers-col__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
    margin: 0 0 0.9rem;
  }
  .movers-col__icon {
    font-size: 0.8rem;
  }
  .movers-col__title--up .movers-col__icon {
    color: var(--c-pos);
  }
  .movers-col__title--down .movers-col__icon {
    color: var(--c-neg);
  }

  .movers-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .movers-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }
  .movers-row:first-child {
    border-top: none;
  }
  .movers-rank {
    flex-shrink: 0;
    width: 1.5rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .movers-identity {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .movers-power {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* The voting-power delta chip is the shared global .drep-trend component (same as
     the directory); it just needs to hold its width and sit at the row's end here. */
  .movers-row .drep-trend {
    flex-shrink: 0;
    align-items: flex-end;
  }

  .movers-back {
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .movers-back a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .movers-back a:hover {
    text-decoration: underline;
  }
</style>
