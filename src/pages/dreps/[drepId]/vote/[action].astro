---
// Shareable page for a single DRep's vote and rationale on one governance
// action: /dreps/<drepId>/vote/<action-slug>/. Linked from the action's
// Positions tab and used as the target of the vote OG card.
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '@/layouts/Layout.astro';
import NotFound from '@/components/NotFound.astro';
import VoteStatement from '@/components/VoteStatement.astro';
import { currentNetwork } from '@/lib/api/response';
import { getDrepByIdOrSlug } from '@/lib/db/dreps.js';
import { getTopicBySlug } from '@/lib/db/forum.js';
import { getGovernanceActionByTopicId } from '@/lib/db/governance.js';
import { getVoteStatement } from '@/lib/db/voteRationale.js';
import { getSupersededVotesFor } from '@/lib/db/voteHistory.js';
import { getUserByDrepId } from '@/lib/db/users.js';
import { drepPath, isCanonicalDrepParam } from '@/lib/dreps/profile.js';
import { drepCredentialHexFromId } from '@/lib/cardano/identity.js';
import { isVoteStatementIndexable } from '@/lib/governance/voteStatement.js';
import { describeAuthor } from '@/lib/forum/author.js';
import { excerptFromHtml } from '@/lib/forum/view.js';

const db = env.DB as D1Database | undefined;
const { drepId, action } = Astro.params;

const drep = drepId && db ? await getDrepByIdOrSlug(db, drepId) : null;

// Same canonical-URL rule as the profile page: an id request redirects to the slug.
if (drep && drepId && !isCanonicalDrepParam(drep, drepId)) {
  return Astro.redirect(`${drepPath(drep)}vote/${action}/`, 301);
}

if (!drep) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const topic = action && db ? await getTopicBySlug(db, action) : null;
const govAction = topic && db ? await getGovernanceActionByTopicId(db, topic.id) : null;
if (drep && (!topic || !govAction)) {
  Astro.response.status = 404;
}

const vote = drep && govAction && db
  ? await getVoteStatement(db, { gaId: govAction.id, voterId: drep.drepId, role: 'DRep' })
  : null;

// The voter and action both exist but there is no shareable vote here (no
// on-chain rationale yet): send the visitor to the position row instead.
if (drep && govAction && topic && !vote) {
  return Astro.redirect(`/t/${topic.slug}/?tab=positions#voter-${drep.drepId}`, 302);
}

const ready = !!(drep && db && topic && govAction && vote);
const now = Date.now();
const earlier = ready ? await getSupersededVotesFor(db!, drep!.drepId, govAction!.id) : [];
const actionTitle = ready ? (govAction!.title ?? topic!.title) : '';
const displayName = drep?.name ?? drep?.drepId ?? '';
const hasMetadata = !!(drep?.name?.trim() || drep?.bio?.trim());
const pending = vote?.localStatus === 'pending';
// Pending votes are optimistic and not yet chain-confirmed, so they never get
// indexed regardless of rationale quality.
const indexable = ready && !pending && isVoteStatementIndexable({ hasMetadata, rationaleText: vote!.bodyText });
// A deregistered DRep no longer accepts delegation, same rule as the profile page.
const isRetired = drep?.status === 'deregistered';
const delegateHex = drep && !isRetired ? (drep.hex ?? drepCredentialHexFromId(drep.drepId)) : null;
const drepUser = ready && db ? await getUserByDrepId(db, drep!.drepId) : null;
// describeAuthor is a pure lookup over its maps; keying them by drepId (rather
// than the user id it is normally keyed by) still resolves correctly because
// the resolver only ever looks up the id it was given.
const author = ready
  ? describeAuthor(
      drep!.drepId,
      new Map(drepUser ? [[drep!.drepId, drepUser]] : []),
      new Map([[drep!.drepId, drep!]]),
      new Map(),
    )
  : null;
const ogImage = ready ? `/og/vote/drep/${drep!.slug ?? drep!.drepId}/${topic!.slug}.png` : '/og.jpg';
---
{ready ? (
  <Layout
    title={`How ${displayName} voted on ${actionTitle}`}
    description={excerptFromHtml(vote!.rationaleHtml, 160)}
    ogImage={ogImage}
    noindex={!indexable}
  >
    <VoteStatement
      author={author!}
      roleLabel="DRep"
      isPool={false}
      pending={pending}
      vote={vote!.vote}
      votingPower={vote!.votingPower}
      actionTitle={actionTitle}
      actionHref={`/t/${topic!.slug}/`}
      rationaleHtml={vote!.rationaleHtml}
      earlier={earlier}
      delegateTarget={delegateHex ? { drepId: drep!.drepId, slug: drep!.slug, name: displayName, credentialHex: delegateHex, isScript: drep!.hasScript } : null}
      delegateNetwork={currentNetwork().network}
      now={now}
    />
  </Layout>
) : (
  <NotFound noun={drep ? 'governance action' : 'DRep'} />
)}
