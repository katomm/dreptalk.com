---
// DRep voting dashboard: open actions with viewer status, plus the voting record.
// Gated to DReps only: non-DRep sessions are redirected to /login.
//
// Vote action: links to the thread (/t/<slug>) where VotePanel is already
// rendered inline in the sidebar. This avoids duplicating the dialog wiring
// and is the simpler correct approach documented in the task brief.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { runtimeEnv, currentNetwork } from '@/lib/api/response';
import { getUserById } from '@/lib/db/users';
import { getVotableActionsForViewer } from '@/lib/db/votableActions';
import { getDrepVotingHistory, getDrepParticipation } from '@/lib/db/drepVotes';
import { getDrepByIdOrSlug } from '@/lib/db/dreps';
import { readableType, epochDaysLeft, voteTone, TONE_COLORS, govTypeTone } from '@/lib/governance/view';
import { resolveNetwork, epochStartUnix } from '@/lib/config/network';
import { deriveVoteStats, isClosingSoon } from '@/lib/governance/voteDashboard';
import { GOV_ACTION_TYPES } from '@/lib/governance/types';
import voteFiltersJs from '@/scripts/vote-filters.js?raw';
import '@/styles/list-controls.css';

// --- resolve network + session ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const isDrep = user.roles.includes('drep');
if (!isDrep) {
  return Astro.redirect('/login/');
}

const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;

// Resolve the drep_id from the database row (same pattern as settings.astro).
const dbUser = db ? await getUserById(db, user.id) : null;
const drepId = dbUser?.drep_id ?? null;

// Network + render instant for the wall-clock voting countdown (mirrors GovActionRow).
const network = resolveNetwork(currentNetwork().network);
const now = Date.now();

// Fetch votable actions, voting history and the DRep record in parallel.
const [votableRows, historyRows, drep] = drepId && db
  ? await Promise.all([
      getVotableActionsForViewer(db, drepId),
      getDrepVotingHistory(db, drepId, { limit: 50 }),
      getDrepByIdOrSlug(db, drepId),
    ])
  : [[], [], null];

// Participation depends on the DRep's registration epoch, so it runs after.
const participation = drep && db ? await getDrepParticipation(db, drep.drepId, drep.registeredEpoch) : null;
const participationPct =
  participation && participation.eligible > 0
    ? Math.round((participation.voted / participation.eligible) * 100)
    : null;

// Enrich each open action once: type tone + wall-clock days left + closing-soon flag.
const actions = votableRows.map((row) => {
  const expiryUnix = row.expiry_epoch != null ? epochStartUnix(row.expiry_epoch, network) : null;
  const daysLeft = epochDaysLeft(expiryUnix != null ? expiryUnix * 1000 : null, row.status, now);
  return { row, typeTone: govTypeTone(row.type), daysLeft, closingSoon: isClosingSoon(daysLeft) };
});

const stats = deriveVoteStats(actions.map((a) => ({ voted: !!a.row.viewerVote, daysLeft: a.daysLeft })));
// Only offer type-filter options for types actually present in the list.
const presentTypes = GOV_ACTION_TYPES.filter((t) => actions.some((a) => a.row.type === t.value));
---
<Layout
  title="Vote - DRepTalk"
  description="Your DRep voting dashboard: open governance actions ready to vote on, and your voting record."
  noindex={true}
>
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Vote</span>
  </nav>

  <h1 style="margin:0 0 0.25rem;">Vote</h1>
  <p style="margin:0 0 2rem;max-width:62ch;font-size:0.9375rem;color:var(--muted);">
    Open governance actions you can vote on, and your voting record.
  </p>

  {!drepId && (
    <div class="callout callout--info" role="status">
      <div class="callout__body">
        Your DRep id has not synced yet. Check back in a few minutes.
      </div>
    </div>
  )}

  {drepId && (
    <>
      <div class="vote-stats">
        <div class="vote-stat">
          <span class="vote-stat__num">{stats.open}</span>
          <span class="vote-stat__label">Open actions</span>
        </div>
        <div class="vote-stat vote-stat--accent">
          <span class="vote-stat__num">{stats.notVoted}</span>
          <span class="vote-stat__label">Not voted yet</span>
        </div>
        <div class="vote-stat">
          <span class="vote-stat__num">{stats.closingSoon}</span>
          <span class="vote-stat__label">Closing soon</span>
        </div>
        <div class="vote-stat">
          <span class="vote-stat__num">{participationPct != null ? `${participationPct}%` : 'n/a'}</span>
          <span class="vote-stat__label">
            {participation && participation.eligible > 0 ? `Voted on ${participation.voted} of ${participation.eligible}` : 'Participation'}
          </span>
        </div>
      </div>

      <!-- Open actions -->
      <section style="margin-bottom:3rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Open actions</h2>
        {votableRows.length === 0 ? (
          <p style="color:var(--muted);font-size:0.9375rem;margin:0;">
            No active governance actions to vote on right now.
          </p>
        ) : (
          <>
            <div class="vote-controls" data-vote-controls>
              <div class="seg" role="group" aria-label="Filter by your vote status">
                <button type="button" class="seg__btn is-active" data-status="all" aria-pressed="true">All</button>
                <button type="button" class="seg__btn" data-status="notvoted" aria-pressed="false">Not voted</button>
                <button type="button" class="seg__btn" data-status="voted" aria-pressed="false">Voted</button>
              </div>
              {presentTypes.length > 1 && (
                <label class="vote-select">
                  <span class="vote-select__label">Type</span>
                  <select data-type-filter class="ctrl-box">
                    <option value="">All types</option>
                    {presentTypes.map((t) => <option value={t.value}>{t.label}</option>)}
                  </select>
                </label>
              )}
              <label class="vote-select">
                <span class="vote-select__label">Sort</span>
                <select data-sort class="ctrl-box">
                  <option value="closing">Closing soonest</option>
                  <option value="recent">Recently opened</option>
                  <option value="type">By type</option>
                </select>
              </label>
            </div>

            <div class="vote-list" data-vote-list>
              {actions.map(({ row, typeTone, daysLeft, closingSoon }) => {
                const voteColor = row.viewerVote ? TONE_COLORS[voteTone(row.viewerVote)] : null;
                const threadHref = row.slug ? `/t/${row.slug}/` : null;
                return (
                  <div
                    class:list={['vote-row', { 'vote-row--soon': closingSoon }]}
                    data-vote-row
                    data-voted={row.viewerVote ? '1' : '0'}
                    data-type={row.type}
                    data-expiry={row.expiry_epoch ?? ''}
                    data-submitted-at={row.submitted_at ?? ''}
                    data-submitted-epoch={row.submitted_epoch ?? ''}
                  >
                    <div class="vote-row__main">
                      <div class="vote-row__tags">
                        <span class="pill" style={`--ph:var(--gov-${typeTone})`}>
                          {readableType(row.type)}
                        </span>
                        {row.viewerVote ? (
                          <span class="vote-badge" style={`color:${voteColor};border-color:${voteColor}`}>
                            {row.viewerStatus === 'pending'
                              ? `Voted ${row.viewerVote} (pending)`
                              : row.viewerStatus === 'failed'
                                ? `Vote failed`
                                : `Voted ${row.viewerVote}`}
                          </span>
                        ) : (
                          <span class="vote-badge vote-badge--none">Not voted</span>
                        )}
                        {closingSoon && <span class="vote-badge vote-badge--soon">Closing soon</span>}
                      </div>
                      <p class="vote-row__title">
                        {threadHref ? <a href={threadHref}>{row.title ?? row.id}</a> : (row.title ?? row.id)}
                      </p>
                      {row.expiry_epoch != null && (
                        <p class="vote-row__meta">
                          {daysLeft != null
                            ? `~${daysLeft} days left (epoch ${row.expiry_epoch})`
                            : `Epoch ${row.expiry_epoch}`}
                        </p>
                      )}
                    </div>
                    <div class="vote-row__action">
                      {threadHref ? (
                        <a href={threadHref} class="btn btn-primary btn--sm">Vote</a>
                      ) : (
                        <span style="color:var(--muted);font-size:0.875rem;">No thread yet</span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
            <p class="vote-empty" data-vote-empty hidden></p>
          </>
        )}
      </section>

      <!-- Voting record -->
      <section>
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Your voting record</h2>
        {historyRows.length === 0 ? (
          <p style="color:var(--muted);font-size:0.9375rem;margin:0;">
            No recorded votes yet.
          </p>
        ) : (
          <div class="history-list">
            {historyRows.map((row) => {
              const typeTone = govTypeTone(row.type);
              const voteColor = TONE_COLORS[voteTone(row.vote)];
              return (
                <div class="history-row">
                  <div class="history-row__main">
                    <div class="history-row__tags">
                      <span class="pill" style={`--ph:var(--gov-${typeTone})`}>
                        {readableType(row.type)}
                      </span>
                      <span
                        class="vote-badge"
                        style={`color:${voteColor};border-color:${voteColor}`}
                      >
                        Voted {row.vote}
                      </span>
                    </div>
                    <p class="history-row__title">
                      {row.topic_slug ? (
                        <a href={`/t/${row.topic_slug}/`}>{row.title ?? row.ga_id}</a>
                      ) : (
                        (row.title ?? row.ga_id)
                      )}
                    </p>
                    {(row.decided_epoch != null || row.meta_url) && (
                      <p class="history-row__meta">
                        {row.decided_epoch != null && <>Decided epoch {row.decided_epoch}</>}
                        {row.meta_url && (
                          <>
                            {row.decided_epoch != null && <>{' '}</>}
                            <a href={row.meta_url} rel="nofollow noopener" target="_blank" class="rationale-link">Rationale</a>
                          </>
                        )}
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>
    </>
  )}
  {drepId && votableRows.length > 0 && <script is:inline set:html={voteFiltersJs} />}
</Layout>

<style>
  /* ---- Open-action list -------------------------------------------------- */
  .vote-list,
  .history-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .vote-row,
  .history-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  /* The client filter toggles the hidden attribute on rows. This author rule
     for .vote-row sets display:flex, which outranks the UA [hidden] rule, so
     a hidden row would still show. Re-assert display:none at higher specificity. */
  .vote-row[hidden] {
    display: none;
  }
  .vote-row:last-child,
  .history-row:last-child {
    border-bottom: none;
  }
  .vote-row:hover,
  .history-row:hover {
    background: var(--surface);
  }

  .vote-row__main,
  .history-row__main {
    min-width: 0;
    flex: 1;
  }

  .vote-row__tags,
  .history-row__tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0 0 0.375rem;
  }

  .pill {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ph) 14%, transparent);
    color: var(--ph);
  }

  .vote-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid;
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    line-height: 1;
  }
  .vote-badge--none {
    color: var(--muted);
    border-color: var(--border);
  }

  .vote-row__title,
  .history-row__title {
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vote-row__title a,
  .history-row__title a {
    color: inherit;
    text-decoration: none;
  }
  .vote-row__title a:hover,
  .history-row__title a:hover {
    color: var(--accent);
  }

  .vote-row__meta,
  .history-row__meta {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0;
  }

  .vote-row__action {
    flex-shrink: 0;
  }

  /* Small primary button variant for the vote action. */
  .btn--sm {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
  }

  .rationale-link {
    color: var(--accent);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  .rationale-link:hover {
    text-decoration: underline;
  }

  /* ---- Stats strip ------------------------------------------------------- */
  .vote-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0 0 2rem;
  }
  .vote-stat {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 0.875rem;
    background: var(--surface);
  }
  .vote-stat--accent {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .vote-stat__num {
    display: block;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .vote-stat--accent .vote-stat__num {
    color: var(--accent);
  }
  .vote-stat__label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  /* ---- Control bar ------------------------------------------------------- */
  .vote-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0 0 1rem;
  }
  .vote-select {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* ---- Closing-soon highlight ------------------------------------------- */
  .vote-row--soon {
    border-left: 3px solid var(--accent);
  }
  .vote-badge--soon {
    color: var(--accent);
    border-color: var(--accent);
  }

  .vote-empty {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 1rem 0 0;
  }

  @media (max-width: 600px) {
    .vote-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .vote-row__action {
      align-self: flex-end;
    }
    .vote-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
