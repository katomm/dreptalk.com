---
// DRep voting dashboard: open actions with viewer status, plus the voting record.
// Gated to DReps only: non-DRep sessions are redirected to /login.
//
// Vote action: links to the thread (/t/<slug>) where VotePanel is already
// rendered inline in the sidebar. This avoids duplicating the dialog wiring
// and is the simpler correct approach documented in the task brief.
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import GovTypePill from '@/components/GovTypePill.astro';
import GovTypeIcon from '@/components/GovTypeIcon.astro';
import GovActionRow from '@/components/GovActionRow.astro';
import MultiVoteBar from '@/components/MultiVoteBar';
import { runtimeEnv, currentNetwork } from '@/lib/api/response';
import { getSelfDrepId } from '@/lib/db/users';
import { getVotableActionsForViewer } from '@/lib/db/votableActions';
import { getDrepVotingHistory, getDrepParticipation } from '@/lib/db/drepVotes';
import { getDrepByIdOrSlug } from '@/lib/db/dreps';
import { getTopicsByIds, type Topic } from '@/lib/db/forum';
import { getGovernanceActionsByTopicIds, type GovernanceAction } from '@/lib/db/governance';
import { getProtocolParams, type ProtocolParams } from '@/lib/db/protocolParams';
import { getActiveDrepStake } from '@/lib/db/stakeParticipation';
import { epochDaysLeft, voteTone, TONE_COLORS, govTypeTone, shortGovActionId } from '@/lib/governance/view';
import { resolveNetwork, epochStartUnix } from '@/lib/config/network';
import { deriveVoteStats, isClosingSoon } from '@/lib/governance/voteDashboard';
import { GOV_ACTION_TYPES } from '@/lib/governance/types';
import voteFiltersJs from '@/scripts/vote-filters.js?raw';
import '@/styles/list-controls.css';

// --- resolve network + session ---
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login/');
}

const isDrep = user.roles.includes('drep');
if (!isDrep) {
  return Astro.redirect('/login/');
}

const env = runtimeEnv(Astro.locals);
const db = env.DB as D1Database | undefined;

// Resolve the drep_id from the session (falls back to a DB read for legacy sessions).
const drepId = db ? await getSelfDrepId(db, user) : null;

// Raw network id (passed to GovActionRow, which resolves it itself) plus the
// resolved form for this page's own expiry math. Render instant for the countdown.
const networkId = currentNetwork().network;
const network = resolveNetwork(networkId);
const now = Date.now();

// Fetch votable actions, voting history and the DRep record in parallel.
const [votableRows, historyRows, drep] = drepId && db
  ? await Promise.all([
      getVotableActionsForViewer(db, drepId),
      getDrepVotingHistory(db, drepId, { limit: 50 }),
      getDrepByIdOrSlug(db, drepId),
    ])
  : [[], [], null];

// Hydrate the open actions into full GovernanceAction + Topic rows via the same
// batched loaders the governance overview uses, so /vote renders the identical
// GovActionRow (with live tallies/bars). Also load the tally denominators (DRep
// stake, committee size, protocol params) that the composition bars need.
const openTopicIds = votableRows
  .map((r) => r.topic_id)
  .filter((id): id is string => !!id);
const hydratePromise =
  db && openTopicIds.length
    ? Promise.all([
        getTopicsByIds(db, openTopicIds),
        getGovernanceActionsByTopicIds(db, openTopicIds),
        getProtocolParams(db),
        getActiveDrepStake(db),
      ])
    : Promise.resolve([
        new Map<string, Topic>(),
        new Map<string, GovernanceAction>(),
        null as ProtocolParams | null,
        { total: 0, asOf: null as number | null },
      ] as [Map<string, Topic>, Map<string, GovernanceAction>, ProtocolParams | null, { total: number; asOf: number | null }]);
// Participation depends only on `drep` (already resolved above), not on the
// hydration, so it runs alongside it rather than in a second serial round-trip.
const participationPromise =
  drep && db ? getDrepParticipation(db, drep.drepId, drep.registeredEpoch) : Promise.resolve(null);
const [[topicById, actionByTopic, overviewParams, stake], participation] = await Promise.all([
  hydratePromise,
  participationPromise,
]);
const govParamsRawJson = overviewParams?.rawJson ?? null;
const committeeSize = overviewParams?.committeeSize ?? null;
const drepStakeTotal = stake.total > 0 ? stake.total : null;

const participationPct =
  participation && participation.eligible > 0
    ? Math.round((participation.voted / participation.eligible) * 100)
    : null;

// Enrich each open action: full action/topic pair + wall-clock days left +
// closing-soon flag. Drop any row whose topic or action failed to hydrate (a
// rare active action without a thread, which has nowhere to vote anyway).
const actions = votableRows
  .map((row) => {
    const action = row.topic_id ? actionByTopic.get(row.topic_id) : undefined;
    const topic = row.topic_id ? topicById.get(row.topic_id) : undefined;
    const expiryUnix = row.expiry_epoch != null ? epochStartUnix(row.expiry_epoch, network) : null;
    const daysLeft = epochDaysLeft(expiryUnix != null ? expiryUnix * 1000 : null, row.status, now);
    return { row, action, topic, daysLeft, closingSoon: isClosingSoon(daysLeft) };
  })
  .filter((a): a is typeof a & { action: GovernanceAction; topic: Topic } => !!a.action && !!a.topic);

// Batch voting is key-DRep only: script DReps sign via the multisig flow in
// the thread sidebar and keep the plain Vote link rows.
const canMultiVote = Boolean(drepId && drep && !drep.hasScript);

const stats = deriveVoteStats(actions.map((a) => ({ voted: !!a.row.viewerVote, daysLeft: a.daysLeft })));
// Only offer type-filter options for types actually present in the list.
const presentTypes = GOV_ACTION_TYPES.filter((t) => actions.some((a) => a.row.type === t.value));
---
<Layout
  title="Vote - DRepTalk"
  description="Your DRep voting dashboard: open governance actions ready to vote on, and your voting record."
  noindex={true}
>
  <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
    <a href="/">DRepTalk</a>
    <span style="margin:0 0.375rem;">/</span>
    <span>Vote</span>
  </nav>

  <h1 style="margin:0 0 0.25rem;">Vote</h1>
  <p style="margin:0 0 2rem;max-width:62ch;font-size:0.9375rem;color:var(--muted);">
    Open governance actions you can vote on, and your voting record.
  </p>

  {!drepId && (
    <div class="callout callout--info" role="status">
      <div class="callout__body">
        Your DRep id has not synced yet. Check back in a few minutes.
      </div>
    </div>
  )}

  {drepId && (
    <>
      <div class="vote-stats">
        <div class="vote-stat">
          <span class="vote-stat__num">{stats.open}</span>
          <span class="vote-stat__label">Open actions</span>
        </div>
        <div class="vote-stat vote-stat--accent">
          <span class="vote-stat__num">{stats.notVoted}</span>
          <span class="vote-stat__label">Not voted yet</span>
        </div>
        <div class="vote-stat">
          <span class="vote-stat__num">{stats.closingSoon}</span>
          <span class="vote-stat__label">Closing soon</span>
        </div>
        <div class="vote-stat">
          <span class="vote-stat__num">{participationPct != null ? `${participationPct}%` : 'n/a'}</span>
          <span class="vote-stat__label">
            {participation && participation.eligible > 0 ? `Voted on ${participation.voted} of ${participation.eligible} decided` : 'Participation'}
          </span>
        </div>
      </div>

      <!-- Open actions -->
      <section style="margin-bottom:3rem;">
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Open actions</h2>
        {actions.length === 0 ? (
          <p style="color:var(--muted);font-size:0.9375rem;margin:0;">
            No active governance actions to vote on right now.
          </p>
        ) : (
          <>
            <div class="ga-controls" data-vote-controls>
              <div class="seg" role="group" aria-label="Filter by your vote status">
                <button type="button" class="seg__btn is-active" data-status="all" aria-pressed="true">All</button>
                <button type="button" class="seg__btn" data-status="notvoted" aria-pressed="false">Not voted</button>
                <button type="button" class="seg__btn" data-status="voted" aria-pressed="false">Voted</button>
              </div>
              <div class="ga-controls__right">
                <details class="ga-dropdown ga-dropdown--end" data-auto-dismiss>
                  <summary class="ctrl-box ga-dropdown__summary">
                    <span class="ga-dropdown__label">Sort</span>
                    <span class="ga-dropdown__value" data-sort-value>Closing soonest</span>
                    <span class="ga-dropdown__caret" aria-hidden="true">▾</span>
                  </summary>
                  <div class="ga-dropdown__menu" role="menu">
                    <button type="button" class="ga-dropdown__opt" data-sort-opt="closing" aria-current="true">Closing soonest</button>
                    <button type="button" class="ga-dropdown__opt" data-sort-opt="recent">Recently opened</button>
                    <button type="button" class="ga-dropdown__opt" data-sort-opt="type">By type</button>
                  </div>
                </details>
                {presentTypes.length > 1 && (
                  <details class="ga-dropdown ga-dropdown--end" data-auto-dismiss>
                    <summary class="ctrl-box ga-dropdown__summary">
                      <span class="ga-dropdown__label">Type</span>
                      <span class="ga-dropdown__value" data-type-value>All types</span>
                      <span class="ga-dropdown__caret" aria-hidden="true">▾</span>
                    </summary>
                    <div class="ga-dropdown__menu" role="menu">
                      <button type="button" class="ga-dropdown__opt" data-type-opt="" aria-current="true">
                        <span class="gov-oico" aria-hidden="true"></span>
                        All types
                      </button>
                      {presentTypes.map((t) => {
                        const tone = govTypeTone(t.value);
                        return (
                          <button type="button" class="ga-dropdown__opt" data-type-opt={t.value}>
                            <span class="gov-oico" style={`--ph:var(--gov-${tone})`}>
                              <GovTypeIcon tone={tone} size={14} />
                            </span>
                            {t.label}
                          </button>
                        );
                      })}
                    </div>
                  </details>
                )}
              </div>
            </div>

            <div class="ga-wrap">
              <div class="ga-list" data-vote-list>
                <div class="ga-list__head ga-list__head--dashboard">
                  <span>Governance Action</span>
                  <span>Voting</span>
                </div>
                {actions.map(({ row, action, topic, closingSoon }) => {
                  const voteBadge = row.viewerVote
                    ? {
                        label:
                          row.viewerStatus === 'pending'
                            ? `Voted ${row.viewerVote} (pending)`
                            : row.viewerStatus === 'failed'
                              ? 'Vote failed'
                              : `Voted ${row.viewerVote}`,
                        color: TONE_COLORS[voteTone(row.viewerVote)],
                      }
                    : { label: 'Not voted', color: null };
                  // The /vote client filter's data-* schema (opaque to GovActionRow).
                  const rowAttrs = {
                    'data-vote-row': '',
                    'data-voted': row.viewerVote ? '1' : '0',
                    'data-type': action.type,
                    'data-expiry': String(action.expiryEpoch ?? ''),
                    'data-submitted-at': String(action.submittedAt ?? ''),
                    'data-submitted-epoch': String(action.submittedEpoch ?? ''),
                  };
                  return (
                    <GovActionRow
                      topic={topic}
                      action={action}
                      drepStakeTotal={drepStakeTotal}
                      committeeSize={committeeSize}
                      params={overviewParams}
                      network={networkId}
                      now={now}
                      href={`/t/${topic.slug}/`}
                      epochParamsJson={govParamsRawJson}
                      voteBadge={voteBadge}
                      closingSoon={closingSoon}
                      rowAttrs={rowAttrs}
                      variant="dashboard"
                    >
                      {canMultiVote && (
                        <div slot="controls" class="mv-choices" role="group" aria-label={`Vote on ${action.title ?? topic.title}`}>
                          {(['yes', 'no', 'abstain'] as const).map((c) => (
                            <button type="button" class="mv-btn" data-mv-choice={c} data-ga={row.id} aria-pressed="false">
                              {c}
                            </button>
                          ))}
                        </div>
                      )}
                    </GovActionRow>
                  );
                })}
              </div>
            </div>
            <p class="vote-empty" data-vote-empty hidden></p>
            {stats.notVoted === 0 && (
              <div class="callout callout--success vote-done" data-vote-done role="status" hidden>
                <svg class="callout__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                <div class="callout__body">
                  <p class="vote-done__title">You're on top of governance</p>
                  <p class="vote-done__sub">
                    {stats.open === 1
                      ? 'The one open action already has your vote.'
                      : `All ${stats.open} open actions already have your vote.`}
                  </p>
                  <button type="button" class="vote-done__link" data-vote-done-link>See your votes</button>
                </div>
              </div>
            )}
          </>
        )}
      </section>

      {canMultiVote && actions.length > 0 && (
        <MultiVoteBar
          client:load
          network={networkId}
          actions={actions.map((a) => ({
            gaId: a.row.id,
            title: a.action.title ?? a.topic.title,
            prevVote: a.row.viewerVote,
          }))}
        />
      )}

      <!-- Voting record -->
      <section>
        <h2 style="margin:0 0 1rem;font-size:1.125rem;">Your voting record</h2>
        {historyRows.length === 0 ? (
          <p style="color:var(--muted);font-size:0.9375rem;margin:0;">
            No recorded votes yet.
          </p>
        ) : (
          <div class="history-list">
            {historyRows.map((row) => {
              const voteColor = TONE_COLORS[voteTone(row.vote)];
              return (
                <div class="history-row">
                  <div class="history-row__main">
                    <div class="history-row__tags">
                      <GovTypePill type={row.type} />
                      <span
                        class="vote-badge"
                        style={`color:${voteColor};border-color:${voteColor}`}
                      >
                        Voted {row.vote}
                      </span>
                    </div>
                    <p class="history-row__title">
                      {row.topic_slug ? (
                        <a href={`/t/${row.topic_slug}/`}>{row.title ?? shortGovActionId(row.ga_id)}</a>
                      ) : (
                        (row.title ?? shortGovActionId(row.ga_id))
                      )}
                    </p>
                    {(row.decided_epoch != null || row.meta_url) && (
                      <p class="history-row__meta">
                        {row.decided_epoch != null && <>Decided epoch {row.decided_epoch}</>}
                        {row.meta_url && (
                          <>
                            {row.decided_epoch != null && <>{' '}</>}
                            <a href={row.meta_url} rel="nofollow noopener" target="_blank" class="rationale-link">Rationale</a>
                          </>
                        )}
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>
    </>
  )}
  {drepId && actions.length > 0 && <script is:inline set:html={voteFiltersJs} />}
</Layout>

<style>
  /* ---- Multi-vote choice pills (controls slot of GovActionRow) ------------ */
  /* Stacked to fill the dashboard row's fixed right column. Scoped here: the
     slot content is authored in this file, so these styles reach the buttons. */
  .mv-choices {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }
  .mv-btn {
    width: 100%;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
    line-height: 1.2;
  }
  .mv-btn:hover:not(.is-disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Per-choice colors for the active pill, matching the review panel and the
     vote badges (TONE_COLORS: yes = --c-pos, no = --c-neg, abstain = muted). */
  .mv-btn[data-mv-choice='yes'].is-active {
    border-color: var(--c-pos);
    color: var(--c-pos);
    background: color-mix(in srgb, var(--c-pos) 10%, transparent);
    font-weight: 700;
  }
  .mv-btn[data-mv-choice='no'].is-active {
    border-color: var(--c-neg);
    color: var(--c-neg);
    background: color-mix(in srgb, var(--c-neg) 10%, transparent);
    font-weight: 700;
  }
  .mv-btn[data-mv-choice='abstain'].is-active {
    border-color: var(--muted);
    color: var(--muted);
    background: color-mix(in srgb, var(--muted) 12%, transparent);
    font-weight: 700;
  }
  /* Mirrors the island's busy freeze: selection is locked while a submit runs. */
  .mv-btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  /* Mobile: the controls column spans the card bottom (like the Vote CTA), so
     the three pills sit side by side. */
  @media (max-width: 720px) {
    .mv-choices {
      flex-direction: row;
    }
    .mv-btn {
      padding: 0.5rem 0.6rem;
    }
  }
  /* Keep the last rows reachable when the sticky batch bar is visible. */
  .ga-wrap {
    margin-bottom: 4.5rem;
  }

  /* ---- Voting record list ------------------------------------------------ */
  .history-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .history-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .history-row:last-child {
    border-bottom: none;
  }
  .history-row:hover {
    background: var(--surface);
  }

  .history-row__main {
    min-width: 0;
    flex: 1;
  }

  .history-row__tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0 0 0.375rem;
  }

  /* Vote badge in the voting-record rows (outlined, colored inline by tone). */
  .vote-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid;
    border-radius: 999px;
    padding: 0.1rem 0.4rem;
    line-height: 1;
  }

  .history-row__title {
    font-weight: 600;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .history-row__title a {
    color: inherit;
    text-decoration: none;
  }
  .history-row__title a:hover {
    color: var(--accent);
  }

  .history-row__meta {
    color: var(--muted);
    font-size: 0.8125rem;
    margin: 0;
  }

  .rationale-link {
    color: var(--accent);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  .rationale-link:hover {
    text-decoration: underline;
  }

  /* ---- Stats strip ------------------------------------------------------- */
  .vote-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin: 0 0 2rem;
  }
  .vote-stat {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.75rem 0.875rem;
    background: var(--surface);
  }
  .vote-stat--accent {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .vote-stat__num {
    display: block;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .vote-stat--accent .vote-stat__num {
    color: var(--accent);
  }
  .vote-stat__label {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .vote-empty {
    color: var(--muted);
    font-size: 0.9375rem;
    margin: 1rem 0 0;
  }

  .vote-done {
    margin-top: 1rem;
  }
  /* .callout sets display:flex, which would beat the hidden attribute. */
  .vote-done[hidden] {
    display: none;
  }
  .vote-done__title {
    margin: 0 0 0.2rem;
    font-weight: 600;
  }
  .vote-done__sub {
    margin: 0;
    color: var(--muted);
  }
  .vote-done__link {
    margin-top: 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 600px) {
    .vote-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
