---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ActivityFeed from '@/components/ActivityFeed.astro';
import CategorySidebar from '@/components/CategorySidebar.astro';
import { getCategoryStats } from '@/lib/db/forum.js';
import { loadActivityFeed, parseActivityFilter, type ActivityFilter } from '@/lib/forum/activityFeed.js';
import { getCategories } from '../../config/categories.js';
import { cacheControlFor, parsePage, pageToOffset, SITE_ORIGIN, ACTIVE_WINDOW_MS } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';
import RecentlyActiveCard from '@/components/RecentlyActiveCard.astro';
// Segmented pill styles for the activity filter, shared with the governance-actions
// list and /vote so the three controls stay identical.
import '@/styles/list-controls.css';
import { listActiveGovIds, countActiveByRole } from '@/lib/db/activeParticipants.js';
import { loadAuthorIdentities } from '@/lib/forum/author.js';

const db = env.DB as D1Database | undefined;
const now = Date.now();

const categories = getCategories();

const PAGE_SIZE = 20;
const filter = parseActivityFilter(Astro.url.searchParams.get('filter'));
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

// Category stats and the activity page are independent; load them together.
const cutoff = now - ACTIVE_WINDOW_MS;
const [stats, feed, recentIds, activeCounts] = db
  ? await Promise.all([
      getCategoryStats(db),
      loadActivityFeed(db, { filter, limit: PAGE_SIZE, offset, withParticipants: true }),
      listActiveGovIds(db, cutoff, 10),
      countActiveByRole(db, cutoff),
    ])
  : [
      new Map<string, { topicCount: number; lastPostAt: number | null }>(),
      { events: [], total: 0 },
      [],
      { actors: 0, dreps: 0, spos: 0, delegators: 0 },
    ];

// Hydrate the recently-active author ids into presentational descriptors using
// the shared forum resolver (avatar, name, role badges, profile link), keeping
// the query's recency order.
const recentIdentities = db && recentIds.length ? await loadAuthorIdentities(db, recentIds) : null;
const recentAuthors = recentIdentities ? recentIds.map((id) => recentIdentities.describe(id)) : [];

// Tabs and pager keep the active filter; a filter change resets to page 1.
const tabHref = (f: ActivityFilter) => `/discussions/?filter=${f}`;
const prevHref = page > 1 ? `/discussions/?filter=${filter}&page=${page - 1}` : null;
const nextHref = offset + PAGE_SIZE < feed.total ? `/discussions/?filter=${filter}&page=${page + 1}` : null;
const totalPages = Math.max(1, Math.ceil(feed.total / PAGE_SIZE));

Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DRepTalk', item: siteOrigin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Discussions', item: siteOrigin + '/discussions/' },
  ],
};
---

<Layout title="Cardano Governance Discussions and Forum - DRepTalk" description="Browse Cardano governance discussions: the constitution, treasury and budget, and general debate, plus the latest activity across every category on DRepTalk." ogImage="/og-discussions.jpg" wide>
  <JsonLd data={breadcrumbLd} />

  <h1 style="margin:0 0 1.25rem;">Discussions</h1>

  <div class="discussions-grid">
    <CategorySidebar categories={categories} stats={stats} now={now} />

    <ActivityFeed
      events={feed.events}
      now={now}
      variant="discussions"
      title="Latest activity"
      subtitle="Stay up to date with the latest discussions across all categories."
      tabs={{ active: filter, hrefFor: tabHref }}
      pagination={{ prevHref, nextHref, page, totalPages }}
      footer={true}
    />
  </div>

  <RecentlyActiveCard authors={recentAuthors} counts={activeCounts} />
</Layout>

<style>
  .discussions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 820px) {
    .discussions-grid {
      grid-template-columns: 20rem 1fr;
      gap: 2.5rem;
    }
  }
</style>
