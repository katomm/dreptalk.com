---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ActivityFeed from '@/components/ActivityFeed.astro';
import { getCategoryStats } from '@/lib/db/forum.js';
import { loadActivityFeed, parseActivityFilter, type ActivityFilter } from '@/lib/forum/activityFeed.js';
import { getCategories } from '../../config/categories.js';
import { cacheControlFor, formatRelativeTime, parsePage, pageToOffset, SITE_ORIGIN } from '@/lib/forum/view.js';
import { env } from 'cloudflare:workers';

const db = env.DB as D1Database | undefined;
const now = Date.now();

const categories = getCategories();

const PAGE_SIZE = 20;
const filter = parseActivityFilter(Astro.url.searchParams.get('filter'));
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = pageToOffset(page, PAGE_SIZE);

// Category stats and the activity page are independent; load them together.
const [stats, feed] = db
  ? await Promise.all([
      getCategoryStats(db),
      loadActivityFeed(db, { filter, limit: PAGE_SIZE, offset }),
    ])
  : [new Map<string, { topicCount: number; lastPostAt: number | null }>(), { events: [], total: 0 }];

// Tabs and pager keep the active filter; a filter change resets to page 1.
const tabHref = (f: ActivityFilter) => `/discussions?filter=${f}`;
const prevHref = page > 1 ? `/discussions?filter=${filter}&page=${page - 1}` : null;
const nextHref = offset + PAGE_SIZE < feed.total ? `/discussions?filter=${filter}&page=${page + 1}` : null;

Astro.response.headers.set('Cache-Control', cacheControlFor(Astro.locals.user));

const siteOrigin = Astro.site?.origin ?? SITE_ORIGIN;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DRepTalk', item: siteOrigin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Discussions', item: siteOrigin + '/discussions' },
  ],
};
---

<Layout title="Discussions - DRepTalk" description="Cardano governance discussion: browse categories and the latest activity across the forum.">
  <JsonLd data={breadcrumbLd} />

  <h1 style="margin:0 0 1.25rem;">Discussions</h1>

  <div class="discussions-grid">
    <section aria-label="Categories">
      <h2 style="font-size:0.8125rem;text-transform:uppercase;letter-spacing:0.04em;color:var(--muted);margin:0 0 0.75rem;">Categories</h2>
      <div style="display:flex;flex-direction:column;">
        {categories.map((c) => {
          const s = stats.get(c.slug);
          return (
            <a href={`/c/${c.slug}`} style="border-bottom:1px solid var(--border);padding:0.75rem 0;text-decoration:none;color:inherit;display:block;">
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <span aria-hidden="true" style={`width:0.5rem;height:0.5rem;border-radius:999px;flex-shrink:0;background:${c.kind === 'governance' ? 'var(--accent)' : 'var(--muted)'};`}></span>
                <span style="font-weight:600;color:var(--fg);">{c.name}</span>
                <span style="margin-left:auto;font-size:0.8125rem;color:var(--muted);">{s?.topicCount ?? 0}</span>
              </div>
              <p style="margin:0.3rem 0 0 1rem;font-size:0.8125rem;color:var(--muted);">{c.description}</p>
              {s?.lastPostAt && (
                <p style="margin:0.2rem 0 0 1rem;font-size:0.75rem;color:var(--muted);">Last activity {formatRelativeTime(s.lastPostAt, now)}</p>
              )}
            </a>
          );
        })}
      </div>
    </section>

    <ActivityFeed
      events={feed.events}
      now={now}
      title="Latest activity"
      subtitle="A summary of what's happening in governance."
      tabs={{ active: filter, hrefFor: tabHref }}
      pagination={{ prevHref, nextHref }}
      footer={true}
    />
  </div>
</Layout>

<style>
  .discussions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 820px) {
    .discussions-grid {
      grid-template-columns: 20rem 1fr;
      gap: 2.5rem;
    }
  }
</style>
