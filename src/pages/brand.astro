---
import Layout from '@/layouts/Layout.astro';
import LogoMark from '@/components/LogoMark.astro';

// SSR (not prerendered) so this page is served by the Worker and receives
// Astro's hash-based CSP header, which includes the inlined theme-init hash.
// A prerendered static page would instead get the hash-less /* CSP from
// public/_headers, which blocks the inlined theme script and Astro's inline
// styles. The page is static content, so the per-request render cost is trivial.

// Brand palette. Hexes mirror the design tokens in src/styles/global.css.
const brandColors = [
  { name: 'Violet (accent)', hex: '#6d28d9' },
  { name: 'Violet (hover)', hex: '#5b21b6' },
  { name: 'Gradient violet', hex: '#8b5cf6' },
  { name: 'Gradient blue', hex: '#3b82f6' },
  { name: 'Gradient teal', hex: '#2dd4bf' },
];
const lightColors = [
  { name: 'Background', hex: '#ffffff' },
  { name: 'Surface', hex: '#f7f7fb' },
  { name: 'Text', hex: '#17141f' },
  { name: 'Muted', hex: '#6b6880' },
  { name: 'Border', hex: '#ece9f4' },
];
const darkColors = [
  { name: 'Background', hex: '#0c0a12' },
  { name: 'Surface', hex: '#1a1522' },
  { name: 'Text', hex: '#ece9f4' },
  { name: 'Accent', hex: '#a78bfa' },
  { name: 'Border', hex: '#272233' },
];

const swatchGroups = [
  { title: 'Brand', colors: brandColors },
  { title: 'Light theme', colors: lightColors },
  { title: 'Dark theme', colors: darkColors },
];

// ---- Backlink badges ----
// Self-contained snippets partners can paste to link back to DRepTalk. Design
// constraints: a single <a> root (a plain dofollow link, so it passes link
// equity; iframes and JS embeds would not), style="" attributes only (survives
// any host CSS and most CSPs), inline SVG logo with a per-snippet gradient id
// so two badges on one page never collide, and neutral colors that read on
// light and dark host backgrounds. The footer badge is the one exception: its
// hover reveal needs real CSS, so it ships a tiny <style> block with a unique
// dtlk- class prefix.
const badgeFont = "system-ui,-apple-system,'Segoe UI',sans-serif";
const badgeBg = 'rgba(128,128,128,.08)';
const badgeBorder = '1px solid rgba(128,128,128,.32)';
const gradStops = ['#8b5cf6', '#3b82f6', '#2dd4bf'];

// Inline copy of /logo.svg, minified, gradient id namespaced per snippet.
const badgeLogo = (id: string, size: number) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 72" width="${size}" height="${size}" aria-hidden="true" style="flex:none;">` +
  `<defs><linearGradient id="${id}" x1="8" y1="56" x2="66" y2="16" gradientUnits="userSpaceOnUse">` +
  `<stop offset="0" stop-color="${gradStops[0]}"/><stop offset=".5" stop-color="${gradStops[1]}"/><stop offset="1" stop-color="${gradStops[2]}"/>` +
  `</linearGradient></defs>` +
  `<g stroke="url(#${id})" stroke-width="2.4" stroke-linecap="round">` +
  `<line x1="36" y1="27.5" x2="36" y2="19.5"/><line x1="42" y1="30" x2="47.7" y2="24.3"/>` +
  `<line x1="44.5" y1="36" x2="52.5" y2="36"/><line x1="42" y1="42" x2="47.7" y2="47.7"/>` +
  `<line x1="36" y1="44.5" x2="36" y2="52.5"/><line x1="30" y1="42" x2="24.3" y2="47.7"/>` +
  `<line x1="27.5" y1="36" x2="19.5" y2="36"/><line x1="30" y1="30" x2="24.3" y2="24.3"/></g>` +
  `<g fill="url(#${id})">` +
  `<circle cx="36" cy="15" r="4"/><circle cx="50.85" cy="21.15" r="4"/><circle cx="57" cy="36" r="4"/>` +
  `<circle cx="50.85" cy="50.85" r="4"/><circle cx="36" cy="57" r="4"/><circle cx="21.15" cy="50.85" r="4"/>` +
  `<circle cx="15" cy="36" r="4"/><circle cx="21.15" cy="21.15" r="4"/></g>` +
  `<g fill="url(#${id})">` +
  `<circle cx="47.1" cy="9.2" r="2"/><circle cx="62.8" cy="24.9" r="2"/><circle cx="62.8" cy="47.1" r="2"/>` +
  `<circle cx="47.1" cy="62.8" r="2"/><circle cx="24.9" cy="62.8" r="2"/><circle cx="9.2" cy="47.1" r="2"/>` +
  `<circle cx="9.2" cy="24.9" r="2"/><circle cx="24.9" cy="9.2" r="2"/></g>` +
  `<circle cx="36" cy="36" r="7" fill="url(#${id})"/></svg>`;

const footerBadgeSnippet =
  `<style>` +
  `.dtlk{display:inline-flex;align-items:center;gap:7px;padding:5px 12px 5px 8px;border:${badgeBorder};border-radius:999px;background:${badgeBg};text-decoration:none;color:inherit;font:500 12px/1.2 ${badgeFont};}` +
  `.dtlk-x{display:inline-block;vertical-align:bottom;max-width:0;overflow:hidden;white-space:nowrap;opacity:0;transition:max-width .35s ease,opacity .25s ease;}` +
  `.dtlk:hover .dtlk-x,.dtlk:focus-visible .dtlk-x{max-width:220px;opacity:.85;}` +
  `@media (prefers-reduced-motion:reduce){.dtlk-x{transition:none;}}` +
  `</style>` +
  `<a href="https://dreptalk.com/" class="dtlk" title="DRepTalk · Cardano Governance Forum">` +
  badgeLogo('dtg-fb', 16) +
  `<span style="opacity:.9;white-space:nowrap;">DRepTalk<span class="dtlk-x">&nbsp;· Cardano Governance Forum</span></span></a>`;

const sidebarCardSnippet =
  `<a href="https://dreptalk.com/" style="display:block;max-width:300px;box-sizing:border-box;padding:16px;border:${badgeBorder};border-radius:14px;background:${badgeBg};text-decoration:none;color:inherit;font-family:${badgeFont};">` +
  `<span style="display:flex;align-items:center;gap:10px;">` +
  badgeLogo('dtg-sc', 34) +
  `<span style="font-size:17px;font-weight:700;letter-spacing:-.01em;">DRepTalk</span></span>` +
  `<span style="display:block;margin-top:9px;font-size:13px;line-height:1.5;opacity:.75;">Follow Cardano governance votes and discuss them with DReps, SPOs and the community.</span>` +
  `<span style="display:block;height:3px;width:44px;margin-top:12px;border-radius:2px;background:linear-gradient(90deg,${gradStops.join(',')});"></span></a>`;

const bannerSnippet =
  `<a href="https://dreptalk.com/" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;max-width:728px;box-sizing:border-box;padding:14px 18px;border:${badgeBorder};border-radius:14px;background:${badgeBg};text-decoration:none;color:inherit;font-family:${badgeFont};">` +
  badgeLogo('dtg-bn', 36) +
  `<span style="flex:1;min-width:200px;">` +
  `<span style="display:block;font-size:15px;font-weight:700;">DRepTalk · Cardano Governance Forum</span>` +
  `<span style="display:block;margin-top:3px;font-size:13px;line-height:1.45;opacity:.72;">Governance actions, voting power and discussions with DReps and SPOs.</span></span>` +
  `<span style="font-size:12.5px;font-weight:600;color:#8b5cf6;white-space:nowrap;">dreptalk.com</span></a>`;

const badgeSnippets = [
  {
    title: 'Footer badge',
    note: 'Compact pill for footers. Collapsed it shows just the mark and name; the full name slides out on hover or keyboard focus.',
    html: footerBadgeSnippet,
  },
  {
    title: 'Sidebar card',
    note: 'Card for sidebars or article footers, up to 300px wide.',
    html: sidebarCardSnippet,
  },
  {
    title: 'Banner',
    note: 'Fluid banner up to 728px wide; wraps cleanly on small screens.',
    html: bannerSnippet,
  },
];
---

<Layout
  title="Brand assets - DRepTalk"
  description="The DRepTalk logo, wordmark, brand colors, and typeface for press, integrations, and partners."
  ogImage="/og-brand.jpg"
>
  <article class="brand">
    <header class="brand__head">
      <h1 class="brand__title">Brand <span class="grad-text">assets</span></h1>
      <p class="brand__lede">
        The DRepTalk logo, wordmark, colors, and type. Please use them as provided: do not stretch,
        rotate, recolor, or add effects.
      </p>
    </header>

    <section class="brand__section" aria-labelledby="logo-heading">
      <h2 id="logo-heading">Logo</h2>
      <div class="brand__cards">
        <figure class="logo-card logo-card--light">
          <img src="/logo.svg" alt="DRepTalk logo on a light background" width="160" height="160" />
        </figure>
        <figure class="logo-card logo-card--dark">
          <img src="/logo.svg" alt="DRepTalk logo on a dark background" width="160" height="160" />
        </figure>
        <figure class="logo-card logo-card--grad">
          <LogoMark style="width:70%;height:auto;color:#fff" label="DRepTalk mark on the brand gradient" />
        </figure>
      </div>
      <figure class="logo-lockup">
        <span class="logo-lockup__brand">
          <LogoMark style="height:34px;width:34px;color:var(--muted)" />
          <span class="logo-lockup__word">DRep<span class="grad-text">Talk</span></span>
        </span>
        <figcaption class="brand__note">
          In context, next to the wordmark, the mark sits in muted grey like the header lockup; only
          "Talk" keeps the gradient.
        </figcaption>
      </figure>
      <div class="brand__downloads">
        <a class="btn btn-secondary" href="/logo.svg" download="dreptalk-logo.svg">Logo SVG</a>
        <a class="btn btn-secondary" href="/logo.png" download="dreptalk-logo.png">Logo PNG</a>
      </div>
    </section>

    <section class="brand__section" aria-labelledby="wordmark-heading">
      <h2 id="wordmark-heading">Wordmark</h2>
      <p class="brand__note">
        DRepTalk is one word, capital D, R, T. The first half ("DRep") sits in muted grey, like the
        mark; only the second half ("Talk") carries color, the brand gradient (or the accent violet
        on a flat background). Do not space it as "DRep Talk".
      </p>
      <div class="wordmark-row">
        <span class="wordmark-chip">DRep<span class="grad-text">Talk</span></span>
        <span class="wordmark-chip wordmark-chip--accent">DRep<span>Talk</span></span>
      </div>
    </section>

    <section class="brand__section" aria-labelledby="colors-heading">
      <h2 id="colors-heading">Colors</h2>
      <p class="brand__note">Click a swatch to copy its hex.</p>
      {swatchGroups.map((group) => (
        <div class="swatch-group">
          <h3>{group.title}</h3>
          <div class="swatches">
            {group.colors.map((c) => (
              <button class="swatch" type="button" data-copy={c.hex} aria-label={`Copy ${c.hex}`}>
                <span class="swatch__chip" style={`background:${c.hex}`}></span>
                <span class="swatch__meta">
                  <span class="swatch__name">{c.name}</span>
                  <span class="swatch__hex" data-hex={c.hex}>{c.hex}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      ))}
      <div class="swatch-group">
        <h3>Gradient</h3>
        <button class="swatch swatch--wide" type="button" data-copy="linear-gradient(120deg, #8b5cf6 0%, #3b82f6 50%, #2dd4bf 100%)" aria-label="Copy the brand gradient">
          <span class="swatch__chip swatch__chip--grad"></span>
          <span class="swatch__meta">
            <span class="swatch__name">Brand gradient</span>
            <span class="swatch__hex" data-hex="linear-gradient(120deg, #8b5cf6, #3b82f6, #2dd4bf)">linear-gradient(120deg, #8b5cf6, #3b82f6, #2dd4bf)</span>
          </span>
        </button>
      </div>
    </section>

    <section class="brand__section" aria-labelledby="linkback-heading">
      <h2 id="linkback-heading">Link to DRepTalk</h2>
      <p class="brand__note">
        Ready-made badges for linking to DRepTalk from your site: no JavaScript, no external
        requests, and neutral colors that work on light and dark pages alike. Copy a snippet and
        paste it straight into your HTML.
      </p>
      {badgeSnippets.map((b) => (
        <div class="embed">
          <div class="embed__head">
            <h3>{b.title}</h3>
            <button class="btn btn-secondary embed__copy" type="button" data-copy={b.html}>
              <span data-copy-label="Copy HTML">Copy HTML</span>
            </button>
          </div>
          <p class="brand__note">{b.note}</p>
          <div class="embed__preview" set:html={b.html} />
        </div>
      ))}
      <p class="brand__note">
        To link to the discussion for a specific governance action, DRep, or vote, build the
        address from the on-chain id: see <a href="/help/linking/">Linking to DReps, governance
        actions, and votes</a>.
      </p>
    </section>

    <section class="brand__section" aria-labelledby="type-heading">
      <h2 id="type-heading">Typeface</h2>
      <p class="brand__note">
        Plus Jakarta Sans, self-hosted, weight axis 200 to 800, used for both headings and body.
      </p>
      <p class="type-sample">Aa Bb Cc Dd Ee 0123456789</p>
      <p class="type-line">Where DReps discuss governance.</p>
    </section>
  </article>

  <script is:inline src="/brand-copy.js"></script>
</Layout>

<style>
  .brand {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1rem 0 2rem;
  }
  .brand__head {
    padding: 1.5rem 0 0.5rem;
  }
  .brand__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: 0;
  }
  .brand__lede {
    margin: 0.75rem 0 0;
    max-width: 46ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .brand__section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .brand__section h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .brand__section h3 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 1.5rem 0 0.75rem;
  }
  .brand__note {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ---- Logo cards ---- */
  .brand__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .logo-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .logo-card img {
    width: auto;
    height: auto;
    max-width: 70%;
  }
  .logo-card--light {
    background: #ffffff;
  }
  .logo-card--dark {
    background: #0c0a12;
  }
  .logo-card--grad {
    background: var(--grad);
  }

  /* In-context lockup: mark plus wordmark as it appears in the header. */
  .logo-lockup {
    margin: 1.25rem 0 0;
  }
  .logo-lockup__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .logo-lockup__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    /* "DRep" muted like the mark; only "Talk" (.grad-text) carries color. */
    color: var(--muted);
    line-height: 1;
  }
  .logo-lockup figcaption {
    margin-top: 0.75rem;
  }

  .brand__downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  /* ---- Wordmark ---- */
  .wordmark-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .wordmark-chip {
    display: inline-flex;
    align-items: center;
    padding: 1.25rem 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    /* "DRep" muted like the mark, matching the header wordmark; only "Talk"
       (.grad-text or the accent span below) carries color. */
    color: var(--muted);
  }
  .wordmark-chip--accent span {
    color: var(--accent);
  }

  /* ---- Swatches ---- */
  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .swatch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem;
    text-align: left;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .swatch:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    transform: translateY(-1px);
  }
  .swatch.is-copied {
    border-color: var(--accent);
  }
  .swatch--wide {
    width: 100%;
  }
  .swatch__chip {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .swatch__chip--grad {
    background: var(--grad);
    border: none;
  }
  .swatch__meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .swatch__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
  }
  .swatch__hex {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- Backlink badges ---- */
  .embed {
    margin-top: 1.5rem;
  }
  .embed__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .embed__head h3 {
    margin: 0;
  }
  .embed__copy {
    flex-shrink: 0;
  }
  .embed__preview {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }

  /* ---- Type ---- */
  .type-sample {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin: 0.5rem 0 0;
    letter-spacing: -0.01em;
  }
  .type-line {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }
</style>
