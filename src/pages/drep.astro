---
import Layout from '@/layouts/Layout.astro';
import DRepService from '@/components/DRepService.tsx';
import { currentNetwork } from '@/lib/api/response';

// SSR so the island gets the deployment's real network (preprod or mainnet)
// instead of a hardcoded value. All wallet and chain work still happens in the
// client island; the island is non-custodial (the server never sees keys).
export const prerender = false;

// Resolve the network from the runtime env (CARDANO_NETWORK, defaults mainnet).
// The island uses it for the tx network and the explorer links.
const network = currentNetwork().network;
---
<Layout
  title="Register as a DRep - DRepTalk"
  description="Register as a Cardano DRep with your wallet. Fully client-side and non-custodial: dreptalk.com never sees your keys, your wallet signs and submits the transaction."
>
  <h1>Register as a DRep</h1>
  <p style="color:var(--muted);max-width:38rem;margin-bottom:2rem;">
    Become a Delegated Representative for Cardano governance. Connect a CIP-95
    capable wallet, add a short profile, and your wallet will submit the on-chain
    registration. The deposit is refundable when you later retire. Everything is
    signed locally; dreptalk.com never handles your private keys. Read more in
    <a href="/help/managing-your-drep">managing your DRep</a>.
  </p>
  <DRepService network={network} client:load />
</Layout>
