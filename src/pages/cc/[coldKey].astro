---
export const prerender = false;

import { requestDb } from '@/lib/db/requestDb.js';
import Layout from '@/layouts/Layout.astro';
import NotFound from '@/components/NotFound.astro';
import Avatar from '@/components/Avatar.astro';
import CopyButton from '@/components/CopyButton.astro';
import VoteBadge from '@/components/VoteBadge.astro';
import { resolveCcRouteParam } from '@/lib/governance/ccRoute.js';
import { buildCcMemberProfile, countReadableRationales, type CcRecordRow } from '@/lib/governance/ccProfile.js';
import { consideredCcActions } from '@/lib/analytics/ccParticipation.js';
import { tenureLabel } from '@/lib/analytics/ccPanelView.js';
import { shortColdKey, ccProfilePath, buildCcNameIndex } from '@/lib/governance/ccNames.js';
import { getProtocolParams } from '@/lib/db/protocolParams.js';
import { listDecidedCcActions, listDecidedCcVoteRows, getCommitteeTimeline, listOpenCcVoteRows } from '@/lib/db/committee.js';
import { getAllCcMemberNames } from '@/lib/db/ccMemberName.js';
import { getCcRationaleStates } from '@/lib/db/actionRationale.js';
import { positionsVoterAnchor } from '@/lib/governance/voteStatement.js';
import { readableType, statusBadge } from '@/lib/governance/view.js';
import { cacheControlForSynced, truncateIdMiddle } from '@/lib/forum/view.js';

const route = resolveCcRouteParam(Astro.params.coldKey ?? '');

// Validate the request before any DB read.
if (route.kind === 'redirect') {
  return Astro.redirect(`${ccProfilePath(route.hex)}${Astro.url.search}`, 301);
}

const db = route.kind === 'canonical' ? requestDb() : null;
const coldKeyHex = route.kind === 'canonical' ? route.hex : '';

let profile: ReturnType<typeof buildCcMemberProfile> = null;
let readable = 0;
if (db) {
  const [params, actions, votesByAction, timeline, nameRows, openVotes] = await Promise.all([
    getProtocolParams(db),
    listDecidedCcActions(db),
    listDecidedCcVoteRows(db),
    getCommitteeTimeline(db),
    getAllCcMemberNames(db),
    listOpenCcVoteRows(db),
  ]);
  const currentEpoch = params?.epoch ?? null;
  const { members, hotToCold } = timeline;
  const { considered } = consideredCcActions({ actions, votesByAction, members, hotToCold, currentEpoch });
  profile = buildCcMemberProfile({
    coldKeyHex,
    considered,
    members,
    hotToCold,
    nameIndex: buildCcNameIndex(nameRows, hotToCold),
    currentEpoch,
    openVotes,
  });
  if (profile) {
    const voterIds = [...new Set(profile.record.flatMap((r) => (r.vote ? [r.vote.voterId] : [])))];
    const states = await getCcRationaleStates(db, voterIds);
    readable = countReadableRationales(profile.record, states);
  }
}

if (!profile) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', cacheControlForSynced(Astro.locals.user));
}

const HEAD = 10;
const recordHead = profile?.record.slice(0, HEAD) ?? [];
const recordTail = profile?.record.slice(HEAD) ?? [];
const displayName = profile ? (profile.name ?? shortColdKey(profile.coldKeyHex)) : '';
const hotKeys = profile ? [...profile.hotKeys].sort() : [];

function actionHref(row: { topicSlug: string | null }): string | null {
  return row.topicSlug ? `/t/${row.topicSlug}/` : null;
}
function rationaleHref(row: CcRecordRow): string | null {
  return row.topicSlug && row.vote ? `/t/${row.topicSlug}/${positionsVoterAnchor(row.vote.voterId, 'cc')}` : null;
}
const metaDescription = profile
  ? `${displayName}: Constitutional Committee member. ${profile.eligible > 0 ? `Voted on ${profile.voted} of ${profile.eligible} decided actions it could vote on.` : 'No decided actions yet.'} See the full voting record on DRepTalk.`
  : '';
---

{!profile ? (
  <NotFound noun="committee member" />
) : (
  <Layout title={`${displayName} - Constitutional Committee member on DRepTalk`} description={metaDescription} wide>
    <nav style="font-size:0.875rem;color:var(--muted);margin-bottom:1rem;">
      <a href="/">DRepTalk</a>
      <span style="margin:0 0.375rem;">/</span>
      <span>{displayName}</span>
    </nav>

    <header class="cc-hd">
      <span class="cc-hd__avatar">
        <Avatar seed={profile.coldKeyHex} size={96} ring />
      </span>
      <div class="cc-hd__main">
        <div class="cc-hd__tags">
          <span class="cc-hd__kind">Constitutional Committee</span>
          {profile.standing && <span class="cc-hd__standing">{profile.standing}</span>}
        </div>
        <h1 class="cc-hd__name">{displayName}</h1>
        {profile.nameSource?.kind === 'declared' && (
          <p class="cc-hd__note">Name as stated in this member's own vote rationales.</p>
        )}
        {profile.nameSource?.kind === 'curated' && (
          <p class="cc-hd__note">Name from the {profile.nameSource.source}.</p>
        )}
        <div class="cc-hd__id">
          <span title={profile.coldKeyHex}>{truncateIdMiddle(profile.coldKeyHex)}</span>
          <CopyButton value={profile.coldKeyHex} label="Copy cold key" />
        </div>
        <p class="cc-hd__tenure">{tenureLabel(profile.tenure)}</p>
        {hotKeys.length > 0 && (
          <ul class="cc-hd__hot" aria-label="Hot keys">
            {hotKeys.map((hot) => (
              <li class="cc-hd__id">
                <span title={hot}>Hot key {shortColdKey(hot)}</span>
                <CopyButton value={hot} label="Copy hot key" />
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <section class="cc-summary">
      <h2 class="cc-summary__h">
        {profile.eligible > 0
          ? `Voted on ${profile.voted} of ${profile.eligible} actions it could vote on`
          : 'No decided actions yet'}
      </h2>
      {profile.eligible > 0 && (
        <>
          <p class="cc-summary__line">
            Yes {profile.counts.yes}, No {profile.counts.no}, Abstain {profile.counts.abstain}.
            {` ${readable} of ${profile.voted} `}{profile.voted === 1 ? 'vote has' : 'votes have'} a readable rationale.
          </p>
          <div class="cc-raster" role="img" aria-label={`Voted on ${profile.voted} of ${profile.eligible} eligible actions, oldest to newest`}>
            {profile.sequence.map((s) => <span class={`cc-raster__dot cc-raster__dot--${s}`}></span>)}
          </div>
          <p class="cc-raster__note">Each square is one decided action from the oldest to the newest, filled when the member voted, outlined when eligible without a vote, faded outside the member's eligibility window.</p>
        </>
      )}
    </section>

    <section id="record" class="vhist-section">
      <h2 class="vhist-section__title">Record <span class="vhist-section__count">({profile.record.length})</span></h2>
      {profile.record.length === 0 ? (
        <p class="vhist__empty">No decided actions yet.</p>
      ) : (
        <div class="cc-rows">
          {recordHead.map((row) => (
            <Fragment>
              <div class="cc-row">
                <span class="cc-row__vote">{row.vote ? <VoteBadge vote={row.vote.vote} compact /> : <span class="cc-row__none">Not voted</span>}</span>
                <span class="cc-row__main">
                  {actionHref(row) ? <a href={actionHref(row)}>{row.title ?? row.gaId}</a> : <span>{row.title ?? row.gaId}</span>}
                  <span class="cc-row__meta">
                    {readableType(row.type)}
                    <span class={`vhist__badge vhist__badge--${statusBadge(row.status).tone}`}>{statusBadge(row.status).label}</span>
                    epoch {row.decidedEpoch}
                    {rationaleHref(row) && <a href={rationaleHref(row)}>Rationale</a>}
                  </span>
                </span>
              </div>
            </Fragment>
          ))}
          {recordTail.length > 0 && (
            <details class="vhist__more">
              <summary class="vhist__more-toggle">
                <span class="vhist__more-show">Show {recordTail.length} more</span>
                <span class="vhist__more-hide">Show less</span>
              </summary>
              {recordTail.map((row) => (
                <div class="cc-row">
                  <span class="cc-row__vote">{row.vote ? <VoteBadge vote={row.vote.vote} compact /> : <span class="cc-row__none">Not voted</span>}</span>
                  <span class="cc-row__main">
                    {actionHref(row) ? <a href={actionHref(row)}>{row.title ?? row.gaId}</a> : <span>{row.title ?? row.gaId}</span>}
                    <span class="cc-row__meta">
                      {readableType(row.type)}
                      <span class={`vhist__badge vhist__badge--${statusBadge(row.status).tone}`}>{statusBadge(row.status).label}</span>
                      epoch {row.decidedEpoch}
                      {rationaleHref(row) && <a href={rationaleHref(row)}>Rationale</a>}
                    </span>
                  </span>
                </div>
              ))}
            </details>
          )}
        </div>
      )}
    </section>

    {profile.uncounted.length > 0 && (
      <section id="not-counted" class="vhist-section">
        <h2 class="vhist-section__title">Not counted <span class="vhist-section__count">({profile.uncounted.length})</span></h2>
        <div class="cc-rows">
          {profile.uncounted.map((row) => (
            <div class="cc-row">
              <span class="cc-row__vote">{row.vote && <VoteBadge vote={row.vote.vote} compact />}</span>
              <span class="cc-row__main">
                {actionHref(row) ? <a href={actionHref(row)}>{row.title ?? row.gaId}</a> : <span>{row.title ?? row.gaId}</span>}
                <span class="cc-row__meta">
                  {readableType(row.type)}
                  <span class={`vhist__badge vhist__badge--${statusBadge(row.status).tone}`}>{statusBadge(row.status).label}</span>
                  epoch {row.decidedEpoch}
                </span>
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    {profile.open.length > 0 && (
      <section id="open" class="vhist-section">
        <h2 class="vhist-section__title">Open actions <span class="vhist-section__count">({profile.open.length})</span></h2>
        <p class="cc-note">Votes on open actions are not part of the participation figure.</p>
        <div class="cc-rows">
          {profile.open.map((row) => (
            <div class="cc-row">
              <span class="cc-row__vote"><VoteBadge vote={row.vote.vote} compact /></span>
              <span class="cc-row__main">
                {actionHref(row) ? <a href={actionHref(row)}>{row.title ?? row.gaId}</a> : <span>{row.title ?? row.gaId}</span>}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    <p class="cc-note cc-note--foot">Eligibility follows the committee membership at each action's decision boundary, and only a member's final vote counts.</p>
  </Layout>
)}

<style>
  .cc-hd { display: flex; gap: 1.25rem; align-items: flex-start; margin-bottom: 1.5rem; }
  .cc-hd__avatar { flex: none; line-height: 0; border-radius: 50%; box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 8%, transparent); }
  .cc-hd__main { min-width: 0; flex: 1; }
  .cc-hd__tags { display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; margin-bottom: 0.45rem; }
  .cc-hd__kind, .cc-hd__standing {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .cc-hd__standing { color: var(--muted); background: color-mix(in srgb, var(--muted) 14%, transparent); }
  .cc-hd__name { margin: 0 0 0.2rem; font-size: 2rem; line-height: 1.1; overflow-wrap: anywhere; }
  .cc-hd__note { margin: 0 0 0.4rem; font-size: 0.8125rem; color: var(--muted); }
  .cc-hd__id { font-size: 0.8125rem; color: var(--muted); margin-bottom: 0.3rem; }
  .cc-hd__tenure { margin: 0 0 0.4rem; font-size: 0.875rem; color: var(--muted); }
  .cc-hd__hot { list-style: none; margin: 0; padding: 0; }

  .cc-summary {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    box-shadow: var(--shadow);
    padding: 1.1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .cc-summary__h { font-size: 1.05rem; margin: 0 0 0.6rem; }
  .cc-summary__line { margin: 0 0 0.85rem; color: var(--fg); }
  .cc-raster { display: flex; flex-wrap: wrap; gap: 2px; }
  .cc-raster__dot { width: 7px; height: 7px; flex: 0 0 auto; }
  .cc-raster__dot--voted { background: var(--accent); }
  .cc-raster__dot--missed { background: transparent; border: 1px solid var(--muted); }
  .cc-raster__dot--ineligible { background: var(--muted); opacity: 0.4; }
  .cc-raster__note { margin: 0.6rem 0 0; color: var(--muted); font-size: 0.8rem; max-width: 60ch; }

  .cc-rows { display: flex; flex-direction: column; }
  .cc-row {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }
  .cc-row__vote { flex: 0 0 5.5rem; }
  .cc-row__none { color: var(--muted); font-size: 0.8125rem; }
  .cc-row__main { min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; overflow-wrap: anywhere; }
  .cc-row__meta { display: flex; flex-wrap: wrap; gap: 0.2rem 0.75rem; align-items: center; font-size: 0.8125rem; color: var(--muted); }
  .cc-note { margin: 0 0 0.75rem; color: var(--muted); font-size: 0.8125rem; }
  .cc-note--foot { margin-top: 1.5rem; font-size: 0.75rem; }

  @media (max-width: 560px) {
    .cc-hd { gap: 0.85rem; }
    .cc-hd__name { font-size: 1.5rem; }
    .cc-row__vote { flex-basis: 4.5rem; }
  }
</style>
